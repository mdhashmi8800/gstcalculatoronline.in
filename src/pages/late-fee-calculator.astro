---
import CalculatorLayout from '../components/CalculatorLayout.astro';
import ResultCard from '../components/ResultCard.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "GST Late Fee Calculator – GSTR-3B Penalty Online";
const pageDesc = "Calculate GSTR-3B late fee online. Computes daily late fees under Section 47 with aggregate turnover caps (₹500 to ₹10,000). Always updated and free.";

// Schema for Late Fee Calculator Page
const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": "GST Late Fee Calculator – Calculate GSTR-3B Penalty Online",
  "url": "https://gstcalculatoronline.in/late-fee-calculator",
  "description": "Free GST late fee calculator for GSTR-3B. Computes late fees under Section 47 of the CGST Act with turnover-based caps.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
};

const faqs = [
  { question: "What is the late fee for GSTR-3B in 2025?", answer: "The late fee for GSTR-3B under Section 47 of the CGST Act is ₹50 per day (total) for taxable returns with tax liability: ₹25 CGST + ₹25 SGST. For NIL returns (no output tax, no ITC), the late fee is ₹20 per day total: ₹10 CGST + ₹10 SGST." },
  { question: "What are the maximum caps on GSTR-3B late fee?", answer: "Late fees are capped based on Annual Aggregate Turnover (AATO): NIL returns — Max ₹500 (cap applies). Taxable returns, AATO up to ₹1.5 Crore — Max ₹2,000. AATO ₹1.5 Crore to ₹5 Crore — Max ₹5,000. AATO above ₹5 Crore — Max ₹10,000." },
  { question: "What is Section 47 of the CGST Act?", answer: "Section 47 of the CGST Act, 2017 provides for the levy of late fees on taxpayers who fail to file their GST returns by the due date. The late fee accrues on a daily basis from the day after the due date until the actual date of filing." },
  { question: "Can GSTR-3B late fee be waived off?", answer: "Late fees can only be waived off if the Government issues a specific notification under the CGST Act, usually through amnesty schemes or extensions. The GST Council has announced several such waivers in the past (2019, 2021). Without such a notification, late fees are mandatory." },
  { question: "How is GST late fee calculated for GSTR-3B?", answer: "GST Late Fee = Daily Rate × Number of Delay Days (subject to cap). For a taxable return filed 20 days late: Late Fee = 50 × 20 = ₹1,000 (if below the cap for your turnover). CGST component = ₹500; SGST component = ₹500." },
  { question: "Is there a late fee for GSTR-1?", answer: "Yes. GSTR-1 also has a late fee under Section 47: ₹50/day for taxable returns (₹25 CGST + ₹25 SGST) and ₹20/day for NIL returns, with similar turnover-based caps. Note: GSTR-1 late filing also blocks the buyer's ITC reconciliation." },
  { question: "What is a NIL return for GST purposes?", answer: "A NIL GST return is one where the taxpayer has no outward supply (no sales), no inward supply (no purchases), no tax liability, and no ITC claim for the month. Such taxpayers can file NIL GSTR-3B at the lower late fee of ₹20/day." },
  { question: "Does GST late fee apply if tax is already paid on time but return filed late?", answer: "Yes. The late fee under Section 47 is for the delay in filing the return, regardless of whether the tax was already deposited using a challan. Even if you have paid the tax, you must file the return by the due date to avoid the daily late fee accumulation." },
  { question: "How is the late fee split between CGST and SGST?", answer: "The late fee is split equally between CGST and SGST. For taxable returns: CGST late fee = ₹25/day, SGST late fee = ₹25/day (total ₹50/day). For NIL returns: CGST = ₹10/day, SGST = ₹10/day (total ₹20/day)." },
  { question: "Can I claim ITC on GST late fee paid?", answer: "No. GST late fee is a penal charge and is not an eligible input for ITC. It cannot be offset using the Electronic Credit Ledger (ITC balance). Late fees must be paid from the Electronic Cash Ledger only." },
  { question: "When does GST late fee stop accumulating?", answer: "GST late fee stops accumulating on the date the return is actually filed on the GST portal. For example, if the due date was the 20th and you file on the 30th, the late fee applies for 10 days (days 21 through 30). Once the return is filed and the late fee is paid, no further fee accrues." },
  { question: "Is this GST Late Fee Calculator free?", answer: "Yes, completely free. No login, no registration, no fees. Select the return type, enter the due date and actual filing date, select your annual turnover range, and get the instant late fee calculation including the CGST and SGST split." }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema} faqs={faqs}>
  <!-- Calculator Input Form -->
  <form id="latefee-form" class="space-y-4 md:space-y-6">
    <!-- Return Due Date -->
    <div>
      <label for="calc-due-date" class="block text-sm font-semibold text-ink">GST Return Due Date</label>
      <input 
        type="date" 
        name="dueDate" 
        id="calc-due-date" 
        class="mt-2 block w-full rounded-lg border border-hairline bg-canvas py-3 px-4 text-base text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary font-mono transition-all"
        required
      />
    </div>

    <!-- Actual Filing Date -->
    <div>
      <label for="calc-filing-date" class="block text-sm font-semibold text-ink">Actual Filing Date</label>
      <input 
        type="date" 
        name="filingDate" 
        id="calc-filing-date" 
        class="mt-2 block w-full rounded-lg border border-hairline bg-canvas py-3 px-4 text-base text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary font-mono transition-all"
        required
      />
    </div>

    <!-- Return Type -->
    <div>
      <span class="block text-sm font-semibold text-ink mb-2">Type of Return</span>
      <div class="segmented-control" role="group" aria-label="Type of return">
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="return-type" value="nil" checked class="sr-only" />
          <span>NIL Return</span>
        </label>
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="return-type" value="taxable" class="sr-only" />
          <span>Taxable Return</span>
        </label>
      </div>
    </div>

    <!-- Turnover Caps (Visible only for taxable returns) -->
    <div id="turnover-container" class="hidden">
      <span class="block text-sm font-semibold text-ink">Aggregate Annual Turnover (AATO) in Previous FY</span>
      <div class="mt-2 space-y-2">
        <label class="flex items-center justify-between rounded-lg border border-hairline bg-canvas p-3 cursor-pointer text-sm font-medium text-body hover:bg-canvas-soft [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink select-none">
          <div class="flex items-center">
            <input type="radio" name="turnover-cap" value="1.5" checked class="mr-3 accent-primary" />
            <span>Up to ₹1.5 Crores</span>
          </div>
          <span class="text-xs font-mono text-mute">Max Cap: ₹2,000</span>
        </label>
        <label class="flex items-center justify-between rounded-lg border border-hairline bg-canvas p-3 cursor-pointer text-sm font-medium text-body hover:bg-canvas-soft [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink select-none">
          <div class="flex items-center">
            <input type="radio" name="turnover-cap" value="5" class="mr-3 accent-primary" />
            <span>₹1.5 Crores to ₹5 Crores</span>
          </div>
          <span class="text-xs font-mono text-mute">Max Cap: ₹5,000</span>
        </label>
        <label class="flex items-center justify-between rounded-lg border border-hairline bg-canvas p-3 cursor-pointer text-sm font-medium text-body hover:bg-canvas-soft [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink select-none">
          <div class="flex items-center">
            <input type="radio" name="turnover-cap" value="above" class="mr-3 accent-primary" />
            <span>Above ₹5 Crores</span>
          </div>
          <span class="text-xs font-mono text-mute">Max Cap: ₹10,000</span>
        </label>
      </div>
    </div>
  </form>

  <!-- Interactive Results Block -->
  <ResultCard slot="results" title="Late Fee Summary" showEffectiveTax={false} showChart={false} />

  <!-- Educational content -->
  <div slot="content" class="prose max-w-none">
    <h2>GSTR-3B Late Fee Calculation Rules & Guidelines</h2>
    <p>Every registered person who fails to furnish returns including GSTR-3B by the due dates is liable to pay a late fee under Section 47 of the Central Goods and Services Tax (CGST) Act. The late fee is calculated from the day after the due date up to the date on which the return is filed.</p>
        <h2>Complete Guide to GST Late Fee — Section 47 CGST Act</h2>
    <p>Filing your GST returns late can attract significant late fees that accumulate daily. Understanding the <strong>GST late fee structure</strong> under <strong>Section 47 of the CGST Act</strong> is essential for every registered taxpayer in India. Our free <strong>GST Late Fee Calculator online</strong> computes the exact fee for any delay period, based on your return type and annual turnover.</p>

    <h2>GST Late Fee Rate Structure (Section 47)</h2>
    <div class="overflow-x-auto my-4">
      <table class="w-full text-sm border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-canvas-soft-2">
          <tr>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Return Type</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">CGST/day</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">SGST/day</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Total/day</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-hairline/50"><td class="p-3 font-medium text-ink">NIL Return (no tax, no ITC)</td><td class="p-3 font-mono">₹10</td><td class="p-3 font-mono">₹10</td><td class="p-3 font-mono font-bold text-primary">₹20/day</td></tr>
          <tr class="bg-canvas-soft/30"><td class="p-3 font-medium text-ink">Taxable / Liability Return</td><td class="p-3 font-mono">₹25</td><td class="p-3 font-mono">₹25</td><td class="p-3 font-mono font-bold text-primary">₹50/day</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Turnover-Based Late Fee Caps</h2>
    <p>To protect small businesses, the GST Council rationalized late fee caps based on Annual Aggregate Turnover (AATO):</p>
    <div class="overflow-x-auto my-4">
      <table class="w-full text-sm border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-canvas-soft-2">
          <tr>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Return Category</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">AATO</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Max Late Fee</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-hairline/50"><td class="p-3 text-body">NIL Returns</td><td class="p-3 text-body">Any turnover</td><td class="p-3 font-mono font-bold text-primary">₹500 per return</td></tr>
          <tr class="border-b border-hairline/50 bg-canvas-soft/30"><td class="p-3 text-body">Taxable Returns</td><td class="p-3 text-body">Up to ₹1.5 Crore</td><td class="p-3 font-mono font-bold text-primary">₹2,000 per return</td></tr>
          <tr class="border-b border-hairline/50"><td class="p-3 text-body">Taxable Returns</td><td class="p-3 text-body">₹1.5 Crore to ₹5 Crore</td><td class="p-3 font-mono font-bold text-primary">₹5,000 per return</td></tr>
          <tr class="bg-canvas-soft/30"><td class="p-3 text-body">Taxable Returns</td><td class="p-3 text-body">Above ₹5 Crore</td><td class="p-3 font-mono font-bold text-primary">₹10,000 per return</td></tr>
        </tbody>
      </table>
    </div>

    <h2>GST Late Fee Calculation Examples</h2>
    <h3>Example 1 — Small Trader (NIL Return, 25 Days Late)</h3>
    <ul>
      <li>Return Type: NIL</li>
      <li>Delay: 25 days &times; ₹20/day = ₹500</li>
      <li>Cap for NIL: ₹500 &rarr; Late Fee = <strong>₹500</strong> (at cap)</li>
    </ul>

    <h3>Example 2 — Mid-Size Business (Taxable Return, AATO ₹2 Crore, 60 Days Late)</h3>
    <ul>
      <li>Return Type: Taxable</li>
      <li>Delay: 60 days &times; ₹50/day = ₹3,000</li>
      <li>Cap (₹1.5 Cr–₹5 Cr range): ₹5,000 &rarr; Late Fee = <strong>₹3,000</strong> (below cap)</li>
    </ul>

    <h3>Example 3 — Large Business (Taxable Return, AATO ₹10 Crore, 10 Days Late)</h3>
    <ul>
      <li>Return Type: Taxable</li>
      <li>Delay: 10 days &times; ₹50/day = ₹500</li>
      <li>Cap (Above ₹5 Crore): ₹10,000 &rarr; Late Fee = <strong>₹500</strong> (below cap)</li>
    </ul>

    <h2>How to Minimize GST Late Fees</h2>
    <ul>
      <li><strong>File on time</strong> — Set calendar reminders for the 20th of each month (GSTR-3B monthly due date)</li>
      <li><strong>File NIL returns promptly</strong> — Even if there's no business, file NIL to avoid daily accumulation</li>
      <li><strong>Use GST portal alerts</strong> — The GST portal sends SMS/email reminders before due dates</li>
      <li><strong>Check for amnesty schemes</strong> — Watch for GST Council notifications that waive or reduce fees</li>
    </ul>

    <FAQ items={faqs} />

    <h2>Related Calculators</h2>
    <ul>
      <li><a href="/interest-calculator">GST Interest Calculator</a> — Calculate 18% interest on delayed tax payment</li>
      <li><a href="/gst-calculator">GST Calculator Online</a> — Calculate your GST liability</li>
      <li><a href="/gst-refund-calculator">GST Refund Calculator</a> — Estimate excess GST refunds</li>
    </ul>

    <h2>Conclusion</h2>
    <p>Late GST return filing results in penalties that compound daily. Our free <strong>GST Late Fee Calculator online</strong> gives you an instant, accurate view of how much fee you owe for any delay period, helping you plan your filing and budget for compliance costs. Always file on time — the late fee saved is always worth more than the effort of filing.</p>
  </div>
</CalculatorLayout>

<script>
  // Set default dates (due date: 20th of last month, actual filing date: today)
  const d = new Date();
  const todayStr = d.toISOString().split('T')[0];
  
  // Set due date to 20th of previous month
  const prevMonth = new Date(d.getFullYear(), d.getMonth() - 1, 20);
  const dueStr = prevMonth.toISOString().split('T')[0];

  const dueDateInput = document.getElementById('calc-due-date') as HTMLInputElement | null;
  const filingDateInput = document.getElementById('calc-filing-date') as HTMLInputElement | null;
  const returnTypeRadios = document.querySelectorAll('input[name="return-type"]');
  const turnoverContainer = document.getElementById('turnover-container');
  const latefeeForm = document.getElementById('latefee-form') as HTMLFormElement | null;

  // DOM Outputs
  const resTaxable = document.getElementById('res-taxable-val');
  const resCgstVal = document.getElementById('res-cgst-val');
  const resSgstVal = document.getElementById('res-sgst-val');
  const resTotalTax = document.getElementById('res-total-tax');
  const resGrandTotal = document.getElementById('res-grand-total');

  if (dueDateInput && !dueDateInput.value) dueDateInput.value = dueStr;
  if (filingDateInput && !filingDateInput.value) filingDateInput.value = todayStr;

  function validateInput(input: HTMLInputElement, message: string, check: () => boolean): boolean {
    const isValid = check();
    let errSpan = document.getElementById(`${input.id}-error`);
    if (!isValid) {
      input.classList.add('input-error');
      if (!errSpan) {
        errSpan = document.createElement('span');
        errSpan.id = `${input.id}-error`;
        errSpan.className = 'error-message';
        errSpan.innerText = message;
        input.parentElement?.appendChild(errSpan);
      }
    } else {
      input.classList.remove('input-error');
      errSpan?.remove();
    }
    return isValid;
  }

  function updateFormUI() {
    const returnTypeRadio = document.querySelector('input[name="return-type"]:checked') as HTMLInputElement | null;
    if (returnTypeRadio?.value === 'taxable') {
      turnoverContainer?.classList.remove('hidden');
    } else {
      turnoverContainer?.classList.add('hidden');
    }
  }

  function calculate() {
    if (!dueDateInput || !filingDateInput) return;

    // Validation
    const isFilingDateValid = validateInput(
      filingDateInput,
      "Filing date cannot be earlier than payment/return due date",
      () => {
        const due = new Date(dueDateInput.value).getTime();
        const file = new Date(filingDateInput.value).getTime();
        return file >= due;
      }
    );

    if (!isFilingDateValid) {
      if (resTaxable) resTaxable.innerText = "0 Days";
      if (resCgstVal) resCgstVal.innerText = "₹0.00";
      if (resSgstVal) resSgstVal.innerText = "₹0.00";
      if (resTotalTax) resTotalTax.innerText = "₹0.00";
      if (resGrandTotal) resGrandTotal.innerText = "₹0.00";
      return;
    }

    const dueDate = new Date(dueDateInput.value);
    const filingDate = new Date(filingDateInput.value);
    
    // Difference in milliseconds
    const diffTime = filingDate.getTime() - dueDate.getTime();
    // Convert to days
    const delayDays = Math.max(0, Math.floor(diffTime / (1000 * 60 * 60 * 24)));

    const returnTypeRadio = document.querySelector('input[name="return-type"]:checked') as HTMLInputElement | null;
    const isNil = returnTypeRadio ? returnTypeRadio.value === 'nil' : true;

    // Daily fee rates
    const dailyRate = isNil ? 20 : 50;
    
    // Capping logic
    let maxCap = 500; // NIL cap
    if (!isNil) {
      const turnoverRadio = document.querySelector('input[name="turnover-cap"]:checked') as HTMLInputElement | null;
      const turnoverVal = turnoverRadio ? turnoverRadio.value : '1.5';
      
      if (turnoverVal === '1.5') {
        maxCap = 2000;
      } else if (turnoverVal === '5') {
        maxCap = 5000;
      } else {
        maxCap = 10000;
      }
    }

    const calculatedFee = delayDays * dailyRate;
    const payableFee = Math.min(calculatedFee, maxCap);
    const splitFee = payableFee / 2;

    // Format currency function
    const fmtVal = (val: number) => '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    // Update Result labels on page mount / calculation
    const labels = {
      'res-taxable-val': `${delayDays} Day${delayDays === 1 ? '' : 's'}`,
      'res-cgst-val': fmtVal(splitFee),
      'res-sgst-val': fmtVal(splitFee),
      'res-total-tax': fmtVal(payableFee),
      'res-grand-total': fmtVal(payableFee)
    };

    if (resTaxable) resTaxable.innerText = labels['res-taxable-val'];
    if (resCgstVal) resCgstVal.innerText = labels['res-cgst-val'];
    if (resSgstVal) resSgstVal.innerText = labels['res-sgst-val'];
    if (resTotalTax) resTotalTax.innerText = labels['res-total-tax'];
    if (resGrandTotal) resGrandTotal.innerText = labels['res-grand-total'];
  }

  // Set visual text labels inside the result card to fit late fee terminology
  function customizeLabels() {
    const labelTaxable = document.querySelector('#res-taxable-val')?.previousElementSibling as HTMLElement | null;
    const labelCgst = document.querySelector('#res-cgst-val')?.previousElementSibling as HTMLElement | null;
    const labelSgst = document.querySelector('#res-sgst-val')?.previousElementSibling as HTMLElement | null;
    const labelTotalTax = document.querySelector('#res-total-tax')?.previousElementSibling as HTMLElement | null;
    const labelGrandTotal = document.querySelector('#res-grand-total')?.previousElementSibling as HTMLElement | null;

    if (labelTaxable) labelTaxable.innerText = "Filing Delay Duration";
    if (labelCgst) labelCgst.innerText = "Central Late Fee (CGST)";
    if (labelSgst) labelSgst.innerText = "State Late Fee (SGST)";
    if (labelTotalTax) labelTotalTax.innerText = "Uncapped Fee Calculated";
    if (labelGrandTotal) labelGrandTotal.innerText = "Total Late Fee (Capped)";

    // Hide IGST row as late fee is split strictly 50:50 between CGST and SGST
    document.getElementById('res-igst-row')?.classList.add('hidden');
  }

  // Pre-load from parameters
  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const due = params.get('due');
    const file = params.get('file');
    const returnType = params.get('returntype');
    const turnover = params.get('turnover');

    if (due && dueDateInput) dueDateInput.value = due;
    if (file && filingDateInput) filingDateInput.value = file;
    if (returnType) {
      const typeRadio = document.querySelector(`input[name="return-type"][value="${returnType}"]`) as HTMLInputElement | null;
      if (typeRadio) typeRadio.checked = true;
    }
    if (turnover) {
      const turnRadio = document.querySelector(`input[name="turnover-cap"][value="${turnover}"]`) as HTMLInputElement | null;
      if (turnRadio) turnRadio.checked = true;
    }
    updateFormUI();
  }

  // Add listeners
  if (latefeeForm) {
    latefeeForm.addEventListener('input', calculate);
    latefeeForm.addEventListener('change', calculate);
  }

  returnTypeRadios.forEach((radio) => {
    radio.addEventListener('change', () => {
      updateFormUI();
      calculate();
    });
  });

  // Init
  customizeLabels();
  loadFromUrl();
  calculate();
</script>

