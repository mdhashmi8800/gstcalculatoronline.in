---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import FAQ from '../components/FAQ.astro';
import AdSense from '../components/AdSense.astro';
import { tools } from '../utils/tools';

const pageTitle = "GST Calculator Online India - GST Rates & Return Tools";
const pageDesc = "Free online GST calculators for Indian taxpayers. Easily calculate CGST, SGST, IGST, return late fees, interest on tax delays, and composition scheme liabilities according to current Indian tax regulations.";

// Load latest 3 articles from blog content
const posts = Object.values(import.meta.glob('../content/blog/*.md', { eager: true })) as any[];
const latestArticles = posts.map(post => ({
  title: post.frontmatter.title,
  slug: post.frontmatter.slug,
  date: post.frontmatter.date,
  readTime: post.frontmatter.readTime,
  category: post.frontmatter.category || 'Guides',
  desc: post.frontmatter.metaDescription || post.frontmatter.description
})).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()).slice(0, 3);

// Get popular calculators
const popularCalculators = tools.filter(t => t.badge === 'Popular' || t.id === 'reverse-gst-calculator' || t.id === 'gst-inclusive-calculator' || t.id === 'late-fee-calculator' || t.id === 'interest-calculator');

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

const homepageFaqs = [
  {
    question: "How do I calculate GST online?",
    answer: "You can calculate GST by entering the transaction amount and selecting the appropriate GST slab (5%, 12%, 18%, 28%) in our GST Calculator. It will automatically show the CGST, SGST, and IGST breakdowns for both 'Add GST' and 'Remove GST' types."
  },
  {
    question: "Is this GST Calculator updated with the latest Indian tax laws?",
    answer: "Yes, all our calculators are updated in accordance with the latest Central Goods and Services Tax (CGST) and State Goods and Services Tax (SGST) regulations, including rationalized late fees and Section 50 interest calculations."
  },
  {
    question: "What is the difference between CGST, SGST, and IGST?",
    answer: "CGST (Central GST) and SGST (State GST) are levied on transactions within a single state (intrastate) and are shared equally between the Centre and State. IGST (Integrated GST) is levied on interstate transactions and imports, collected by the Centre and distributed to the consumption state."
  },
  {
    question: "How is interest calculated on late GST payments?",
    answer: "Under Section 50 of the CGST Act, interest is levied at 18% per annum on delayed tax payments made through the Electronic Cash Ledger (net tax liability). For wrongful utilization of Input Tax Credit (ITC), interest is charged at 24% per annum."
  },
  {
    question: "What is the daily late fee for filing GSTR-3B late?",
    answer: "The standard late fee for late filing of GSTR-3B is ₹50 per day for returns with tax liability (₹25 CGST + ₹25 SGST) and ₹20 per day for NIL returns. These fees are subject to turnover-based caps ranging from ₹500 to ₹10,000 per return."
  },
  {
    question: "What is the difference between GST inclusive and exclusive prices?",
    answer: "A GST inclusive price already includes the tax component within the listed price (such as MRP retail prices). A GST exclusive price is the pre-tax base price, meaning GST will be calculated and added on top of it at checkout."
  },
  {
    question: "Who is eligible for the GST Composition Scheme?",
    answer: "Taxpayers with an annual aggregate turnover of up to ₹1.5 Crores (₹75 Lakhs for North-Eastern states) can opt for the Composition Scheme to pay tax at flat rates (1% for traders/manufacturers, 5% for restaurants). Service providers can opt for the scheme with a limit of ₹50 Lakhs at a flat rate of 6%."
  },
  {
    question: "Can a composition dealer claim Input Tax Credit (ITC)?",
    answer: "No. A taxpayer opting for the Composition Scheme is barred from claiming Input Tax Credit (ITC) on purchases. They also cannot collect GST from their customers or issue tax invoices (they issue a 'Bill of Supply' instead)."
  },
  {
    question: "How do I extract the base price from a GST-inclusive amount?",
    answer: "To extract the base price, divide the total GST inclusive amount by (1 + GST Rate/100). For example, to remove 18% GST from ₹11,800: Base Price = 11,800 ÷ 1.18 = ₹10,000. The GST amount is the remaining ₹1,800."
  },
  {
    question: "Is this online GST calculator platform free to use?",
    answer: "Yes, our website and all of its 11 calculators (GST, Reverse GST, Interest, Late Fees, Composition, Refund, etc.) are completely free to use. There are no limits, registrations, or hidden fees."
  },
  {
    question: "What are the GST return filing due dates?",
    answer: "GSTR-1 (outward supplies) is due by the 11th of the following month for monthly filers or the 13th for quarterly QRMP filers. GSTR-3B (summary return) is due by the 20th monthly or the 22nd/24th quarterly. Annual returns (GSTR-9) are due by December 31st."
  },
  {
    question: "How does the Reverse Charge Mechanism (RCM) work?",
    answer: "Under RCM, the recipient (buyer) pays GST instead of the supplier. This applies to specific notified goods and services like GTA, legal services, and director services. RCM tax must be paid in cash via the Electronic Cash Ledger, and the recipient can claim Input Tax Credit on the amount paid."
  },
  {
    question: "How can I verify a GST number (GSTIN)?",
    answer: "You can verify any GSTIN through the GST Portal's Search Taxpayer tool at gst.gov.in. Enter the 15-digit GSTIN to check the business name, registration date, status, and filing history of the taxpayer."
  },
  {
    question: "What is E-invoicing and who needs it?",
    answer: "E-invoicing is the electronic reporting of B2B invoices on the government IRP portal. It is mandatory for businesses with aggregate annual turnover exceeding ₹5 Crores. Invoices not generated through E-invoicing are treated as invalid for Input Tax Credit claims."
  }
];

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GST Calculator Online India",
  "url": "https://gstcalculatoronline.in",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://gstcalculatoronline.in/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homepageFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const pageSchemas = [websiteSchema, faqSchema];
---
<Layout seo={{ title: pageTitle, description: pageDesc }} schemas={pageSchemas}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-24 px-4 sm:px-6 lg:px-8 text-center border-b border-hairline transition-colors duration-200">
    <div class="mx-auto max-w-4xl relative z-10">
      <div class="flex justify-center mb-6">
        <div class="relative group">
          <div class="absolute -inset-1.5 rounded-3xl bg-gradient-to-r from-primary to-brand-cyan opacity-20 blur-md transition duration-300 group-hover:opacity-35"></div>
          <img 
            src="/favicon.png" 
            alt="GST Calculator Online India" 
            class="relative h-20 w-20 sm:h-24 sm:w-24 rounded-3xl shadow-lg transition-transform duration-300 group-hover:scale-105"
          />
        </div>
      </div>
      <span class="inline-flex items-center rounded-full bg-primary/10 px-3.5 py-1 text-xs font-bold text-primary font-mono uppercase tracking-wider mb-5">
        100% Free Financial Tools
      </span>
      <h1 class="text-4xl font-extrabold tracking-tight text-ink sm:text-5xl lg:text-6xl font-sans leading-tight">
        GST Calculator Online India
      </h1>
      <p class="mt-6 text-base sm:text-lg text-body max-w-2xl mx-auto leading-relaxed">
        Instantly compute transaction taxes, filing late fees, Section 50 interest penalties, and composition liabilities. Tailored for Indian businesses, taxpayers, and CAs.
      </p>

      <!-- Instant Search Trigger -->
      <div class="mt-10 max-w-md mx-auto">
        <button 
          id="hero-search-btn"
          type="button" 
          class="flex w-full items-center justify-between rounded-2xl border border-hairline bg-canvas/80 backdrop-blur-xs py-4 px-6 shadow-sm hover:border-hairline-strong transition-all hover:bg-canvas text-mute hover:text-ink cursor-pointer"
        >
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-4.5 w-4.5 text-primary">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
            </svg>
            <span class="text-sm font-semibold">Search 11 calculators & 30 articles...</span>
          </div>
          <span class="hidden sm:inline-block border border-hairline rounded-md px-1.5 py-0.5 text-[9px] font-bold font-mono uppercase bg-canvas-soft tracking-wider">Ctrl + K</span>
        </button>
      </div>

      <!-- Quick Category Chips -->
      <div class="mt-8 flex flex-wrap gap-2 justify-center max-w-2xl mx-auto">
        <span class="text-xs font-bold text-mute self-center mr-2">Categories:</span>
        <a href="/tools/category/tax-slabs" class="rounded-full bg-canvas-soft border border-hairline px-3.5 py-1 text-xs font-semibold text-body hover:bg-canvas-soft-2 hover:text-ink transition-colors">Tax Slabs</a>
        <a href="/tools/category/late-fees" class="rounded-full bg-canvas-soft border border-hairline px-3.5 py-1 text-xs font-semibold text-body hover:bg-canvas-soft-2 hover:text-ink transition-colors">Late Fees</a>
        <a href="/tools/category/interest-penalties" class="rounded-full bg-canvas-soft border border-hairline px-3.5 py-1 text-xs font-semibold text-body hover:bg-canvas-soft-2 hover:text-ink transition-colors">Interest</a>
        <a href="/tools/category/composition-scheme" class="rounded-full bg-canvas-soft border border-hairline px-3.5 py-1 text-xs font-semibold text-body hover:bg-canvas-soft-2 hover:text-ink transition-colors">Composition</a>
      </div>
    </div>
  </section>

  <!-- AdSense Below Hero -->
  <AdSense type="below-hero" className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 my-8" />

  <!-- Popular Tools Grid Section -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="text-center sm:text-left mb-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">Popular GST Calculators</h2>
        <p class="mt-2 text-sm text-body">Select one of our frequently used calculators to compute GST liability or penalties.</p>
      </div>
      <a href="/tools" class="text-sm font-semibold text-primary hover:underline shrink-0 inline-flex items-center gap-1">
        View All 11 Calculators
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {popularCalculators.slice(0, 6).map(tool => (
        <ToolCard 
          title={tool.name} 
          description={tool.desc} 
          url={tool.url}
          icon={tool.icon}
          badge={tool.badge}
        />
      ))}
    </div>
  </section>

  <!-- AdSense Middle of Content -->
  <AdSense type="middle-content" className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 my-8" />

  <!-- Latest Articles Section -->
  <section class="py-16 border-t border-b border-hairline bg-canvas-soft transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center sm:text-left mb-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">Latest Tax Guides & Insights</h2>
          <p class="mt-2 text-sm text-body font-normal">Stay up to date with GSTR filing dates, penalties, slabs, and ITC rules.</p>
        </div>
        <a href="/blog" class="text-sm font-semibold text-primary hover:underline shrink-0 inline-flex items-center gap-1">
          Explore All Articles
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestArticles.map(art => (
          <a 
            href={`/blog/${art.slug}`}
            class="flex flex-col justify-between overflow-hidden rounded-2xl border border-hairline bg-canvas p-6 hover:border-hairline-strong hover:shadow-xs transition-all duration-200 group"
          >
            <div>
              <div class="flex items-center justify-between text-[10px] font-mono text-mute">
                <span>{formatDate(art.date)}</span>
                <span class="font-semibold text-primary">{art.category}</span>
              </div>
              <h3 class="mt-3 text-base font-bold text-ink group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                {art.title}
              </h3>
              <p class="mt-2.5 text-xs text-body leading-relaxed line-clamp-3">
                {art.desc}
              </p>
            </div>
            <div class="mt-6 border-t border-hairline pt-4 flex items-center justify-between text-[10px] font-mono text-mute">
              <span>{art.readTime}</span>
              <span class="text-xs font-semibold text-primary group-hover:underline">Read Guide</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Editorial Info Section -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto prose dark:prose-invert">
    <h2>Understanding the Goods and Services Tax (GST) in India</h2>
    <p>Launched on July 1, 2017, the Goods and Services Tax (GST) is a comprehensive, multi-stage, destination-based tax that replaced major indirect taxes in India, such as VAT, Service Tax, Excise Duty, and Octroi. The goal was to unify the country under a single tax system, eliminating cascading taxes and simplifying compliance.</p>
    
    <h3>Structure of Indian GST</h3>
    <p>The GST regime divides transactions based on their physical supply location:</p>
    <ul>
      <li><strong>Intrastate Transactions (Within State):</strong> Subject to CGST (levied by the Central Government) and SGST (levied by the State Government). The standard tax rate is split equally (e.g., an 18% tax equals 9% CGST + 9% SGST).</li>
      <li><strong>Interstate Transactions (Between States):</strong> Subject to IGST (Integrated GST), collected by the Center and distributed to the consumption state. The rate equals the combined total rate (e.g., 18% IGST).</li>
    </ul>

    <h3>Why Taxpayers Choose Our Platform</h3>
    <p>Navigating return deadlines and penalty rates can be complicated. Our calculators are built to simplify your tax workflow:</p>
    <ol>
      <li><strong>Instant Performance:</strong> Written in native JS, our calculator outputs load in real-time, matching portal numbers.</li>
      <li><strong>Turnover-Capped Late Fees:</strong> Auto-computes rationalized late fee limits according to small business turnover.</li>
      <li><strong>Net Cash Interest Calculations:</strong> Applies the Section 50 proviso to calculate interest only on cash liabilities, not input credits.</li>
    </ol>

    <!-- AdSense Above FAQ -->
    <AdSense type="above-faq" className="my-8" />

    <FAQ items={homepageFaqs} />
  </section>

  <!-- AdSense Before Footer -->
  <AdSense type="before-footer" className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 my-12" />
</Layout>

<script>
  // Open search overlay from Hero button
  const heroSearchBtn = document.getElementById('hero-search-btn');
  const searchInput = document.getElementById('search-input');
  const searchModal = document.getElementById('search-modal');

  heroSearchBtn?.addEventListener('click', () => {
    searchModal?.classList.remove('hidden');
    searchModal?.classList.add('flex');
    setTimeout(() => (searchInput as HTMLElement | null)?.focus(), 50);
    document.body.classList.add('overflow-hidden');
  });
</script>
