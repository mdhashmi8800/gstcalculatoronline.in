---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import FAQ from '../components/FAQ.astro';
import { tools } from '../utils/tools';

const pageTitle = "GST Calculator Online — Free CGST, SGST & IGST Calculator India";
const pageDesc = "India's fastest GST calculator. Add or remove GST at 5%, 12%, 18%, 28% rates. Get CGST, SGST and IGST splits instantly. Free, accurate, and updated with latest GST rules. No login required.";

// Load latest 3 articles from blog content
const posts = Object.values(import.meta.glob('../content/blog/*.md', { eager: true })) as any[];
const latestArticles = posts.map(post => ({
  title: post.frontmatter.title,
  slug: post.frontmatter.slug,
  date: post.frontmatter.date,
  readTime: post.frontmatter.readTime,
  category: post.frontmatter.category || 'Guides',
  desc: post.frontmatter.metaDescription || post.frontmatter.description
})).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()).slice(0, 3);

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' });
}

const homepageFaqs = [
  {
    question: "How do I calculate GST online?",
    answer: "Enter the transaction amount, select 'Add GST' or 'Remove GST', pick the applicable slab (5%, 12%, 18%, or 28%), choose Intra-State or Inter-State, and get instant CGST, SGST, and IGST breakdowns."
  },
  {
    question: "What is the difference between CGST, SGST, and IGST?",
    answer: "CGST and SGST are levied on intrastate transactions, split equally between Centre and State (e.g., 18% GST = 9% CGST + 9% SGST). IGST applies to interstate transactions and is collected by the Centre in full."
  },
  {
    question: "What are the GST tax slabs in India?",
    answer: "India has four primary GST slabs: 0% (essential goods), 5% (food, transport), 12% (computers, processed food), 18% (most services and electronics), and 28% (luxury items). Gold attracts 3% GST."
  },
  {
    question: "Is this GST Calculator free to use?",
    answer: "Yes, all calculators on gstcalculatoronline.in are completely free. No registration, no login, no hidden charges. Calculate GST for any amount, any rate, unlimited times."
  },
  {
    question: "How is GST calculated on a service invoice?",
    answer: "For a CA charging ₹50,000 for audit services at 18% GST: GST = ₹9,000. Total Invoice = ₹59,000. Intrastate: CGST ₹4,500 + SGST ₹4,500. Interstate: IGST ₹9,000."
  },
  {
    question: "What is the GST formula for adding tax?",
    answer: "Add GST: GST Amount = (Base Price × GST Rate) ÷ 100. Total Invoice = Base Price + GST Amount. CGST = SGST = GST Amount ÷ 2 (intrastate). IGST = full GST Amount (interstate)."
  },
  {
    question: "How to remove GST from an inclusive price?",
    answer: "Remove GST: Base Price = Inclusive Amount ÷ (1 + GST Rate ÷ 100). For ₹11,800 at 18%: Base = 11,800 ÷ 1.18 = ₹10,000. GST = ₹1,800. Use our 'Remove GST' mode for instant calculation."
  },
  {
    question: "What are the late fees for GSTR-3B?",
    answer: "Standard late fee: ₹50/day with tax liability (₹25 CGST + ₹25 SGST), ₹20/day for NIL returns. Capped at ₹500–₹10,000 per return based on annual turnover. Use our Late Fee Calculator for precise amounts."
  }
];

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GST Calculator Online",
  "url": "https://gstcalculatoronline.in",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://gstcalculatoronline.in/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homepageFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Calculate GST Online in India",
  "description": "Step-by-step guide to calculate GST (CGST, SGST, IGST) on any transaction amount using the online GST calculator.",
  "step": [
    { "@type": "HowToStep", "name": "Enter Amount", "text": "Type the transaction amount in the amount field. For Add GST, enter the base price. For Remove GST, enter the final inclusive price." },
    { "@type": "HowToStep", "name": "Select GST Type", "text": "Choose 'Add GST' to add tax on top of the base amount, or 'Remove GST' to extract tax from an inclusive total." },
    { "@type": "HowToStep", "name": "Choose GST Rate", "text": "Select the applicable GST rate: 3%, 5%, 12%, 18%, 28%, or enter a custom rate for special categories like gold." },
    { "@type": "HowToStep", "name": "Select Transaction Type", "text": "Choose Intra-State (CGST + SGST) for within-state transactions or Inter-State (IGST) for cross-state transactions." },
    { "@type": "HowToStep", "name": "View Results", "text": "The calculator instantly shows Base Amount, CGST, SGST or IGST, Total GST, Effective Tax Rate, and Grand Total." }
  ]
};

const pageSchemas = [websiteSchema, faqSchema, howToSchema];
---
<Layout seo={{ title: pageTitle, description: pageDesc }} schemas={pageSchemas}>

  <!-- Compact Hero Section -->
  <section class="pt-10 pb-6 px-4 sm:px-6 lg:px-8 text-center">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink leading-tight">
        GST Calculator Online — Free &amp; Instant
      </h1>
      <p class="mt-2 text-sm text-body max-w-xl mx-auto leading-relaxed">
        Calculate CGST, SGST &amp; IGST in seconds. Trusted by 50,000+ businesses, CAs, and taxpayers across India.
      </p>
      <!-- Trust Badges -->
      <div class="mt-4 flex flex-wrap gap-2 justify-center">
        <span class="trust-badge">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
          Free Forever
        </span>
        <span class="trust-badge">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"/></svg>
          100% Accurate
        </span>
        <span class="trust-badge">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
          Updated GST Rules
        </span>
        <span class="trust-badge">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z"/></svg>
          No Login
        </span>
        <span class="trust-badge">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 8.25h3m-3 3h3m-6 3h.008v.008H6V16.5Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/></svg>
          Mobile Friendly
        </span>
      </div>
    </div>
  </section>

  <!-- PRIMARY CALCULATOR — visible above the fold -->
  <section class="px-4 sm:px-6 lg:px-8 pb-12" id="calculator">
    <div class="mx-auto max-w-5xl">
      <div class="homepage-calc-wrapper">
        <!-- Calculator Header Bar -->
        <div class="flex items-center justify-between px-5 py-3.5 border-b border-hairline bg-canvas-soft-2/60">
          <div class="flex items-center gap-2">
            <div class="flex gap-1.5">
              <span class="w-3 h-3 rounded-full" style="background:#f87171"></span>
              <span class="w-3 h-3 rounded-full" style="background:#fbbf24"></span>
              <span class="w-3 h-3 rounded-full" style="background:#34d399"></span>
            </div>
            <span class="text-xs font-bold text-mute font-mono ml-2">GST Calculator</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[10px] text-mute font-mono hidden sm:block">Press <span class="kbd">ESC</span> to reset</span>
            <a href="/tools/gst-calculator" class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
              Full Page
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
            </a>
          </div>
        </div>

        <!-- Two-Column Calculator Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
          <!-- LEFT: Inputs -->
          <div class="p-4 sm:p-7 border-b lg:border-b-0 lg:border-r border-hairline">
            <form id="home-gst-form" class="space-y-4 md:space-y-6" autocomplete="off">

              <!-- Amount Input -->
              <div>
                <label for="home-calc-amount" class="block text-sm font-bold text-ink mb-2">Transaction Amount</label>
                <div class="relative">
                  <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
                    <span class="text-sm font-bold text-mute font-mono">₹</span>
                  </div>
                  <input
                    type="text"
                    id="home-calc-amount"
                    name="amount"
                    value="10,000"
                    inputmode="numeric"
                    class="block w-full rounded-xl border border-hairline bg-canvas py-3.5 pl-8 pr-4 text-base font-mono font-semibold text-ink outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-mute"
                    placeholder="e.g. 10,000"
                    required
                    aria-label="Transaction Amount in Rupees"
                  />
                </div>

                <!-- Quick Amount Chips -->
                <div class="mt-3 flex flex-wrap gap-1.5" id="home-quick-chips" role="group" aria-label="Quick amount presets">
                  {['100', '500', '1K', '5K', '10K', '25K', '50K', '1L'].map(chip => (
                    <button type="button" class="quick-chip" data-value={chip}>{`₹${chip}`}</button>
                  ))}
                </div>
              </div>

              <!-- GST Type Segmented Control -->
              <div>
                <label class="block text-sm font-bold text-ink mb-2">GST Direction</label>
                <div class="segmented-control" role="group" aria-label="GST calculation direction">
                  <button type="button" id="home-type-add" class="segmented-btn active btn-add-gst" data-type="add" aria-pressed="true">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                    Add GST
                  </button>
                  <button type="button" id="home-type-remove" class="segmented-btn btn-remove-gst" data-type="remove" aria-pressed="false">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/></svg>
                    Remove GST
                  </button>
                </div>
                <input type="hidden" id="home-calc-type" name="calc-type" value="add" />
              </div>

              <!-- GST Rate Pills -->
              <div>
                <label class="block text-sm font-bold text-ink mb-2">GST Rate</label>
                <div class="rate-pill-container sm:grid sm:grid-cols-6 gap-2" role="group" aria-label="GST rate selection">
                  {['3', '5', '12', '18', '28'].map(rate => (
                    <button
                      type="button"
                      class={`rate-pill ${rate === '18' ? 'active' : ''}`}
                      data-rate={rate}
                      aria-pressed={rate === '18' ? 'true' : 'false'}
                    >
                      {rate}%
                    </button>
                  ))}
                  <button type="button" class="rate-pill" data-rate="custom" aria-pressed="false">Custom</button>
                </div>
                <input type="hidden" id="home-calc-rate" name="calc-rate" value="18" />

                <!-- Custom Rate Input -->
                <div id="home-custom-rate-wrap" class="hidden mt-3">
                  <div class="relative">
                    <input
                      type="number"
                      id="home-calc-rate-custom"
                      name="custom-rate"
                      min="0.1"
                      max="100"
                      step="any"
                      value="18"
                      class="block w-full rounded-xl border border-hairline bg-canvas py-2.5 px-3 pr-8 text-sm font-mono text-ink outline-none focus:border-primary"
                      placeholder="e.g. 3"
                      aria-label="Custom GST rate percentage"
                    />
                    <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-mute text-xs font-mono">%</span>
                  </div>
                </div>
              </div>

              <!-- Transaction Type -->
              <div>
                <label class="block text-sm font-bold text-ink mb-2">Transaction Type</label>
                <div class="segmented-control" role="group" aria-label="Transaction type">
                  <label class="segmented-btn cursor-pointer">
                    <input type="radio" name="home-tax-type" value="intrastate" checked class="sr-only" />
                    <span>Intra-State <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(CGST+SGST)</span></span>
                  </label>
                  <label class="segmented-btn cursor-pointer">
                    <input type="radio" name="home-tax-type" value="interstate" class="sr-only" />
                    <span>Inter-State <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(IGST)</span></span>
                  </label>
                </div>
              </div>

            </form>
          </div>

          <!-- RIGHT: Live Results -->
          <div class="p-4 sm:p-7 bg-canvas-soft/40 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-sm font-bold uppercase tracking-wider text-ink">Live Results</h2>
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-brand-success">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-success animate-pulse"></span>
                Real-time
              </span>
            </div>

            <!-- Result Rows -->
            <div class="space-y-0.5 flex-1" id="home-result-rows">
              <div class="result-row" id="home-res-taxable-row">
                <span class="text-sm text-body">Base Amount</span>
                <span id="home-res-taxable" class="result-value">₹10,000.00</span>
              </div>
              <div class="result-row" id="home-res-total-tax-row">
                <span class="text-sm text-body font-medium">Total GST</span>
                <span id="home-res-total-tax" class="result-value font-bold" style="color:var(--color-brand-link)">₹1,800.00</span>
              </div>
              <div class="result-row pl-3" id="home-res-cgst-row">
                <span class="text-xs text-mute flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full flex-shrink-0" style="background:#059669"></span>
                  CGST
                </span>
                <span id="home-res-cgst" class="font-mono text-xs text-mute">₹900.00</span>
              </div>
              <div class="result-row pl-3" id="home-res-sgst-row">
                <span class="text-xs text-mute flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full flex-shrink-0" style="background:#10b981"></span>
                  SGST
                </span>
                <span id="home-res-sgst" class="font-mono text-xs text-mute">₹900.00</span>
              </div>
              <div class="result-row pl-3 hidden" id="home-res-igst-row">
                <span class="text-xs text-mute flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full flex-shrink-0" style="background:#059669"></span>
                  IGST
                </span>
                <span id="home-res-igst" class="font-mono text-xs text-mute">₹0.00</span>
              </div>
              <div class="result-row border-t border-hairline mt-1 pt-1">
                <span class="text-xs text-body flex items-center gap-1.5">
                  Effective Rate
                  <span class="tooltip-container">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 text-mute hover:text-ink cursor-help transition-colors">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 111.083.984l-.04.02-.116.06c-.198.113-.33.32-.33.565v1.5a.75.75 0 001.5 0v-1.5c0-.022.01-.044.028-.06l.041-.02a2.25 2.25 0 00-.115-3.832L12 8.25M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="tooltip-content">Effective Rate represents GST as a percentage of the final amount after tax inclusion.</span>
                  </span>
                </span>
                <span id="home-res-effective" class="font-mono text-xs font-bold" style="color:var(--color-brand-link)">18.00%</span>
              </div>
            </div>

            <!-- Grand Total Card -->
            <div class="grand-total-row mt-4">
              <div class="flex justify-between items-center">
                <span class="text-sm font-bold text-ink">Grand Total</span>
                <span id="home-res-grand-total" class="font-mono text-2xl font-extrabold text-ink">₹11,800.00</span>
              </div>
              <p class="text-[10px] text-mute mt-0.5 font-mono" id="home-grand-label">Inclusive of 18% GST (Intra-State)</p>
            </div>

            <!-- Mini Bar Chart -->
            <div class="bar-chart-container">
              <p class="bar-chart-label mb-3">Breakdown</p>
              <div class="space-y-2">
                <div>
                  <div class="flex justify-between mb-1">
                    <span class="bar-chart-label">Base</span>
                    <span id="home-chart-base-pct" class="bar-chart-label">84.7%</span>
                  </div>
                  <div class="h-2 rounded-full overflow-hidden bg-canvas-soft-2">
                    <div id="home-chart-base-bar" class="bar-chart-bar" style="background:var(--color-ink);opacity:0.2;width:84.7%"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between mb-1">
                    <span class="bar-chart-label">GST</span>
                    <span id="home-chart-gst-pct" class="bar-chart-label">15.3%</span>
                  </div>
                  <div class="h-2 rounded-full overflow-hidden bg-canvas-soft-2">
                    <div id="home-chart-gst-bar" class="bar-chart-bar" style="background:var(--color-primary);width:15.3%"></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-5 grid grid-cols-2 gap-2">
              <button id="home-copy-btn" type="button" class="flex items-center justify-center gap-1.5 rounded-xl border border-hairline bg-canvas py-2.5 text-xs font-semibold text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 7.5V6.108c0-1.135.845-2.098 1.976-2.192.373-.03.748-.057 1.123-.08M15.75 18H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08M15.75 18.75v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5A3.375 3.375 0 0 0 6.375 7.5H5.25m11.9-3.664A2.251 2.251 0 0 0 15 2.25h-1.5a2.251 2.251 0 0 0-2.15 1.586m5.8 0c.065.21.1.433.1.664v.75h-6V4.5c0-.231.035-.454.1-.664M6.75 7.5H4.875c-.621 0-1.125.504-1.125 1.125v12c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V16.5a9 9 0 0 0-9-9Z"/></svg>
                Copy
              </button>
              <button id="home-pdf-btn" type="button" class="flex items-center justify-center gap-1.5 rounded-xl border border-hairline bg-canvas py-2.5 text-xs font-semibold text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/></svg>
                PDF
              </button>
              <button id="home-share-btn" type="button" class="flex items-center justify-center gap-1.5 rounded-xl border border-hairline bg-canvas py-2.5 text-xs font-semibold text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z"/></svg>
                Share
              </button>
