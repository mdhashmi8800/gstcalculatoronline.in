  <!-- Educational Content Section -->
  <section class="py-14 px-4 sm:px-6 lg:px-8 border-t border-hairline/60 bg-canvas-soft/40">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-extrabold tracking-tight text-ink mb-6">GST Formulas & How It Works</h2>

      <!-- Formula Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <div class="rounded-2xl border border-hairline bg-canvas p-5">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-bold text-on-primary bg-primary px-2 py-0.5 rounded-full">Add GST</span>
            <span class="text-xs text-mute">Exclusive pricing</span>
          </div>
          <div class="font-mono text-xs text-ink space-y-1.5">
            <p>GST Amount = Base × Rate ÷ 100</p>
            <p>Total = Base + GST Amount</p>
            <p>CGST = SGST = GST ÷ 2 (Intra-State)</p>
            <p>IGST = GST Amount (Inter-State)</p>
          </div>
          <div class="mt-3 pt-3 border-t border-hairline text-[10px] text-mute font-mono">
            Example: ₹10,000 + 18% = ₹11,800
          </div>
        </div>
        <div class="rounded-2xl border border-hairline bg-canvas p-5">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-bold text-on-primary bg-brand-link-deep px-2 py-0.5 rounded-full">Remove GST</span>
            <span class="text-xs text-mute">Inclusive pricing</span>
          </div>
          <div class="font-mono text-xs text-ink space-y-1.5">
            <p>Base = Inclusive ÷ (1 + Rate ÷ 100)</p>
            <p>GST Amount = Inclusive − Base</p>
            <p>CGST = SGST = GST ÷ 2 (Intra-State)</p>
            <p>IGST = GST Amount (Inter-State)</p>
          </div>
          <div class="mt-3 pt-3 border-t border-hairline text-[10px] text-mute font-mono">
            Example: ₹11,800 at 18% → Base ₹10,000
          </div>
        </div>
      </div>

      <!-- GST Slab Table -->
      <h2 class="text-xl font-extrabold tracking-tight text-ink mb-4">GST Rate Slabs — India 2025-26</h2>
      <div class="overflow-x-auto rounded-2xl border border-hairline mb-8">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-canvas-soft-2">
              <th class="text-left p-3.5 font-bold text-ink border-b border-hairline">Rate</th>
              <th class="text-left p-3.5 font-bold text-ink border-b border-hairline">Common Products / Services</th>
              <th class="text-left p-3.5 font-bold text-ink border-b border-hairline hidden sm:table-cell">CGST</th>
              <th class="text-left p-3.5 font-bold text-ink border-b border-hairline hidden sm:table-cell">SGST</th>
            </tr>
          </thead>
          <tbody>
            {[
              { rate: '0%', items: 'Fresh vegetables, milk, eggs, bread, educational services, healthcare', cgst: '0%', sgst: '0%' },
              { rate: '3%', items: 'Gold, silver, precious metals and stones', cgst: '1.5%', sgst: '1.5%' },
              { rate: '5%', items: 'Economy class air travel, packaged food, coffee (non-branded), transport', cgst: '2.5%', sgst: '2.5%' },
              { rate: '12%', items: 'Computers, processed food, butter, cheese, mobile phones', cgst: '6%', sgst: '6%' },
              { rate: '18%', items: 'Most services, FMCG goods, electronics, banking services, restaurants', cgst: '9%', sgst: '9%' },
              { rate: '28%', items: 'Luxury cars, tobacco, cement, aerated drinks, casinos, online gaming', cgst: '14%', sgst: '14%' },
            ].map((row, i) => (
              <tr class={i % 2 === 1 ? 'bg-canvas-soft/40' : ''}>
                <td class="p-3.5 font-mono font-bold text-primary border-b border-hairline/50">{row.rate}</td>
                <td class="p-3.5 text-body border-b border-hairline/50">{row.items}</td>
                <td class="p-3.5 font-mono text-mute border-b border-hairline/50 hidden sm:table-cell">{row.cgst}</td>
                <td class="p-3.5 font-mono text-mute border-b border-hairline/50 hidden sm:table-cell">{row.sgst}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Latest GST Updates -->
      <h2 class="text-xl font-extrabold tracking-tight text-ink mb-4">Latest GST Updates</h2>
      <div class="space-y-3 mb-8">
        {[
          { date: 'July 2025', update: 'GST Council reduces rate on insurance premiums — term life and health insurance premiums may attract reduced GST rates.' },
          { date: 'June 2025', update: 'E-invoicing threshold reduced to ₹5 crore annual turnover — more businesses now required to generate IRN on government portal.' },
          { date: 'April 2025', update: 'GSTR-1A enabled for all taxpayers — allows amendments to outward supply data before GSTR-3B filing.' },
          { date: 'March 2025', update: 'New GST Amnesty Scheme announced — waiver of interest and penalties for pending returns from FY 2017-18 to 2019-20.' },
        ].map(item => (
          <div class="flex gap-4 p-4 rounded-xl border border-hairline bg-canvas hover:border-hairline-strong transition-colors">
            <div class="shrink-0 text-[10px] font-mono font-bold text-primary bg-primary/8 px-2 py-1 rounded-lg h-fit mt-0.5">{item.date}</div>
            <p class="text-sm text-body leading-relaxed">{item.update}</p>
          </div>
        ))}
      </div>

      <!-- Internal Links -->
      <h2 class="text-xl font-extrabold tracking-tight text-ink mb-4">Related Tools</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-10">
        {[
          { name: 'Reverse GST Calculator', url: '/tools/reverse-gst-calculator' },
          { name: 'GST Split Calculator', url: '/tools/gst-split-calculator' },
          { name: 'IGST Calculator', url: '/tools/igst-calculator' },
          { name: 'Late Fee Calculator', url: '/tools/late-fee-calculator' },
          { name: 'Interest Calculator', url: '/tools/interest-calculator' },
          { name: 'Composition Calculator', url: '/tools/composition-calculator' },
          { name: 'GST Invoice Builder', url: '/tools/invoice-builder' },
          { name: 'GST Rate Finder', url: '/tools/gst-rate-finder' },
          { name: 'GST Refund Calculator', url: '/tools/gst-refund-calculator' },
        ].map(link => (
          <a href={link.url} class="flex items-center gap-2 p-3 rounded-xl border border-hairline bg-canvas hover:border-primary/40 hover:text-primary text-sm font-semibold text-body transition-all group">
            <svg class="w-3.5 h-3.5 text-primary shrink-0 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
            {link.name}
          </a>
        ))}
      </div>

      <!-- FAQ -->
      <FAQ items={homepageFaqs} />
    </div>
  </section>

  <!-- Latest Articles -->
  {latestArticles.length > 0 && (
    <section class="py-14 px-4 sm:px-6 lg:px-8 border-t border-hairline/60">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
          <div>
            <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight text-ink">Latest Tax Guides</h2>
            <p class="mt-1 text-sm text-body">Stay updated with GSTR filing dates, penalties, slabs, and ITC rules.</p>
          </div>
          <a href="/blog" class="text-sm font-semibold text-primary hover:underline shrink-0 inline-flex items-center gap-1">
            All Articles
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {latestArticles.map(art => (
            <a
              href={`/blog/${art.slug}`}
              class="flex flex-col justify-between overflow-hidden rounded-2xl border border-hairline bg-canvas p-5 hover:border-hairline-strong hover:shadow-xs transition-all duration-200 group"
            >
              <div>
                <div class="flex items-center justify-between text-[10px] font-mono text-mute">
                  <span>{formatDate(art.date)}</span>
                  <span class="font-bold text-primary">{art.category}</span>
                </div>
                <h3 class="mt-3 text-sm font-bold text-ink group-hover:text-primary transition-colors line-clamp-2 leading-snug">{art.title}</h3>
                <p class="mt-2 text-xs text-body leading-relaxed line-clamp-3">{art.desc}</p>
              </div>
              <div class="mt-5 border-t border-hairline pt-3.5 flex items-center justify-between text-[10px] font-mono text-mute">
                <span>{art.readTime}</span>
                <span class="text-xs font-semibold text-primary group-hover:underline">Read →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</Layout>

<script>
  import { generateCalculationPDF } from '../utils/pdfGenerator';

  // =====================================================
  // HOMEPAGE CALCULATOR LOGIC
  // =====================================================

  // Chip value map
  const chipValues: Record<string, number> = {
    '100': 100, '500': 500, '1K': 1000, '5K': 5000,
    '10K': 10000, '25K': 25000, '50K': 50000, '1L': 100000
  };

  const amountInput = document.getElementById('home-calc-amount') as HTMLInputElement | null;
  const calcTypeHidden = document.getElementById('home-calc-type') as HTMLInputElement | null;
  const calcRateHidden = document.getElementById('home-calc-rate') as HTMLInputElement | null;
  const customRateInput = document.getElementById('home-calc-rate-custom') as HTMLInputElement | null;
  const customRateWrap = document.getElementById('home-custom-rate-wrap');

  // Result elements
  const rTaxable = document.getElementById('home-res-taxable');
  const rTotalTax = document.getElementById('home-res-total-tax');
  const rCgst = document.getElementById('home-res-cgst');
  const rSgst = document.getElementById('home-res-sgst');
  const rIgst = document.getElementById('home-res-igst');
  const rEffective = document.getElementById('home-res-effective');
  const rGrandTotal = document.getElementById('home-res-grand-total');
  const rGrandLabel = document.getElementById('home-grand-label');
  const rCgstRow = document.getElementById('home-res-cgst-row');
  const rSgstRow = document.getElementById('home-res-sgst-row');
  const rIgstRow = document.getElementById('home-res-igst-row');
  const chartBaseBar = document.getElementById('home-chart-base-bar') as HTMLElement | null;
  const chartBaseP = document.getElementById('home-chart-base-pct');
  const chartGstBar = document.getElementById('home-chart-gst-bar') as HTMLElement | null;
  const chartGstP = document.getElementById('home-chart-gst-pct');

  function parseRawAmount(val: string): number {
    return parseFloat(val.replace(/[₹,\s]/g, '')) || 0;
  }

  function formatIndian(val: number): string {
    return '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function calculate() {
    const rawAmount = amountInput?.value || '0';
    const amount = parseRawAmount(rawAmount);
    const rate = calcRateHidden?.value === 'custom'
      ? parseFloat(customRateInput?.value || '0') || 0
      : parseFloat(calcRateHidden?.value || '18') || 0;
    const isAdd = (calcTypeHidden?.value || 'add') === 'add';
    const taxTypeRadio = document.querySelector('input[name="home-tax-type"]:checked') as HTMLInputElement | null;
    const isIntrastate = (taxTypeRadio?.value || 'intrastate') === 'intrastate';

    if (amount <= 0) {
      [rTaxable, rTotalTax, rCgst, rSgst, rIgst, rEffective, rGrandTotal].forEach(el => { if (el) el.innerText = el === rEffective ? '0.00%' : '₹0.00'; });
      if (rGrandLabel) rGrandLabel.textContent = 'Enter an amount above';
      if (chartBaseBar) chartBaseBar.style.width = '0%';
      if (chartGstBar) chartGstBar.style.width = '0%';
      return;
    }

    let taxable: number, totalTax: number, grandTotal: number;
    if (isAdd) {
      taxable = amount;
      totalTax = amount * (rate / 100);
      grandTotal = amount + totalTax;
    } else {
      taxable = amount / (1 + rate / 100);
      totalTax = amount - taxable;
      grandTotal = amount;
    }

    const effectivePct = grandTotal > 0 ? (totalTax / grandTotal) * 100 : 0;
    const basePct = grandTotal > 0 ? (taxable / grandTotal) * 100 : 0;
    const gstPct = 100 - basePct;

    if (rTaxable) rTaxable.innerText = formatIndian(taxable);
    if (rTotalTax) rTotalTax.innerText = formatIndian(totalTax);
    if (rEffective) rEffective.innerText = effectivePct.toFixed(2) + '%';
    if (rGrandTotal) rGrandTotal.innerText = formatIndian(grandTotal);

    const supplyLabel = isIntrastate ? 'Intra-State' : 'Inter-State';
    if (rGrandLabel) rGrandLabel.textContent = `Inclusive of ${rate}% GST (${supplyLabel})`;

    if (isIntrastate) {
      rCgstRow?.classList.remove('hidden');
      rSgstRow?.classList.remove('hidden');
      rIgstRow?.classList.add('hidden');
      const half = totalTax / 2;
      if (rCgst) rCgst.innerText = formatIndian(half);
      if (rSgst) rSgst.innerText = formatIndian(half);
    } else {
      rCgstRow?.classList.add('hidden');
      rSgstRow?.classList.add('hidden');
      rIgstRow?.classList.remove('hidden');
      if (rIgst) rIgst.innerText = formatIndian(totalTax);
    }

    // Update chart bars
    if (chartBaseBar) chartBaseBar.style.width = Math.min(basePct, 100).toFixed(1) + '%';
    if (chartGstBar) chartGstBar.style.width = Math.min(gstPct, 100).toFixed(1) + '%';
    if (chartBaseP) chartBaseP.textContent = basePct.toFixed(1) + '%';
    if (chartGstP) chartGstP.textContent = gstPct.toFixed(1) + '%';
  }

  // Auto-format amount input as Indian number while typing
  amountInput?.addEventListener('input', () => {
    const raw = parseRawAmount(amountInput.value);
    // Only reformat if it's a valid number
    if (!isNaN(raw) && raw > 0) {
      const pos = amountInput.selectionStart || 0;
      const formatted = raw.toLocaleString('en-IN');
      // Only update if different to avoid cursor jump issues
      if (amountInput.value !== formatted) {
        amountInput.value = formatted;
      }
    }
    calculate();
  });

  // Quick Amount Chips
  document.querySelectorAll<HTMLButtonElement>('#home-quick-chips .quick-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const val = chipValues[chip.dataset.value || ''] || 0;
      if (amountInput) amountInput.value = val.toLocaleString('en-IN');
      document.querySelectorAll('#home-quick-chips .quick-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      calculate();
    });
  });

  // Segmented Control — GST Type
  document.querySelectorAll<HTMLButtonElement>('[aria-label="GST calculation direction"] .segmented-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[aria-label="GST calculation direction"] .segmented-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      if (calcTypeHidden) calcTypeHidden.value = btn.dataset.type || 'add';
      calculate();
    });
  });

  // Rate Pills
  document.querySelectorAll<HTMLButtonElement>('.rate-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      document.querySelectorAll('.rate-pill').forEach(p => {
        p.classList.remove('active');
        p.setAttribute('aria-pressed', 'false');
      });
      pill.classList.add('active');
      pill.setAttribute('aria-pressed', 'true');
      const rate = pill.dataset.rate || '18';
      if (calcRateHidden) calcRateHidden.value = rate;
      if (rate === 'custom') {
        customRateWrap?.classList.remove('hidden');
        customRateInput?.focus();
      } else {
        customRateWrap?.classList.add('hidden');
      }
      calculate();
    });
  });

  // Custom rate input
  customRateInput?.addEventListener('input', calculate);

  // Tax type radio change
  document.querySelectorAll<HTMLInputElement>('input[name="home-tax-type"]').forEach(radio => {
    radio.addEventListener('change', calculate);
  });

  // Action buttons
  function showToast(msg: string) {
    const toast = document.getElementById('home-toast');
    if (toast) {
      toast.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 2500);
    }
  }

  document.getElementById('home-copy-btn')?.addEventListener('click', () => {
    const lines = [
      `GST Calculation — gstcalculatoronline.in`,
      `${'─'.repeat(30)}`,
      `Base Amount:    ${rTaxable?.innerText || '₹0'}`,
      rCgstRow?.classList.contains('hidden') ? `IGST:           ${rIgst?.innerText || '₹0'}` : `CGST:           ${rCgst?.innerText || '₹0'}`,
      rSgstRow?.classList.contains('hidden') ? '' : `SGST:           ${rSgst?.innerText || '₹0'}`,
      `Total GST:      ${rTotalTax?.innerText || '₹0'}`,
      `Effective Rate: ${rEffective?.innerText || '0%'}`,
      `${'─'.repeat(30)}`,
      `Grand Total:    ${rGrandTotal?.innerText || '₹0'}`,
    ].filter(Boolean).join('\n');
    navigator.clipboard.writeText(lines).then(() => showToast('✓ Copied to clipboard!'));
  });

  document.getElementById('home-share-btn')?.addEventListener('click', () => {
    const url = new URL(window.location.href);
    url.hash = '#calculator';
    const rawAmount = parseRawAmount(amountInput?.value || '0');
    url.searchParams.set('amount', rawAmount.toString());
    url.searchParams.set('rate', calcRateHidden?.value || '18');
    url.searchParams.set('type', calcTypeHidden?.value || 'add');
    const taxType = (document.querySelector('input[name="home-tax-type"]:checked') as HTMLInputElement | null)?.value || 'intrastate';
    url.searchParams.set('taxtype', taxType);
    navigator.clipboard.writeText(url.toString()).then(() => showToast('✓ Link copied!'));
  });

  document.getElementById('home-pdf-btn')?.addEventListener('click', async () => {
    try {
      await generateCalculationPDF();
      showToast('✓ PDF downloaded!');
    } catch (err) {
      console.error('Failed to generate PDF:', err);
    }
  });

  document.getElementById('home-reset-btn')?.addEventListener('click', () => {
    if (amountInput) amountInput.value = '10,000';
    if (calcTypeHidden) calcTypeHidden.value = 'add';
    if (calcRateHidden) calcRateHidden.value = '18';
    customRateWrap?.classList.add('hidden');
    document.getElementById('home-type-add')?.classList.add('active');
    document.getElementById('home-type-remove')?.classList.remove('active');
    document.querySelectorAll('.rate-pill').forEach(p => { p.classList.remove('active'); p.setAttribute('aria-pressed', 'false'); });
    document.querySelector('.rate-pill[data-rate="18"]')?.classList.add('active');
    const intra = document.querySelector('input[name="home-tax-type"][value="intrastate"]') as HTMLInputElement | null;
    if (intra) intra.checked = true;
    document.querySelectorAll('#home-quick-chips .quick-chip').forEach(c => c.classList.remove('active'));
    calculate();
  });

  // ESC key to reset
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      document.getElementById('home-reset-btn')?.click();
    }
  });

  // Filter buttons
  const filterBtns = document.querySelectorAll('.home-filter-btn');
  const toolItems = document.querySelectorAll('.home-tool-item');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter || 'all';
      filterBtns.forEach(b => {
        b.classList.remove('bg-primary', 'text-on-primary', 'border-primary');
        b.classList.add('bg-canvas-soft', 'text-body', 'border-hairline');
      });
      btn.classList.remove('bg-canvas-soft', 'text-body', 'border-hairline');
      btn.classList.add('bg-primary', 'text-on-primary', 'border-primary');
      toolItems.forEach(item => {
        const cat = (item as HTMLElement).dataset.category;
        if (filter === 'all' || cat === filter) item.classList.remove('hidden');
        else item.classList.add('hidden');
      });
    });
  });

  // Initial calculation on load
  calculate();
</script>
