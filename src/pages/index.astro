      <button type="button" data-filter="tax-slabs" class="home-filter-btn rounded-full px-4 py-1.5 text-xs font-semibold border border-hairline bg-canvas-soft text-body hover:bg-canvas-soft-2 transition-all cursor-pointer">Tax Slabs</button>
      <button type="button" data-filter="late-fees" class="home-filter-btn rounded-full px-4 py-1.5 text-xs font-semibold border border-hairline bg-canvas-soft text-body hover:bg-canvas-soft-2 transition-all cursor-pointer">Late Fees</button>
