      <button type="button" data-filter="composition-scheme" class="home-filter-btn rounded-full px-4 py-1.5 text-xs font-semibold border border-hairline bg-canvas-soft text-body hover:bg-canvas-soft-2 transition-all cursor-pointer">Composition</button>
