---
import CalculatorLayout from '../components/CalculatorLayout.astro';
import ResultCard from '../components/ResultCard.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "IGST Calculator – Free Interstate GST Tool";
const pageDesc = "Compute Integrated Goods and Services Tax (IGST) liabilities specifically for interstate transactions. Free, fast, and 100% accurate.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": "IGST Calculator Online – Calculate Integrated GST for Interstate Sales",
  "url": "https://gstcalculatoronline.in/igst-calculator",
  "description": "Compute Integrated Goods and Services Tax (IGST) liabilities specifically for interstate transactions. Free, fast, and 100% accurate.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  }
};

const faqs = [
  {
    question: "What is IGST?",
    answer: "IGST stands for Integrated Goods and Services Tax. It is a tax levied under the GST regime on all interstate transactions of goods and services (between different states or union territories), as well as on imports and exports."
  },
  {
    question: "What is the formula to calculate IGST?",
    answer: "For exclusive price: IGST Amount = Base Price × (IGST Rate ÷ 100). For inclusive price: IGST Amount = Inclusive Price - [Inclusive Price ÷ (1 + IGST Rate ÷ 100)]."
  },
  {
    question: "When does IGST apply?",
    answer: "IGST applies when the location of the supplier and the place of supply are in different states, or during imports/exports. If both supplier and buyer are in the same state, CGST + SGST apply instead."
  },
  {
    question: "Who collects the IGST tax?",
    answer: "IGST is collected by the Central Government of India and then distributed between the Centre and the destination state based on consumption."
  },
  {
    question: "How is the IGST rate determined?",
    answer: "The IGST rate matches the combined rate of CGST and SGST. If a service attracts 9% CGST and 9% SGST locally, the IGST rate for interstate sales of that service is 18%."
  },
  {
    question: "Is IGST applicable on imports?",
    answer: "Yes. Imports of goods and services into India are treated as interstate supplies, and IGST is levied at the applicable rate along with Basic Customs Duty."
  },
  {
    question: "Is IGST applicable on exports?",
    answer: "Exports are zero-rated under GST. While the rate is 0%, exporters can either pay IGST and claim a refund or export without tax under a Letter of Undertaking (LUT)."
  },
  {
    question: "Can IGST credit be used to offset CGST and SGST?",
    answer: "Yes. Under the ITC utilization rules, IGST credit must be utilized first to offset IGST output liability, and the remainder can be used to offset CGST and SGST liabilities in that order."
  },
  {
    question: "How is IGST calculated for a ₹50,000 transaction at 18%?",
    answer: "IGST Amount = 50,000 × 18% = ₹9,000. The grand total invoice value is ₹59,000."
  },
  {
    question: "How is IGST calculated from a ₹11,200 inclusive amount at 12%?",
    answer: "Base value = 11,200 ÷ 1.12 = ₹10,000. IGST Amount = ₹1,200."
  },
  {
    question: "What is the IGST Act, 2017?",
    answer: "The Integrated Goods and Services Tax Act, 2017, is the legal act governing the levy, apportionment, and collection rules of IGST in India."
  },
  {
    question: "Does the IGST calculator support custom rates?",
    answer: "Yes, click 'Custom' in the rates list and enter the percentage to compute the Integrated tax amount instantly."
  },
  {
    question: "Is this IGST calculator free?",
    answer: "Yes, completely free with no registration or usage limitations."
  },
  {
    question: "Does this calculator run on mobile phones?",
    answer: "Yes, the layout is mobile-responsive and works perfectly on all web browsers."
  },
  {
    question: "Are calculations kept private?",
    answer: "Yes, calculations are computed locally in your browser. We do not store or transmit your financial inputs."
  },
  {
    question: "What is place of supply in IGST?",
    answer: "Place of supply is a legal concept under the IGST Act that determines the tax jurisdiction (the state where the goods/services are deemed consumed) to identify if IGST is applicable."
  },
  {
    question: "How is IGST reported in returns?",
    answer: "Outward IGST supplies are declared in GSTR-1. Combined IGST collections and input tax credit claims are filed in GSTR-3B."
  },
  {
    question: "Does the calculator round off the final tax?",
    answer: "The calculator outputs figures to two decimal places. Under Section 170, the final tax payable should be rounded off to the nearest rupee."
  },
  {
    question: "How do I reset the calculator inputs?",
    answer: "Click the 'Reset' button at the bottom of the results card or press the 'ESC' key to clear the fields."
  },
  {
    question: "Can I download my IGST calculations?",
    answer: "Yes. Click on the 'PDF' button to save a copy of the breakdown to your device."
  }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema} faqs={faqs}>
  <form id="gst-form" class="space-y-4 md:space-y-6" autocomplete="off">
    <!-- Transaction Amount -->
    <div>
      <label for="calc-amount" class="block text-sm font-bold text-ink">Transaction Amount (₹)</label>
      <div class="relative mt-2">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-mute">
          <span class="text-sm font-bold font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="amount" 
          id="calc-amount" 
          value="10000" 
          min="1" 
          step="any"
          class="block w-full rounded-xl border border-hairline bg-canvas py-3.5 pl-9 pr-4 text-base text-ink outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 font-mono font-semibold transition-all"
          placeholder="e.g. 10000"
          required
          aria-label="Transaction Amount in Rupees"
        />
      </div>
      <!-- Quick Amount Chips -->
      <div class="mt-3 flex flex-wrap gap-1.5" id="page-quick-chips" role="group" aria-label="Quick amount presets">
        {(['100', '500', '1K', '5K', '10K', '25K', '50K', '1L'] as const).map(chip => (
          <button type="button" class="quick-chip" data-chip={chip}>₹{chip}</button>
        ))}
      </div>
    </div>

    <!-- Calculation Direction -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">GST Direction</span>
      <div class="segmented-control" role="group" aria-label="GST calculation direction">
        <label class="segmented-btn btn-add-gst cursor-pointer">
          <input type="radio" name="calc-type" value="add" checked class="sr-only" />
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          Add GST
        </label>
        <label class="segmented-btn btn-remove-gst cursor-pointer">
          <input type="radio" name="calc-type" value="remove" class="sr-only" />
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/></svg>
          Remove GST
        </label>
      </div>
    </div>

    <!-- GST Tax Slab Rates -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">GST Rate</span>
      <div class="rate-pill-container sm:grid sm:grid-cols-6 gap-2" role="group" aria-label="GST rate selection">
        {(['3', '5', '12', '18', '28'] as const).map((rate) => (
          <label class="rate-pill cursor-pointer [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-primary [&:has(input:checked)]:text-on-primary">
            <input type="radio" name="calc-rate" value={rate} checked={rate === '18'} class="sr-only" />
            {rate}%
          </label>
        ))}
        <label class="rate-pill cursor-pointer [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-primary [&:has(input:checked)]:text-on-primary">
          <input type="radio" name="calc-rate" id="rate-custom-radio" value="custom" class="sr-only" />
          Custom
        </label>
      </div>
      
      <!-- Custom Rate Input (Hidden by default) -->
      <div id="custom-rate-container" class="hidden mt-3">
        <label for="calc-rate-custom" class="sr-only">Custom GST Rate (%)</label>
        <div class="relative">
          <input 
            type="number" 
            name="custom-rate" 
            id="calc-rate-custom" 
            min="0.1" 
            max="100" 
            step="any"
            value="18"
            class="block w-full rounded-xl border border-hairline bg-canvas py-2.5 px-3 pr-8 text-sm text-ink outline-none focus:border-primary font-mono"
            placeholder="Enter custom rate e.g. 3"
          />
          <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-mute text-xs font-mono">%</span>
        </div>
      </div>
    </div>

    <!-- Supply Destination -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">Transaction Type</span>
      <div class="segmented-control" role="group" aria-label="Transaction type">
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="tax-type" value="intrastate" class="sr-only" />
          <span>Intra-State <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(CGST+SGST)</span></span>
        </label>
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="tax-type" value="interstate" checked class="sr-only" />
          <span>Inter-State <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(IGST)</span></span>
        </label>
      </div>
    </div>

    <!-- Keyboard Shortcuts Hint -->
    <div class="flex items-center gap-3 text-[10px] text-mute font-mono pt-1">
      <span class="kbd">ESC</span><span>Reset</span>
      <span class="kbd ml-2">Tab</span><span>Navigate fields</span>
    </div>
  </form>

  <ResultCard slot="results" />

  <div slot="content" class="prose max-w-none">
    <h2>IGST Calculator — Integrated Goods and Services Tax Guide</h2>
    <p>Under India's indirect tax system, transactions that cross state or union territory borders are classified as interstate supplies and are governed by the <strong>Integrated Goods and Services Tax (IGST) Act, 2017</strong>. IGST also applies to all commercial imports of goods and services into India, as well as supplies made to or by Special Economic Zone (SEZ) developers and units.</p>
    <p>Unlike local intrastate sales which split tax into equal CGST and SGST portions, interstate transactions charge the entire tax rate under a single unified line item: <strong>IGST</strong>. This free <strong>IGST Calculator</strong> enables exporters, importers, e-commerce sellers, and corporate accountants to calculate exact IGST tax liabilities for exclusive and inclusive transactions across all GST tax slabs (5%, 12%, 18%, 28%).</p>

    <h2>Mathematical Formula for IGST Calculation</h2>
    <p>Because IGST represents the full combined rate (CGST + SGST), calculating IGST uses the full tax percentage without halving:</p>
    
    <div class="my-6 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed space-y-4">
      <div>
        <p class="font-semibold text-primary">1. Adding IGST to Exclusive Base Amount:</p>
        <p>IGST Tax Amount = Base Taxable Price × (IGST Rate ÷ 100)</p>
        <p>Gross Invoice Total = Base Taxable Price + IGST Tax Amount</p>
        <p>CGST / SGST Split: ₹0 (Not applicable for interstate transactions)</p>
      </div>
      <div class="border-t border-hairline/50 pt-4">
        <p class="font-semibold text-primary">2. Extracting IGST from Inclusive Total Amount:</p>
        <p>Pre-Tax Base Price = Inclusive Total Amount ÷ (1 + IGST Rate ÷ 100)</p>
        <p>IGST Tax Amount = Inclusive Total Amount − Pre-Tax Base Price</p>
      </div>
      <div class="border-t border-hairline/50 pt-4">
        <p class="font-semibold text-primary">3. Imports Valuation Formula (Customs Value + Basic Customs Duty):</p>
        <p>Assessable Value = CIF Value + Landing Charges</p>
        <p>Customs Duty = Assessable Value × Basic Customs Duty (BCD Rate)</p>
        <p>Taxable Base for IGST = Assessable Value + Customs Duty + SWS (Social Welfare Surcharge)</p>
        <p>Import IGST Amount = Taxable Base for IGST × IGST Rate</p>
      </div>
    </div>

    <h2>Step-by-Step Numerical Examples</h2>
    
    <h3>Example 1: Interstate B2B Supply of Electronics at 18% IGST (Exclusive)</h3>
    <p>A computer distributor in New Delhi sells server hardware to a software company in Bengaluru for a base taxable price of <strong>₹10,00,000</strong> (exclusive of GST).</p>
    <ul>
      <li><strong>Base Taxable Price:</strong> ₹10,00,000</li>
      <li><strong>Applicable IGST Rate:</strong> 18%</li>
      <li><strong>IGST Tax Amount:</strong> ₹10,00,000 × 18% = <strong>₹1,80,000</strong></li>
      <li><strong>CGST / SGST Split:</strong> ₹0</li>
      <li><strong>Grand Total Invoice Amount:</strong> ₹10,00,000 + ₹1,80,000 = <strong>₹11,80,000</strong></li>
    </ul>

    <h3>Example 2: Commercial Import of Industrial Valves (Customs Valuation)</h3>
    <p>A manufacturing plant in Gujarat imports machinery parts from Germany with an assessable CIF value of <strong>₹5,00,000</strong>. Basic Customs Duty (BCD) is 10% and IGST is 18%.</p>
    <ul>
      <li><strong>Assessable CIF Value:</strong> ₹5,00,000</li>
      <li><strong>Basic Customs Duty (10% BCD):</strong> ₹50,000</li>
      <li><strong>Social Welfare Surcharge (10% of BCD):</strong> ₹5,000</li>
      <li><strong>Taxable Base for IGST:</strong> ₹5,00,000 + ₹50,000 + ₹5,000 = <strong>₹5,55,000</strong></li>
      <li><strong>Import IGST Payable (18%):</strong> ₹5,55,000 × 18% = <strong>₹99,900</strong></li>
      <li><strong>Total Customs + IGST Payable:</strong> ₹55,000 + ₹99,900 = <strong>₹1,54,900</strong></li>
    </ul>

    <h2>Interstate vs. Intrastate Tax Provision Summary</h2>
    
    <div class="overflow-x-auto my-6">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="border-b border-hairline bg-canvas-soft">
            <th class="p-3 font-semibold text-ink">Transaction Type</th>
            <th class="p-3 font-semibold text-ink">Location Criteria</th>
            <th class="p-3 font-semibold text-ink">Tax Charged</th>
            <th class="p-3 font-semibold text-ink">Revenue Recipient</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <tr>
            <td class="p-3 font-medium text-ink">Intrastate Supply</td>
            <td class="p-3 text-body">Supplier location and Place of Supply are in the SAME State</td>
            <td class="p-3 font-mono text-xs">CGST + SGST (50:50)</td>
            <td class="p-3 text-body">Centre & Origin State</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-ink">Interstate Supply</td>
            <td class="p-3 text-body">Supplier location and Place of Supply are in DIFFERENT States</td>
            <td class="p-3 font-mono text-xs text-primary font-semibold">IGST (100%)</td>
            <td class="p-3 text-body">Centre & Destination State</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-ink">Imports into India</td>
            <td class="p-3 text-body">Goods/services supplied from outside India into Indian territory</td>
            <td class="p-3 font-mono text-xs text-primary font-semibold">IGST + Customs Duty</td>
            <td class="p-3 text-body">Central Government</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-ink">SEZ Supplies</td>
            <td class="p-3 text-body">Supplies to or from Special Economic Zone units/developers</td>
            <td class="p-3 font-mono text-xs">Zero-Rated or IGST</td>
            <td class="p-3 text-body">Zero Tax or IGST Refund</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>Rule 88A: IGST Input Tax Credit Utilization Hierarchy</h2>
    <p>Under Section 49 and Rule 88A of the CGST Rules, IGST Input Tax Credit occupies the highest priority in the credit ledger:</p>
    <ul>
      <li><strong>MANDATORY STEP 1:</strong> Available IGST credit MUST be 100% fully utilized first against IGST output liability.</li>
      <li><strong>MANDATORY STEP 2:</strong> Any balance IGST credit remaining after setting off IGST liability can be utilized to set off CGST and SGST output liabilities in ANY proportion or order chosen by the taxpayer.</li>
      <li><strong>FLEXIBILITY ADVANTAGE:</strong> Taxpayers can strategically utilize remaining IGST credit to minimize cash ledger payments for either CGST or SGST. Use our <a href="/interest-calculator" class="text-primary hover:underline">GST Interest Calculator</a> to avoid late payment interest under Section 50.</li>
    </ul>

    <h2>Frequently Asked Questions</h2>
    <FAQ items={faqs} />

    <div class="mt-8 rounded-xl border border-hairline bg-canvas-soft p-6 shadow-xs text-center">
      <h3 class="text-lg font-bold text-ink mb-2">Need a different GST tool?</h3>
      <p class="text-sm text-body mb-4">Browse our complete list of calculators, find active GST rate slabs, or create professional invoices in seconds.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/" class="px-5 py-2.5 rounded-xl bg-primary text-on-primary text-sm font-semibold hover:opacity-90 transition-all">All Calculators</a>
        <a href="/gst-rates" class="px-5 py-2.5 rounded-xl border border-hairline bg-canvas text-ink text-sm font-semibold hover:bg-canvas-soft-2 transition-all">View GST Rates</a>
      </div>
    </div>
  </div>
</CalculatorLayout>

<script>
  // Calculator logical implementation
  const amountInput = document.getElementById('calc-amount') as HTMLInputElement | null;
  const customRateInput = document.getElementById('calc-rate-custom') as HTMLInputElement | null;
  const customRateContainer = document.getElementById('custom-rate-container');
  const gstForm = document.getElementById('gst-form') as HTMLFormElement | null;

  // DOM Outputs
  const resTaxable = document.getElementById('res-taxable-val');
  const resCgstRow = document.getElementById('res-cgst-row');
  const resCgstVal = document.getElementById('res-cgst-val');
  const resSgstRow = document.getElementById('res-sgst-row');
  const resSgstVal = document.getElementById('res-sgst-val');
  const resIgstRow = document.getElementById('res-igst-row');
  const resIgstVal = document.getElementById('res-igst-val');
  const resTotalTax = document.getElementById('res-total-tax');
  const resGrandTotal = document.getElementById('res-grand-total');

  function validateInput(input: HTMLInputElement, message: string, check: () => boolean): boolean {
    const isValid = check();
    let errSpan = document.getElementById(`${input.id}-error`);
    if (!isValid) {
      input.classList.add('input-error');
      if (!errSpan) {
        errSpan = document.createElement('span');
        errSpan.id = `${input.id}-error`;
        errSpan.className = 'error-message';
        errSpan.innerText = message;
        input.parentElement?.parentElement?.appendChild(errSpan);
      }
    } else {
      input.classList.remove('input-error');
      errSpan?.remove();
    }
    return isValid;
  }

  function getSelectedRate(): number {
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    if (!rateRadio) return 18;
    if (rateRadio.value === 'custom') {
      return parseFloat(customRateInput?.value || '0') || 0;
    }
    return parseFloat(rateRadio.value) || 0;
  }

  function calculate() {
    if (!amountInput) return;

    // Validate main amount
    const isAmountValid = validateInput(
      amountInput,
      "Please enter a valid amount greater than 0",
      () => parseFloat(amountInput.value) > 0
    );

    // Validate custom rate if selected
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    let isRateValid = true;
    if (rateRadio?.value === 'custom' && customRateInput) {
      isRateValid = validateInput(
        customRateInput,
        "Please enter a rate between 0.1% and 100%",
        () => {
          const val = parseFloat(customRateInput.value);
          return val >= 0.1 && val <= 100;
        }
      );
    }

    if (!isAmountValid || !isRateValid) {
      if (resTaxable) resTaxable.innerText = "₹0.00";
      if (resTotalTax) resTotalTax.innerText = "₹0.00";
      if (resGrandTotal) resGrandTotal.innerText = "₹0.00";
      if (resCgstVal) resCgstVal.innerText = "₹0.00";
      if (resSgstVal) resSgstVal.innerText = "₹0.00";
      if (resIgstVal) resIgstVal.innerText = "₹0.00";
      return;
    }

    const amount = parseFloat(amountInput.value) || 0;
    const rate = getSelectedRate();
    const typeRadio = document.querySelector('input[name="calc-type"]:checked') as HTMLInputElement | null;
    const isAdd = typeRadio ? typeRadio.value === 'add' : true;
    
    const taxTypeRadio = document.querySelector('input[name="tax-type"]:checked') as HTMLInputElement | null;
    const isIntrastate = taxTypeRadio ? taxTypeRadio.value === 'intrastate' : true;

    let taxableValue = 0;
    let totalTax = 0;
    let grandTotal = 0;

    if (isAdd) {
      taxableValue = amount;
      totalTax = amount * (rate / 100);
      grandTotal = amount + totalTax;
    } else {
      taxableValue = amount / (1 + (rate / 100));
      totalTax = amount - taxableValue;
      grandTotal = amount;
    }

    const fmt = (val: number) => '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (resTaxable) resTaxable.innerText = fmt(taxableValue);
    if (resTotalTax) resTotalTax.innerText = fmt(totalTax);
    if (resGrandTotal) resGrandTotal.innerText = fmt(grandTotal);

    if (isIntrastate) {
      resCgstRow?.classList.remove('hidden');
      resSgstRow?.classList.remove('hidden');
      resIgstRow?.classList.add('hidden');
      const splitTax = totalTax / 2;
      if (resCgstVal) resCgstVal.innerText = fmt(splitTax);
      if (resSgstVal) resSgstVal.innerText = fmt(splitTax);
    } else {
      resCgstRow?.classList.add('hidden');
      resSgstRow?.classList.add('hidden');
      resIgstRow?.classList.remove('hidden');
      if (resIgstVal) resIgstVal.innerText = fmt(totalTax);
    }
  }

  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const amount = params.get('amount');
    const rate = params.get('rate');
    const type = params.get('type');
    const taxtype = params.get('taxtype');

    if (amount && amountInput) amountInput.value = amount;

    if (type) {
      const typeRadio = document.querySelector(`input[name="calc-type"][value="${type}"]`) as HTMLInputElement | null;
      if (typeRadio) typeRadio.checked = true;
    }

    if (taxtype) {
      const taxRadio = document.querySelector(`input[name="tax-type"][value="${taxtype}"]`) as HTMLInputElement | null;
      if (taxRadio) taxRadio.checked = true;
    }

    if (rate) {
      const standardRates = ['5', '12', '18', '28'];
      if (standardRates.includes(rate)) {
        const rateRadio = document.querySelector(`input[name="calc-rate"][value="${rate}"]`) as HTMLInputElement | null;
        if (rateRadio) rateRadio.checked = true;
      } else {
        const customRadio = document.getElementById('rate-custom-radio') as HTMLInputElement | null;
        if (customRadio) {
          customRadio.checked = true;
          customRateContainer?.classList.remove('hidden');
          if (customRateInput) customRateInput.value = rate;
        }
      }
    }
  }

  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  const rateRadios = document.querySelectorAll('input[name="calc-rate"]');
  rateRadios.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value === 'custom') {
        customRateContainer?.classList.remove('hidden');
        customRateInput?.focus();
      } else {
        customRateContainer?.classList.add('hidden');
        if (customRateInput) {
          customRateInput.classList.remove('input-error');
          document.getElementById('calc-rate-custom-error')?.remove();
        }
      }
      calculate();
    });
  });

  // Quick Amount Chips
  const chipValues: Record<string, number> = {
    '100': 100, '500': 500, '1K': 1000, '5K': 5000,
    '10K': 10000, '25K': 25000, '50K': 50000, '1L': 100000
  };
  document.querySelectorAll<HTMLButtonElement>('#page-quick-chips .quick-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const val = chipValues[chip.dataset.chip || ''] || 0;
      if (amountInput) amountInput.value = String(val);
      document.querySelectorAll('#page-quick-chips .quick-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      calculate();
    });
  });

  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  loadFromUrl();
  calculate();
</script>
