---
import CalculatorLayout from '../components/CalculatorLayout.astro';

const pageTitle = "GST Invoice Builder – Free Online Invoice Generator";
const pageDesc = "Create professional GST invoices with automatic CGST/SGST/IGST split, PDF export, and print-ready layout. Free online invoice builder for India.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": "GST Invoice Builder – Free Online Invoice Generator",
  "url": "https://gstcalculatoronline.in/invoice-builder",
  "description": "Free online GST invoice builder for India. Auto-calculates CGST/SGST/IGST, supports PDF export and print-ready layout.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
};

const faqs = [
  {
    question: "What is a GST Invoice?",
    answer: "A GST invoice is a legal document issued by a registered taxpayer showing the supply of goods or services, including GSTIN, HSN/SAC codes, taxable value, and CGST/SGST/IGST breakdown as required under the CGST Act, 2017."
  },
  {
    question: "What details are mandatory on a GST invoice?",
    answer: "Mandatory fields include: Invoice number and date, supplier GSTIN, name and address, recipient details, HSN/SAC codes, taxable value, GST rate and amount (CGST+SGST or IGST), and the place of supply."
  },
  {
    question: "When should I use CGST+SGST vs IGST on an invoice?",
    answer: "Use CGST+SGST (split equally) for intrastate transactions where supplier and recipient are in the same state. Use IGST for interstate transactions where supplier and recipient are in different states."
  },
  {
    question: "Can I export the invoice as a PDF?",
    answer: "Yes. Click the 'Download PDF' button to export a print-ready A4 invoice. You can also use the 'Print' button to print directly from your browser."
  },
  {
    question: "Is my invoice data saved anywhere?",
    answer: "No. All invoice data is processed entirely in your browser. Drafts are saved to your browser's localStorage only. No data is sent to any server."
  }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema} faqs={faqs}>

  <!-- Invoice Builder Form -->
  <div id="invoice-builder" class="space-y-6">

    <!-- Party Details -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Seller -->
      <div class="rounded-xl border border-hairline bg-canvas p-4 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink border-b border-hairline pb-2">Seller (From)</h3>
        <div>
          <label class="block text-xs font-semibold text-mute mb-1">Business Name</label>
          <input type="text" id="inv-seller-name" class="inv-input" placeholder="Your Company Pvt Ltd" value="" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-mute mb-1">GSTIN</label>
          <input type="text" id="inv-seller-gstin" class="inv-input font-mono" placeholder="22AAAAA0000A1Z5" maxlength="15" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-mute mb-1">Address</label>
          <textarea id="inv-seller-address" class="inv-input resize-none" rows="2" placeholder="123, Business Park, Mumbai, MH 400001"></textarea>
        </div>
      </div>

      <!-- Buyer -->
      <div class="rounded-xl border border-hairline bg-canvas p-4 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink border-b border-hairline pb-2">Buyer (To)</h3>
        <div>
          <label class="block text-xs font-semibold text-mute mb-1">Client Name</label>
          <input type="text" id="inv-buyer-name" class="inv-input" placeholder="Client Company Ltd" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-mute mb-1">GSTIN (optional)</label>
          <input type="text" id="inv-buyer-gstin" class="inv-input font-mono" placeholder="27BBBBB0000B1Z3" maxlength="15" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-mute mb-1">Address</label>
          <textarea id="inv-buyer-address" class="inv-input resize-none" rows="2" placeholder="456, Corporate Ave, Delhi, DL 110001"></textarea>
        </div>
      </div>
    </div>

    <!-- Invoice Meta -->
    <div class="rounded-xl border border-hairline bg-canvas p-4">
      <h3 class="text-xs font-bold uppercase tracking-wider text-ink border-b border-hairline pb-2 mb-3">Invoice Details</h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div>
          <label class="block text-xs font-semibold text-mute mb-1">Invoice #</label>
          <input type="text" id="inv-number" class="inv-input font-mono" placeholder="INV-2025-001" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-mute mb-1">Invoice Date</label>
          <input type="date" id="inv-date" class="inv-input" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-mute mb-1">Due Date</label>
          <input type="date" id="inv-due-date" class="inv-input" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-mute mb-1">Transaction Type</label>
          <select id="inv-supply-type" class="inv-input">
            <option value="intrastate">Intra-State (CGST+SGST)</option>
            <option value="interstate">Inter-State (IGST)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Line Items -->
    <div class="rounded-xl border border-hairline bg-canvas overflow-hidden">
      <div class="flex items-center justify-between px-4 py-3 border-b border-hairline">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Line Items</h3>
        <button type="button" id="add-item-btn" class="flex items-center gap-1.5 text-xs font-bold text-primary hover:text-brand-link-deep transition-colors cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          Add Item
        </button>
      </div>
      <div class="overflow-x-auto">
        <table class="invoice-table w-full" id="items-table">
          <thead>
            <tr>
              <th style="min-width:200px">Description</th>
              <th style="min-width:90px">HSN/SAC</th>
              <th style="min-width:70px">Qty</th>
              <th style="min-width:100px">Unit Price (₹)</th>
              <th style="min-width:80px">Discount %</th>
              <th style="min-width:80px">GST %</th>
              <th style="min-width:110px">Taxable (₹)</th>
              <th style="min-width:110px">GST (₹)</th>
              <th style="min-width:110px">Total (₹)</th>
              <th style="min-width:40px"></th>
            </tr>
          </thead>
          <tbody id="items-tbody">
            <!-- Rows inserted by JS -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Shipping & Notes -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="rounded-xl border border-hairline bg-canvas p-4 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink border-b border-hairline pb-2">Additional Charges</h3>
        <div class="flex justify-between items-center">
          <label class="text-xs font-semibold text-mute">Shipping Charges (₹)</label>
          <input type="number" id="inv-shipping" class="inv-input w-28 text-right font-mono" placeholder="0" min="0" step="any" value="0" />
        </div>
        <div class="flex justify-between items-center">
          <label class="text-xs font-semibold text-mute">Shipping GST %</label>
          <select id="inv-shipping-gst" class="inv-input w-28">
            <option value="0">0%</option>
            <option value="5">5%</option>
            <option value="12">12%</option>
            <option value="18" selected>18%</option>
            <option value="28">28%</option>
          </select>
        </div>
      </div>
      <div class="rounded-xl border border-hairline bg-canvas p-4 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink border-b border-hairline pb-2">Notes / Terms</h3>
        <textarea id="inv-notes" class="inv-input resize-none w-full" rows="3" placeholder="Payment due within 30 days. Bank transfer preferred.&#10;Account: XXXXXXXX | IFSC: XXXXXX"></textarea>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap gap-3">
      <button type="button" id="inv-preview-btn" class="flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-on-primary hover:bg-brand-link-deep transition-colors cursor-pointer">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
        Preview Invoice
      </button>
      <button type="button" id="inv-pdf-btn" class="flex items-center gap-2 rounded-xl border border-hairline bg-canvas px-5 py-2.5 text-sm font-bold text-ink hover:bg-canvas-soft-2 transition-colors cursor-pointer">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/></svg>
        Download PDF
      </button>
      <button type="button" id="inv-print-btn" class="flex items-center gap-2 rounded-xl border border-hairline bg-canvas px-5 py-2.5 text-sm font-bold text-ink hover:bg-canvas-soft-2 transition-colors cursor-pointer">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.615 0-1.101-.482-1.12-1.1L5.91 18m11.75 0c.27-.024.54-.051.81-.082 1.18-.137 2.13-1.02 2.21-2.207l.45-6.6a2.25 2.25 0 0 0-2.01-2.402a48.9 48.9 0 0 0-15.16 0A2.25 2.25 0 0 0 2.22 9.11l.45 6.6a2.25 2.25 0 0 0 2.21 2.207c.27.031.54.058.81.082"/></svg>
        Print
      </button>
      <button type="button" id="inv-save-btn" class="flex items-center gap-2 rounded-xl border border-hairline bg-canvas px-5 py-2.5 text-sm font-bold text-ink hover:bg-canvas-soft-2 transition-colors cursor-pointer">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z"/></svg>
        Save Draft
      </button>
      <button type="button" id="inv-reset-btn" class="flex items-center gap-2 rounded-xl border border-hairline bg-canvas px-4 py-2.5 text-sm font-semibold text-mute hover:text-ink hover:bg-canvas-soft-2 transition-colors cursor-pointer ml-auto">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
        New Invoice
      </button>
    </div>
    <div id="inv-toast" class="hidden text-center text-xs font-semibold text-brand-success py-1.5 rounded-lg bg-brand-success/10"></div>
  </div>

  <!-- INVOICE PREVIEW MODAL (hidden by default) -->
  <div id="inv-preview-modal" class="fixed inset-0 z-50 hidden bg-slate-900/70 backdrop-blur-sm p-4 overflow-y-auto" role="dialog" aria-modal="true" aria-label="Invoice Preview">
    <div class="mx-auto max-w-3xl my-8">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-base font-bold text-white">Invoice Preview</h2>
        <div class="flex gap-2">
          <button type="button" id="modal-pdf-btn" class="flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-xs font-bold text-on-primary cursor-pointer">Download PDF</button>
          <button type="button" id="modal-print-btn" class="flex items-center gap-1.5 rounded-lg bg-canvas px-4 py-2 text-xs font-bold text-ink cursor-pointer">Print</button>
          <button type="button" id="inv-preview-close" class="flex h-9 w-9 items-center justify-center rounded-lg bg-white/10 text-white hover:bg-white/20 cursor-pointer">✕</button>
        </div>
      </div>
      <!-- A4 Invoice Layout -->
      <div id="invoice-print-area" class="bg-white rounded-xl shadow-2xl p-8 invoice-print-area text-sm" style="color:#111;font-family:sans-serif;">
        <!-- Invoice content rendered by JS -->
      </div>
    </div>
  </div>

  <!-- Summary right column -->
  <div slot="results">
    <div class="rounded-2xl border border-hairline bg-canvas-soft p-5 shadow-xs">
      <h3 class="text-sm font-bold uppercase tracking-wider text-ink border-b border-hairline pb-3 mb-4">Invoice Summary</h3>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between"><span class="text-body">Subtotal</span><span id="inv-subtotal" class="font-mono font-semibold text-ink">₹0.00</span></div>
        <div class="flex justify-between"><span class="text-body">Discount</span><span id="inv-discount-total" class="font-mono text-mute">-₹0.00</span></div>
        <div class="flex justify-between"><span class="text-body">Taxable Value</span><span id="inv-taxable-total" class="font-mono font-semibold text-ink">₹0.00</span></div>
        <div id="inv-cgst-row" class="flex justify-between"><span class="text-body">CGST</span><span id="inv-cgst-total" class="font-mono text-mute">₹0.00</span></div>
        <div id="inv-sgst-row" class="flex justify-between"><span class="text-body">SGST</span><span id="inv-sgst-total" class="font-mono text-mute">₹0.00</span></div>
        <div id="inv-igst-row" class="hidden flex justify-between"><span class="text-body">IGST</span><span id="inv-igst-total" class="font-mono text-mute">₹0.00</span></div>
        <div class="flex justify-between"><span class="text-body">Shipping (incl. GST)</span><span id="inv-shipping-total" class="font-mono text-mute">₹0.00</span></div>
        <div class="border-t border-hairline pt-3 mt-2 flex justify-between items-center">
          <span class="text-base font-bold text-ink">Grand Total</span>
          <span id="inv-grand-total" class="font-mono text-2xl font-extrabold text-ink">₹0.00</span>
        </div>
        <p id="inv-summary-items" class="text-[10px] text-mute font-mono mt-1">0 items</p>
      </div>
    </div>
  </div>

</CalculatorLayout>

<style>
  .inv-input {
    display: block;
    width: 100%;
    background: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: 0.5rem;
    padding: 0.4rem 0.625rem;
    font-size: 0.8rem;
    color: var(--color-ink);
    outline: none;
    transition: border-color 0.15s;
  }
  .inv-input:focus {
    border-color: var(--color-primary);
  }
  .inv-td-input {
    background: transparent;
    border: none;
    outline: none;
    width: 100%;
    font-size: 0.8rem;
    color: var(--color-ink);
    padding: 2px 0;
    font-family: inherit;
  }
  .inv-td-input:focus {
    border-bottom: 1.5px solid var(--color-primary);
  }
  .inv-td-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-body);
  }
</style>

<script>
  // =====================================================
  // INVOICE BUILDER LOGIC
  // =====================================================
  interface LineItem {
    id: number;
    desc: string;
    hsn: string;
    qty: number;
    unitPrice: number;
    discountPct: number;
    gstPct: number;
  }

  let items: LineItem[] = [];
  let nextId = 1;

  const tbody = document.getElementById('items-tbody')!;

  function fmt(v: number): string {
    return v.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function getSupplyType(): 'intrastate' | 'interstate' {
    return (document.getElementById('inv-supply-type') as HTMLSelectElement)?.value as any || 'intrastate';
  }

  function calcItem(item: LineItem) {
    const gross = item.qty * item.unitPrice;
    const discAmt = gross * (item.discountPct / 100);
    const taxable = gross - discAmt;
    const gstAmt = taxable * (item.gstPct / 100);
    const total = taxable + gstAmt;
    return { gross, discAmt, taxable, gstAmt, total };
  }

  function renderRow(item: LineItem) {
    const { taxable, gstAmt, total } = calcItem(item);
    const tr = document.createElement('tr');
    tr.dataset.id = String(item.id);
    tr.innerHTML = `
      <td><input class="inv-td-input" data-field="desc" value="${item.desc}" placeholder="Service description" /></td>
      <td><input class="inv-td-input font-mono" data-field="hsn" value="${item.hsn}" placeholder="998314" /></td>
      <td><input class="inv-td-input inv-td-num text-right" data-field="qty" type="number" value="${item.qty}" min="1" step="any" /></td>
      <td><input class="inv-td-input inv-td-num text-right" data-field="unitPrice" type="number" value="${item.unitPrice}" min="0" step="any" /></td>
      <td><input class="inv-td-input inv-td-num text-right" data-field="discountPct" type="number" value="${item.discountPct}" min="0" max="100" step="any" /></td>
      <td>
        <select class="inv-td-input" data-field="gstPct">
          ${[0,3,5,12,18,28].map(r => `<option value="${r}" ${item.gstPct === r ? 'selected' : ''}>${r}%</option>`).join('')}
        </select>
      </td>
      <td class="inv-td-num text-right item-taxable">${fmt(taxable)}</td>
      <td class="inv-td-num text-right item-gst">${fmt(gstAmt)}</td>
      <td class="inv-td-num text-right font-semibold item-total">${fmt(total)}</td>
      <td>
        <button type="button" class="remove-item-btn text-mute hover:text-red-500 transition-colors cursor-pointer px-1" aria-label="Remove item">✕</button>
      </td>
    `;
    // Attach listeners
    tr.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-field]').forEach(el => {
      el.addEventListener('input', () => {
        const field = el.dataset.field as keyof LineItem;
        const val = el.tagName === 'SELECT' ? parseFloat((el as HTMLSelectElement).value) : (field === 'desc' || field === 'hsn') ? (el as HTMLInputElement).value : parseFloat((el as HTMLInputElement).value) || 0;
        (item as any)[field] = val;
        updateRow(tr, item);
        updateSummary();
      });
    });
    tr.querySelector('.remove-item-btn')?.addEventListener('click', () => {
      items = items.filter(i => i.id !== item.id);
      tr.remove();
      updateSummary();
    });
    return tr;
  }

  function updateRow(tr: HTMLTableRowElement, item: LineItem) {
    const { taxable, gstAmt, total } = calcItem(item);
    const taxableEl = tr.querySelector('.item-taxable');
    const gstEl = tr.querySelector('.item-gst');
    const totalEl = tr.querySelector('.item-total');
    if (taxableEl) taxableEl.textContent = fmt(taxable);
    if (gstEl) gstEl.textContent = fmt(gstAmt);
    if (totalEl) totalEl.textContent = fmt(total);
  }

  function addItem() {
    const item: LineItem = { id: nextId++, desc: '', hsn: '', qty: 1, unitPrice: 0, discountPct: 0, gstPct: 18 };
    items.push(item);
    tbody.appendChild(renderRow(item));
    updateSummary();
    // Focus description of new row
    const lastRow = tbody.lastElementChild as HTMLTableRowElement;
    (lastRow.querySelector('input') as HTMLInputElement)?.focus();
  }

  function updateSummary() {
    const supplyType = getSupplyType();
    let subtotal = 0, discountTotal = 0, taxableTotal = 0, cgstTotal = 0, sgstTotal = 0, igstTotal = 0;

    items.forEach(item => {
      const { gross, discAmt, taxable, gstAmt } = calcItem(item);
      subtotal += gross;
      discountTotal += discAmt;
      taxableTotal += taxable;
      if (supplyType === 'intrastate') {
        cgstTotal += gstAmt / 2;
        sgstTotal += gstAmt / 2;
      } else {
        igstTotal += gstAmt;
      }
    });

    // Shipping
    const shippingBase = parseFloat((document.getElementById('inv-shipping') as HTMLInputElement)?.value || '0') || 0;
    const shippingGst = parseFloat((document.getElementById('inv-shipping-gst') as HTMLSelectElement)?.value || '0') || 0;
    const shippingGstAmt = shippingBase * (shippingGst / 100);
    const shippingTotal = shippingBase + shippingGstAmt;

    const totalGst = supplyType === 'intrastate' ? cgstTotal + sgstTotal : igstTotal;
    const grandTotal = taxableTotal + totalGst + shippingTotal;

    // Update DOM
    const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    set('inv-subtotal', '₹' + fmt(subtotal));
    set('inv-discount-total', '-₹' + fmt(discountTotal));
    set('inv-taxable-total', '₹' + fmt(taxableTotal));
    set('inv-cgst-total', '₹' + fmt(cgstTotal));
    set('inv-sgst-total', '₹' + fmt(sgstTotal));
    set('inv-igst-total', '₹' + fmt(igstTotal));
    set('inv-shipping-total', '₹' + fmt(shippingTotal));
    set('inv-grand-total', '₹' + fmt(grandTotal));
    set('inv-summary-items', `${items.length} item${items.length !== 1 ? 's' : ''}`);

    const cgstRow = document.getElementById('inv-cgst-row');
    const sgstRow = document.getElementById('inv-sgst-row');
    const igstRow = document.getElementById('inv-igst-row');
    if (supplyType === 'intrastate') {
      cgstRow?.classList.remove('hidden');
      sgstRow?.classList.remove('hidden');
      igstRow?.classList.add('hidden');
    } else {
      cgstRow?.classList.add('hidden');
      sgstRow?.classList.add('hidden');
      igstRow?.classList.remove('hidden');
    }
  }

  function renderInvoiceHTML(): string {
    const sellerName = (document.getElementById('inv-seller-name') as HTMLInputElement)?.value || 'Your Business';
    const sellerGstin = (document.getElementById('inv-seller-gstin') as HTMLInputElement)?.value || '';
    const sellerAddr = (document.getElementById('inv-seller-address') as HTMLTextAreaElement)?.value || '';
    const buyerName = (document.getElementById('inv-buyer-name') as HTMLInputElement)?.value || 'Client';
    const buyerGstin = (document.getElementById('inv-buyer-gstin') as HTMLInputElement)?.value || '';
    const buyerAddr = (document.getElementById('inv-buyer-address') as HTMLTextAreaElement)?.value || '';
    const invNum = (document.getElementById('inv-number') as HTMLInputElement)?.value || 'INV-001';
    const invDate = (document.getElementById('inv-date') as HTMLInputElement)?.value || '';
    const dueDate = (document.getElementById('inv-due-date') as HTMLInputElement)?.value || '';
    const notes = (document.getElementById('inv-notes') as HTMLTextAreaElement)?.value || '';
    const supplyType = getSupplyType();
    const shippingBase = parseFloat((document.getElementById('inv-shipping') as HTMLInputElement)?.value || '0') || 0;
    const shippingGst = parseFloat((document.getElementById('inv-shipping-gst') as HTMLSelectElement)?.value || '0') || 0;
    const shippingGstAmt = shippingBase * (shippingGst / 100);
    const shippingTotal = shippingBase + shippingGstAmt;

    let subtotal = 0, discountTotal = 0, taxableTotal = 0, cgstTotal = 0, sgstTotal = 0, igstTotal = 0;
    const itemRows = items.map(item => {
      const { gross, discAmt, taxable, gstAmt, total } = calcItem(item);
      subtotal += gross; discountTotal += discAmt; taxableTotal += taxable;
      if (supplyType === 'intrastate') { cgstTotal += gstAmt / 2; sgstTotal += gstAmt / 2; } else { igstTotal += gstAmt; }
      return `<tr style="border-bottom:1px solid #e5e7eb;">
        <td style="padding:6px 8px;">${item.desc || '—'}</td>
        <td style="padding:6px 8px;font-family:monospace;">${item.hsn}</td>
        <td style="padding:6px 8px;text-align:right;">${item.qty}</td>
        <td style="padding:6px 8px;text-align:right;font-family:monospace;">₹${fmt(item.unitPrice)}</td>
        <td style="padding:6px 8px;text-align:right;">${item.discountPct}%</td>
        <td style="padding:6px 8px;text-align:right;">${item.gstPct}%</td>
        <td style="padding:6px 8px;text-align:right;font-family:monospace;">₹${fmt(taxable)}</td>
        <td style="padding:6px 8px;text-align:right;font-family:monospace;">₹${fmt(gstAmt)}</td>
        <td style="padding:6px 8px;text-align:right;font-family:monospace;font-weight:600;">₹${fmt(total)}</td>
      </tr>`;
    }).join('');

    const totalGst = supplyType === 'intrastate' ? cgstTotal + sgstTotal : igstTotal;
    const grandTotal = taxableTotal + totalGst + shippingTotal;

    const taxRows = supplyType === 'intrastate'
      ? `<tr><td colspan="6" style="text-align:right;padding:4px 8px;color:#6b7280;">CGST</td><td colspan="3" style="text-align:right;padding:4px 8px;font-family:monospace;">₹${fmt(cgstTotal)}</td></tr>
         <tr><td colspan="6" style="text-align:right;padding:4px 8px;color:#6b7280;">SGST</td><td colspan="3" style="text-align:right;padding:4px 8px;font-family:monospace;">₹${fmt(sgstTotal)}</td></tr>`
      : `<tr><td colspan="6" style="text-align:right;padding:4px 8px;color:#6b7280;">IGST</td><td colspan="3" style="text-align:right;padding:4px 8px;font-family:monospace;">₹${fmt(igstTotal)}</td></tr>`;

    return `<div style="font-family:sans-serif;color:#111;font-size:12px;max-width:210mm;">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;padding-bottom:16px;border-bottom:2px solid #059669;">
        <div>
          <div style="font-size:22px;font-weight:900;color:#059669;">TAX INVOICE</div>
          <div style="font-size:10px;color:#6b7280;margin-top:2px;">gstcalculatoronline.in</div>
        </div>
        <div style="text-align:right;">
          <div style="font-weight:700;font-size:13px;">${invNum}</div>
          <div style="font-size:10px;color:#6b7280;">Date: ${invDate || 'N/A'}</div>
          ${dueDate ? `<div style="font-size:10px;color:#6b7280;">Due: ${dueDate}</div>` : ''}
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:16px 0;">
        <div>
          <div style="font-size:9px;text-transform:uppercase;font-weight:700;color:#6b7280;margin-bottom:4px;">From</div>
          <div style="font-weight:700;font-size:13px;">${sellerName}</div>
          ${sellerGstin ? `<div style="font-family:monospace;font-size:10px;color:#374151;">GSTIN: ${sellerGstin}</div>` : ''}
          <div style="font-size:11px;color:#6b7280;white-space:pre-line;">${sellerAddr}</div>
        </div>
        <div>
          <div style="font-size:9px;text-transform:uppercase;font-weight:700;color:#6b7280;margin-bottom:4px;">To</div>
          <div style="font-weight:700;font-size:13px;">${buyerName}</div>
          ${buyerGstin ? `<div style="font-family:monospace;font-size:10px;color:#374151;">GSTIN: ${buyerGstin}</div>` : ''}
          <div style="font-size:11px;color:#6b7280;white-space:pre-line;">${buyerAddr}</div>
        </div>
      </div>
      <table style="width:100%;border-collapse:collapse;font-size:11px;margin:16px 0;">
        <thead>
          <tr style="background:#f9fafb;border-bottom:2px solid #e5e7eb;">
            <th style="padding:8px;text-align:left;font-size:10px;color:#6b7280;">Description</th>
            <th style="padding:8px;text-align:left;font-size:10px;color:#6b7280;">HSN/SAC</th>
            <th style="padding:8px;text-align:right;font-size:10px;color:#6b7280;">Qty</th>
            <th style="padding:8px;text-align:right;font-size:10px;color:#6b7280;">Rate</th>
            <th style="padding:8px;text-align:right;font-size:10px;color:#6b7280;">Disc%</th>
            <th style="padding:8px;text-align:right;font-size:10px;color:#6b7280;">GST%</th>
            <th style="padding:8px;text-align:right;font-size:10px;color:#6b7280;">Taxable</th>
            <th style="padding:8px;text-align:right;font-size:10px;color:#6b7280;">GST</th>
            <th style="padding:8px;text-align:right;font-size:10px;color:#6b7280;">Total</th>
          </tr>
        </thead>
        <tbody>${itemRows || '<tr><td colspan="9" style="text-align:center;padding:12px;color:#9ca3af;">No items added</td></tr>'}</tbody>
        <tfoot>
          <tr><td colspan="6" style="text-align:right;padding:4px 8px;color:#6b7280;">Subtotal</td><td colspan="3" style="text-align:right;padding:4px 8px;font-family:monospace;">₹${fmt(subtotal)}</td></tr>
          ${discountTotal > 0 ? `<tr><td colspan="6" style="text-align:right;padding:4px 8px;color:#6b7280;">Discount</td><td colspan="3" style="text-align:right;padding:4px 8px;font-family:monospace;color:#dc2626;">-₹${fmt(discountTotal)}</td></tr>` : ''}
          <tr><td colspan="6" style="text-align:right;padding:4px 8px;color:#6b7280;">Taxable Value</td><td colspan="3" style="text-align:right;padding:4px 8px;font-family:monospace;">₹${fmt(taxableTotal)}</td></tr>
          ${taxRows}
          ${shippingTotal > 0 ? `<tr><td colspan="6" style="text-align:right;padding:4px 8px;color:#6b7280;">Shipping (incl. ${shippingGst}% GST)</td><td colspan="3" style="text-align:right;padding:4px 8px;font-family:monospace;">₹${fmt(shippingTotal)}</td></tr>` : ''}
          <tr style="background:#f0fdf4;">
            <td colspan="6" style="text-align:right;padding:10px 8px;font-weight:700;font-size:13px;color:#059669;">GRAND TOTAL</td>
            <td colspan="3" style="text-align:right;padding:10px 8px;font-family:monospace;font-weight:800;font-size:15px;color:#059669;">₹${fmt(grandTotal)}</td>
          </tr>
        </tfoot>
      </table>
      <div style="display:flex;justify-content:space-between;margin-top:24px;padding-top:16px;border-top:1px solid #e5e7eb;font-size:10px;color:#6b7280;">
        <div>${notes ? `<strong>Notes / Terms:</strong><br/><span style="white-space:pre-line;">${notes}</span>` : ''}</div>
        <div style="text-align:right;">
          <div style="margin-bottom:40px;">Authorised Signatory</div>
          <div style="border-top:1px solid #374151;padding-top:4px;font-weight:600;">${sellerName}</div>
        </div>
      </div>
      <div style="margin-top:16px;text-align:center;font-size:9px;color:#9ca3af;">Generated by gstcalculatoronline.in — ${supplyType === 'intrastate' ? 'Intra-State Supply' : 'Inter-State Supply'}</div>
    </div>`;
  }

  // Initialize with 2 default items
  function initDefault() {
    items = [];
    nextId = 1;
    tbody.innerHTML = '';
    // Set today's date
    const today = new Date();
    const todayStr = today.toISOString().split('T')[0];
    const dueStr = new Date(today.getTime() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
    const invDateEl = document.getElementById('inv-date') as HTMLInputElement;
    const invDueEl = document.getElementById('inv-due-date') as HTMLInputElement;
    if (invDateEl) invDateEl.value = todayStr;
    if (invDueEl) invDueEl.value = dueStr;
    const invNumEl = document.getElementById('inv-number') as HTMLInputElement;
    if (invNumEl) invNumEl.value = `INV-${today.getFullYear()}-001`;
    addItem();
    addItem();
    updateSummary();
  }

  // Toast
  function showToast(msg: string) {
    const toast = document.getElementById('inv-toast');
    if (toast) { toast.textContent = msg; toast.classList.remove('hidden'); setTimeout(() => toast.classList.add('hidden'), 2500); }
  }

  // Event Listeners
  document.getElementById('add-item-btn')?.addEventListener('click', () => { addItem(); updateSummary(); });
  document.getElementById('inv-supply-type')?.addEventListener('change', updateSummary);
  document.getElementById('inv-shipping')?.addEventListener('input', updateSummary);
  document.getElementById('inv-shipping-gst')?.addEventListener('change', updateSummary);

  document.getElementById('inv-preview-btn')?.addEventListener('click', () => {
    const modal = document.getElementById('inv-preview-modal');
    const area = document.getElementById('invoice-print-area');
    if (area) area.innerHTML = renderInvoiceHTML();
    modal?.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
  });

  document.getElementById('inv-preview-close')?.addEventListener('click', () => {
    document.getElementById('inv-preview-modal')?.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  });

  document.getElementById('inv-print-btn')?.addEventListener('click', () => {
    const area = document.getElementById('invoice-print-area');
    if (area) area.innerHTML = renderInvoiceHTML();
    window.print();
  });

  document.getElementById('modal-print-btn')?.addEventListener('click', () => window.print());

  async function downloadPDF() {
    if (!(window as any).jspdf) {
      const s = document.createElement('script');
      s.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
      document.head.appendChild(s);
      await new Promise(r => s.onload = r);
    }
    if (!(window as any).html2canvas) {
      const s2 = document.createElement('script');
      s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
      document.head.appendChild(s2);
      await new Promise(r => s2.onload = r);
    }
    // Render to a temporary div
    const tmp = document.createElement('div');
    tmp.style.cssText = 'position:fixed;left:-9999px;top:0;width:794px;background:white;padding:32px;font-family:sans-serif;z-index:-1;';
    tmp.innerHTML = renderInvoiceHTML();
    document.body.appendChild(tmp);
    const canvas = await (window as any).html2canvas(tmp, { scale: 2, useCORS: true, logging: false });
    const imgData = canvas.toDataURL('image/png');
    const { jsPDF } = (window as any).jspdf;
    const pdf = new jsPDF({ orientation: 'portrait', unit: 'px', format: 'a4' });
    const pdfW = pdf.internal.pageSize.getWidth();
    const pdfH = (canvas.height * pdfW) / canvas.width;
    pdf.addImage(imgData, 'PNG', 0, 0, pdfW, pdfH);
    const invNum = (document.getElementById('inv-number') as HTMLInputElement)?.value || 'Invoice';
    pdf.save(`${invNum}.pdf`);
    document.body.removeChild(tmp);
  }

  document.getElementById('inv-pdf-btn')?.addEventListener('click', async () => {
    showToast('Generating PDF...');
    await downloadPDF();
    showToast('✓ PDF downloaded!');
  });
  document.getElementById('modal-pdf-btn')?.addEventListener('click', async () => { await downloadPDF(); });

  document.getElementById('inv-save-btn')?.addEventListener('click', () => {
    const data = {
      items,
      sellerName: (document.getElementById('inv-seller-name') as HTMLInputElement)?.value,
      sellerGstin: (document.getElementById('inv-seller-gstin') as HTMLInputElement)?.value,
      sellerAddr: (document.getElementById('inv-seller-address') as HTMLTextAreaElement)?.value,
      buyerName: (document.getElementById('inv-buyer-name') as HTMLInputElement)?.value,
      buyerGstin: (document.getElementById('inv-buyer-gstin') as HTMLInputElement)?.value,
      buyerAddr: (document.getElementById('inv-buyer-address') as HTMLTextAreaElement)?.value,
      invNum: (document.getElementById('inv-number') as HTMLInputElement)?.value,
      invDate: (document.getElementById('inv-date') as HTMLInputElement)?.value,
      dueDate: (document.getElementById('inv-due-date') as HTMLInputElement)?.value,
      supplyType: (document.getElementById('inv-supply-type') as HTMLSelectElement)?.value,
      shipping: (document.getElementById('inv-shipping') as HTMLInputElement)?.value,
      shippingGst: (document.getElementById('inv-shipping-gst') as HTMLSelectElement)?.value,
      notes: (document.getElementById('inv-notes') as HTMLTextAreaElement)?.value,
    };
    localStorage.setItem('gst_invoice_draft', JSON.stringify(data));
    showToast('✓ Draft saved to browser!');
  });

  document.getElementById('inv-reset-btn')?.addEventListener('click', () => {
    if (confirm('Start a new invoice? Unsaved changes will be lost.')) initDefault();
  });

  // Load draft if exists
  function loadDraft() {
    try {
      const saved = localStorage.getItem('gst_invoice_draft');
      if (!saved) return initDefault();
      const data = JSON.parse(saved);
      (document.getElementById('inv-seller-name') as HTMLInputElement).value = data.sellerName || '';
      (document.getElementById('inv-seller-gstin') as HTMLInputElement).value = data.sellerGstin || '';
      (document.getElementById('inv-seller-address') as HTMLTextAreaElement).value = data.sellerAddr || '';
      (document.getElementById('inv-buyer-name') as HTMLInputElement).value = data.buyerName || '';
      (document.getElementById('inv-buyer-gstin') as HTMLInputElement).value = data.buyerGstin || '';
      (document.getElementById('inv-buyer-address') as HTMLTextAreaElement).value = data.buyerAddr || '';
      (document.getElementById('inv-number') as HTMLInputElement).value = data.invNum || '';
      (document.getElementById('inv-date') as HTMLInputElement).value = data.invDate || '';
      (document.getElementById('inv-due-date') as HTMLInputElement).value = data.dueDate || '';
      (document.getElementById('inv-supply-type') as HTMLSelectElement).value = data.supplyType || 'intrastate';
      (document.getElementById('inv-shipping') as HTMLInputElement).value = data.shipping || '0';
      (document.getElementById('inv-shipping-gst') as HTMLSelectElement).value = data.shippingGst || '18';
      (document.getElementById('inv-notes') as HTMLTextAreaElement).value = data.notes || '';
      items = []; nextId = 1; tbody.innerHTML = '';
      (data.items || []).forEach((item: LineItem) => {
        item.id = nextId++;
        items.push(item);
        tbody.appendChild(renderRow(item));
      });
      if (items.length === 0) { addItem(); addItem(); }
      updateSummary();
    } catch { initDefault(); }
  }

  loadDraft();
</script>
