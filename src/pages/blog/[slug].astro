---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Article from '../../components/Article.astro';
import FAQ from '../../components/FAQ.astro';
import { tools } from '../../utils/tools';

// CA & Advocate profiles mapping for author details
const AUTHORS: Record<string, { name: string; designation: string; bio: string }> = {
  "CA Amit Sharma": {
    name: "CA Amit Sharma",
    designation: "Chartered Accountant & Indirect Tax Advisor",
    bio: "CA Amit Sharma is a seasoned Chartered Accountant with over 12 years of experience in GST advisory, corporate audits, and tax planning. He specializes in Input Tax Credit optimizations and structuring B2B transactions for SMEs."
  },
  "CA Neha Patel": {
    name: "CA Neha Patel",
    designation: "Chartered Accountant & Compliance Expert",
    bio: "CA Neha Patel holds a Master's in Finance and has guided over 500 startups and small businesses through GST registrations, GSTR-1 & 3B compliance, and composition scheme conversions."
  },
  "Advocate Raj Malhotra": {
    name: "Advocate Raj Malhotra",
    designation: "Senior GST Litigation Advocate",
    bio: "Advocate Raj Malhotra practices before various High Courts and GST Appellate Tribunals. With a decade of litigation experience, he represents clients in complex tax assessment disputes, audits, and refund claims."
  }
};

export async function getStaticPaths() {
  const posts = import.meta.glob('../../content/blog/*.md', { eager: true });
  return Object.values(posts).map((post: any) => ({
    params: { slug: post.frontmatter.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = post;
const headings = post.getHeadings();

// Dynamic SEO and Schemas
const articleUrl = `https://gstcalculatoronline.in/blog/${post.frontmatter.slug}`;
const enrichedSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.frontmatter.metaTitle || post.frontmatter.title,
  "description": post.frontmatter.metaDescription || post.frontmatter.description,
  "datePublished": post.frontmatter.date,
  "dateModified": post.frontmatter.lastUpdated || post.frontmatter.date,
  "author": {
    "@type": "Person",
    "name": post.frontmatter.author
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": articleUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "GST Calculator Online",
    "logo": {
      "@type": "ImageObject",
      "url": "https://gstcalculatoronline.in/favicon.png"
    }
  },
  "image": "https://gstcalculatoronline.in/og-image.png"
};

const authorDetails = AUTHORS[post.frontmatter.author] || null;

// Fetch all posts for dynamic links
const posts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true })) as any[];

// Get latest 4 posts (excluding current post)
const latestPosts = posts
  .filter((p: any) => p.frontmatter.slug !== post.frontmatter.slug)
  .map((p: any) => ({
    title: p.frontmatter.title,
    slug: p.frontmatter.slug,
    date: p.frontmatter.date,
    readTime: p.frontmatter.readTime,
    category: p.frontmatter.category || 'Guides'
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 4);

// Dynamic Related Calculators: Use frontmatter definition or fallback to category-relevant ones
let relatedCalculators = post.frontmatter.relatedCalculators || [];
if (relatedCalculators.length === 0) {
  const blogCategory = post.frontmatter.category || '';
  let targetCalcCategory: 'tax-slabs' | 'late-fees' | 'interest-penalties' | 'composition-scheme' = 'tax-slabs';
  if (blogCategory.includes('Compliance') || blogCategory.includes('Audit')) {
    targetCalcCategory = 'late-fees';
  } else if (blogCategory.includes('Credit') || blogCategory.includes('Refund')) {
    targetCalcCategory = 'interest-penalties';
  } else if (blogCategory.includes('Business')) {
    targetCalcCategory = 'composition-scheme';
  }

  relatedCalculators = tools
    .filter(t => t.category === targetCalcCategory)
    .slice(0, 3)
    .map(t => ({ name: t.name, url: t.url }));
}

// Dynamic Related Articles: Use frontmatter definition or fallback to category posts
let relatedArticles = post.frontmatter.relatedArticles || [];
if (relatedArticles.length === 0) {
  relatedArticles = posts
    .filter((p: any) => p.frontmatter.category === post.frontmatter.category && p.frontmatter.slug !== post.frontmatter.slug)
    .slice(0, 2)
    .map((p: any) => ({ title: p.frontmatter.title, slug: p.frontmatter.slug }));
}
if (relatedArticles.length < 2) {
  const existingSlugs = relatedArticles.map((a: any) => a.slug);
  const fallbacks = posts
    .filter((p: any) => p.frontmatter.slug !== post.frontmatter.slug && !existingSlugs.includes(p.frontmatter.slug) && p.frontmatter.category === 'GST Basics')
    .slice(0, 2 - relatedArticles.length)
    .map((p: any) => ({ title: p.frontmatter.title, slug: p.frontmatter.slug }));
  relatedArticles = [...relatedArticles, ...fallbacks];
}
---
<Layout 
  seo={{ 
    title: post.frontmatter.metaTitle || post.frontmatter.title, 
    description: post.frontmatter.metaDescription || post.frontmatter.description,
    ogType: 'article'
  }} 
  schema={enrichedSchema}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
      <!-- Main Content Column (8 Cols) -->
      <main class="lg:col-span-8">
        <Article 
          title={post.frontmatter.title} 
          date={post.frontmatter.date} 
          author={post.frontmatter.author} 
          readTime={post.frontmatter.readTime}
          description={post.frontmatter.metaDescription}
        >
          <!-- Table of Contents for Mobile screens (Collapsible / hidden on large desktops) -->
          <div class="block lg:hidden mb-8 rounded-2xl border border-hairline bg-canvas-soft p-5">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-ink mb-3">Table of Contents</h2>
            <nav class="space-y-1.5 text-sm">
              {headings.filter(h => h.depth === 2 || h.depth === 3).map((h) => (
                <a 
                  href={`#${h.slug}`} 
                  class="block text-primary hover:underline transition-colors leading-normal" 
                  class:list={[{ "pl-4 text-xs text-mute": h.depth === 3 }]}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>

          <!-- Main Markdown Article Body -->
          <Content />

          <!-- FAQ Accordion section -->
          {post.frontmatter.faqs && post.frontmatter.faqs.length > 0 && (
            <FAQ items={post.frontmatter.faqs} />
          )}

          <!-- Author Bio section -->
          {authorDetails && (
            <section class="mt-12 rounded-2xl border border-hairline bg-canvas-soft p-6 flex flex-col sm:flex-row gap-4 items-start no-print">
              <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-lg border border-hairline shrink-0 font-mono">
                {authorDetails.name.split(' ').map((n) => n[0]).join('')}
              </div>
              <div>
                <div class="text-sm font-semibold text-ink">{authorDetails.name}</div>
                <div class="text-xs text-mute font-mono">{authorDetails.designation}</div>
                <p class="text-xs text-body mt-2 leading-relaxed">{authorDetails.bio}</p>
              </div>
            </section>
          )}

          <!-- Related Guides section -->
          {relatedArticles.length > 0 && (
            <section class="mt-12 border-t border-hairline pt-8 no-print">
              <h3 class="text-lg font-bold text-ink mb-4">Related Reading</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {relatedArticles.map((art: any) => (
                  <a 
                    href={`/blog/${art.slug}`} 
                    class="block p-4 rounded-xl border border-hairline bg-canvas hover:border-hairline-strong hover:bg-canvas-soft hover:shadow-xs transition-all group"
                  >
                    <span class="text-xs font-semibold text-primary font-mono uppercase tracking-wider">Guide</span>
                    <h4 class="text-sm font-semibold text-ink group-hover:text-primary mt-1 line-clamp-2">{art.title}</h4>
                  </a>
                ))}
              </div>
            </section>
          )}
        </Article>
      </main>

      <!-- Sidebar Widget Column (4 Cols) - Sticky for Desktop -->
      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24 self-start no-print">
        <!-- Table of Contents Desktop Widget -->
        {headings && headings.length > 0 && (
          <div class="hidden lg:block rounded-2xl border border-hairline bg-canvas p-5 shadow-xs">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-ink mb-4 pb-2 border-b border-hairline">Table of Contents</h2>
            <nav class="space-y-2 text-sm max-h-[300px] overflow-y-auto pr-1">
              {headings.filter(h => h.depth === 2 || h.depth === 3).map((h) => (
                <a 
                  href={`#${h.slug}`} 
                  class="block text-mute hover:text-primary hover:underline transition-colors leading-relaxed" 
                  class:list={[{ "pl-4 text-xs": h.depth === 3, "font-medium text-body": h.depth === 2 }]}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        )}

        <!-- Recommended Calculators Widget -->
        {relatedCalculators.length > 0 && (
          <div class="rounded-2xl border border-hairline bg-canvas p-5 shadow-xs">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-ink mb-4 pb-2 border-b border-hairline">Recommended Calculators</h2>
            <div class="space-y-3">
              {relatedCalculators.map((calc: any) => (
                <a 
                  href={calc.url} 
                  class="flex items-center justify-between p-3 rounded-xl border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas-soft-2 hover:shadow-xs transition-all group"
                >
                  <div class="shrink">
                    <span class="text-xs font-semibold text-ink group-hover:text-primary transition-colors block">{calc.name}</span>
                    <span class="text-[10px] text-mute font-mono">Free Online Tool</span>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5 text-mute group-hover:text-primary group-hover:translate-x-0.5 transition-all">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Latest Articles Widget -->
        {latestPosts.length > 0 && (
          <div class="rounded-2xl border border-hairline bg-canvas p-5 shadow-xs">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-ink mb-4 pb-2 border-b border-hairline">Recent Tax Guides</h2>
            <div class="space-y-3">
              {latestPosts.map((p: any) => (
                <a 
                  href={`/blog/${p.slug}`}
                  class="block p-3 rounded-xl border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas-soft-2 hover:shadow-xs transition-all group"
                >
                  <span class="text-[9px] font-semibold text-primary font-mono uppercase tracking-wider">{p.category}</span>
                  <h3 class="text-xs font-semibold text-ink group-hover:text-primary transition-colors mt-1 line-clamp-1 leading-snug">{p.title}</h3>
                </a>
              ))}
            </div>
          </div>
        )}


      </aside>
    </div>
  </div>
</Layout>
