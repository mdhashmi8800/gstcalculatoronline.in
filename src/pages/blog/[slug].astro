---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Article from '../../components/Article.astro';
import FAQ from '../../components/FAQ.astro';
import AdUnit from '../../components/AdUnit.astro';
import { render } from 'astro:content';
import { getAllPosts, getPost, formatDate } from '../../lib/blog';
import { tools } from '../../utils/tools';

const AUTHORS: Record<string, { name: string; designation: string; bio: string }> = {
  "Hashmi Akbar": {
    name: "Hashmi Akbar",
    designation: "Senior GST & Indirect Tax Specialist",
    bio: "Hashmi Akbar is a seasoned tax advisor with extensive experience in GST advisory, corporate audits, and tax planning. He specializes in Input Tax Credit optimizations and structuring B2B transactions for SMEs."
  },
  "Anjum Mina": {
    name: "Anjum Mina",
    designation: "GST Compliance & Financial Advisor",
    bio: "Anjum Mina holds a Master's in Finance and has guided over 500 startups and small businesses through GST registrations, GSTR-1 & 3B compliance, and composition scheme conversions."
  },
  "Mehakma": {
    name: "Mehakma",
    designation: "GST Legal & Policy Analyst",
    bio: "Mehakma practices before tax regulatory bodies and Appellate Tribunals. With years of experience, she represents clients in complex tax assessment disputes, audits, and refund claims."
  }
};

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  return allPosts.map((post) => ({
    params: { slug: post.slug },
    props: { postId: post.slug }
  }));
}

const { postId } = Astro.props;
const post = await getPost(postId);
const allPosts = await getAllPosts();

if (!post) {
  return Astro.redirect('/404', 404);
}

const { Content, headings } = await render(post.entry);

const articleUrl = `https://gstcalculatoronline.in/blog/${post.slug}`;

function buildSeoTitle(raw: string): string {
  const brand = ' | GST Calculator Online';
  if (raw.includes('GST Calculator Online')) return raw;
  return `${raw}${brand}`;
}

const enrichedSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.metaTitle || post.title,
  "description": post.metaDescription || post.description || post.excerpt,
  "datePublished": post.date,
  "dateModified": post.modified,
  "author": {
    "@type": "Person",
    "name": post.author
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": articleUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "GST Calculator Online",
    "logo": {
      "@type": "ImageObject",
      "url": "https://gstcalculatoronline.in/favicon.png"
    }
  },
  "image": "https://gstcalculatoronline.in/og-image.jpg"
};

const authorDetails = AUTHORS[post.author] || null;

const latestPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 4);

let relatedCalculators = post.relatedCalculators || [];
if (relatedCalculators.length === 0) {
  const blogCategory = post.category || '';
  let targetCalcCategory: 'tax-slabs' | 'late-fees' | 'interest-penalties' | 'composition-scheme' = 'tax-slabs';
  if (blogCategory.includes('Compliance') || blogCategory.includes('Audit')) {
    targetCalcCategory = 'late-fees';
  } else if (blogCategory.includes('Credit') || blogCategory.includes('Refund')) {
    targetCalcCategory = 'interest-penalties';
  } else if (blogCategory.includes('Business')) {
    targetCalcCategory = 'composition-scheme';
  }

  relatedCalculators = tools
    .filter(t => t.category === targetCalcCategory)
    .slice(0, 3)
    .map(t => ({ name: t.name, url: t.url }));
}

let relatedArticles = post.relatedArticles || [];
if (relatedArticles.length === 0) {
  relatedArticles = allPosts
    .filter((p) => p.category === post.category && p.slug !== post.slug)
    .slice(0, 2)
    .map((p) => ({ title: p.title, slug: p.slug }));
}
if (relatedArticles.length < 2) {
  const existingSlugs = relatedArticles.map((a) => a.slug);
  const fallbacks = allPosts
    .filter((p) => p.slug !== post.slug && !existingSlugs.includes(p.slug) && p.category === 'GST Basics')
    .slice(0, 2 - relatedArticles.length)
    .map((p) => ({ title: p.title, slug: p.slug }));
  relatedArticles = [...relatedArticles, ...fallbacks];
}

const pageSchemas: Record<string, any>[] = [enrichedSchema];

if (post.faqs && post.faqs.length > 0) {
  pageSchemas.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "inLanguage": "en-IN",
    "mainEntity": post.faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer.replace(/<[^>]*>/g, '')
      }
    }))
  });
}
---

<Layout
  seo={{
    title: buildSeoTitle(post.metaTitle || post.title),
    description: post.metaDescription || post.description || post.excerpt,
    ogType: 'article',
    author: post.author
  }}
  schemas={pageSchemas}
  publishedTime={post.date}
  modifiedTime={post.modified}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
      <main class="lg:col-span-8">
        <Article
          title={post.title}
          date={formatDate(post.date)}
          author={post.author}
          readTime={post.readTime}
          description={post.metaDescription}
        >
          {headings && headings.length > 0 && (
            <div class="block lg:hidden mb-8 rounded-2xl border border-hairline bg-canvas-soft p-5">
              <h2 class="text-sm font-semibold uppercase tracking-wider text-ink mb-3">Table of Contents</h2>
              <nav class="space-y-1.5 text-sm">
                {headings.filter(h => h.depth === 2 || h.depth === 3).map((h) => (
                  <a
                    href={`#${h.slug}`}
                    class="block text-primary hover:underline transition-colors leading-normal"
                    class:list={[{ "pl-4 text-xs text-mute": h.depth === 3 }]}
                  >
                    {h.text}
                  </a>
                ))}
              </nav>
            </div>
          )}

          <Content />

          <AdUnit class="my-8" />

          {post.faqs && post.faqs.length > 0 && (
            <FAQ items={post.faqs} />
          )}

          {authorDetails && (
            <section class="mt-12 rounded-2xl border border-hairline bg-canvas-soft p-6 flex flex-col sm:flex-row gap-4 items-start no-print">
              <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-lg border border-hairline shrink-0 font-mono">
                {authorDetails.name.split(' ').map((n) => n[0]).join('')}
              </div>
              <div>
                <div class="text-sm font-semibold text-ink">{authorDetails.name}</div>
                <div class="text-xs text-mute font-mono">{authorDetails.designation}</div>
                <p class="text-xs text-body mt-2 leading-relaxed">{authorDetails.bio}</p>
              </div>
            </section>
          )}

          {relatedArticles.length > 0 && (
            <section class="mt-12 border-t border-hairline pt-8 no-print">
              <h3 class="text-lg font-bold text-ink mb-4">Related Reading</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {relatedArticles.map((art) => (
                  <a
                    href={`/blog/${art.slug}`}
                    class="block p-4 rounded-xl border border-hairline bg-canvas hover:border-hairline-strong hover:bg-canvas-soft hover:shadow-xs transition-all group"
                  >
                    <span class="text-xs font-semibold text-primary font-mono uppercase tracking-wider">Guide</span>
                    <h4 class="text-sm font-semibold text-ink group-hover:text-primary mt-1 line-clamp-2">{art.title}</h4>
                  </a>
                ))}
              </div>
            </section>
          )}
        </Article>
      </main>

      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24 self-start no-print">
        {headings && headings.length > 0 && (
          <div class="hidden lg:block rounded-2xl border border-hairline bg-canvas p-5 shadow-xs">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-ink mb-4 pb-2 border-b border-hairline">Table of Contents</h2>
            <nav class="space-y-2 text-sm max-h-[300px] overflow-y-auto pr-1">
              {headings.filter(h => h.depth === 2 || h.depth === 3).map((h) => (
                <a
                  href={`#${h.slug}`}
                  class="block text-mute hover:text-primary hover:underline transition-colors leading-relaxed"
                  class:list={[{ "pl-4 text-xs": h.depth === 3, "font-medium text-body": h.depth === 2 }]}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        )}

        {relatedCalculators.length > 0 && (
          <div class="rounded-2xl border border-hairline bg-canvas p-5 shadow-xs">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-ink mb-4 pb-2 border-b border-hairline">Recommended Calculators</h2>
            <div class="space-y-3">
              {relatedCalculators.map((calc) => (
                <a
                  href={calc.url}
                  class="flex items-center justify-between p-3 rounded-xl border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas-soft-2 hover:shadow-xs transition-all group"
                >
                  <div class="shrink">
                    <span class="text-xs font-semibold text-ink group-hover:text-primary transition-colors block">{calc.name}</span>
                    <span class="text-[10px] text-mute font-mono">Free Online Tool</span>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5 text-mute group-hover:text-primary group-hover:translate-x-0.5 transition-all">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        )}

        {latestPosts.length > 0 && (
          <div class="rounded-2xl border border-hairline bg-canvas p-5 shadow-xs">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-ink mb-4 pb-2 border-b border-hairline">Recent Tax Guides</h2>
            <div class="space-y-3">
              {latestPosts.map((p) => (
                <a
                  href={`/blog/${p.slug}`}
                  class="block p-3 rounded-xl border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas-soft-2 hover:shadow-xs transition-all group"
                >
                  <span class="text-[9px] font-semibold text-primary font-mono uppercase tracking-wider">{p.category}</span>
                  <h3 class="text-xs font-semibold text-ink group-hover:text-primary transition-colors mt-1 line-clamp-1 leading-snug">{p.title}</h3>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </div>
</Layout>
