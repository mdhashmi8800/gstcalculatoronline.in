---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const now = Date.now();
  const publishedPosts = allPosts.filter(p => {
    if (import.meta.env.DEV) return true;
    if (p.data.draft) return false;
    if (p.data.date && new Date(p.data.date).getTime() > now) return false;
    return true;
  });

  const slugify = (text: string) => text.toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/[^\w\-]+/g, '')
    .replace(/\-\-+/g, '-')
    .replace(/^-+/, '')
    .replace(/-+$/, '');

  const categoriesMap = new Map<string, string>();
  publishedPosts.forEach((post) => {
    const name = post.data.category || 'General';
    const slug = slugify(name);
    if (!categoriesMap.has(slug)) {
      categoriesMap.set(slug, name);
    }
  });

  return Array.from(categoriesMap.entries()).map(([slug, name]) => ({
    params: { category: slug },
    props: { categoryName: name, allPosts: publishedPosts }
  }));
}

const { category } = Astro.params;
const { categoryName, allPosts } = Astro.props;

const slugify = (text: string) => text.toLowerCase()
  .replace(/\s+/g, '-')
  .replace(/[^\w\-]+/g, '')
  .replace(/\-\-+/g, '-')
  .replace(/^-+/, '')
  .replace(/-+$/, '');

const filteredPosts = allPosts
  .filter((post) => slugify(post.data.category || 'General') === category)
  .map((post) => ({
    title: post.data.title,
    slug: post.data.slug || post.slug,
    date: post.data.date,
    author: post.data.author,
    readTime: post.data.readTime,
    desc: post.data.metaDescription || post.data.description || post.data.title
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---
<Layout 
  seo={{ 
    title: `${categoryName} GST Guides & Tax Articles | GST Calculator Online`, 
    description: `Explore all expert GST articles, guides, and tax filing resources under ${categoryName}. Verified by CAs and legal advisors.` 
  }}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs />

    <header class="mb-10 text-center mt-4">
      <div class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-mono font-semibold text-primary mb-3">
        Category Archives
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{categoryName}</h1>
      <p class="mt-2 text-base text-body max-w-2xl mx-auto">
        Showing {filteredPosts.length} expert guides under {categoryName}.
      </p>
    </header>

    <main class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {filteredPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="flex flex-col justify-between overflow-hidden rounded-xl border border-hairline bg-canvas p-6 hover:border-hairline-strong hover:shadow-md hover:bg-canvas-soft transition-all duration-200 group cursor-pointer"
          >
            <div>
              <div class="flex items-center justify-between gap-2 text-xs font-mono text-mute mb-3">
                <span class="text-primary font-semibold">{categoryName}</span>
                <span>{post.readTime}</span>
              </div>
              <h2 class="text-base font-semibold text-ink group-hover:text-link transition-colors line-clamp-2 leading-snug">
                {post.title}
              </h2>
              <p class="mt-2 text-sm text-body leading-relaxed line-clamp-3">
                {post.desc}
              </p>
            </div>
            <div class="mt-5 border-t border-hairline pt-4 flex items-center justify-between">
              <span class="text-xs font-medium text-ink font-mono">{post.author}</span>
              <span class="text-xs font-semibold text-link group-hover:text-brand-link-deep transition-colors inline-flex items-center gap-0.5">
                Read Guide
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </main>
  </div>
</Layout>
