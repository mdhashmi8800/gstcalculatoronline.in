---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AdSense from '../../../components/AdSense.astro';

export async function getStaticPaths() {
  const posts = Object.values(import.meta.glob('../../../content/blog/*.md', { eager: true })) as any[];
  
  const slugify = (text: string) => text.toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/[^\w\-]+/g, '')
    .replace(/\-\-+/g, '-')
    .replace(/^-+/, '')
    .replace(/-+$/, '');

  const categoriesMap = new Map<string, string>();
  posts.forEach((post) => {
    const name = post.frontmatter.category || 'General';
    const slug = slugify(name);
    if (!categoriesMap.has(slug)) {
      categoriesMap.set(slug, name);
    }
  });

  return Array.from(categoriesMap.entries()).map(([slug, name]) => ({
    params: { category: slug },
    props: { categoryName: name }
  }));
}

const { category } = Astro.params;
const { categoryName } = Astro.props;

// Fetch all posts and filter by current category
const posts = Object.values(import.meta.glob('../../../content/blog/*.md', { eager: true })) as any[];
const slugify = (text: string) => text.toLowerCase()
  .replace(/\s+/g, '-')
  .replace(/[^\w\-]+/g, '')
  .replace(/\-\-+/g, '-')
  .replace(/^-+/, '')
  .replace(/-+$/, '');

const filteredPosts = posts
  .filter((post) => slugify(post.frontmatter.category || 'General') === category)
  .map((post) => ({
    title: post.frontmatter.title,
    slug: post.frontmatter.slug,
    date: post.frontmatter.date,
    author: post.frontmatter.author,
    readTime: post.frontmatter.readTime,
    desc: post.frontmatter.metaDescription || post.frontmatter.description
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<Layout seo={{ title: `${categoryName} Guides - GST Calculator Blog`, description: `Browse educational guides and tax updates on ${categoryName}. Written by Indian indirect tax practitioners and compliance advisors.` }}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs />

    <header class="mb-12 text-center sm:text-left mt-6">
      <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary font-mono uppercase tracking-wider mb-3">
        Blog Category
      </span>
      <h1 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{categoryName} Insights</h1>
      <p class="mt-3 text-base text-body max-w-2xl">Educational resources, filing tutorials, and rule explanations covering {categoryName} in India.</p>
    </header>

    <AdSense type="below-hero" className="mb-8" />

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Blog Posts list (8 cols) -->
      <main class="lg:col-span-8">
        <div class="space-y-6">
          {filteredPosts.map((post) => (
            <a 
              href={`/blog/${post.slug}`} 
              class="block overflow-hidden rounded-2xl border border-hairline bg-canvas-soft p-6 hover:border-hairline-strong hover:shadow-xs transition-all group cursor-pointer"
            >
              <div class="flex items-center gap-2 text-xs font-mono text-mute">
                <span>{formatDate(post.date)}</span>
                <span>&bull;</span>
                <span>{post.readTime}</span>
              </div>
              <h2 class="mt-3 text-lg font-bold text-ink group-hover:text-primary transition-colors leading-snug">
                {post.title}
              </h2>
              <p class="mt-2 text-sm text-body leading-relaxed line-clamp-2">
                {post.desc}
              </p>
              <div class="mt-4 pt-4 border-t border-hairline flex items-center justify-between">
                <span class="text-xs text-ink font-semibold font-mono">{post.author}</span>
                <span class="text-xs font-semibold text-primary inline-flex items-center gap-1 group-hover:underline">
                  Read Guide
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </main>

      <!-- Sidebar widgets (4 cols) -->
      <aside class="lg:col-span-4 space-y-6">
        <!-- Explorer chips widget -->
        <div class="rounded-2xl border border-hairline bg-canvas-soft p-6 shadow-xs">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-ink pb-3 border-b border-hairline mb-4">Other Topics</h3>
          <div class="flex flex-wrap gap-2">
            {Array.from(new Set(posts.map(p => p.frontmatter.category || 'General'))).map((catName) => {
              const catSlug = slugify(catName);
              const isActive = catSlug === category;
              return (
                <a 
                  href={`/blog/category/${catSlug}`}
                  class="rounded-full px-3 py-1 text-xs font-semibold border transition-all select-none"
                  class:list={[
                    isActive 
                      ? "bg-primary border-primary text-on-primary shadow-xs" 
                      : "bg-canvas border-hairline text-body hover:bg-canvas-soft-2 hover:text-ink"
                  ]}
                >
                  {catName}
                </a>
              );
            })}
          </div>
        </div>

        <!-- AdSense Sidebar Banner -->
        <AdSense type="sidebar-desktop" />
      </aside>
    </div>

    <AdSense type="before-footer" className="mt-12" />
  </div>
</Layout>
