---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getAllPosts, formatDateShort } from '../../../lib/blog';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  const slugs = new Set(allPosts.map(p => p.category.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]+/g, '')));
  return Array.from(slugs).map(slug => ({
    params: { category: slug },
    props: { allPosts }
  }));
}

const { category } = Astro.params;
const { allPosts } = Astro.props;

const filteredPosts = allPosts
  .filter((post) => {
    const catSlug = post.category.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]+/g, '');
    return catSlug === category;
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

function categoryDisplayName(slug: string) {
  return slug
    .split('-')
    .map(word => word.toUpperCase() === 'GST' ? 'GST' : word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}
---

<Layout
  seo={{
    title: `${categoryDisplayName(category!)} Guides – GST Tax Articles`,
    description: `Explore expert ${categoryDisplayName(category!)} GST articles, guides, and tax filing resources. Verified by CAs and legal advisors.`
  }}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs />

    <header class="mb-10 text-center mt-4">
      <div class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-mono font-semibold text-primary mb-3">
        Category Archives
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">GST {categoryDisplayName(category!)} Guides</h1>
      <p class="mt-2 text-base text-body max-w-2xl mx-auto">
        Showing {filteredPosts.length} expert guides.
      </p>
    </header>

    <main class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {filteredPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="flex flex-col justify-between overflow-hidden rounded-xl border border-hairline bg-canvas p-6 hover:border-hairline-strong hover:shadow-md hover:bg-canvas-soft transition-all duration-200 group cursor-pointer"
          >
            <div>
              <div class="flex items-center justify-between gap-2 text-xs font-mono text-mute mb-3">
                <span class="text-primary font-semibold">{post.category}</span>
                <span>{formatDateShort(post.date)}</span>
              </div>
              <h2 class="text-base font-semibold text-ink group-hover:text-link transition-colors line-clamp-2 leading-snug">
                {post.title}
              </h2>
              <p class="mt-2 text-sm text-body leading-relaxed line-clamp-3">
                {post.excerpt}
              </p>
            </div>
            <div class="mt-5 border-t border-hairline pt-4 flex items-center justify-between">
              <span class="text-xs font-medium text-ink font-mono">{post.author}</span>
              <span class="text-xs font-semibold text-link group-hover:text-brand-link-deep transition-colors inline-flex items-center gap-0.5">
                Read Guide
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </main>
  </div>
</Layout>
