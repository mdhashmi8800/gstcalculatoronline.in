---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPosts, formatDateShort } from '../../lib/wordpress';

const { posts, total, totalPages } = await getPosts(1, 9);

const pageTitle = "GST Tax Blog & Filing Guides – India's Expert GST Knowledge Hub";
const pageDesc = "Read current articles and educational guides about GST regulations in India, tax slabs, GSTR filings, late fee capping rules, interest rates, and compliance updates. Written by Chartered Accountants and GST advocates.";
---

<Layout seo={{ title: pageTitle, description: pageDesc }}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs />

    <header class="mb-8 text-center mt-4">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">GST Insights & Tax Guides</h1>
      <p class="mt-2 text-base text-body max-w-2xl mx-auto">Expert GST articles written by Chartered Accountants. Stay updated with regulations, return checklists, and compliance tips.</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <main class="lg:col-span-8">
        {posts.length === 0 ? (
          <div class="text-center py-16">
            <p class="text-body text-lg">No articles published yet. Check back soon.</p>
          </div>
        ) : (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {posts.map((post) => (
                <a
                  href={`/blog/${post.slug}`}
                  class="flex flex-col justify-between overflow-hidden rounded-xl border border-hairline bg-canvas hover:border-hairline-strong hover:shadow-md hover:bg-canvas-soft transition-all duration-200 group cursor-pointer"
                >
                  {post.featuredImage && (
                    <div class="relative h-40 overflow-hidden -mx-px -mt-px rounded-t-xl">
                      <img
                        src={post.featuredImage}
                        alt={post.featuredImageAlt || post.title}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div class="flex flex-col justify-between flex-1 p-6">
                    <div>
                      <div class="flex items-center justify-between gap-2 text-xs font-mono text-mute mb-3">
                        <span class="text-primary font-semibold">{post.categories[0]}</span>
                        <span>{formatDateShort(post.date)}</span>
                      </div>
                      <h2 class="text-base font-semibold text-ink group-hover:text-link transition-colors line-clamp-2 leading-snug">
                        {post.title}
                      </h2>
                      <p class="mt-2 text-sm text-body leading-relaxed line-clamp-3">
                        {post.excerpt}
                      </p>
                    </div>
                    <div class="mt-5 border-t border-hairline pt-4 flex items-center justify-between">
                      <span class="text-xs font-medium text-ink font-mono">{post.author}</span>
                      <span class="text-xs font-semibold text-link group-hover:text-brand-link-deep transition-colors inline-flex items-center gap-0.5">
                        Read Guide
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              ))}
            </div>

            {totalPages > 1 && (
              <nav class="mt-10 flex items-center justify-center gap-2">
                {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                  <a
                    href={p === 1 ? '/blog' : `/blog/page/${p}`}
                    class={`inline-flex h-9 w-9 items-center justify-center rounded-xl text-sm font-semibold transition-colors ${
                      p === 1
                        ? 'bg-primary text-on-primary'
                        : 'border border-hairline bg-canvas text-ink hover:bg-canvas-soft'
                    }`}
                  >
                    {p}
                  </a>
                ))}
                {totalPages > 1 && (
                  <a
                    href="/blog/page/2"
                    class="inline-flex items-center gap-1 rounded-xl border border-hairline bg-canvas px-4 py-2 text-sm font-semibold text-ink hover:bg-canvas-soft transition-colors"
                  >
                    Next
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-4 w-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                    </svg>
                  </a>
                )}
              </nav>
            )}
          </>
        )}
      </main>

      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-2xl border border-hairline bg-canvas p-5 shadow-xs">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-ink mb-4 pb-2 border-b border-hairline">Free GST Calculators</h2>
          <div class="space-y-2">
            {[
              { name: 'GST Calculator', url: '/gst-calculator' },
              { name: 'Late Fee Calculator', url: '/late-fee-calculator' },
              { name: 'Interest Calculator', url: '/interest-calculator' },
              { name: 'Reverse GST Calculator', url: '/reverse-gst-calculator' },
              { name: 'Composition Scheme', url: '/composition-calculator' },
              { name: 'Invoice Builder', url: '/invoice-builder' },
            ].map(tool => (
              <a
                href={tool.url}
                class="flex items-center justify-between p-3 rounded-xl border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas-soft-2 hover:shadow-xs transition-all group"
              >
                <span class="text-xs font-semibold text-ink group-hover:text-primary transition-colors">{tool.name}</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5 text-mute group-hover:text-primary transition-colors">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </a>
            ))}
          </div>
          <div class="mt-4 pt-4 border-t border-hairline">
            <a href="/" class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1">
              View all 25+ tools
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3 w-3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>

        <div class="rounded-2xl border border-hairline bg-canvas p-5 shadow-xs">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-ink mb-4 pb-2 border-b border-hairline">Browse by Topic</h2>
          <div class="space-y-2">
            {['GST Calculator'].map(cat => (
              <a
                href="/blog/category/gst-calculator"
                class="flex items-center justify-between p-2.5 rounded-xl hover:bg-canvas-soft transition-all group"
              >
                <span class="text-sm font-medium text-body group-hover:text-primary transition-colors">{cat}</span>
                <span class="text-xs text-mute font-mono">{total} guides</span>
              </a>
            ))}
          </div>
        </div>

        <div class="rounded-2xl border border-hairline bg-canvas-soft p-5">
          <h2 class="text-sm font-semibold text-ink mb-2">About Our Guides</h2>
          <p class="text-xs text-body leading-relaxed">All articles are authored or reviewed by qualified CAs and GST advocates. We update content within 15 days of GST Council notifications.</p>
          <a href="/editorial-policy" class="text-xs text-primary hover:underline font-semibold mt-2 inline-block">Read our Editorial Policy →</a>
        </div>
      </aside>
    </div>
  </div>
</Layout>
