---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const pageTitle = "GST Tax Blog & Filing Guides";
const pageDesc = "Read current articles and educational guides about GST regulations in India, tax slabs, GSTR filings, late fee capping rules, and interest rates.";

// Mock Blog Posts
const blogPosts = [
  {
    title: "GST Rates in India: A Comprehensive Guide (2026)",
    slug: "understanding-gst-rates-in-india-2026",
    date: "June 25, 2026",
    author: "CA Amit Sharma",
    readTime: "6 min read",
    desc: "An in-depth review of the standard GST rates (5%, 12%, 18%, 28%), exempt categories, and state compensation cesses applied under current Indian tax slabs."
  },
  {
    title: "How to File GSTR-1: Step-by-Step Instructions",
    slug: "how-to-file-gstr-1-step-by-step",
    date: "May 14, 2026",
    author: "CA Neha Patel",
    readTime: "8 min read",
    desc: "A practical guide for business owners and accountants explaining how to report outward supplies, format B2B invoices, and upload sales records in GSTR-1."
  },
  {
    title: "Understanding GST Late Fees, Interest Rates, and Penalties",
    slug: "gst-late-fees-interest-rates-penalties",
    date: "March 02, 2026",
    author: "Advocate Raj Malhotra",
    readTime: "5 min read",
    desc: "A simple explanation of late fees for GSTR-3B delays, aggregate turnover capping thresholds, and Section 50 interest on cash-payment defaults."
  }
];
---
<Layout seo={{ title: pageTitle, description: pageDesc }}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs />

    <header class="mb-12 text-center">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">GST Insights & Tax Guides</h1>
      <p class="mt-2 text-base text-body max-w-2xl mx-auto">Stay updated with the latest regulations, return checklists, and compliance tips from Indian tax experts.</p>
    </header>

    <!-- AdSense Top Banner -->
    <div class="mb-8 rounded-lg border border-dashed border-hairline-strong bg-canvas-soft-2 p-2 text-center text-xs text-mute">
      Ad Placement (Blog Responsive Banner)
    </div>

    <!-- Blog Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {blogPosts.map((post) => (
        <a 
          href={`/blog/${post.slug}`} 
          class="flex flex-col justify-between overflow-hidden rounded-xl border border-hairline bg-canvas p-6 hover:border-hairline-strong hover:shadow-md hover:bg-canvas-soft transition-all duration-200 group cursor-pointer"
        >
          <div>
            <!-- Date & Read time -->
            <div class="flex items-center gap-2 text-xs font-mono text-mute">
              <span>{post.date}</span>
              <span>&bull;</span>
              <span>{post.readTime}</span>
            </div>
            
            <!-- Title -->
            <h2 class="mt-4 text-lg font-semibold text-ink group-hover:text-link transition-colors line-clamp-2">
              {post.title}
            </h2>
            
            <!-- Description -->
            <p class="mt-3 text-sm text-body leading-relaxed line-clamp-3">
              {post.desc}
            </p>
          </div>

          <!-- Footer Metadata -->
          <div class="mt-6 border-t border-hairline pt-4 flex items-center justify-between">
            <span class="text-xs font-medium text-ink font-mono">{post.author}</span>
            <span class="text-xs font-semibold text-link group-hover:text-brand-link-deep transition-colors inline-flex items-center gap-0.5">
              Read Guide
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3 w-3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
