---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const pageTitle = "Contact Us - GST Calculator Online";
const pageDesc = "Get in touch with the team at gstcalculatoronline.in. Submit feedback, suggest new tax calculators, or report calculation issues.";
---
<Layout seo={{ title: pageTitle, description: pageDesc }}>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs />

    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Contact Us</h1>
      <p class="mt-2 text-base text-body">Have suggestions or spotted a bug? Send us a message.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      <!-- Contact Info -->
      <div class="md:col-span-5 space-y-6">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-ink">Support Email</h2>
          <p class="mt-2 text-sm text-body">
            <a href="mailto:support@gstcalculatoronline.in" class="text-link hover:underline font-mono">support@gstcalculatoronline.in</a>
          </p>
        </div>

        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-ink">Operational Hours</h2>
          <p class="mt-2 text-sm text-body">
            Monday to Friday: 9:00 AM to 6:00 PM (IST)<br>
            We typically respond to inquiries within 24-48 business hours.
          </p>
        </div>

        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-ink">Feedback & Suggestions</h2>
          <p class="mt-2 text-xs text-mute">
            We are dedicated to building free tools for Indian CAs and taxpayers. If there's an interest rule, penalty structure, or filing check you want us to add, let us know!
          </p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="md:col-span-7 bg-canvas rounded-xl border border-hairline p-6 shadow-xs">
        <form id="contact-form" class="space-y-4">
          <!-- Name -->
          <div>
            <label for="form-name" class="block text-sm font-semibold text-ink">Full Name</label>
            <input 
              type="text" 
              name="name" 
              id="form-name" 
              required
              class="mt-1.5 block w-full rounded-lg border border-hairline bg-canvas py-2.5 px-3.5 text-sm text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary transition-all"
              placeholder="e.g. Rahul Sharma"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="form-email" class="block text-sm font-semibold text-ink">Email Address</label>
            <input 
              type="email" 
              name="email" 
              id="form-email" 
              required
              class="mt-1.5 block w-full rounded-lg border border-hairline bg-canvas py-2.5 px-3.5 text-sm text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary transition-all font-mono"
              placeholder="e.g. rahul@example.com"
            />
          </div>

          <!-- Subject -->
          <div>
            <label for="form-subject" class="block text-sm font-semibold text-ink">Subject</label>
            <input 
              type="text" 
              name="subject" 
              id="form-subject" 
              required
              class="mt-1.5 block w-full rounded-lg border border-hairline bg-canvas py-2.5 px-3.5 text-sm text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary transition-all"
              placeholder="e.g. Calculator suggestion / Report discrepancy"
            />
          </div>

          <!-- Message -->
          <div>
            <label for="form-message" class="block text-sm font-semibold text-ink">Message</label>
            <textarea 
              name="message" 
              id="form-message" 
              rows="4"
              required
              class="mt-1.5 block w-full rounded-lg border border-hairline bg-canvas py-2.5 px-3.5 text-sm text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary transition-all"
              placeholder="Write your message here..."
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit"
            class="w-full flex items-center justify-center rounded-lg bg-primary py-3 px-4 text-sm font-semibold text-on-primary hover:opacity-90 transition-all cursor-pointer"
          >
            Send Message
          </button>
        </form>

        <!-- Success Message -->
        <div id="form-success" class="hidden rounded-lg bg-brand-success/10 p-4 border border-brand-success/20 text-center text-sm font-semibold text-brand-success transition-all duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="mx-auto h-6 w-6 mb-2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          Thank you! Your message has been sent successfully. We will review your feedback shortly.
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const formSuccess = document.getElementById('form-success');

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    // Simulate successful form submission
    contactForm.classList.add('hidden');
    formSuccess?.classList.remove('hidden');
  });
</script>
