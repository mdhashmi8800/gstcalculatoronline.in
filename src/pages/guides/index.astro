---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const pageTitle = "GST Guides & Legal Manuals | GST Calculator Online";
const pageDesc = "In-depth GST compliance guides, e-invoicing threshold rules, return filing manuals, and tax procedures curated by experienced Chartered Accountants and Legal Counsel.";

const allGuides = await getCollection('guides');
const now = Date.now();

const publishedGuides = allGuides.filter(g => {
  if (import.meta.env.DEV) return true;
  if (g.data.draft) return false;
  if (g.data.date && new Date(g.data.date).getTime() > now) return false;
  return true;
});

const slugify = (text: string) => text.toLowerCase()
  .replace(/\s+/g, '-')
  .replace(/[^\w\-]+/g, '')
  .replace(/\-\-+/g, '-')
  .replace(/^-+/, '')
  .replace(/-+$/, '');

const guideList = publishedGuides.map(g => ({
  title: g.data.title,
  slug: g.data.slug || g.slug,
  date: g.data.date,
  author: g.data.author,
  readTime: g.data.readTime,
  category: g.data.category || 'Tax Compliance',
  desc: g.data.metaDescription || g.data.title
})).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const categories = Array.from(new Set(guideList.map(g => g.category)));
---
<Layout seo={{ title: pageTitle, description: pageDesc }}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs />

    <header class="mb-8 text-center mt-4">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">GST Knowledge Guides & Manuals</h1>
      <p class="mt-2 text-base text-body max-w-2xl mx-auto">Master GST regulations, e-invoicing compliance, and tax procedures with our step-by-step authoritative guides.</p>
    </header>

    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {guideList.map(guide => (
          <a
            href={`/guides/${guide.slug}`}
            class="flex flex-col justify-between overflow-hidden rounded-xl border border-hairline bg-canvas p-6 hover:border-hairline-strong hover:shadow-md hover:bg-canvas-soft transition-all duration-200 group cursor-pointer"
          >
            <div>
              <div class="flex items-center justify-between gap-2 text-xs font-mono text-mute mb-3">
                <span class="text-primary font-semibold">{guide.category}</span>
                <span>{guide.readTime}</span>
              </div>
              <h2 class="text-lg font-semibold text-ink group-hover:text-link transition-colors line-clamp-2 leading-snug">
                {guide.title}
              </h2>
              <p class="mt-2 text-sm text-body leading-relaxed line-clamp-3">
                {guide.desc}
              </p>
            </div>
            <div class="mt-5 border-t border-hairline pt-4 flex items-center justify-between">
              <span class="text-xs font-medium text-ink font-mono">{guide.author}</span>
              <span class="text-xs font-semibold text-link group-hover:text-brand-link-deep transition-colors inline-flex items-center gap-0.5">
                Read Full Guide
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
