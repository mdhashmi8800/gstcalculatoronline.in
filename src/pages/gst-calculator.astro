---
import CalculatorLayout from '../components/CalculatorLayout.astro';
import ResultCard from '../components/ResultCard.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "GST Calculator Online – Add or Remove GST (CGST, SGST, IGST)";
const pageDesc = "Calculate GST online in India for 5%, 12%, 18%, and 28% tax slabs. Add or subtract GST with instant CGST, SGST, and IGST breakdown. Free & CA-verified.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": "GST Calculator Online (Free) – Calculate GST Instantly (2026)",
  "url": "https://gstcalculatoronline.in/gst-calculator",
  "description": "Free online GST calculator for India. Instantly calculate CGST, SGST, and IGST for 5%, 12%, 18%, and 28% slabs. Add or remove tax with 100% accuracy.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  }
};

const faqs = [
  {
    question: "What is a GST Calculator Online?",
    answer: "A GST Calculator Online is a free digital tool that helps businesses, accountants, and individuals compute the Goods and Services Tax (GST) on any transaction amount. You simply enter the amount and select the GST rate — the calculator instantly shows the tax amount, CGST/SGST/IGST split, and the final invoice value."
  },
  {
    question: "How do I calculate GST online in India?",
    answer: "To calculate GST online: (1) Enter your transaction amount, (2) Select 'Add GST' if the price is exclusive of tax or 'Remove GST' if the price already includes tax, (3) Choose the applicable GST rate — 5%, 12%, 18%, or 28%, (4) Select Intrastate (CGST + SGST) or Interstate (IGST). The calculator shows the tax breakdown instantly."
  },
  {
    question: "What is the formula to calculate GST?",
    answer: "To Add GST: GST Amount = (Base Price × GST Rate) ÷ 100; Total Invoice = Base Price + GST Amount. To Remove GST (inclusive price): Base Price = Inclusive Amount ÷ (1 + GST Rate ÷ 100); GST Amount = Inclusive Amount − Base Price. For CGST/SGST split, divide the total GST equally by 2."
  },
  {
    question: "What is the difference between CGST, SGST, and IGST?",
    answer: "CGST (Central GST) is collected by the Central Government for intrastate transactions. SGST (State GST) is collected by the State Government for the same intrastate transactions — always equal to CGST. IGST (Integrated GST) is collected by the Centre for interstate transactions and imports, and equals the full combined rate (CGST + SGST combined)."
  },
  {
    question: "How to calculate 18% GST on a product?",
    answer: "To calculate 18% GST on, say, ₹10,000: GST Amount = 10,000 × 18 ÷ 100 = ₹1,800. Total Invoice = ₹10,000 + ₹1,800 = ₹11,800. For intrastate supply, CGST = ₹900 and SGST = ₹900. For interstate supply, IGST = ₹1,800. Our free 18% GST calculator online does this instantly."
  },
  {
    question: "How to remove GST from an amount (reverse calculation)?",
    answer: "To remove GST from an inclusive price of ₹11,800 at 18%: Base Price = 11,800 ÷ (1 + 18/100) = 11,800 ÷ 1.18 = ₹10,000. GST Amount = 11,800 − 10,000 = ₹1,800. This is known as the reverse GST calculation or inclusive GST calculation."
  },
  {
    question: "What are the GST tax slabs in India?",
    answer: "India has four primary GST slabs: 5% (essential goods like food items, medicines, transport), 12% (standard goods like computers, processed foods), 18% (most services, electronics, FMCG goods), and 28% (luxury items like cars, tobacco, aerated drinks). Some items are exempt (0%) and a few attract special rates like gold at 3%."
  },
  {
    question: "Is this GST Calculator free to use?",
    answer: "Yes, our GST Calculator Online is completely free to use. There is no registration, no login, no subscription, and no hidden charges. You can calculate GST for any amount, any rate, and any number of times without any cost."
  },
  {
    question: "Can I use this GST calculator on my mobile phone?",
    answer: "Absolutely. This GST Calculator Online is fully mobile responsive. It works perfectly on Android smartphones, iPhones, tablets, and all modern browsers. You get the same fast, accurate results on any device."
  },
  {
    question: "What is CGST?",
    answer: "CGST stands for Central Goods and Services Tax. It is the portion of GST collected by the Central Government of India on goods and services sold within the same state (intrastate supply). CGST is always equal to SGST and together they make up the total GST for intrastate transactions."
  },
  {
    question: "What is SGST?",
    answer: "SGST stands for State Goods and Services Tax. It is the portion of GST collected by the respective State Government on intrastate sales of goods and services. SGST equals CGST in rate, so for an 18% GST transaction, SGST = 9% and CGST = 9%."
  },
  {
    question: "What is IGST?",
    answer: "IGST stands for Integrated Goods and Services Tax. It is levied on all interstate transactions — when goods or services are sold from one state to another — and also on imports into India. IGST is collected by the Central Government and then distributed between the Centre and the destination state."
  },
  {
    question: "How is GST calculated on a service invoice?",
    answer: "GST on a service invoice is calculated the same way as goods. If a CA charges ₹50,000 for audit services (taxable at 18%), GST Amount = 50,000 × 18% = ₹9,000. Total Invoice = ₹59,000. If the service is provided within the state, split as CGST ₹4,500 + SGST ₹4,500."
  },
  {
    question: "What is the GST rate for 12% slab?",
    answer: "The 12% GST slab applies to goods and services like computers, mobile accessories, butter, cheese, frozen meat, medicines for certain categories, and various business services. For ₹10,000 at 12%: GST = ₹1,200; Total Invoice = ₹11,200; CGST = ₹600; SGST = ₹600."
  },
  {
    question: "How to calculate GST inclusive amount?",
    answer: "If a price is GST inclusive (meaning tax is already included in the listed price), use: Base Value = Inclusive Price ÷ (1 + Rate/100). Example: ₹5,900 inclusive of 18% GST → Base Value = 5,900 ÷ 1.18 = ₹5,000. GST = ₹900. Our 'Remove GST' mode handles this automatically."
  },
  {
    question: "Which GST rate should I use for my business?",
    answer: "The GST rate depends on the HSN code (for goods) or SAC code (for services) of your product/service. Most common rates: 5% for essential items, 12% for standard goods, 18% for most services and manufactured goods, 28% for luxury and demerit goods. Consult the official GST rate schedule or your CA to determine the correct slab."
  },
  {
    question: "Can I calculate GST for custom rates not in standard slabs?",
    answer: "Yes. Our GST Calculator supports custom rates. Apart from standard slabs (5%, 12%, 18%, 28%), you can enter any custom percentage — like 3% for gold or 0.25% for rough precious stones. Just click 'Custom' in the rate selector and type your rate."
  },
  {
    question: "Does this calculator work for GST on exports?",
    answer: "For exports, goods and services are zero-rated (0% GST). While this calculator focuses on domestic transactions, for interstate exports you would select Interstate (IGST) with a 0% rate. For detailed export refund calculations, use our GST Refund Calculator."
  },
  {
    question: "What is UTGST?",
    answer: "UTGST stands for Union Territory Goods and Services Tax. It is the equivalent of SGST but levied in Union Territories of India (like Andaman and Nicobar Islands, Lakshadweep, Ladakh, etc.) that do not have their own legislature. It is charged along with CGST."
  },
  {
    question: "Does the GST Calculator round off decimals?",
    answer: "According to Section 170 of the CGST Act, 2017, the amount of tax, interest, penalty, fine or refund should be rounded off to the nearest rupee. Our calculator shows exact decimal figures to two places for billing accuracy, but businesses typically round off the final grand total."
  }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema} faqs={faqs}>
  <form id="gst-form" class="space-y-4 md:space-y-6" autocomplete="off">
    <!-- Transaction Amount -->
    <div>
      <label for="calc-amount" class="block text-sm font-bold text-ink">Transaction Amount (₹)</label>
      <div class="relative mt-2">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-mute">
          <span class="text-sm font-bold font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="amount" 
          id="calc-amount" 
          value="10000" 
          min="1" 
          step="any"
          class="block w-full rounded-xl border border-hairline bg-canvas py-3.5 pl-9 pr-4 text-base text-ink outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 font-mono font-semibold transition-all"
          placeholder="e.g. 10000"
          required
          aria-label="Transaction Amount in Rupees"
        />
      </div>
      <!-- Quick Amount Chips -->
      <div class="mt-3 flex flex-wrap gap-1.5" id="page-quick-chips" role="group" aria-label="Quick amount presets">
        {(['100', '500', '1K', '5K', '10K', '25K', '50K', '1L'] as const).map(chip => (
          <button type="button" class="quick-chip" data-chip={chip}>₹{chip}</button>
        ))}
      </div>
    </div>

    <!-- Calculation Direction -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">GST Direction</span>
      <div class="segmented-control" role="group" aria-label="GST calculation direction">
        <label class="segmented-btn btn-add-gst cursor-pointer">
          <input type="radio" name="calc-type" value="add" checked class="sr-only" />
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          Add GST
        </label>
        <label class="segmented-btn btn-remove-gst cursor-pointer">
          <input type="radio" name="calc-type" value="remove" class="sr-only" />
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/></svg>
          Remove GST
        </label>
      </div>
    </div>

    <!-- GST Tax Slab Rates -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">GST Rate</span>
      <div class="rate-pill-container sm:grid sm:grid-cols-6 gap-2" role="group" aria-label="GST rate selection">
        {(['3', '5', '12', '18', '28'] as const).map((rate) => (
          <label class="rate-pill cursor-pointer [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-primary [&:has(input:checked)]:text-on-primary">
            <input type="radio" name="calc-rate" value={rate} checked={rate === '18'} class="sr-only" />
            {rate}%
          </label>
        ))}
        <label class="rate-pill cursor-pointer [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-primary [&:has(input:checked)]:text-on-primary">
          <input type="radio" name="calc-rate" id="rate-custom-radio" value="custom" class="sr-only" />
          Custom
        </label>
      </div>
      
      <!-- Custom Rate Input (Hidden by default) -->
      <div id="custom-rate-container" class="hidden mt-3">
        <label for="calc-rate-custom" class="sr-only">Custom GST Rate (%)</label>
        <div class="relative">
          <input 
            type="number" 
            name="custom-rate" 
            id="calc-rate-custom" 
            min="0.1" 
            max="100" 
            step="any"
            value="18"
            class="block w-full rounded-xl border border-hairline bg-canvas py-2.5 px-3 pr-8 text-sm text-ink outline-none focus:border-primary font-mono"
            placeholder="Enter custom rate e.g. 3"
          />
          <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-mute text-xs font-mono">%</span>
        </div>
      </div>
    </div>

    <!-- Supply Destination -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">Transaction Type</span>
      <div class="segmented-control" role="group" aria-label="Transaction type">
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="tax-type" value="intrastate" checked class="sr-only" />
          <span>Intra-State <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(CGST+SGST)</span></span>
        </label>
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="tax-type" value="interstate" class="sr-only" />
          <span>Inter-State <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(IGST)</span></span>
        </label>
      </div>
    </div>

    <!-- Keyboard Shortcuts Hint -->
    <div class="flex items-center gap-3 text-[10px] text-mute font-mono pt-1">
      <span class="kbd">ESC</span><span>Reset</span>
      <span class="kbd ml-2">Tab</span><span>Navigate fields</span>
    </div>
  </form>

  <ResultCard slot="results" />

  <div slot="content" class="prose max-w-none">
    <h2>Online GST Calculator — Calculate Goods &amp; Services Tax Instantly</h2>
    <p>Whether you are a business owner raising invoices, a Chartered Accountant preparing monthly GSTR-3B returns, or a consumer checking a retail receipt, our <strong>free GST calculator online</strong> provides instant, 100% accurate tax computations as per the latest Central Goods and Services Tax (CGST) and State Goods and Services Tax (SGST) statutory provisions.</p>
    <p>India's Goods and Services Tax system consolidates multiple indirect levies into a single destination-based consumption tax. This calculator supports all official Indian tax slabs — <strong>5%, 12%, 18%, and 28%</strong> — as well as special rates (such as 3% for gold and jewellery or 0.25% for rough precious stones) and custom percentage inputs.</p>

    <h2>How GST is Calculated: Exclusive vs. Inclusive Tax Formulas</h2>
    <p>Depending on whether your initial price is quoted before tax (exclusive) or after tax (inclusive/MRP), use the corresponding formula below:</p>

    <div class="my-6 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed space-y-4">
      <div>
        <p class="font-semibold text-primary">1. Adding GST to Base Price (GST Exclusive Amount):</p>
        <p>GST Tax Amount = (Base Price × GST Rate) ÷ 100</p>
        <p>Total Invoice Value (Gross) = Base Price + GST Tax Amount</p>
        <p>CGST Portion = GST Tax Amount ÷ 2 (for intra-state sales)</p>
        <p>SGST Portion = GST Tax Amount ÷ 2 (for intra-state sales)</p>
        <p>IGST Portion = Full GST Tax Amount (for inter-state sales)</p>
      </div>
      <div class="border-t border-hairline/50 pt-4">
        <p class="font-semibold text-primary">2. Removing GST from Total Price (GST Inclusive / MRP Amount):</p>
        <p>Pre-Tax Base Value = Inclusive Total Price ÷ (1 + GST Rate ÷ 100)</p>
        <p>GST Tax Amount = Inclusive Total Price − Pre-Tax Base Value</p>
        <p>CGST Portion = SGST Portion = GST Tax Amount ÷ 2 (for intra-state sales)</p>
      </div>
    </div>

    <h2>Step-by-Step Worked Calculation Examples</h2>

    <h3>Example 1: Adding 18% GST to Professional Service Fees (Exclusive)</h3>
    <p>A software consultant in Bengaluru bills a client within Karnataka ₹50,000 for development services:</p>
    <ul>
      <li><strong>Base Taxable Amount:</strong> ₹50,000</li>
      <li><strong>Applicable GST Rate:</strong> 18% (Standard Services Slab)</li>
      <li><strong>Total GST Amount:</strong> (₹50,000 × 18) ÷ 100 = <strong>₹9,000</strong></li>
      <li><strong>CGST Component (9%):</strong> ₹4,500</li>
      <li><strong>SGST Component (9%):</strong> ₹4,500</li>
      <li><strong>Final Invoice Amount:</strong> ₹50,000 + ₹9,000 = <strong>₹59,000</strong></li>
    </ul>

    <h3>Example 2: Extracting GST from an Inclusive MRP Retail Price (Inclusive)</h3>
    <p>A customer buys a home appliance in Delhi for ₹23,600 inclusive of 18% GST:</p>
    <ul>
      <li><strong>Total Inclusive Price:</strong> ₹23,600</li>
      <li><strong>Pre-Tax Base Price:</strong> ₹23,600 ÷ (1 + 18/100) = ₹23,600 ÷ 1.18 = <strong>₹20,000</strong></li>
      <li><strong>Total GST Extracted:</strong> ₹23,600 − ₹20,000 = <strong>₹3,600</strong></li>
      <li><strong>CGST (9%):</strong> ₹1,800 | <strong>SGST (9%):</strong> ₹1,800</li>
    </ul>

    <h3>Example 3: Interstate Supply at 12% IGST</h3>
    <p>A manufacturer in Gujarat ships processed goods worth ₹1,00,000 to a distributor in Maharashtra:</p>
    <ul>
      <li><strong>Base Amount:</strong> ₹1,00,000</li>
      <li><strong>Transaction Type:</strong> Inter-State (Integrated GST)</li>
      <li><strong>IGST Amount (12%):</strong> (₹1,00,000 × 12) ÷ 100 = <strong>₹12,000</strong></li>
      <li><strong>Total Invoice Amount:</strong> ₹1,00,000 + ₹12,000 = <strong>₹1,12,000</strong></li>
    </ul>

    <h2>Understanding CGST, SGST, UTGST, and IGST</h2>
    <p>Under India's federal constitutional structure, indirect taxes are governed by a dual-GST framework:</p>
    <ul>
      <li><strong>CGST (Central GST):</strong> Levied by the Central Government on intra-state supplies under the CGST Act, 2017.</li>
      <li><strong>SGST (State GST):</strong> Levied by State Governments on intra-state supplies under respective State GST Acts. For intra-state transactions, CGST and SGST rates are always identical.</li>
      <li><strong>UTGST (Union Territory GST):</strong> Applied in place of SGST in Union Territories without a separate state legislature (such as Ladakh, Chandigarh, Andaman &amp; Nicobar Islands).</li>
      <li><strong>IGST (Integrated GST):</strong> Levied by the Centre under the IGST Act, 2017 on inter-state supplies (across state borders) and all imports of goods and services into India. IGST equals CGST + SGST combined.</li>
    </ul>

    <h2>Standard GST Tax Slabs in India (2025–2026)</h2>
    <div class="overflow-x-auto my-6">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="border-b border-hairline bg-canvas-soft">
            <th class="p-3 font-semibold text-ink">Rate Slab</th>
            <th class="p-3 font-semibold text-ink">CGST + SGST Split</th>
            <th class="p-3 font-semibold text-ink">Common Goods &amp; Services</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <tr>
            <td class="p-3 font-mono font-bold text-primary">0% (Nil / Exempt)</td>
            <td class="p-3 font-mono">0% + 0%</td>
            <td class="p-3 text-body">Fresh vegetables, unbranded milk, eggs, bread, basic healthcare, school education</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold text-primary">3% (Special)</td>
            <td class="p-3 font-mono">1.5% + 1.5%</td>
            <td class="p-3 text-body">Gold, silver, platinum jewellery, articles of precious metals</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold text-primary">5% (Merit Slab)</td>
            <td class="p-3 font-mono">2.5% + 2.5%</td>
            <td class="p-3 text-body">Packaged food, medicines, domestic LPG, economy flight tickets, tea, coffee, spices</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold text-primary">12% (Standard I)</td>
            <td class="p-3 font-mono">6% + 6%</td>
            <td class="p-3 text-body">Computers, processed foods, fruit juices, dairy products, business class flights</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold text-primary">18% (Standard II)</td>
            <td class="p-3 font-mono">9% + 9%</td>
            <td class="p-3 text-body">Most services, IT consulting, telecom, restaurants, electronics, FMCG products, banking</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold text-primary">28% (Luxury / Sin)</td>
            <td class="p-3 font-mono">14% + 14%</td>
            <td class="p-3 text-body">Automobiles, air conditioners, aerated drinks, tobacco products, high-end luxury goods</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>Who Should Use This Online GST Calculator?</h2>
    <ul>
      <li><strong>Small Business Owners &amp; Retailers:</strong> Fast quote generation, MRP tax extraction, and accurate billing for customers.</li>
      <li><strong>Chartered Accountants &amp; Tax Practitioners:</strong> Instant cross-verification of taxable values and tax splits before filing GSTR-1 and GSTR-3B.</li>
      <li><strong>Freelancers &amp; Service Providers:</strong> Correctly adding 18% GST on client invoices and separating CGST/SGST for local clients versus IGST for interstate clients.</li>
      <li><strong>E-Commerce Sellers:</strong> Calculating net profit margins and extracting GST included in marketplace sales prices.</li>
      <li><strong>Consumers &amp; Buyers:</strong> Verifying whether GST charged on retail receipts or restaurant bills matches the statutory rate.</li>
    </ul>

    <h2>Frequently Asked Questions</h2>
    <FAQ items={faqs} />

    <div class="mt-8 rounded-xl border border-hairline bg-canvas-soft p-6 shadow-xs text-center">
      <h3 class="text-lg font-bold text-ink mb-2">Explore Related GST Calculators &amp; Guides</h3>
      <p class="text-sm text-body mb-4">Calculate specific tax components or read our comprehensive compliance guides.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/reverse-gst-calculator" class="px-4 py-2 rounded-xl bg-primary text-on-primary text-xs font-semibold hover:opacity-90 transition-all">Reverse GST Calculator</a>
        <a href="/cgst-calculator" class="px-4 py-2 rounded-xl border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all">CGST Calculator</a>
        <a href="/igst-calculator" class="px-4 py-2 rounded-xl border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all">IGST Calculator</a>
        <a href="/gst-rates" class="px-4 py-2 rounded-xl border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all">GST Rates 2026</a>
      </div>
    </div>
  </div>
</CalculatorLayout>

<script>
  // Calculator logical implementation
  const amountInput = document.getElementById('calc-amount') as HTMLInputElement | null;
  const customRateInput = document.getElementById('calc-rate-custom') as HTMLInputElement | null;
  const customRateContainer = document.getElementById('custom-rate-container');
  const gstForm = document.getElementById('gst-form') as HTMLFormElement | null;

  // DOM Outputs
  const resTaxable = document.getElementById('res-taxable-val');
  const resCgstRow = document.getElementById('res-cgst-row');
  const resCgstVal = document.getElementById('res-cgst-val');
  const resSgstRow = document.getElementById('res-sgst-row');
  const resSgstVal = document.getElementById('res-sgst-val');
  const resIgstRow = document.getElementById('res-igst-row');
  const resIgstVal = document.getElementById('res-igst-val');
  const resTotalTax = document.getElementById('res-total-tax');
  const resGrandTotal = document.getElementById('res-grand-total');

  function validateInput(input: HTMLInputElement, message: string, check: () => boolean): boolean {
    const isValid = check();
    let errSpan = document.getElementById(`${input.id}-error`);
    if (!isValid) {
      input.classList.add('input-error');
      if (!errSpan) {
        errSpan = document.createElement('span');
        errSpan.id = `${input.id}-error`;
        errSpan.className = 'error-message';
        errSpan.innerText = message;
        input.parentElement?.parentElement?.appendChild(errSpan);
      }
    } else {
      input.classList.remove('input-error');
      errSpan?.remove();
    }
    return isValid;
  }

  function getSelectedRate(): number {
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    if (!rateRadio) return 18;
    if (rateRadio.value === 'custom') {
      return parseFloat(customRateInput?.value || '0') || 0;
    }
    return parseFloat(rateRadio.value) || 0;
  }

  function calculate() {
    if (!amountInput) return;

    // Validate main amount
    const isAmountValid = validateInput(
      amountInput,
      "Please enter a valid amount greater than 0",
      () => parseFloat(amountInput.value) > 0
    );

    // Validate custom rate if selected
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    let isRateValid = true;
    if (rateRadio?.value === 'custom' && customRateInput) {
      isRateValid = validateInput(
        customRateInput,
        "Please enter a rate between 0.1% and 100%",
        () => {
          const val = parseFloat(customRateInput.value);
          return val >= 0.1 && val <= 100;
        }
      );
    }

    if (!isAmountValid || !isRateValid) {
      if (resTaxable) resTaxable.innerText = "₹0.00";
      if (resTotalTax) resTotalTax.innerText = "₹0.00";
      if (resGrandTotal) resGrandTotal.innerText = "₹0.00";
      if (resCgstVal) resCgstVal.innerText = "₹0.00";
      if (resSgstVal) resSgstVal.innerText = "₹0.00";
      if (resIgstVal) resIgstVal.innerText = "₹0.00";
      return;
    }

    const amount = parseFloat(amountInput.value) || 0;
    const rate = getSelectedRate();
    const typeRadio = document.querySelector('input[name="calc-type"]:checked') as HTMLInputElement | null;
    const isAdd = typeRadio ? typeRadio.value === 'add' : true;
    
    const taxTypeRadio = document.querySelector('input[name="tax-type"]:checked') as HTMLInputElement | null;
    const isIntrastate = taxTypeRadio ? taxTypeRadio.value === 'intrastate' : true;

    let taxableValue = 0;
    let totalTax = 0;
    let grandTotal = 0;

    if (isAdd) {
      taxableValue = amount;
      totalTax = amount * (rate / 100);
      grandTotal = amount + totalTax;
    } else {
      taxableValue = amount / (1 + (rate / 100));
      totalTax = amount - taxableValue;
      grandTotal = amount;
    }

    const fmt = (val: number) => '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (resTaxable) resTaxable.innerText = fmt(taxableValue);
    if (resTotalTax) resTotalTax.innerText = fmt(totalTax);
    if (resGrandTotal) resGrandTotal.innerText = fmt(grandTotal);

    if (isIntrastate) {
      resCgstRow?.classList.remove('hidden');
      resSgstRow?.classList.remove('hidden');
      resIgstRow?.classList.add('hidden');
      const splitTax = totalTax / 2;
      if (resCgstVal) resCgstVal.innerText = fmt(splitTax);
      if (resSgstVal) resSgstVal.innerText = fmt(splitTax);
    } else {
      resCgstRow?.classList.add('hidden');
      resSgstRow?.classList.add('hidden');
      resIgstRow?.classList.remove('hidden');
      if (resIgstVal) resIgstVal.innerText = fmt(totalTax);
    }
  }

  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const amount = params.get('amount');
    const rate = params.get('rate');
    const type = params.get('type');
    const taxtype = params.get('taxtype');

    if (amount && amountInput) amountInput.value = amount;

    if (type) {
      const typeRadio = document.querySelector(`input[name="calc-type"][value="${type}"]`) as HTMLInputElement | null;
      if (typeRadio) typeRadio.checked = true;
    }

    if (taxtype) {
      const taxRadio = document.querySelector(`input[name="tax-type"][value="${taxtype}"]`) as HTMLInputElement | null;
      if (taxRadio) taxRadio.checked = true;
    }

    if (rate) {
      const standardRates = ['5', '12', '18', '28'];
      if (standardRates.includes(rate)) {
        const rateRadio = document.querySelector(`input[name="calc-rate"][value="${rate}"]`) as HTMLInputElement | null;
        if (rateRadio) rateRadio.checked = true;
      } else {
        const customRadio = document.getElementById('rate-custom-radio') as HTMLInputElement | null;
        if (customRadio) {
          customRadio.checked = true;
          customRateContainer?.classList.remove('hidden');
          if (customRateInput) customRateInput.value = rate;
        }
      }
    }
  }

  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  const rateRadios = document.querySelectorAll('input[name="calc-rate"]');
  rateRadios.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value === 'custom') {
        customRateContainer?.classList.remove('hidden');
        customRateInput?.focus();
      } else {
        customRateContainer?.classList.add('hidden');
        if (customRateInput) {
          customRateInput.classList.remove('input-error');
          document.getElementById('calc-rate-custom-error')?.remove();
        }
      }
      calculate();
    });
  });

  // Quick Amount Chips
  const chipValues: Record<string, number> = {
    '100': 100, '500': 500, '1K': 1000, '5K': 5000,
    '10K': 10000, '25K': 25000, '50K': 50000, '1L': 100000
  };
  document.querySelectorAll<HTMLButtonElement>('#page-quick-chips .quick-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const val = chipValues[chip.dataset.chip || ''] || 0;
      if (amountInput) amountInput.value = String(val);
      document.querySelectorAll('#page-quick-chips .quick-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      calculate();
    });
  });

  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  loadFromUrl();
  calculate();
</script>
