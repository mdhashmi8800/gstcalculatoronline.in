---
import CalculatorLayout from '../../components/CalculatorLayout.astro';
import ResultCard from '../../components/ResultCard.astro';
import FAQ from '../../components/FAQ.astro';
import ToolCard from '../../components/ToolCard.astro';

const pageTitle = "GST Inclusive Calculator Online - Tax Inclusive Price Tool";
const pageDesc = "Extract the original base taxable amount and CGST/SGST/IGST tax splits from a GST-inclusive product price. Free tax-inclusive calculator updated with standard slabs.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GST Inclusive Calculator Online",
  "url": "https://gstcalculatoronline.in/tools/gst-inclusive-calculator",
  "description": "Calculate base prices and tax amounts from gross GST-inclusive values.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5."
};

const faqs = [
  {
    question: "What is a GST inclusive price?",
    answer: "A GST inclusive price is the final amount charged to a buyer that already includes the Goods and Services Tax (GST) component. No additional tax is added to this final price."
  },
  {
    question: "How do you calculate GST inclusive value manually?",
    answer: "To extract the GST amount from an inclusive price, use these steps:<br>1. **Base Value = Inclusive Price ÷ (1 + (GST Rate ÷ 100))**<br>2. **GST Tax = Inclusive Price - Base Value**."
  },
  {
    question: "What is the difference between GST inclusive and exclusive?",
    answer: "**GST Inclusive** means the listed price includes the tax (the customer pays exactly the listed price). **GST Exclusive** means the listed price does not include tax, so GST is added on top of it, increasing the final amount paid."
  }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema}>
  <!-- Calculator Input Form -->
  <form id="gst-form" class="space-y-6">
    <!-- Gross Price (GST Inclusive) -->
    <div>
      <label for="calc-amount" class="block text-sm font-semibold text-ink">Total Tax-Inclusive Price (₹)</label>
      <div class="relative mt-2 rounded-lg shadow-xs">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-mute">
          <span class="text-xs font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="amount" 
          id="calc-amount" 
          value="10000" 
          min="1" 
          step="any"
          class="block w-full rounded-lg border border-hairline bg-canvas py-3 pl-8 pr-4 text-base text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary font-mono transition-all"
          placeholder="e.g. 10000"
          required
        />
      </div>
      <p class="mt-1 text-xs text-mute">The final price charged to the consumer.</p>
    </div>

    <!-- GST Tax Slab Rates -->
    <div>
      <span class="block text-sm font-semibold text-ink">GST Tax Rate (%)</span>
      <div class="mt-2 grid grid-cols-5 gap-2">
        {['5', '12', '18', '28'].map((rate) => (
          <label class="flex items-center justify-center rounded-lg border border-hairline bg-canvas py-2.5 cursor-pointer text-sm font-semibold text-body hover:bg-canvas-soft-2 [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink font-mono select-none">
            <input type="radio" name="calc-rate" value={rate} checked={rate === '18'} class="sr-only" />
            <span>{rate}%</span>
          </label>
        ))}
        <label class="flex items-center justify-center rounded-lg border border-hairline bg-canvas py-2.5 cursor-pointer text-sm font-semibold text-body hover:bg-canvas-soft-2 [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink select-none">
          <input type="radio" name="calc-rate" id="rate-custom-radio" value="custom" class="sr-only" />
          <span>Custom</span>
        </label>
      </div>
      
      <!-- Custom Rate Input (Hidden by default) -->
      <div id="custom-rate-container" class="hidden mt-3">
        <label for="calc-rate-custom" class="sr-only">Custom GST Rate (%)</label>
        <div class="relative rounded-lg shadow-xs">
          <input 
            type="number" 
            name="custom-rate" 
            id="calc-rate-custom" 
            min="0.1" 
            max="100" 
            step="any"
            value="18"
            class="block w-full rounded-lg border border-hairline bg-canvas py-2 px-3 text-sm text-ink outline-hidden focus:border-hairline-strong font-mono"
            placeholder="Enter custom rate e.g. 3"
          />
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-mute">
            <span class="text-xs font-mono">%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Supply Destination -->
    <div>
      <span class="block text-sm font-semibold text-ink">Supply Location</span>
      <div class="mt-2 grid grid-cols-2 gap-3">
        <label class="flex flex-col items-center justify-center rounded-lg border border-hairline bg-canvas p-3 cursor-pointer text-center hover:bg-canvas-soft [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 select-none group">
          <input type="radio" name="tax-type" value="intrastate" checked class="sr-only" />
          <span class="text-sm font-semibold text-body group-hover:text-ink group-has-checked:text-ink">Intrastate</span>
          <span class="text-[10px] text-mute uppercase font-mono mt-0.5 group-has-checked:text-body">CGST + SGST</span>
        </label>
        <label class="flex flex-col items-center justify-center rounded-lg border border-hairline bg-canvas p-3 cursor-pointer text-center hover:bg-canvas-soft [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 select-none group">
          <input type="radio" name="tax-type" value="interstate" class="sr-only" />
          <span class="text-sm font-semibold text-body group-hover:text-ink group-has-checked:text-ink">Interstate</span>
          <span class="text-[10px] text-mute uppercase font-mono mt-0.5 group-has-checked:text-body">IGST Only</span>
        </label>
      </div>
    </div>
  </form>

  <!-- Results Block -->
  <ResultCard slot="results" title="Inclusive Value Summary" />

  <!-- Educational content -->
  <div slot="content" class="prose max-w-none">
    <h2>How to Calculate Base Price from a GST Inclusive Amount</h2>
    <p>Calculating the base price from a GST-inclusive price involves removing the tax proportion. Since the final price already has tax built into it, simply multiplying by the tax percentage will result in incorrect figures. The proper division formula must be applied.</p>
    
    <h3>Mathematical Formula</h3>
    <div class="my-4 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed space-y-3">
      <p class="font-semibold text-brand-link">Inclusive Calculation Formula:</p>
      <p>1. Base Taxable Cost = Inclusive Total / (1 + (GST % / 100))</p>
      <p>2. Calculated Tax = Inclusive Total - Base Taxable Cost</p>
    </div>

    <h3>Step-by-Step Example</h3>
    <p>Let's calculate the tax components for a retail invoice of <strong>₹5,000</strong> inclusive of <strong>12% GST</strong>:</p>
    <ul>
      <li><strong>Find Taxable Net Value:</strong>
        <br>Net Value = ₹5,000 ÷ (1 + (12 / 100))
        <br>Net Value = ₹5,000 ÷ 1.12 = <strong>₹4,464.29</strong>.
      </li>
      <li><strong>Find GST Tax Amount:</strong>
        <br>GST Tax Amount = ₹5,000 - ₹4,464.29 = <strong>₹535.71</strong>.
      </li>
      <li><strong>Intrastate Splits (CGST & SGST):</strong>
        <br>Central Tax (CGST) = ₹535.71 ÷ 2 = <strong>₹267.86</strong>.
        <br>State Tax (SGST) = ₹535.71 ÷ 2 = <strong>₹267.86</strong>.
      </li>
    </ul>

    <FAQ items={faqs} />

    <!-- Related Tools Section -->
    <section class="mt-12 not-prose border-t border-hairline pt-10">
      <h3 class="text-xl font-bold tracking-tight text-ink mb-6">Related GST Calculators</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <ToolCard 
          title="GST Exclusive Calculator" 
          description="Calculate final prices by adding GST on top of base values." 
          url="/tools/gst-exclusive-calculator"
          icon="calculator"
        />
        <ToolCard 
          title="Reverse GST Calculator" 
          description="Subtract tax to determine original base cost." 
          url="/tools/reverse-gst-calculator"
          icon="calculator"
        />
        <ToolCard 
          title="GST Rate Calculator" 
          description="Calculate active GST slab percentage rates." 
          url="/tools/gst-rate-calculator"
          icon="calculator"
        />
      </div>
    </section>
  </div>
</CalculatorLayout>

<script>
  const amountInput = document.getElementById('calc-amount') as HTMLInputElement | null;
  const customRateInput = document.getElementById('calc-rate-custom') as HTMLInputElement | null;
  const customRateContainer = document.getElementById('custom-rate-container');
  const gstForm = document.getElementById('gst-form') as HTMLFormElement | null;

  // DOM Outputs
  const resTaxable = document.getElementById('res-taxable-val');
  const resCgstRow = document.getElementById('res-cgst-row');
  const resCgstVal = document.getElementById('res-cgst-val');
  const resSgstRow = document.getElementById('res-sgst-row');
  const resSgstVal = document.getElementById('res-sgst-val');
  const resIgstRow = document.getElementById('res-igst-row');
  const resIgstVal = document.getElementById('res-igst-val');
  const resTotalTax = document.getElementById('res-total-tax');
  const resGrandTotal = document.getElementById('res-grand-total');

  function validateInput(input: HTMLInputElement, message: string, check: () => boolean): boolean {
    const isValid = check();
    let errSpan = document.getElementById(`${input.id}-error`);
    if (!isValid) {
      input.classList.add('input-error');
      if (!errSpan) {
        errSpan = document.createElement('span');
        errSpan.id = `${input.id}-error`;
        errSpan.className = 'error-message';
        errSpan.innerText = message;
        input.parentElement?.parentElement?.appendChild(errSpan);
      }
    } else {
      input.classList.remove('input-error');
      errSpan?.remove();
    }
    return isValid;
  }

  function getSelectedRate(): number {
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    if (!rateRadio) return 18;
    if (rateRadio.value === 'custom') {
      return parseFloat(customRateInput?.value || '0') || 0;
    }
    return parseFloat(rateRadio.value) || 0;
  }

  function calculate() {
    if (!amountInput) return;

    const isAmountValid = validateInput(
      amountInput,
      "Please enter a valid price greater than 0",
      () => parseFloat(amountInput.value) > 0
    );

    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    let isRateValid = true;
    if (rateRadio?.value === 'custom' && customRateInput) {
      isRateValid = validateInput(
        customRateInput,
        "Please enter a rate between 0.1% and 100%",
        () => {
          const val = parseFloat(customRateInput.value);
          return val >= 0.1 && val <= 100;
        }
      );
    }

    if (!isAmountValid || !isRateValid) {
      if (resTaxable) resTaxable.innerText = "₹0.00";
      if (resTotalTax) resTotalTax.innerText = "₹0.00";
      if (resGrandTotal) resGrandTotal.innerText = "₹0.00";
      if (resCgstVal) resCgstVal.innerText = "₹0.00";
      if (resSgstVal) resSgstVal.innerText = "₹0.00";
      if (resIgstVal) resIgstVal.innerText = "₹0.00";
      return;
    }

    const amount = parseFloat(amountInput.value) || 0;
    const rate = getSelectedRate();
    const taxTypeRadio = document.querySelector('input[name="tax-type"]:checked') as HTMLInputElement | null;
    const isIntrastate = taxTypeRadio ? taxTypeRadio.value === 'intrastate' : true;

    // Inclusive GST logic: taxableValue = gross / (1 + (rate/100))
    const taxableValue = amount / (1 + (rate / 100));
    const totalTax = amount - taxableValue;
    const grandTotal = amount;

    // Format currency function
    const fmt = (val: number) => '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (resTaxable) resTaxable.innerText = fmt(taxableValue);
    if (resTotalTax) resTotalTax.innerText = fmt(totalTax);
    if (resGrandTotal) resGrandTotal.innerText = fmt(grandTotal);

    if (isIntrastate) {
      resCgstRow?.classList.remove('hidden');
      resSgstRow?.classList.remove('hidden');
      resIgstRow?.classList.add('hidden');
      
      const splitTax = totalTax / 2;
      if (resCgstVal) resCgstVal.innerText = fmt(splitTax);
      if (resSgstVal) resSgstVal.innerText = fmt(splitTax);
    } else {
      resCgstRow?.classList.add('hidden');
      resSgstRow?.classList.add('hidden');
      resIgstRow?.classList.remove('hidden');
      
      if (resIgstVal) resIgstVal.innerText = fmt(totalTax);
    }
  }

  // Handle prefill from URL
  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const amount = params.get('amount');
    const rate = params.get('rate');
    const taxtype = params.get('taxtype');

    if (amount && amountInput) {
      amountInput.value = amount;
    }

    if (taxtype) {
      const taxRadio = document.querySelector(`input[name="tax-type"][value="${taxtype}"]`) as HTMLInputElement | null;
      if (taxRadio) taxRadio.checked = true;
    }

    if (rate) {
      const standardRates = ['5', '12', '18', '28'];
      if (standardRates.includes(rate)) {
        const rateRadio = document.querySelector(`input[name="calc-rate"][value="${rate}"]`) as HTMLInputElement | null;
        if (rateRadio) rateRadio.checked = true;
      } else {
        const customRadio = document.getElementById('rate-custom-radio') as HTMLInputElement | null;
        if (customRadio) {
          customRadio.checked = true;
          customRateContainer?.classList.remove('hidden');
          if (customRateInput) customRateInput.value = rate;
        }
      }
    }
  }

  // Add listeners
  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  // Monitor Custom Rate visibility
  const rateRadios = document.querySelectorAll('input[name="calc-rate"]');
  rateRadios.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value === 'custom') {
        customRateContainer?.classList.remove('hidden');
        customRateInput?.focus();
      } else {
        customRateContainer?.classList.add('hidden');
        if (customRateInput) {
          customRateInput.classList.remove('input-error');
          document.getElementById('calc-rate-custom-error')?.remove();
        }
      }
      calculate();
    });
  });

  // Init
  loadFromUrl();
  calculate();
</script>
