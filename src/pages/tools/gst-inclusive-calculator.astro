---
import CalculatorLayout from '../../components/CalculatorLayout.astro';
import ResultCard from '../../components/ResultCard.astro';
import FAQ from '../../components/FAQ.astro';
import ToolCard from '../../components/ToolCard.astro';

const pageTitle = "GST Inclusive Calculator Online — Extract Tax from MRP Price";
const pageDesc = "Use our free GST Inclusive Calculator online to extract the base price and CGST/SGST/IGST breakdown from any GST-inclusive (MRP) amount. Works for 5%, 12%, 18%, and 28% slabs. Accurate, fast, and free.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GST Inclusive Calculator Online",
  "url": "https://gstcalculatoronline.in/tools/gst-inclusive-calculator",
  "description": "Free GST inclusive calculator for India. Extract base price and CGST/SGST/IGST breakdown from any GST-inclusive amount.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
};

const faqs = [
  { question: "What is a GST inclusive price?", answer: "A GST inclusive price (also called MRP or gross price) is the final amount charged to a buyer that already includes the Goods and Services Tax component. The customer pays exactly the listed price — no additional tax is charged on top." },
  { question: "How do you calculate GST from an inclusive price?", answer: "To extract GST from an inclusive price, use: Base Value = Inclusive Price ÷ (1 + GST Rate / 100). Then GST Amount = Inclusive Price − Base Value. Example: ₹5,600 at 12% → Base = 5,600 ÷ 1.12 = ₹5,000; GST = ₹600." },
  { question: "What is the difference between GST inclusive and exclusive?", answer: "GST Inclusive means the listed price already includes the tax (MRP, restaurant bills). GST Exclusive means the listed price is the pre-tax base price and GST will be added on top, resulting in a higher final invoice amount." },
  { question: "How to calculate 18% GST inclusive amount?", answer: "For 18% GST inclusive: divide the inclusive price by 1.18 to get the base price. Example: ₹59,000 ÷ 1.18 = ₹50,000 base; GST = ₹9,000. CGST = SGST = ₹4,500 each for intrastate." },
  { question: "How to calculate 12% GST inclusive amount?", answer: "For 12% GST inclusive: divide by 1.12. Example: ₹11,200 ÷ 1.12 = ₹10,000 base; GST = ₹1,200; CGST = SGST = ₹600 each." },
  { question: "How to calculate 5% GST from inclusive price?", answer: "For 5% GST inclusive: divide by 1.05. Example: ₹21,000 ÷ 1.05 = ₹20,000 base; GST = ₹1,000; CGST = SGST = ₹500 each." },
  { question: "Is the GST Inclusive Calculator the same as Reverse GST Calculator?", answer: "Yes, both tools perform the same mathematical operation — extracting GST from a GST-inclusive price using the division formula. The GST Inclusive Calculator emphasizes extracting the base from MRP-type prices, while the Reverse GST Calculator is often described as working backwards from a total invoice." },
  { question: "What is CGST and SGST in a GST inclusive price?", answer: "For intrastate (within the same state) transactions, the total GST embedded in an inclusive price is split equally: CGST = GST Amount ÷ 2 (collected by Centre) and SGST = GST Amount ÷ 2 (collected by State). For interstate, the entire amount is IGST." },
  { question: "Why can't I simply multiply the inclusive price by the GST rate?", answer: "Because GST is calculated on the base price, not the total price. If you apply 18% to ₹11,800, you get ₹2,124, which is wrong. The correct GST embedded in ₹11,800 is ₹1,800 (₹10,000 base × 18%). Always use the division method." },
  { question: "Can businesses claim ITC on GST inclusive purchases?", answer: "Yes. When you buy goods or services at a GST-inclusive price, you can claim the GST component as Input Tax Credit (ITC), provided you have a valid tax invoice with GSTIN details. The base value is used for your cost of goods, and the GST amount becomes your ITC claim." },
  { question: "What is the GST inclusive price formula for 28%?", answer: "For 28% GST: Base Price = Inclusive Price ÷ 1.28. Example: ₹12,800 ÷ 1.28 = ₹10,000 base; GST = ₹2,800. For intrastate: CGST = SGST = ₹1,400 each." },
  { question: "Are retail prices (MRP) in India GST inclusive?", answer: "Yes. Under Indian consumer protection laws, the Maximum Retail Price (MRP) printed on packaged goods is the maximum price inclusive of all taxes, including GST. So when you see a price tag in India, that is the GST inclusive price." },
  { question: "How is GST inclusive calculation used in restaurant billing?", answer: "Restaurants typically display menu prices that are exclusive of GST. However, some include GST in their displayed price. If the menu price is GST inclusive, you can use this calculator to find the food charge and the GST component separately." },
  { question: "Is this GST Inclusive Calculator free?", answer: "Yes, completely free. No sign-up, no subscription, no hidden fees. Enter any inclusive price, select the GST rate, and get instant results as many times as you need." },
  { question: "How to use the GST Inclusive Calculator?", answer: "Step 1: Enter the total GST-inclusive price. Step 2: Select the GST rate (5%, 12%, 18%, 28%, or Custom). Step 3: Choose Intrastate or Interstate supply location. Step 4: Read the instant results — base value, total GST, CGST, SGST or IGST." }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema} faqs={faqs}>
  <!-- Calculator Input Form -->
  <form id="gst-form" class="space-y-6">
    <!-- Gross Price (GST Inclusive) -->
    <div>
      <label for="calc-amount" class="block text-sm font-semibold text-ink">Total Tax-Inclusive Price (₹)</label>
      <div class="relative mt-2 rounded-lg shadow-xs">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-mute">
          <span class="text-xs font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="amount" 
          id="calc-amount" 
          value="10000" 
          min="1" 
          step="any"
          class="block w-full rounded-lg border border-hairline bg-canvas py-3 pl-8 pr-4 text-base text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary font-mono transition-all"
          placeholder="e.g. 10000"
          required
        />
      </div>
      <p class="mt-1 text-xs text-mute">The final price charged to the consumer.</p>
    </div>

    <!-- GST Tax Slab Rates -->
    <div>
      <span class="block text-sm font-semibold text-ink">GST Tax Rate (%)</span>
      <div class="mt-2 grid grid-cols-5 gap-2">
        {['5', '12', '18', '28'].map((rate) => (
          <label class="flex items-center justify-center rounded-lg border border-hairline bg-canvas py-2.5 cursor-pointer text-sm font-semibold text-body hover:bg-canvas-soft-2 [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink font-mono select-none">
            <input type="radio" name="calc-rate" value={rate} checked={rate === '18'} class="sr-only" />
            <span>{rate}%</span>
          </label>
        ))}
        <label class="flex items-center justify-center rounded-lg border border-hairline bg-canvas py-2.5 cursor-pointer text-sm font-semibold text-body hover:bg-canvas-soft-2 [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink select-none">
          <input type="radio" name="calc-rate" id="rate-custom-radio" value="custom" class="sr-only" />
          <span>Custom</span>
        </label>
      </div>
      
      <!-- Custom Rate Input (Hidden by default) -->
      <div id="custom-rate-container" class="hidden mt-3">
        <label for="calc-rate-custom" class="sr-only">Custom GST Rate (%)</label>
        <div class="relative rounded-lg shadow-xs">
          <input 
            type="number" 
            name="custom-rate" 
            id="calc-rate-custom" 
            min="0.1" 
            max="100" 
            step="any"
            value="18"
            class="block w-full rounded-lg border border-hairline bg-canvas py-2 px-3 text-sm text-ink outline-hidden focus:border-hairline-strong font-mono"
            placeholder="Enter custom rate e.g. 3"
          />
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-mute">
            <span class="text-xs font-mono">%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Supply Destination -->
    <div>
      <span class="block text-sm font-semibold text-ink">Supply Location</span>
      <div class="mt-2 grid grid-cols-2 gap-3">
        <label class="flex flex-col items-center justify-center rounded-lg border border-hairline bg-canvas p-3 cursor-pointer text-center hover:bg-canvas-soft [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 select-none group">
          <input type="radio" name="tax-type" value="intrastate" checked class="sr-only" />
          <span class="text-sm font-semibold text-body group-hover:text-ink group-has-checked:text-ink">Intrastate</span>
          <span class="text-[10px] text-mute uppercase font-mono mt-0.5 group-has-checked:text-body">CGST + SGST</span>
        </label>
        <label class="flex flex-col items-center justify-center rounded-lg border border-hairline bg-canvas p-3 cursor-pointer text-center hover:bg-canvas-soft [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 select-none group">
          <input type="radio" name="tax-type" value="interstate" class="sr-only" />
          <span class="text-sm font-semibold text-body group-hover:text-ink group-has-checked:text-ink">Interstate</span>
          <span class="text-[10px] text-mute uppercase font-mono mt-0.5 group-has-checked:text-body">IGST Only</span>
        </label>
      </div>
    </div>
  </form>

  <!-- Results Block -->
  <ResultCard slot="results" title="Inclusive Value Summary" />

  <!-- Educational content: 1200+ words -->
  <div slot="content" class="prose max-w-none">
    <h2>GST Inclusive Calculator Online — Complete Guide to Extracting Tax from MRP</h2>
    <p>In India, the price you see on most product packaging, supermarket shelves, and restaurant menus is the <strong>GST inclusive price</strong> — also known as the Maximum Retail Price (MRP). This means the Goods and Services Tax is already embedded within the displayed price, and no extra tax is added at the checkout. While this simplifies transactions for consumers, it can be confusing when you need to know how much of the price was actual tax and how much was the product cost.</p>

    <p>This free <strong>GST Inclusive Calculator online</strong> solves exactly that problem. Enter any GST-inclusive amount, select the applicable GST rate, and instantly see the net base price, the total GST embedded in it, and the CGST/SGST or IGST split — all calculated using the official formula from the CGST Act, 2017.</p>

    <h2>What Is a GST Inclusive Price?</h2>
    <p>A <strong>GST inclusive price</strong> is a price that already contains the Goods and Services Tax within it. This is different from a GST exclusive (ex-GST) price, which shows only the base value and requires GST to be added separately on top. In India:</p>
    <ul>
      <li><strong>MRP (Maximum Retail Price)</strong> on packaged goods is always GST inclusive</li>
      <li><strong>Restaurant menu prices</strong> may or may not be GST inclusive</li>
      <li><strong>E-commerce product prices</strong> are typically GST inclusive (the checkout shows the breakdown)</li>
      <li><strong>B2B invoices</strong> usually show the GST exclusive price with GST added separately</li>
    </ul>

    <h2>GST Inclusive Formula — How to Extract Tax from an Inclusive Price</h2>
    <div class="my-4 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed space-y-4">
      <div>
        <p class="font-semibold text-brand-link">GST Inclusive Formula:</p>
        <p>Base (Net) Value = Inclusive Price ÷ (1 + GST Rate ÷ 100)</p>
        <p>GST Amount = Inclusive Price − Base Value</p>
        <p>CGST = SGST = GST Amount ÷ 2 (for intrastate)</p>
        <p>IGST = GST Amount (for interstate)</p>
      </div>
      <div class="border-t border-hairline/50 pt-4">
        <p class="font-semibold text-brand-link">Quick Reference:</p>
        <p>5% inclusive → ÷ 1.05 &nbsp;|&nbsp; 12% inclusive → ÷ 1.12</p>
        <p>18% inclusive → ÷ 1.18 &nbsp;|&nbsp; 28% inclusive → ÷ 1.28</p>
      </div>
    </div>

    <h2>Step-by-Step Guide</h2>
    <ol>
      <li><strong>Enter the GST-inclusive price</strong> — The total MRP or final price shown on the product or invoice.</li>
      <li><strong>Select the GST rate</strong> — Choose 5%, 12%, 18%, 28%, or enter a Custom rate (e.g., 3% for gold).</li>
      <li><strong>Choose Supply Location</strong> — Intrastate for same-state transactions (CGST + SGST), or Interstate (IGST).</li>
      <li><strong>View instant results</strong> — Net base value, total GST, and CGST/SGST or IGST split appear immediately.</li>
    </ol>

    <h2>Calculation Examples</h2>
    <h3>Example 1 — 18% GST Inclusive (Electronics)</h3>
    <p>A laptop has an MRP of ₹59,000 (18% GST inclusive). Find the base price and tax breakdown.</p>
    <ul>
      <li>Base Value: 59,000 ÷ 1.18 = <strong>₹50,000</strong></li>
      <li>GST Amount: <strong>₹9,000</strong></li>
      <li>CGST (9%): <strong>₹4,500</strong> &nbsp;|&nbsp; SGST (9%): <strong>₹4,500</strong></li>
    </ul>

    <h3>Example 2 — 12% GST Inclusive (Restaurant Bill)</h3>
    <p>A restaurant bill shows ₹1,120 (12% GST inclusive). Find the food cost vs tax.</p>
    <ul>
      <li>Base Value: 1,120 ÷ 1.12 = <strong>₹1,000</strong></li>
      <li>GST Amount: <strong>₹120</strong></li>
      <li>CGST (6%): <strong>₹60</strong> &nbsp;|&nbsp; SGST (6%): <strong>₹60</strong></li>
    </ul>

    <h3>Business Example — ITC Claim Calculation</h3>
    <p>A Delhi retailer buys 100 units of FMCG products at ₹1,18,000 inclusive of 18% GST from a Delhi wholesaler (intrastate). For ITC purposes:</p>
    <ul>
      <li>Net Purchase Value: 1,18,000 ÷ 1.18 = <strong>₹1,00,000</strong></li>
      <li>Total GST Paid: <strong>₹18,000</strong></li>
      <li>CGST ITC Claimable: <strong>₹9,000</strong> &nbsp;|&nbsp; SGST ITC Claimable: <strong>₹9,000</strong></li>
    </ul>

    <h2>Common GST Inclusive Rates Reference</h2>
    <div class="overflow-x-auto my-4">
      <table class="w-full text-sm border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-canvas-soft-2">
          <tr>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">GST Rate</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Common Items</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Divisor</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-hairline/50"><td class="p-3 font-mono font-bold text-primary">5%</td><td class="p-3 text-body">Packaged food, economy travel</td><td class="p-3 font-mono">÷ 1.05</td></tr>
          <tr class="border-b border-hairline/50 bg-canvas-soft/30"><td class="p-3 font-mono font-bold text-primary">12%</td><td class="p-3 text-body">Computers, processed food, business services</td><td class="p-3 font-mono">÷ 1.12</td></tr>
          <tr class="border-b border-hairline/50"><td class="p-3 font-mono font-bold text-primary">18%</td><td class="p-3 text-body">Electronics, FMCG, most services</td><td class="p-3 font-mono">÷ 1.18</td></tr>
          <tr class="bg-canvas-soft/30"><td class="p-3 font-mono font-bold text-primary">28%</td><td class="p-3 text-body">Luxury cars, cement, tobacco, aerated drinks</td><td class="p-3 font-mono">÷ 1.28</td></tr>
        </tbody>
      </table>
    </div>

    <h2>CGST vs SGST vs IGST in Inclusive Prices</h2>
    <p>Once the total GST is extracted from the inclusive price, the distribution depends on whether the transaction is intrastate or interstate:</p>
    <ul>
      <li><strong>Intrastate (same state)</strong>: CGST = SGST = Total GST ÷ 2. Both collected separately.</li>
      <li><strong>Interstate (different states)</strong>: IGST = Total GST. Collected by Centre, then apportioned to the destination state.</li>
    </ul>

    <h2>Benefits of Using This GST Inclusive Calculator</h2>
    <ul>
      <li><strong>Accurate extraction</strong> — Uses the correct division formula, not approximation</li>
      <li><strong>Instant results</strong> — No submit button needed; calculations update in real time</li>
      <li><strong>ITC-ready</strong> — Get exact CGST/SGST amounts for your input credit claims</li>
      <li><strong>All slabs covered</strong> — 5%, 12%, 18%, 28%, and any custom rate</li>
      <li><strong>Mobile-friendly</strong> — Works on all devices, no app download needed</li>
      <li><strong>Completely free</strong> — No login, no subscription, no hidden charges</li>
    </ul>

    <h2>Common Mistakes to Avoid</h2>
    <ul>
      <li><strong>Multiplying by the GST rate</strong> instead of dividing gives the wrong answer</li>
      <li><strong>Using the wrong GST rate</strong> for the category of goods — always verify the HSN code</li>
      <li><strong>Ignoring interstate vs intrastate</strong> for ITC ledger entries</li>
    </ul>

    <FAQ items={faqs} />

    <h2>Related Calculators</h2>
    <ul>
      <li><a href="/tools/gst-exclusive-calculator">GST Exclusive Calculator</a> — Add GST on top of a base price</li>
      <li><a href="/tools/reverse-gst-calculator">Reverse GST Calculator</a> — Extract tax from an invoice total</li>
      <li><a href="/tools/gst-calculator">GST Calculator Online</a> — Standard add/remove GST tool</li>
      <li><a href="/tools/gst-split-calculator">GST Split Calculator</a> — Split total GST into CGST and SGST</li>
    </ul>

    <h2>Related Articles</h2>
    <ul>
      <li><a href="/blog/what-is-gst">What is GST — Complete Guide for Beginners</a></li>
      <li><a href="/blog/input-tax-credit-itc-rules">Input Tax Credit (ITC) Rules — How to Claim GST on Purchases</a></li>
      <li><a href="/blog/gst-rates-india-2026">GST Rates in India 2025–26 — Full Slab Chart</a></li>
    </ul>

    <h2>Conclusion</h2>
    <p>Understanding and extracting the tax from a <strong>GST inclusive price</strong> is a fundamental skill for any business owner, accountant, or consumer in India. Our free <strong>GST Inclusive Calculator online</strong> makes this process instant and error-free. Whether you are verifying an MRP, calculating ITC from purchase invoices, or reconciling accounts, this tool gives you the correct base price and tax breakdown every time — no formulas to remember, no errors to worry about.</p>
  </div>
</CalculatorLayout>

<script>
  const amountInput = document.getElementById('calc-amount') as HTMLInputElement | null;
  const customRateInput = document.getElementById('calc-rate-custom') as HTMLInputElement | null;
  const customRateContainer = document.getElementById('custom-rate-container');
  const gstForm = document.getElementById('gst-form') as HTMLFormElement | null;

  // DOM Outputs
  const resTaxable = document.getElementById('res-taxable-val');
  const resCgstRow = document.getElementById('res-cgst-row');
  const resCgstVal = document.getElementById('res-cgst-val');
  const resSgstRow = document.getElementById('res-sgst-row');
  const resSgstVal = document.getElementById('res-sgst-val');
  const resIgstRow = document.getElementById('res-igst-row');
  const resIgstVal = document.getElementById('res-igst-val');
  const resTotalTax = document.getElementById('res-total-tax');
  const resGrandTotal = document.getElementById('res-grand-total');

  function validateInput(input: HTMLInputElement, message: string, check: () => boolean): boolean {
    const isValid = check();
    let errSpan = document.getElementById(`${input.id}-error`);
    if (!isValid) {
      input.classList.add('input-error');
      if (!errSpan) {
        errSpan = document.createElement('span');
        errSpan.id = `${input.id}-error`;
        errSpan.className = 'error-message';
        errSpan.innerText = message;
        input.parentElement?.parentElement?.appendChild(errSpan);
      }
    } else {
      input.classList.remove('input-error');
      errSpan?.remove();
    }
    return isValid;
  }

  function getSelectedRate(): number {
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    if (!rateRadio) return 18;
    if (rateRadio.value === 'custom') {
      return parseFloat(customRateInput?.value || '0') || 0;
    }
    return parseFloat(rateRadio.value) || 0;
  }

  function calculate() {
    if (!amountInput) return;

    const isAmountValid = validateInput(
      amountInput,
      "Please enter a valid price greater than 0",
      () => parseFloat(amountInput.value) > 0
    );

    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    let isRateValid = true;
    if (rateRadio?.value === 'custom' && customRateInput) {
      isRateValid = validateInput(
        customRateInput,
        "Please enter a rate between 0.1% and 100%",
        () => {
          const val = parseFloat(customRateInput.value);
          return val >= 0.1 && val <= 100;
        }
      );
    }

    if (!isAmountValid || !isRateValid) {
      if (resTaxable) resTaxable.innerText = "₹0.00";
      if (resTotalTax) resTotalTax.innerText = "₹0.00";
      if (resGrandTotal) resGrandTotal.innerText = "₹0.00";
      if (resCgstVal) resCgstVal.innerText = "₹0.00";
      if (resSgstVal) resSgstVal.innerText = "₹0.00";
      if (resIgstVal) resIgstVal.innerText = "₹0.00";
      return;
    }

    const amount = parseFloat(amountInput.value) || 0;
    const rate = getSelectedRate();
    const taxTypeRadio = document.querySelector('input[name="tax-type"]:checked') as HTMLInputElement | null;
    const isIntrastate = taxTypeRadio ? taxTypeRadio.value === 'intrastate' : true;

    // Inclusive GST logic: taxableValue = gross / (1 + (rate/100))
    const taxableValue = amount / (1 + (rate / 100));
    const totalTax = amount - taxableValue;
    const grandTotal = amount;

    // Format currency function
    const fmt = (val: number) => '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (resTaxable) resTaxable.innerText = fmt(taxableValue);
    if (resTotalTax) resTotalTax.innerText = fmt(totalTax);
    if (resGrandTotal) resGrandTotal.innerText = fmt(grandTotal);

    if (isIntrastate) {
      resCgstRow?.classList.remove('hidden');
      resSgstRow?.classList.remove('hidden');
      resIgstRow?.classList.add('hidden');
      
      const splitTax = totalTax / 2;
      if (resCgstVal) resCgstVal.innerText = fmt(splitTax);
      if (resSgstVal) resSgstVal.innerText = fmt(splitTax);
    } else {
      resCgstRow?.classList.add('hidden');
      resSgstRow?.classList.add('hidden');
      resIgstRow?.classList.remove('hidden');
      
      if (resIgstVal) resIgstVal.innerText = fmt(totalTax);
    }
  }

  // Handle prefill from URL
  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const amount = params.get('amount');
    const rate = params.get('rate');
    const taxtype = params.get('taxtype');

    if (amount && amountInput) {
      amountInput.value = amount;
    }

    if (taxtype) {
      const taxRadio = document.querySelector(`input[name="tax-type"][value="${taxtype}"]`) as HTMLInputElement | null;
      if (taxRadio) taxRadio.checked = true;
    }

    if (rate) {
      const standardRates = ['5', '12', '18', '28'];
      if (standardRates.includes(rate)) {
        const rateRadio = document.querySelector(`input[name="calc-rate"][value="${rate}"]`) as HTMLInputElement | null;
        if (rateRadio) rateRadio.checked = true;
      } else {
        const customRadio = document.getElementById('rate-custom-radio') as HTMLInputElement | null;
        if (customRadio) {
          customRadio.checked = true;
          customRateContainer?.classList.remove('hidden');
          if (customRateInput) customRateInput.value = rate;
        }
      }
    }
  }

  // Add listeners
  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  // Monitor Custom Rate visibility
  const rateRadios = document.querySelectorAll('input[name="calc-rate"]');
  rateRadios.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value === 'custom') {
        customRateContainer?.classList.remove('hidden');
        customRateInput?.focus();
      } else {
        customRateContainer?.classList.add('hidden');
        if (customRateInput) {
          customRateInput.classList.remove('input-error');
          document.getElementById('calc-rate-custom-error')?.remove();
        }
      }
      calculate();
    });
  });

  // Init
  loadFromUrl();
  calculate();
</script>
