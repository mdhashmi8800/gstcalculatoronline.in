---
import CalculatorLayout from '../../components/CalculatorLayout.astro';
import ResultCard from '../../components/ResultCard.astro';
import FAQ from '../../components/FAQ.astro';
import ToolCard from '../../components/ToolCard.astro';

const pageTitle = "GST Rate Calculator – Find Applied GST Percentage Online";
const pageDesc = "Determine the active GST tax percentage slab rate from base cost and final price/tax inputs. Free rate identifier for invoices. Simple, fast, and accurate.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": "GST Rate Calculator – Find Applied GST Percentage Online",
  "url": "https://gstcalculatoronline.in/tools/gst-rate-calculator",
  "description": "Free GST rate calculator. Find the exact GST percentage applied on any invoice by entering the base price and final price.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
};

const faqs = [
  { question: "How do I calculate the GST rate from a price?", answer: "GST Rate (%) = ((Final Price − Base Price) ÷ Base Price) × 100. Or, if you know the tax amount: GST Rate (%) = (GST Amount ÷ Base Price) × 100. Example: Base ₹10,000, Final ₹11,800 → GST = 1,800; Rate = (1800 ÷ 10000) × 100 = 18%." },
  { question: "Why do I need to calculate the applied GST rate?", answer: "You need to calculate the GST rate to: (1) Verify that a vendor has charged the correct legal GST slab, (2) Audit invoices for ITC reconciliation, (3) Determine the HSN code-based applicable rate when the supplier has not mentioned it, (4) Identify overcharging or tax fraud by suppliers." },
  { question: "What are the standard GST rates in India?", answer: "India's GST has four main positive rates: 5% (essential goods, economy services), 12% (standard goods, processed foods), 18% (most services, electronics, FMCG), 28% (luxury goods, sin goods). There are also special rates of 3% (gold/silver), 0.25% (rough precious stones), and 0% (exempt goods)." },
  { question: "What is the formula to find GST rate from invoice?", answer: "GST Rate from Invoice = ((Invoice Total − Base Price) ÷ Base Price) × 100. Or from tax amount: GST Rate = (Tax Amount ÷ Base Price) × 100. Our GST Rate Calculator automates this for both input methods." },
  { question: "How to verify the GST rate on a purchase invoice?", answer: "Check the tax invoice for: (1) The HSN/SAC code, (2) The CGST rate and SGST rate separately (they should be equal), (3) Total GST rate = CGST rate + SGST rate. Then verify using this calculator: if the base price and total match the expected rate, the invoice is correct." },
  { question: "What if the GST rate on an invoice doesn't match the standard slabs?", answer: "If the calculated rate doesn't match 5%, 12%, 18%, or 28%, there may be: (1) An incorrect HSN code on the invoice, (2) Mathematical errors in the invoice, (3) A special rate that applies (e.g., 3% for gold, 0.25% for rough diamonds), (4) Tax fraud. Consult the GST rate schedule or a tax professional." },
  { question: "How do I find the GST rate for my product or service?", answer: "Look up the HSN (Harmonized System of Nomenclature) code for goods or SAC (Service Accounting Code) for services in the GST rate schedule published by the CBIC at gst.gov.in. The applicable GST rate is listed against each HSN/SAC code." },
  { question: "What is the GST rate for services in India?", answer: "Most services attract 18% GST in India. Specific rates include: Restaurant services — 5% (without ITC) or 18% (AC restaurant with alcohol license); Healthcare services — 0% (exempt); Educational services — 0% (exempt); Financial services — 18%; IT and software services — 18%." },
  { question: "How is CGST and SGST rate split for any GST rate?", answer: "CGST and SGST are always equal: each is half of the total GST rate. So at 18% total: CGST = 9% + SGST = 9%. At 12%: CGST = 6% + SGST = 6%. At 5%: CGST = 2.5% + SGST = 2.5%. For interstate transactions, the full rate is IGST." },
  { question: "Can the GST rate be different for the same product in different states?", answer: "No. Under India's unified GST framework, the GST rate for a product or service is the same across all states. What differs is only the split: intrastate transactions use CGST + SGST (at same combined rate), while interstate uses IGST. The total tax burden is identical." },
  { question: "Is this GST Rate Calculator free?", answer: "Yes, completely free. Enter the base price and final price (or tax amount), and get the exact GST percentage applied. No login, no registration, no charges. Useful for invoice auditing, ITC reconciliation, and tax compliance verification." }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema} faqs={faqs}>
  <!-- Calculator Input Form -->
  <form id="gst-form" class="space-y-4 md:space-y-6">
    <!-- Input Mode -->
    <div>
      <span class="block text-sm font-semibold text-ink mb-2">Calculation Method</span>
      <div class="segmented-control" role="group" aria-label="Calculation method">
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="calc-method" value="gross" checked class="sr-only" />
          <span>Base & Gross Price</span>
        </label>
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="calc-method" value="tax" class="sr-only" />
          <span>Base & GST Amount</span>
        </label>
      </div>
    </div>

    <!-- Base Value (Exclusive of GST) -->
    <div>
      <label for="calc-base" class="block text-sm font-semibold text-ink">Base Taxable Price / Net Amount (₹)</label>
      <div class="relative mt-2 rounded-lg shadow-xs">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-mute">
          <span class="text-xs font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="baseAmount" 
          id="calc-base" 
          value="10000" 
          min="1" 
          step="any"
          class="block w-full rounded-lg border border-hairline bg-canvas py-3 pl-8 pr-4 text-base text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary font-mono transition-all"
          placeholder="e.g. 10000"
          required
        />
      </div>
    </div>

    <!-- Secondary Input (Gross Price or Tax Amount) -->
    <div>
      <label for="calc-secondary" id="secondary-label" class="block text-sm font-semibold text-ink">Gross Final Price / Inclusive Amount (₹)</label>
      <div class="relative mt-2 rounded-lg shadow-xs">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-mute">
          <span class="text-xs font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="secondaryAmount" 
          id="calc-secondary" 
          value="11800" 
          min="1" 
          step="any"
          class="block w-full rounded-lg border border-hairline bg-canvas py-3 pl-8 pr-4 text-base text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary font-mono transition-all"
          placeholder="e.g. 11800"
          required
        />
      </div>
    </div>
  </form>

  <!-- Results Block -->
  <ResultCard slot="results" title="GST Rate Summary" showEffectiveTax={false} showChart={false} />

  <!-- Educational content -->
  <div slot="content" class="prose max-w-none">
    <h2>How to Calculate the Applied GST Rate Percentage</h2>
    <p>Calculating the GST rate helps consumers and auditors verify if invoices have been computed accurately. In India, products and services are mapped to specific GST slabs. Any variance in the computed tax rate could indicate billing errors or non-compliance.</p>
    
    <h3>Calculations Formulas</h3>
    <div class="my-4 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed space-y-4">
      <div>
        <p class="font-semibold text-brand-link">1. Using Base & Gross Final Prices:</p>
        <p>GST Rate (%) = [(Gross Price - Base Price) / Base Price] × 100</p>
      </div>
      <div class="border-t border-hairline/50 pt-4">
        <p class="font-semibold text-brand-link">2. Using Base Price & Direct GST Tax Amount:</p>
        <p>GST Rate (%) = [GST Tax Amount / Base Price] × 100</p>
      </div>
    </div>
    <h2>Find Applied GST Rate on Any Invoice</h2>
    <p>Ever received an invoice and wondered: <em>is the GST rate correct?</em> Our free <strong>GST Rate Calculator online</strong> helps you instantly verify the applied GST percentage on any invoice. Just enter the base price and the final invoice amount (or the tax amount directly), and the calculator shows you the exact rate applied — whether it is 5%, 12%, 18%, 28%, or any custom rate.</p>

    <h2>GST Rate Formulas</h2>
    <div class="my-4 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed space-y-4">
      <div>
        <p class="font-semibold text-brand-link">Method 1 — Base Price & Final Price:</p>
        <p>GST Amount = Final Price − Base Price</p>
        <p>GST Rate (%) = (GST Amount ÷ Base Price) × 100</p>
      </div>
      <div class="border-t border-hairline/50 pt-4">
        <p class="font-semibold text-brand-link">Method 2 — Base Price & Tax Amount:</p>
        <p>GST Rate (%) = (Tax Amount ÷ Base Price) × 100</p>
      </div>
    </div>

    <h2>Calculation Examples</h2>
    <h3>Example 1 — Services Invoice (18% GST)</h3>
    <ul>
      <li>Base Price: ₹10,000</li>
      <li>Final Invoice: ₹11,800</li>
      <li>GST Amount: 11,800 − 10,000 = <strong>₹1,800</strong></li>
      <li>GST Rate: (1,800 ÷ 10,000) × 100 = <strong>18%</strong></li>
    </ul>

    <h3>Example 2 — Packaged Foods (5% GST)</h3>
    <ul>
      <li>Base Price: ₹20,000</li>
      <li>GST Amount: ₹1,000</li>
      <li>GST Rate: (1,000 ÷ 20,000) × 100 = <strong>5%</strong></li>
    </ul>

    <h2>Standard GST Rates in India</h2>
    <div class="overflow-x-auto my-4">
      <table class="w-full text-sm border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-canvas-soft-2">
          <tr>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Rate</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Example Categories</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-hairline/50"><td class="p-3 font-mono font-bold text-primary">5%</td><td class="p-3 text-body">Essential food, economy transport, agricultural equipment</td></tr>
          <tr class="border-b border-hairline/50 bg-canvas-soft/30"><td class="p-3 font-mono font-bold text-primary">12%</td><td class="p-3 text-body">Computers, mobile phones, processed food, business services</td></tr>
          <tr class="border-b border-hairline/50"><td class="p-3 font-mono font-bold text-primary">18%</td><td class="p-3 text-body">Most services, software, electronics, FMCG products</td></tr>
          <tr class="border-b border-hairline/50 bg-canvas-soft/30"><td class="p-3 font-mono font-bold text-primary">28%</td><td class="p-3 text-body">Luxury cars, cement, aerated drinks, tobacco products</td></tr>
          <tr class="border-b border-hairline/50"><td class="p-3 font-mono font-bold text-primary">3%</td><td class="p-3 text-body">Gold, silver, precious metals</td></tr>
          <tr class="bg-canvas-soft/30"><td class="p-3 font-mono font-bold text-primary">0%</td><td class="p-3 text-body">Fresh vegetables, milk, healthcare, education (exempt)</td></tr>
        </tbody>
      </table>
    </div>

    <FAQ items={faqs} />

    <h2>Related Calculators</h2>
    <ul>
      <li><a href="/tools/gst-calculator">GST Calculator Online</a> — Add or remove GST using a known rate</li>
      <li><a href="/tools/gst-inclusive-calculator">GST Inclusive Calculator</a> — Extract GST from MRP price</li>
      <li><a href="/tools/gst-exclusive-calculator">GST Exclusive Calculator</a> — Add GST to base price</li>
    </ul>

    <h2>Conclusion</h2>
    <p>The <strong>GST Rate Calculator online</strong> is your quick verification tool for any invoice. Whether you are a buyer auditing a supplier's bill, a CA reconciling ITC claims, or a business owner reviewing invoices, this tool ensures the correct GST rate has been applied every time. Use it alongside our complete suite of free GST calculators at gstcalculatoronline.in.</p>
  </div>
</CalculatorLayout>

<script>
  const baseInput = document.getElementById('calc-base') as HTMLInputElement | null;
  const secondaryInput = document.getElementById('calc-secondary') as HTMLInputElement | null;
  const secondaryLabel = document.getElementById('secondary-label');
  const gstForm = document.getElementById('gst-form') as HTMLFormElement | null;
  const methodRadios = document.querySelectorAll('input[name="calc-method"]');

  // DOM Outputs
  const resTaxable = document.getElementById('res-taxable-val');
  const resCgstVal = document.getElementById('res-cgst-val');
  const resTotalTax = document.getElementById('res-total-tax');
  const resGrandTotal = document.getElementById('res-grand-total');

  function validateInput(input: HTMLInputElement, message: string, check: () => boolean): boolean {
    const isValid = check();
    let errSpan = document.getElementById(`${input.id}-error`);
    if (!isValid) {
      input.classList.add('input-error');
      if (!errSpan) {
        errSpan = document.createElement('span');
        errSpan.id = `${input.id}-error`;
        errSpan.className = 'error-message';
        errSpan.innerText = message;
        input.parentElement?.parentElement?.appendChild(errSpan);
      }
    } else {
      input.classList.remove('input-error');
      errSpan?.remove();
    }
    return isValid;
  }

  function updateFormUI() {
    const methodRadio = document.querySelector('input[name="calc-method"]:checked') as HTMLInputElement | null;
    if (!methodRadio || !secondaryLabel || !secondaryInput) return;

    if (methodRadio.value === 'gross') {
      secondaryLabel.innerText = "Gross Final Price / Inclusive Amount (₹)";
      secondaryInput.value = "11800";
    } else {
      secondaryLabel.innerText = "GST Tax Amount (₹)";
      secondaryInput.value = "1800";
    }
  }

  function calculate() {
    if (!baseInput || !secondaryInput) return;

    const methodRadio = document.querySelector('input[name="calc-method"]:checked') as HTMLInputElement | null;
    const method = methodRadio ? methodRadio.value : 'gross';

    const isBaseValid = validateInput(
      baseInput,
      "Please enter a valid base price greater than 0",
      () => parseFloat(baseInput.value) > 0
    );

    const isSecondaryValid = validateInput(
      secondaryInput,
      method === 'gross' 
        ? "Please enter a gross price greater than base price" 
        : "Please enter a valid GST tax amount greater than 0",
      () => {
        const base = parseFloat(baseInput.value) || 0;
        const sec = parseFloat(secondaryInput.value) || 0;
        if (method === 'gross') {
          return sec > base;
        }
        return sec > 0;
      }
    );

    if (!isBaseValid || !isSecondaryValid) {
      if (resTaxable) resTaxable.innerText = "0.00%";
      if (resCgstVal) resCgstVal.innerText = "₹0.00";
      if (resTotalTax) resTotalTax.innerText = "₹0.00";
      if (resGrandTotal) resGrandTotal.innerText = "₹0.00";
      return;
    }

    const base = parseFloat(baseInput.value) || 0;
    const sec = parseFloat(secondaryInput.value) || 0;

    let rate = 0;
    let totalTax = 0;
    let grandTotal = 0;

    if (method === 'gross') {
      totalTax = sec - base;
      rate = (totalTax / base) * 100;
      grandTotal = sec;
    } else {
      totalTax = sec;
      rate = (totalTax / base) * 100;
      grandTotal = base + totalTax;
    }

    // Format outputs
    const fmtRate = (val: number) => val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '%';
    const fmtCurrency = (val: number) => '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (resTaxable) resTaxable.innerText = fmtRate(rate);
    if (resCgstVal) resCgstVal.innerText = fmtCurrency(base);
    if (resTotalTax) resTotalTax.innerText = fmtCurrency(totalTax);
    if (resGrandTotal) resGrandTotal.innerText = fmtCurrency(grandTotal);
  }

  function customizeLabels() {
    const labelTaxable = document.querySelector('#res-taxable-val')?.previousElementSibling as HTMLElement | null;
    const labelCgst = document.querySelector('#res-cgst-val')?.previousElementSibling as HTMLElement | null;
    const labelTotalTax = document.querySelector('#res-total-tax')?.previousElementSibling as HTMLElement | null;
    const labelGrandTotal = document.querySelector('#res-grand-total')?.previousElementSibling as HTMLElement | null;

    if (labelTaxable) labelTaxable.innerText = "Calculated GST Rate";
    if (labelCgst) labelCgst.innerText = "Taxable Base Value (Net)";
    if (labelTotalTax) labelTotalTax.innerText = "Total GST Tax Amount";
    if (labelGrandTotal) labelGrandTotal.innerText = "Gross Invoice Value";

    // Hide SGST and IGST rows as we represent CGST/SGST collectively in the Base/Tax layout
    document.getElementById('res-sgst-row')?.classList.add('hidden');
    document.getElementById('res-igst-row')?.classList.add('hidden');
  }

  // Handle prefill from URL
  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const base = params.get('base');
    const sec = params.get('sec');
    const method = params.get('method');

    if (method) {
      const radio = document.querySelector(`input[name="calc-method"][value="${method}"]`) as HTMLInputElement | null;
      if (radio) radio.checked = true;
    }

    updateFormUI();

    if (base && baseInput) baseInput.value = base;
    if (sec && secondaryInput) secondaryInput.value = sec;
  }

  // Add listeners
  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  methodRadios.forEach((radio) => {
    radio.addEventListener('change', () => {
      updateFormUI();
      calculate();
    });
  });

  // Init
  customizeLabels();
  loadFromUrl();
  calculate();
</script>
