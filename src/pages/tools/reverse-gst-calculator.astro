---
import CalculatorLayout from '../../components/CalculatorLayout.astro';
import ResultCard from '../../components/ResultCard.astro';
import FAQ from '../../components/FAQ.astro';
import ToolCard from '../../components/ToolCard.astro';

const pageTitle = "Reverse GST Calculator Online — Remove GST & Find Original Price";
const pageDesc = "Use our free Reverse GST Calculator online to find the original base price of any product or service from its GST-inclusive total. Instantly extracts CGST, SGST, and IGST. Works for all Indian tax slabs — 5%, 12%, 18%, 28%.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Reverse GST Calculator Online",
  "url": "https://gstcalculatoronline.in/tools/reverse-gst-calculator",
  "description": "Free reverse GST calculator for India. Remove GST from any inclusive price and find the original base value with CGST/SGST/IGST breakdown.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
};

const faqs = [
  { question: "What is Reverse GST Calculator Online?", answer: "A Reverse GST Calculator Online is a free digital tool that helps you find the original price of a product or service before GST was applied. You enter the final GST-inclusive amount and the applicable tax rate, and the calculator instantly shows you the net taxable base value, total GST amount, and the CGST/SGST/IGST split." },
  { question: "What is Reverse GST calculation?", answer: "A reverse GST calculation works backwards from the final invoice price (which includes GST) to find the original pre-tax base price. This is also called the 'GST inclusive calculation' or 'removing GST from price.' It is commonly used by retailers, accountants, and consumers to verify correct pricing on invoices." },
  { question: "What is the formula to remove GST in India?", answer: "The formula to remove GST: Base Price = GST Inclusive Amount ÷ (1 + GST Rate ÷ 100). Then GST Amount = Inclusive Amount − Base Price. Example: For ₹11,800 inclusive of 18% GST: Base Price = 11,800 ÷ 1.18 = ₹10,000. GST = ₹1,800." },
  { question: "How to calculate GST inclusive price in India?", answer: "To calculate from a GST inclusive price, use: Net Value = Total Price ÷ (1 + GST%/100). For ₹5,900 at 18% GST: Net = 5,900 ÷ 1.18 = ₹5,000. GST Amount = ₹900. Our reverse GST calculator handles this automatically for all slabs." },
  { question: "How to remove 18% GST from a price?", answer: "To remove 18% GST from an inclusive price, divide by 1.18. Example: If the inclusive price is ₹23,600, then: Base Price = 23,600 ÷ 1.18 = ₹20,000. GST Amount = ₹3,600. CGST = SGST = ₹1,800 each for intrastate supply." },
  { question: "How to reverse calculate 12% GST?", answer: "To reverse calculate 12% GST from an inclusive price, divide by 1.12. Example: For ₹11,200 at 12%: Base Price = 11,200 ÷ 1.12 = ₹10,000. GST = ₹1,200. CGST = SGST = ₹600 each." },
  { question: "How to remove 5% GST from a price?", answer: "To remove 5% GST from a price, divide by 1.05. Example: ₹10,500 inclusive of 5% GST: Base Price = 10,500 ÷ 1.05 = ₹10,000. GST Amount = ₹500. CGST = SGST = ₹250 each." },
  { question: "Can I split the reverse GST into CGST and SGST?", answer: "Yes. Once the total GST amount is calculated using the reverse formula, it is split equally (50:50) into CGST and SGST for intrastate transactions. For interstate transactions, the full amount is IGST. Our calculator handles this split automatically." },
  { question: "When should I use a Reverse GST Calculator?", answer: "Use a reverse GST calculator when: (1) You have a GST-inclusive retail price and need the base taxable value, (2) You want to verify the GST component on a received invoice, (3) You are auditing accounts and need to separate tax from total receipts, (4) You need to determine profit margins on goods sold at MRP." },
  { question: "Is reverse GST the same as GST inclusive calculation?", answer: "Yes, reverse GST and GST inclusive calculation refer to the same process — deriving the net taxable base price from a total that already includes GST. Both use the formula: Base Value = Inclusive Price ÷ (1 + GST Rate/100)." },
  { question: "Why is the reverse GST amount different from simply applying GST% on the inclusive price?", answer: "Because GST is calculated on the base price, not the final price. If you apply 18% to ₹11,800, you get ₹2,124 — wrong. The correct method: ₹11,800 ÷ 1.18 = ₹10,000 base, GST = ₹1,800. Always use the division formula." },
  { question: "What is the difference between GST exclusive and GST inclusive price?", answer: "A GST exclusive price is the base price before any tax is added. A GST inclusive price is the final price after GST has already been added. In India, retail MRP is usually GST inclusive. Use the reverse calculator to find the exclusive (pre-tax) price." },
  { question: "How to do reverse GST calculation for 28%?", answer: "To remove 28% GST from an inclusive price, divide by 1.28. Example: ₹12,800 inclusive of 28% GST: Base Price = 12,800 ÷ 1.28 = ₹10,000. GST Amount = ₹2,800. For intrastate supply: CGST = SGST = ₹1,400 each." },
  { question: "Can I use reverse GST calculation for gold (3% GST)?", answer: "Yes. Enter the inclusive price and select Custom rate, then type 3. For example: ₹1,03,000 inclusive of 3% GST → Base Price = 1,03,000 ÷ 1.03 = ₹1,00,000. GST = ₹3,000." },
  { question: "Is this reverse GST calculator free?", answer: "Yes, this reverse GST calculator is completely free to use. No registration, no login, no charges. Calculate as many times as you need, for any amount and any GST rate." },
  { question: "How is reverse GST calculation used in business?", answer: "Businesses use reverse GST calculations for: invoice reconciliation, profit margin analysis when selling at MRP, input tax credit base value calculations, and accounting entries separating tax from total receipts." }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema} faqs={faqs}>
  <!-- Calculator Input Form -->
  <form id="gst-form" class="space-y-4 md:space-y-6">
    <!-- Gross Price (GST Inclusive) -->
    <div>
      <label for="calc-amount" class="block text-sm font-semibold text-ink">Total Final Price / Gross Amount (₹)</label>
      <div class="relative mt-2 rounded-lg shadow-xs">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-mute">
          <span class="text-xs font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="amount" 
          id="calc-amount" 
          value="11800" 
          min="1" 
          step="any"
          class="block w-full rounded-lg border border-hairline bg-canvas py-3 pl-8 pr-4 text-base text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary font-mono transition-all"
          placeholder="e.g. 11800"
          required
        />
      </div>
      <p class="mt-1 text-xs text-mute">This is the final invoice amount that already contains GST.</p>
    </div>

    <!-- GST Tax Slab Rates -->
    <div>
      <span class="block text-sm font-semibold text-ink">GST Tax Rate (%)</span>
      <div class="rate-pill-container sm:grid sm:grid-cols-5 gap-2">
        {['5', '12', '18', '28'].map((rate) => (
          <label class="flex items-center justify-center rounded-lg border border-hairline bg-canvas py-2.5 cursor-pointer text-sm font-semibold text-body hover:bg-canvas-soft-2 [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink font-mono select-none">
            <input type="radio" name="calc-rate" value={rate} checked={rate === '18'} class="sr-only" />
            <span>{rate}%</span>
          </label>
        ))}
        <label class="flex items-center justify-center rounded-lg border border-hairline bg-canvas py-2.5 cursor-pointer text-sm font-semibold text-body hover:bg-canvas-soft-2 [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink select-none">
          <input type="radio" name="calc-rate" id="rate-custom-radio" value="custom" class="sr-only" />
          <span>Custom</span>
        </label>
      </div>
      
      <!-- Custom Rate Input (Hidden by default) -->
      <div id="custom-rate-container" class="hidden mt-3">
        <label for="calc-rate-custom" class="sr-only">Custom GST Rate (%)</label>
        <div class="relative rounded-lg shadow-xs">
          <input 
            type="number" 
            name="custom-rate" 
            id="calc-rate-custom" 
            min="0.1" 
            max="100" 
            step="any"
            value="18"
            class="block w-full rounded-lg border border-hairline bg-canvas py-2 px-3 text-sm text-ink outline-hidden focus:border-hairline-strong font-mono"
            placeholder="Enter custom rate e.g. 3"
          />
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-mute">
            <span class="text-xs font-mono">%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Supply Destination -->
    <div>
      <span class="block text-sm font-semibold text-ink mb-2">Supply Location</span>
      <div class="segmented-control" role="group" aria-label="Transaction type">
        <label class="segmented-btn cursor-pointer [&:has(input:checked)]:bg-canvas-soft [&:has(input:checked)]:text-ink [&:has(input:checked)]:shadow-sm">
          <input type="radio" name="tax-type" value="intrastate" checked class="sr-only" />
          <span>Intrastate <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(CGST+SGST)</span></span>
        </label>
        <label class="segmented-btn cursor-pointer [&:has(input:checked)]:bg-canvas-soft [&:has(input:checked)]:text-ink [&:has(input:checked)]:shadow-sm">
          <input type="radio" name="tax-type" value="interstate" class="sr-only" />
          <span>Interstate <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(IGST)</span></span>
        </label>
      </div>
    </div>
  </form>

  <!-- Results Block -->
  <ResultCard slot="results" title="Reverse Calculation Summary" />

  <!-- Educational content: 1300+ words, SEO optimized -->
  <div slot="content" class="prose max-w-none">
    <h2>Reverse GST Calculator Online — Complete Guide</h2>
    <p>When you receive a bill or see a product price tag in India, the amount usually <em>includes GST</em>. To find out how much of that price is actually the base value (before tax) and how much is tax, you need a <strong>reverse GST calculator online</strong>. This free tool does exactly that — it extracts the GST component from any GST-inclusive price and gives you the net taxable value along with a CGST/SGST or IGST breakdown.</p>

    <p>This is different from simply applying the GST percentage to the inclusive price. The reverse GST formula uses division, not multiplication, which gives a different — and correct — result. This calculator follows the official methodology prescribed under the CGST Act, 2017 and is used by CAs, accountants, retailers, and everyday shoppers across India.</p>

    <h2>What Is a Reverse GST Calculator?</h2>
    <p>A <strong>reverse GST calculator</strong> (also known as a GST inclusive calculator or GST backwards calculator) is a tool that helps you work backwards from a GST-inclusive price to find:</p>
    <ul>
      <li>The <strong>original base price</strong> (net taxable value before tax)</li>
      <li>The <strong>total GST amount</strong> embedded in the final price</li>
      <li>The <strong>CGST and SGST split</strong> for intrastate transactions</li>
      <li>The <strong>IGST amount</strong> for interstate transactions</li>
    </ul>
    <p>It is called "reverse" because it reverses the standard GST addition process. Instead of multiplying base price by the GST rate, you divide the inclusive price by a factor to separate the tax from the base value.</p>

    <h2>How the Reverse GST Calculator Works</h2>
    <p>This calculator performs the reverse computation in real time. As you enter the inclusive price and select the GST rate, the results update instantly — showing the net base value, GST amount, and the CGST/SGST or IGST split depending on whether you select intrastate or interstate supply.</p>

    <h2>Reverse GST Formula — How to Remove GST from Price</h2>
    <div class="my-4 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed space-y-4">
      <div>
        <p class="font-semibold text-brand-link">Reverse GST Formula (Removing GST from Inclusive Price):</p>
        <p>Base (Net) Value = Inclusive Price ÷ (1 + GST Rate ÷ 100)</p>
        <p>GST Amount = Inclusive Price − Base Value</p>
        <p>CGST = SGST = GST Amount ÷ 2 (for intrastate)</p>
        <p>IGST = GST Amount (for interstate)</p>
      </div>
      <div class="border-t border-hairline/50 pt-4">
        <p class="font-semibold text-brand-link">Quick Reference Divisors:</p>
        <p>5% GST: divide by 1.05 &nbsp;|&nbsp; 12% GST: divide by 1.12</p>
        <p>18% GST: divide by 1.18 &nbsp;|&nbsp; 28% GST: divide by 1.28</p>
      </div>
    </div>

    <h2>Step-by-Step Guide — How to Use This Reverse GST Calculator</h2>
    <ol>
      <li><strong>Enter the GST-inclusive final price</strong> — This is the total amount you see on the invoice or price tag that already includes GST.</li>
      <li><strong>Select the GST Rate</strong> — Choose 5%, 12%, 18%, or 28%, or click Custom for rates like 3% (gold) or 0.25%.</li>
      <li><strong>Choose Supply Location</strong> — Select Intrastate for same-state transactions (shows CGST + SGST split) or Interstate for cross-state transactions (shows IGST).</li>
      <li><strong>Read the results instantly</strong> — The calculator shows Net Taxable Value, Total GST, CGST, SGST or IGST, and the Grand Total (same as your input).</li>
    </ol>

    <h2>Reverse GST Calculation Examples</h2>
    <h3>Example 1 — Remove 18% GST from ₹11,800</h3>
    <p>A customer paid ₹11,800 for a smartphone. The invoice says 18% GST is included. What is the base price before tax?</p>
    <ul>
      <li>Inclusive Price: ₹11,800</li>
      <li>Base Value: 11,800 ÷ 1.18 = <strong>₹10,000</strong></li>
      <li>GST Amount: 11,800 − 10,000 = <strong>₹1,800</strong></li>
      <li>CGST (9%): <strong>₹900</strong> &nbsp;|&nbsp; SGST (9%): <strong>₹900</strong></li>
    </ul>

    <h3>Example 2 — Remove 12% GST from a Restaurant Bill</h3>
    <p>A hotel charges ₹22,400 for catering services (12% GST inclusive). Find the net service charge.</p>
    <ul>
      <li>Inclusive Amount: ₹22,400</li>
      <li>Base Value: 22,400 ÷ 1.12 = <strong>₹20,000</strong></li>
      <li>GST Amount: <strong>₹2,400</strong></li>
      <li>CGST (6%): <strong>₹1,200</strong> &nbsp;|&nbsp; SGST (6%): <strong>₹1,200</strong></li>
    </ul>

    <h3>Business Example — Reverse GST for ITC Claims</h3>
    <p>A business buys raw materials worth ₹5,90,000 (inclusive of 18% GST) from a Maharashtra supplier for use in its Pune factory (intrastate). For Input Tax Credit purposes, it needs the net taxable value.</p>
    <ul>
      <li>Inclusive Amount: ₹5,90,000</li>
      <li>Base Value: 5,90,000 ÷ 1.18 = <strong>₹5,00,000</strong></li>
      <li>CGST Claimable: <strong>₹45,000</strong> &nbsp;|&nbsp; SGST Claimable: <strong>₹45,000</strong></li>
      <li>Total ITC Available: <strong>₹90,000</strong></li>
    </ul>

    <h2>Common GST Rates & Their Reverse Divisors</h2>
    <div class="overflow-x-auto my-4">
      <table class="w-full text-sm border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-canvas-soft-2">
          <tr>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">GST Rate</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Reverse Divisor</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Example (₹10,000 inclusive)</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-hairline/50"><td class="p-3 font-mono font-bold text-primary">3%</td><td class="p-3 font-mono">÷ 1.03</td><td class="p-3 text-body">Base = ₹9,708.74; GST = ₹291.26</td></tr>
          <tr class="border-b border-hairline/50 bg-canvas-soft/30"><td class="p-3 font-mono font-bold text-primary">5%</td><td class="p-3 font-mono">÷ 1.05</td><td class="p-3 text-body">Base = ₹9,523.81; GST = ₹476.19</td></tr>
          <tr class="border-b border-hairline/50"><td class="p-3 font-mono font-bold text-primary">12%</td><td class="p-3 font-mono">÷ 1.12</td><td class="p-3 text-body">Base = ₹8,928.57; GST = ₹1,071.43</td></tr>
          <tr class="border-b border-hairline/50 bg-canvas-soft/30"><td class="p-3 font-mono font-bold text-primary">18%</td><td class="p-3 font-mono">÷ 1.18</td><td class="p-3 text-body">Base = ₹8,474.58; GST = ₹1,525.42</td></tr>
          <tr class="bg-canvas-soft/30"><td class="p-3 font-mono font-bold text-primary">28%</td><td class="p-3 font-mono">÷ 1.28</td><td class="p-3 text-body">Base = ₹7,812.50; GST = ₹2,187.50</td></tr>
        </tbody>
      </table>
    </div>

    <h2>CGST vs SGST vs IGST in Reverse GST Calculations</h2>
    <p>Once the total GST amount is calculated using the reverse formula, it is distributed between CGST and SGST (for intrastate) or treated as IGST (for interstate). Here is how the split works:</p>
    <div class="overflow-x-auto my-4">
      <table class="w-full text-sm border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-canvas-soft-2">
          <tr>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Transaction Type</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Tax Structure</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">At 18% (on ₹10,000 base)</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-hairline/50"><td class="p-3 text-body">Intrastate (Within same state)</td><td class="p-3 text-body">CGST + SGST</td><td class="p-3 font-mono">CGST ₹900 + SGST ₹900</td></tr>
          <tr class="bg-canvas-soft/30"><td class="p-3 text-body">Interstate (Different states)</td><td class="p-3 text-body">IGST only</td><td class="p-3 font-mono">IGST ₹1,800</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Benefits of Using This Reverse GST Calculator</h2>
    <ul>
      <li><strong>Instant results</strong> — No waiting; calculations happen as you type</li>
      <li><strong>Accurate formula</strong> — Uses the correct division method, not multiplication</li>
      <li><strong>All GST slabs</strong> — Works for 5%, 12%, 18%, 28%, and custom rates</li>
      <li><strong>CGST/SGST auto-split</strong> — Automatically divides intrastate GST equally</li>
      <li><strong>Useful for ITC</strong> — Get the exact net taxable value for input credit claims</li>
      <li><strong>Free and private</strong> — No data stored; all computation is local</li>
    </ul>

    <h2>Common Mistakes to Avoid in Reverse GST Calculation</h2>
    <ul>
      <li><strong>Applying GST% directly to the inclusive price</strong> — This is wrong. Always use the division formula, not multiplication.</li>
      <li><strong>Using the wrong GST rate</strong> — Verify the applicable rate for the specific goods or service category.</li>
      <li><strong>Ignoring interstate vs intrastate distinction</strong> — The total tax is the same but the ledger entries differ (CGST/SGST vs IGST).</li>
      <li><strong>Rounding errors</strong> — Always round to 2 decimal places in your accounts. Our calculator does this automatically.</li>
    </ul>

    <FAQ items={faqs} />

    <h2>Related Calculators</h2>
    <ul>
      <li><a href="/tools/gst-calculator">GST Calculator Online</a> — Add GST to a base price</li>
      <li><a href="/tools/gst-inclusive-calculator">GST Inclusive Calculator</a> — For tax-inclusive pricing scenarios</li>
      <li><a href="/tools/gst-split-calculator">GST Split Calculator</a> — Divide GST into CGST and SGST</li>
      <li><a href="/tools/igst-calculator">IGST Calculator</a> — For interstate transaction reverse calculations</li>
    </ul>

    <h2>Related Articles</h2>
    <ul>
      <li><a href="/blog/what-is-gst">What is GST — Complete Beginner's Guide</a></li>
      <li><a href="/blog/cgst-sgst-igst-explained">CGST, SGST and IGST Explained</a></li>
      <li><a href="/blog/input-tax-credit-itc-rules">Input Tax Credit (ITC) Rules — How to Claim GST Refunds</a></li>
    </ul>

    <h2>Conclusion</h2>
    <p>A <strong>reverse GST calculator online</strong> is an essential tool for anyone dealing with GST-inclusive pricing in India. Whether you are verifying an invoice, calculating ITC for your business, or simply understanding what you paid in taxes on your last purchase, this free tool gives you instant and accurate answers. Bookmark this page as your go-to <strong>GST calculator online including tax</strong> reference — it is always free and always precise.</p>
  </div>
</CalculatorLayout>

<script>
  const amountInput = document.getElementById('calc-amount') as HTMLInputElement | null;
  const customRateInput = document.getElementById('calc-rate-custom') as HTMLInputElement | null;
  const customRateContainer = document.getElementById('custom-rate-container');
  const gstForm = document.getElementById('gst-form') as HTMLFormElement | null;

  // DOM Outputs
  const resTaxable = document.getElementById('res-taxable-val');
  const resCgstRow = document.getElementById('res-cgst-row');
  const resCgstVal = document.getElementById('res-cgst-val');
  const resSgstRow = document.getElementById('res-sgst-row');
  const resSgstVal = document.getElementById('res-sgst-val');
  const resIgstRow = document.getElementById('res-igst-row');
  const resIgstVal = document.getElementById('res-igst-val');
  const resTotalTax = document.getElementById('res-total-tax');
  const resGrandTotal = document.getElementById('res-grand-total');

  function validateInput(input: HTMLInputElement, message: string, check: () => boolean): boolean {
    const isValid = check();
    let errSpan = document.getElementById(`${input.id}-error`);
    if (!isValid) {
      input.classList.add('input-error');
      if (!errSpan) {
        errSpan = document.createElement('span');
        errSpan.id = `${input.id}-error`;
        errSpan.className = 'error-message';
        errSpan.innerText = message;
        input.parentElement?.parentElement?.appendChild(errSpan);
      }
    } else {
      input.classList.remove('input-error');
      errSpan?.remove();
    }
    return isValid;
  }

  function getSelectedRate(): number {
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    if (!rateRadio) return 18;
    if (rateRadio.value === 'custom') {
      return parseFloat(customRateInput?.value || '0') || 0;
    }
    return parseFloat(rateRadio.value) || 0;
  }

  function calculate() {
    if (!amountInput) return;

    const isAmountValid = validateInput(
      amountInput,
      "Please enter a valid final price greater than 0",
      () => parseFloat(amountInput.value) > 0
    );

    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    let isRateValid = true;
    if (rateRadio?.value === 'custom' && customRateInput) {
      isRateValid = validateInput(
        customRateInput,
        "Please enter a rate between 0.1% and 100%",
        () => {
          const val = parseFloat(customRateInput.value);
          return val >= 0.1 && val <= 100;
        }
      );
    }

    if (!isAmountValid || !isRateValid) {
      if (resTaxable) resTaxable.innerText = "₹0.00";
      if (resTotalTax) resTotalTax.innerText = "₹0.00";
      if (resGrandTotal) resGrandTotal.innerText = "₹0.00";
      if (resCgstVal) resCgstVal.innerText = "₹0.00";
      if (resSgstVal) resSgstVal.innerText = "₹0.00";
      if (resIgstVal) resIgstVal.innerText = "₹0.00";
      return;
    }

    const amount = parseFloat(amountInput.value) || 0;
    const rate = getSelectedRate();
    const taxTypeRadio = document.querySelector('input[name="tax-type"]:checked') as HTMLInputElement | null;
    const isIntrastate = taxTypeRadio ? taxTypeRadio.value === 'intrastate' : true;

    // Reverse GST calculation: original amount = gross / (1 + (rate / 100))
    const taxableValue = amount / (1 + (rate / 100));
    const totalTax = amount - taxableValue;
    const grandTotal = amount;

    // Format currency function
    const fmt = (val: number) => '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (resTaxable) resTaxable.innerText = fmt(taxableValue);
    if (resTotalTax) resTotalTax.innerText = fmt(totalTax);
    if (resGrandTotal) resGrandTotal.innerText = fmt(grandTotal);

    if (isIntrastate) {
      resCgstRow?.classList.remove('hidden');
      resSgstRow?.classList.remove('hidden');
      resIgstRow?.classList.add('hidden');
      
      const splitTax = totalTax / 2;
      if (resCgstVal) resCgstVal.innerText = fmt(splitTax);
      if (resSgstVal) resSgstVal.innerText = fmt(splitTax);
    } else {
      resCgstRow?.classList.add('hidden');
      resSgstRow?.classList.add('hidden');
      resIgstRow?.classList.remove('hidden');
      
      if (resIgstVal) resIgstVal.innerText = fmt(totalTax);
    }
  }

  // Handle prefill from URL
  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const amount = params.get('amount');
    const rate = params.get('rate');
    const taxtype = params.get('taxtype');

    if (amount && amountInput) {
      amountInput.value = amount;
    }

    if (taxtype) {
      const taxRadio = document.querySelector(`input[name="tax-type"][value="${taxtype}"]`) as HTMLInputElement | null;
      if (taxRadio) taxRadio.checked = true;
    }

    if (rate) {
      const standardRates = ['5', '12', '18', '28'];
      if (standardRates.includes(rate)) {
        const rateRadio = document.querySelector(`input[name="calc-rate"][value="${rate}"]`) as HTMLInputElement | null;
        if (rateRadio) rateRadio.checked = true;
      } else {
        const customRadio = document.getElementById('rate-custom-radio') as HTMLInputElement | null;
        if (customRadio) {
          customRadio.checked = true;
          customRateContainer?.classList.remove('hidden');
          if (customRateInput) customRateInput.value = rate;
        }
      }
    }
  }

  // Add listeners
  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  // Monitor Custom Rate visibility
  const rateRadios = document.querySelectorAll('input[name="calc-rate"]');
  rateRadios.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value === 'custom') {
        customRateContainer?.classList.remove('hidden');
        customRateInput?.focus();
      } else {
        customRateContainer?.classList.add('hidden');
        if (customRateInput) {
          customRateInput.classList.remove('input-error');
          document.getElementById('calc-rate-custom-error')?.remove();
        }
      }
      calculate();
    });
  });

  // Init
  loadFromUrl();
  calculate();
</script>
