---
import CalculatorLayout from '../../components/CalculatorLayout.astro';
import ResultCard from '../../components/ResultCard.astro';
import FAQ from '../../components/FAQ.astro';
import ToolCard from '../../components/ToolCard.astro';

const pageTitle = "IGST Calculator – Calculate Integrated GST for Interstate Sales";
const pageDesc = "Compute Integrated Goods and Services Tax (IGST) liabilities specifically for interstate transactions. Free, fast, and 100% accurate.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": "IGST Calculator – Calculate Integrated GST for Interstate Sales",
  "url": "https://gstcalculatoronline.in/tools/igst-calculator",
  "description": "Free IGST calculator for India. Calculate Integrated Goods and Services Tax (IGST) liabilities specifically for interstate transactions.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
};

const faqs = [
  { question: "What is IGST (Integrated Goods and Services Tax)?", answer: "IGST is a tax levied under the GST regime on all interstate transactions of goods and services (between different states or union territories), as well as on imports and exports. It is collected by the Central Government and then apportioned to the destination state." },
  { question: "When is IGST applied instead of CGST and SGST?", answer: "IGST applies when the supplier's location and the place of supply are in different states (interstate transactions) or when goods are imported into India. If both the supplier and buyer are in the same state, it is an intrastate transaction and CGST + SGST apply instead." },
  { question: "How is IGST calculated?", answer: "To Add IGST: IGST Amount = Base Price × (IGST Rate ÷ 100); Total Invoice = Base Price + IGST Amount. To Remove IGST: Taxable Value = Inclusive Price ÷ (1 + IGST Rate ÷ 100); IGST Amount = Inclusive Price − Taxable Value." },
  { question: "How is IGST different from CGST and SGST?", answer: "CGST and SGST are levied together on intrastate (same-state) transactions — each at half the total rate. IGST is levied as a single tax on interstate transactions at the full combined rate. The total tax paid is the same amount; only the collection mechanism differs." },
  { question: "Who collects IGST and how is it shared with states?", answer: "IGST is collected by the Central Government. It is then apportioned: the Centre retains its CGST-equivalent share and transfers the SGST-equivalent share to the destination state (not the origin state). This ensures tax flows to where the goods or services are consumed." },
  { question: "Is IGST applicable on exports?", answer: "Exports are zero-rated under GST. IGST rate on exports is 0%. Exporters can either pay IGST and claim a refund, or export under a Letter of Undertaking (LUT) without paying IGST. This makes Indian exports globally competitive." },
  { question: "Can IGST be used to offset CGST or SGST liability?", answer: "Yes. Under the ITC utilization rules, IGST credit can be used to pay CGST, SGST, or IGST output tax liabilities. This cross-state ITC mechanism is one of the key benefits of the IGST framework over the pre-GST CST regime." },
  { question: "What is the IGST rate for common goods and services?", answer: "IGST rates mirror the combined GST rate: 5% (essential goods), 12% (standard goods), 18% (most services, electronics), 28% (luxury items). So an 18% GST on intrastate transaction = 9% CGST + 9% SGST; on interstate = 18% IGST." },
  { question: "Is IGST applicable on e-commerce transactions?", answer: "Yes. When goods or services are sold through e-commerce platforms to buyers in other states, IGST applies on the transaction. The Tax Collected at Source (TCS) provisions under Section 52 of the CGST Act also apply to e-commerce operators." },
  { question: "How is IGST reported in GST returns?", answer: "IGST on outward supplies is reported in GSTR-1 (Table 6 for interstate B2B, Table 7 for B2C). IGST paid in a month is reported in GSTR-3B. IGST ITC received from purchases is reported in GSTR-3B Table 4." },
  { question: "What is the IGST Act, 2017?", answer: "The Integrated Goods and Services Tax Act, 2017 is the legislation governing IGST. It defines interstate supply, imports, exports, ITC on IGST, and the apportionment mechanism between Centre and states. It came into force on July 1, 2017, along with the CGST Act." },
  { question: "Is this IGST Calculator free?", answer: "Yes, completely free. No login, no registration, no charges. Enter any amount, select the IGST rate (5%, 12%, 18%, 28%, or custom), choose Add or Remove IGST, and get instant results." }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema} faqs={faqs}>
  <!-- Calculator Input Form -->
  <form id="gst-form" class="space-y-4 md:space-y-6">
    <!-- Transaction Amount -->
    <div>
      <label for="calc-amount" class="block text-sm font-semibold text-ink">Transaction Amount (₹)</label>
      <div class="relative mt-2 rounded-lg shadow-xs">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-mute">
          <span class="text-xs font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="amount" 
          id="calc-amount" 
          value="10000" 
          min="1" 
          step="any"
          class="block w-full rounded-lg border border-hairline bg-canvas py-3 pl-8 pr-4 text-base text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary font-mono transition-all"
          placeholder="e.g. 10000"
          required
        />
      </div>
    </div>

    <!-- Calculation Direction -->
    <div>
      <span class="block text-sm font-semibold text-ink mb-2">IGST Calculation Mode</span>
      <div class="segmented-control" role="group" aria-label="IGST calculation direction">
        <label class="segmented-btn btn-add-gst cursor-pointer">
          <input type="radio" name="calc-type" value="add" checked class="sr-only" />
          <span>Add IGST (+)</span>
        </label>
        <label class="segmented-btn btn-remove-gst cursor-pointer">
          <input type="radio" name="calc-type" value="remove" class="sr-only" />
          <span>Remove IGST (-)</span>
        </label>
      </div>
    </div>

    <!-- IGST Tax Slab Rates -->
    <div>
      <span class="block text-sm font-semibold text-ink">IGST Tax Rate (%)</span>
      <div class="rate-pill-container sm:grid sm:grid-cols-5 gap-2">
        {['5', '12', '18', '28'].map((rate) => (
          <label class="flex items-center justify-center rounded-lg border border-hairline bg-canvas py-2.5 cursor-pointer text-sm font-semibold text-body hover:bg-canvas-soft-2 [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink font-mono select-none">
            <input type="radio" name="calc-rate" value={rate} checked={rate === '18'} class="sr-only" />
            <span>{rate}%</span>
          </label>
        ))}
        <label class="flex items-center justify-center rounded-lg border border-hairline bg-canvas py-2.5 cursor-pointer text-sm font-semibold text-body hover:bg-canvas-soft-2 [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink select-none">
          <input type="radio" name="calc-rate" id="rate-custom-radio" value="custom" class="sr-only" />
          <span>Custom</span>
        </label>
      </div>
      
      <!-- Custom Rate Input (Hidden by default) -->
      <div id="custom-rate-container" class="hidden mt-3">
        <label for="calc-rate-custom" class="sr-only">Custom IGST Rate (%)</label>
        <div class="relative rounded-lg shadow-xs">
          <input 
            type="number" 
            name="custom-rate" 
            id="calc-rate-custom" 
            min="0.1" 
            max="100" 
            step="any"
            value="18"
            class="block w-full rounded-lg border border-hairline bg-canvas py-2 px-3 text-sm text-ink outline-hidden focus:border-hairline-strong font-mono"
            placeholder="Enter custom rate e.g. 3"
          />
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-mute">
            <span class="text-xs font-mono">%</span>
          </div>
        </div>
      </div>
    </div>
  </form>

  <!-- Interactive Results Block -->
  <ResultCard slot="results" title="IGST Summary" />

  <!-- Educational content: 1000+ words -->
  <div slot="content" class="prose max-w-none">
    <h2>IGST Calculator Online — Integrated GST for Interstate Business</h2>
    <p>India's GST system has a dual structure — when goods or services move <em>within</em> a state, both CGST and SGST apply. But when they cross state borders or are imported, only <strong>IGST (Integrated GST)</strong> applies. Our free <strong>IGST Calculator online</strong> makes it easy to compute the exact IGST amount for any interstate transaction, import, or export scenario.</p>

    <h2>What Is IGST?</h2>
    <p>IGST stands for <strong>Integrated Goods and Services Tax</strong>. It is governed by the IGST Act, 2017, and is levied by the Central Government on:</p>
    <ul>
      <li><strong>Interstate supply of goods</strong> — goods crossing state boundaries</li>
      <li><strong>Interstate supply of services</strong> — service provider and recipient in different states</li>
      <li><strong>Imports into India</strong> — customs duty equivalent</li>
      <li><strong>Export of goods/services</strong> — at 0% rate (zero-rated)</li>
    </ul>
    <p>The IGST rate is always equal to the sum of the applicable CGST and SGST rates for the same category of goods/services.</p>

    <h2>IGST vs CGST & SGST — Key Differences</h2>
    <div class="overflow-x-auto my-4">
      <table class="w-full text-sm border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-canvas-soft-2">
          <tr>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Feature</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">CGST + SGST</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">IGST</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-hairline/50"><td class="p-3 font-medium text-ink">Applicable On</td><td class="p-3 text-body">Intrastate (same state)</td><td class="p-3 text-body">Interstate (different states) &amp; imports</td></tr>
          <tr class="border-b border-hairline/50 bg-canvas-soft/30"><td class="p-3 font-medium text-ink">Number of Tax Lines</td><td class="p-3 text-body">Two separate taxes</td><td class="p-3 text-body">One single tax</td></tr>
          <tr class="border-b border-hairline/50"><td class="p-3 font-medium text-ink">Collected By</td><td class="p-3 text-body">Centre (CGST) + State (SGST)</td><td class="p-3 text-body">Centre (shared later)</td></tr>
          <tr class="border-b border-hairline/50 bg-canvas-soft/30"><td class="p-3 font-medium text-ink">At 18% Rate</td><td class="p-3 text-body">CGST 9% + SGST 9%</td><td class="p-3 text-body">IGST 18%</td></tr>
          <tr class="bg-canvas-soft/30"><td class="p-3 font-medium text-ink">ITC Utilization</td><td class="p-3 text-body">CGST can offset CGST &amp; IGST; SGST can offset SGST &amp; IGST</td><td class="p-3 text-body">IGST can offset IGST, CGST, or SGST</td></tr>
        </tbody>
      </table>
    </div>

    <h2>IGST Calculation Formulas</h2>
    <div class="my-4 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed space-y-4">
      <div>
        <p class="font-semibold text-brand-link">1. Adding IGST (Tax-Exclusive Base Price):</p>
        <p>IGST Amount = Base Price × (IGST Rate ÷ 100)</p>
        <p>Total Invoice = Base Price + IGST Amount</p>
      </div>
      <div class="border-t border-hairline/50 pt-4">
        <p class="font-semibold text-brand-link">2. Removing IGST (Tax-Inclusive Price):</p>
        <p>Taxable Value = Inclusive Price ÷ (1 + IGST Rate ÷ 100)</p>
        <p>IGST Amount = Inclusive Price − Taxable Value</p>
      </div>
    </div>

    <h2>IGST Calculation Examples</h2>
    <h3>Example 1 — Adding IGST (Interstate B2B)</h3>
    <p>A Mumbai supplier sells machinery worth ₹25,00,000 to a Delhi buyer (interstate).</p>
    <ul>
      <li>Base Price: ₹25,00,000</li>
      <li>IGST Rate: 18%</li>
      <li>IGST Amount: 25,00,000 × 18% = <strong>₹4,50,000</strong></li>
      <li>Total Invoice: <strong>₹29,50,000</strong></li>
    </ul>

    <h3>Example 2 — Removing IGST from an Inclusive Price</h3>
    <p>An imported product costs ₹29,500 inclusive of 18% IGST. Find the custom value before IGST.</p>
    <ul>
      <li>Inclusive Price: ₹29,500</li>
      <li>Taxable Value: 29,500 ÷ 1.18 = <strong>₹25,000</strong></li>
      <li>IGST Amount: <strong>₹4,500</strong></li>
    </ul>

    <h2>Benefits of This IGST Calculator</h2>
    <ul>
      <li><strong>Both modes</strong> — Add IGST (exclusive) or remove IGST (inclusive)</li>
      <li><strong>All standard rates</strong> — 5%, 12%, 18%, 28%, and custom rates</li>
      <li><strong>No CGST/SGST confusion</strong> — Shows only IGST for clean interstate reporting</li>
      <li><strong>Import-ready</strong> — Useful for calculating IGST on customs duty invoices</li>
      <li><strong>Completely free</strong> — No login, no subscription required</li>
    </ul>

    <FAQ items={faqs} />

    <h2>Related Calculators</h2>
    <ul>
      <li><a href="/tools/gst-calculator">GST Calculator Online</a> — General GST add/remove tool with CGST/SGST split</li>
      <li><a href="/tools/gst-split-calculator">GST Split Calculator</a> — Split total GST into CGST and SGST</li>
      <li><a href="/tools/reverse-gst-calculator">Reverse GST Calculator</a> — Extract GST from inclusive price</li>
    </ul>

    <h2>Conclusion</h2>
    <p>Our free <strong>IGST Calculator online</strong> is the essential tool for any Indian business dealing with interstate commerce, imports, or exports. Whether you are raising an invoice for a cross-state client or verifying customs duties on imports, this calculator gives you the exact IGST amount in seconds. No formulas to remember, no errors — just instant, accurate results.</p>
  </div>
</CalculatorLayout>

<script>
  const amountInput = document.getElementById('calc-amount') as HTMLInputElement | null;
  const customRateInput = document.getElementById('calc-rate-custom') as HTMLInputElement | null;
  const customRateContainer = document.getElementById('custom-rate-container');
  const gstForm = document.getElementById('gst-form') as HTMLFormElement | null;

  // DOM Outputs
  const resTaxable = document.getElementById('res-taxable-val');
  const resCgstRow = document.getElementById('res-cgst-row');
  const resCgstVal = document.getElementById('res-cgst-val');
  const resSgstRow = document.getElementById('res-sgst-row');
  const resSgstVal = document.getElementById('res-sgst-val');
  const resIgstRow = document.getElementById('res-igst-row');
  const resIgstVal = document.getElementById('res-igst-val');
  const resTotalTax = document.getElementById('res-total-tax');
  const resGrandTotal = document.getElementById('res-grand-total');

  function validateInput(input: HTMLInputElement, message: string, check: () => boolean): boolean {
    const isValid = check();
    let errSpan = document.getElementById(`${input.id}-error`);
    if (!isValid) {
      input.classList.add('input-error');
      if (!errSpan) {
        errSpan = document.createElement('span');
        errSpan.id = `${input.id}-error`;
        errSpan.className = 'error-message';
        errSpan.innerText = message;
        input.parentElement?.parentElement?.appendChild(errSpan);
      }
    } else {
      input.classList.remove('input-error');
      errSpan?.remove();
    }
    return isValid;
  }

  function getSelectedRate(): number {
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    if (!rateRadio) return 18;
    if (rateRadio.value === 'custom') {
      return parseFloat(customRateInput?.value || '0') || 0;
    }
    return parseFloat(rateRadio.value) || 0;
  }

  function calculate() {
    if (!amountInput) return;

    const isAmountValid = validateInput(
      amountInput,
      "Please enter a valid amount greater than 0",
      () => parseFloat(amountInput.value) > 0
    );

    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    let isRateValid = true;
    if (rateRadio?.value === 'custom' && customRateInput) {
      isRateValid = validateInput(
        customRateInput,
        "Please enter a rate between 0.1% and 100%",
        () => {
          const val = parseFloat(customRateInput.value);
          return val >= 0.1 && val <= 100;
        }
      );
    }

    if (!isAmountValid || !isRateValid) {
      if (resTaxable) resTaxable.innerText = "₹0.00";
      if (resTotalTax) resTotalTax.innerText = "₹0.00";
      if (resGrandTotal) resGrandTotal.innerText = "₹0.00";
      if (resCgstVal) resCgstVal.innerText = "₹0.00";
      if (resSgstVal) resSgstVal.innerText = "₹0.00";
      if (resIgstVal) resIgstVal.innerText = "₹0.00";
      return;
    }

    const amount = parseFloat(amountInput.value) || 0;
    const rate = getSelectedRate();
    const typeRadio = document.querySelector('input[name="calc-type"]:checked') as HTMLInputElement | null;
    const isAdd = typeRadio ? typeRadio.value === 'add' : true;

    let taxableValue = 0;
    let totalTax = 0;
    let grandTotal = 0;

    if (isAdd) {
      taxableValue = amount;
      totalTax = amount * (rate / 100);
      grandTotal = amount + totalTax;
    } else {
      taxableValue = amount / (1 + (rate / 100));
      totalTax = amount - taxableValue;
      grandTotal = amount;
    }

    // Format currency function
    const fmt = (val: number) => '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (resTaxable) resTaxable.innerText = fmt(taxableValue);
    if (resTotalTax) resTotalTax.innerText = fmt(totalTax);
    if (resGrandTotal) resGrandTotal.innerText = fmt(grandTotal);

    // Hide CGST/SGST completely, show IGST only
    resCgstRow?.classList.add('hidden');
    resSgstRow?.classList.add('hidden');
    resIgstRow?.classList.remove('hidden');
    
    if (resIgstVal) resIgstVal.innerText = fmt(totalTax);
  }

  function customizeLabels() {
    const labelCgst = document.querySelector('#res-cgst-val')?.previousElementSibling as HTMLElement | null;
    const labelSgst = document.querySelector('#res-sgst-val')?.previousElementSibling as HTMLElement | null;
    if (labelCgst) labelCgst.innerText = "CGST (Interstate supply)";
    if (labelSgst) labelSgst.innerText = "SGST (Interstate supply)";
  }

  // Handle prefill from URL
  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const amount = params.get('amount');
    const rate = params.get('rate');
    const type = params.get('type');

    if (amount && amountInput) {
      amountInput.value = amount;
    }

    if (type) {
      const typeRadio = document.querySelector(`input[name="calc-type"][value="${type}"]`) as HTMLInputElement | null;
      if (typeRadio) typeRadio.checked = true;
    }

    if (rate) {
      const standardRates = ['5', '12', '18', '28'];
      if (standardRates.includes(rate)) {
        const rateRadio = document.querySelector(`input[name="calc-rate"][value="${rate}"]`) as HTMLInputElement | null;
        if (rateRadio) rateRadio.checked = true;
      } else {
        const customRadio = document.getElementById('rate-custom-radio') as HTMLInputElement | null;
        if (customRadio) {
          customRadio.checked = true;
          customRateContainer?.classList.remove('hidden');
          if (customRateInput) customRateInput.value = rate;
        }
      }
    }
  }

  // Add listeners
  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  // Monitor Custom Rate visibility
  const rateRadios = document.querySelectorAll('input[name="calc-rate"]');
  rateRadios.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value === 'custom') {
        customRateContainer?.classList.remove('hidden');
        customRateInput?.focus();
      } else {
        customRateContainer?.classList.add('hidden');
        if (customRateInput) {
          customRateInput.classList.remove('input-error');
          document.getElementById('calc-rate-custom-error')?.remove();
        }
      }
      calculate();
    });
  });

  // Init
  customizeLabels();
  loadFromUrl();
  calculate();
</script>
