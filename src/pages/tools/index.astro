---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { tools } from '../../utils/tools';

const pageTitle = "All GST Calculators & Return Tools";
const pageDesc = "Explore our complete suite of Indian GST calculators. Includes standard GST rate calculators, return late fee calculators, Section 50 interest calculators, and Composition Scheme liabilities.";

// Group categories for overview
const categories = [
  { slug: 'tax-slabs', name: 'Tax Slabs', count: tools.filter(t => t.category === 'tax-slabs').length },
  { slug: 'late-fees', name: 'Late Fees', count: tools.filter(t => t.category === 'late-fees').length },
  { slug: 'interest-penalties', name: 'Interest', count: tools.filter(t => t.category === 'interest-penalties').length },
  { slug: 'composition-scheme', name: 'Composition', count: tools.filter(t => t.category === 'composition-scheme').length }
];
---
<Layout seo={{ title: pageTitle, description: pageDesc }}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs />

    <header class="mb-10 text-center sm:text-left mt-6">
      <h1 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">GST Calculators Directory</h1>
      <p class="mt-2 text-base text-body max-w-3xl leading-relaxed">Select a specialized calculator to compute tax liabilities, split CGST/SGST/IGST, verify active slabs, or calculate filing late fees.</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Filters and Grid (9 cols on large screen) -->
      <main class="lg:col-span-9 space-y-6">
        <!-- Interactive Category Filters -->
        <div class="mb-6 flex flex-wrap gap-2 justify-center sm:justify-start">
          <button 
            type="button" 
            data-filter="all"
            class="tool-filter-btn rounded-full px-4 py-1.5 text-xs font-bold border border-primary bg-primary text-on-primary shadow-xs transition-all cursor-pointer"
          >
            All Tools
          </button>
          <button 
            type="button" 
            data-filter="tax-slabs"
            class="tool-filter-btn rounded-full px-4 py-1.5 text-xs font-semibold border border-hairline bg-canvas text-body hover:bg-canvas-soft hover:text-ink transition-all cursor-pointer"
          >
            Tax Slab Calculators
          </button>
          <button 
            type="button" 
            data-filter="late-fees"
            class="tool-filter-btn rounded-full px-4 py-1.5 text-xs font-semibold border border-hairline bg-canvas text-body hover:bg-canvas-soft hover:text-ink transition-all cursor-pointer"
          >
            Filing Late Fees
          </button>
          <button 
            type="button" 
            data-filter="interest-penalties"
            class="tool-filter-btn rounded-full px-4 py-1.5 text-xs font-semibold border border-hairline bg-canvas text-body hover:bg-canvas-soft hover:text-ink transition-all cursor-pointer"
          >
            Interest Penalties
          </button>
          <button 
            type="button" 
            data-filter="composition-scheme"
            class="tool-filter-btn rounded-full px-4 py-1.5 text-xs font-semibold border border-hairline bg-canvas text-body hover:bg-canvas-soft hover:text-ink transition-all cursor-pointer"
          >
            Composition Scheme
          </button>
        </div>



        <!-- Tools Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" id="tools-grid-container">
          {tools.map((tool) => (
            <div data-category={tool.category} class="tool-grid-item">
              <ToolCard 
                title={tool.name} 
                description={tool.desc} 
                url={tool.url}
                icon={tool.icon}
                badge={tool.badge}
              />
            </div>
          ))}
        </div>
      </main>

      <!-- Right Column: Sidebar (Category navigation & AdSense) -->
      <aside class="lg:col-span-3 space-y-6">
        <!-- Category Explorer Widget -->
        <div class="rounded-2xl border border-hairline bg-canvas-soft p-5 shadow-xs">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-ink pb-2 border-b border-hairline mb-4">Dedicated Categories</h2>
          <div class="space-y-2">
            {categories.map((cat) => (
              <a 
                href={`/tools/category/${cat.slug}`} 
                class="flex items-center justify-between p-3 rounded-xl border border-hairline bg-canvas hover:border-hairline-strong hover:bg-canvas-soft-2 transition-all group"
              >
                <div class="shrink">
                  <span class="text-xs font-bold text-body group-hover:text-primary transition-colors block">{cat.name}</span>
                  <span class="text-[9px] text-mute font-mono">{cat.count} {cat.count === 1 ? 'tool' : 'tools'}</span>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5 text-mute group-hover:text-primary group-hover:translate-x-0.5 transition-all">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </a>
            ))}
          </div>
        </div>


      </aside>
    </div>


  </div>
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.tool-filter-btn');
  const toolItems = document.querySelectorAll('.tool-grid-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const clickedBtn = e.currentTarget as HTMLButtonElement;
      const filterValue = clickedBtn.dataset.filter || 'all';

      // Reset button classes
      filterBtns.forEach((b) => {
        b.classList.remove('bg-primary', 'text-on-primary', 'border-primary');
        b.classList.add('bg-canvas', 'text-body', 'border-hairline');
      });

      // Highlight clicked button
      clickedBtn.classList.remove('bg-canvas', 'text-body', 'border-hairline');
      clickedBtn.classList.add('bg-primary', 'text-on-primary', 'border-primary');

      // Filter items
      toolItems.forEach((item) => {
        const htmlItem = item as HTMLElement;
        const category = htmlItem.dataset.category;
        if (filterValue === 'all' || category === filterValue) {
          htmlItem.classList.remove('hidden');
        } else {
          htmlItem.classList.add('hidden');
        }
      });
    });
  });
</script>
