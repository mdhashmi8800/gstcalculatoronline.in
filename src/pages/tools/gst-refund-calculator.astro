---
import CalculatorLayout from '../../components/CalculatorLayout.astro';
import ResultCard from '../../components/ResultCard.astro';
import FAQ from '../../components/FAQ.astro';
import ToolCard from '../../components/ToolCard.astro';

const pageTitle = "GST Refund Calculator – Zero-Rated Exports & Inverted Duty (Rule 89)";
const pageDesc = "Estimate your GST refund under Rule 89(4) for Zero-Rated Exports and Rule 89(5) for Inverted Duty Structure. Free GST Refund Calculator online.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": "GST Refund Calculator – Zero-Rated Exports & Inverted Duty (Rule 89)",
  "url": "https://gstcalculatoronline.in/tools/gst-refund-calculator",
  "description": "Free GST refund calculator for India. Estimate refunds under Rule 89(4) for exports and Rule 89(5) for inverted duty structure.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
};

const faqs = [
  { question: "What is a GST refund?", answer: "A GST refund is the amount of excess GST paid or accumulated Input Tax Credit (ITC) that a registered taxpayer can claim back from the government. Common refund situations include: exports (zero-rated supply), inverted duty structure (higher tax on inputs than outputs), excess cash balance in Electronic Cash Ledger, and deemed exports." },
  { question: "How is the GST refund calculated for exports (Rule 89(4))?", answer: "Under Rule 89(4) of the CGST Rules, the refund for zero-rated exports is: Refund = (Zero-Rated Supply Turnover × Net ITC) ÷ Adjusted Total Turnover. Net ITC is the ITC on inputs and input services for the period minus ITC reversed. Adjusted Total Turnover is total turnover minus exempt supply turnover." },
  { question: "What is the inverted duty structure in GST?", answer: "An inverted duty structure occurs when the GST rate on inputs (raw materials purchased) is higher than the GST rate on the finished output (goods sold). This results in accumulation of ITC that cannot be fully utilized, and the excess can be claimed as a cash refund from the government." },
  { question: "What is the formula for inverted duty refund (Rule 89(5))?", answer: "Under Rule 89(5), the inverted duty refund formula is: Maximum Refund = [(Inverted Supply Turnover × Net ITC) ÷ Adjusted Total Turnover] − Tax Payable on Inverted Supply. The refund is the lesser of this formula result and the ITC accumulated due to the inverted duty." },
  { question: "What is the time limit to apply for a GST refund?", answer: "Under Section 54 of the CGST Act, a GST refund application must be filed within 2 years from the relevant date. For exports, the relevant date is the date of export. For inverted duty, it is the end of the financial year in which the claim arises. Applications must be filed on the GST portal using Form RFD-01." },
  { question: "What is RFD-01 in GST refund?", answer: "RFD-01 is the GST refund application form filed on the GST portal. It is used to claim refunds for exports under LUT (zero IGST), exports with IGST paid, inverted duty structure, and other scenarios. After filing RFD-01, the tax officer issues an acknowledgment (RFD-02) and then may either sanction (RFD-06) or reject the refund." },
  { question: "What is a zero-rated supply in GST?", answer: "Zero-rated supply is a taxable supply on which the GST rate is 0%. All exports of goods and services are zero-rated under the IGST Act. Special Economic Zone (SEZ) supplies are also zero-rated. Exporters can claim refund of ITC accumulated on inputs used for zero-rated supplies." },
  { question: "Can I get a refund of unutilized ITC?", answer: "Yes, but only in two specific situations: (1) Zero-rated exports where ITC accumulates because output is at 0% rate, (2) Inverted duty structure where tax on inputs is higher than tax on outputs. In all other situations, unutilized ITC cannot be claimed as a cash refund and must be carried forward." },
  { question: "What is the Letter of Undertaking (LUT) for GST exports?", answer: "A Letter of Undertaking (LUT) is a document filed by an exporter on the GST portal (Form GST RFD-11) that allows them to export goods and services without paying IGST. Instead, they claim a refund of the accumulated ITC on inputs. This is the most common export method as it avoids the need to first pay IGST and then apply for refund." },
  { question: "How long does a GST refund take to process?", answer: "Under Section 54, the GST officer must process a complete refund application within 60 days. If the refund is not sanctioned within 60 days, interest at 6% per annum is payable on the delayed refund. Exporters filing automated ITC refunds through GSTR-1 + GSTR-3B linkage can get faster refunds." },
  { question: "Is this GST Refund Calculator free?", answer: "Yes, completely free. Select the refund type (Export/Zero-rated or Inverted Duty), enter the required turnover and ITC figures, and get your estimated refund amount instantly. No login, no registration, no charges." }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema} faqs={faqs}>
  <!-- Calculator Input Form -->
  <form id="refund-form" class="space-y-4 md:space-y-6">
    <!-- Refund Scenario Selector -->
    <div>
      <span class="block text-sm font-semibold text-ink">Refund Scenario</span>
      <div class="mt-2 grid grid-cols-1 gap-2.5">
        <label class="flex items-center rounded-lg border border-hairline bg-canvas p-3 cursor-pointer text-sm font-semibold text-body hover:bg-canvas-soft [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink select-none">
          <input type="radio" name="refund-scenario" value="export" checked class="mr-3 accent-primary" />
          <div>
            <span class="block">Exports / Zero-Rated Supplies (Rule 89(4))</span>
            <span class="block text-xs text-mute font-normal mt-0.5">Refund of ITC on exports made without paying output GST.</span>
          </div>
        </label>
        <label class="flex items-center rounded-lg border border-hairline bg-canvas p-3 cursor-pointer text-sm font-semibold text-body hover:bg-canvas-soft [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink select-none">
          <input type="radio" name="refund-scenario" value="inverted" class="mr-3 accent-primary" />
          <div>
            <span class="block">Inverted Duty Structure (Rule 89(5))</span>
            <span class="block text-xs text-mute font-normal mt-0.5">Refund of ITC when tax on purchases (inputs) > tax on sales.</span>
          </div>
        </label>
      </div>
    </div>

    <!-- Net ITC -->
    <div>
      <label for="calc-net-itc" class="block text-sm font-semibold text-ink">Net Input Tax Credit (ITC) (₹)</label>
      <div class="relative mt-2 rounded-lg shadow-xs">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-mute">
          <span class="text-xs font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="netItc" 
          id="calc-net-itc" 
          value="50000" 
          min="1" 
          step="any"
          class="block w-full rounded-lg border border-hairline bg-canvas py-3 pl-8 pr-4 text-base text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary font-mono transition-all"
          placeholder="e.g. 50000"
          required
        />
      </div>
      <p class="mt-1 text-xs text-mute">ITC accumulated on inputs/input services during the refund period.</p>
    </div>

    <!-- Turnovers (Zero-rated or Inverted) -->
    <div>
      <label for="calc-turnover" id="turnover-label" class="block text-sm font-semibold text-ink">Turnover of Zero-Rated Supply (Export) (₹)</label>
      <div class="relative mt-2 rounded-lg shadow-xs">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-mute">
          <span class="text-xs font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="supplyTurnover" 
          id="calc-turnover" 
          value="200000" 
          min="1" 
          step="any"
          class="block w-full rounded-lg border border-hairline bg-canvas py-3 pl-8 pr-4 text-base text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary font-mono transition-all"
          placeholder="e.g. 200000"
          required
        />
      </div>
    </div>

    <!-- Adjusted Total Turnover -->
    <div>
      <label for="calc-adj-turnover" class="block text-sm font-semibold text-ink">Adjusted Total Turnover (₹)</label>
      <div class="relative mt-2 rounded-lg shadow-xs">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-mute">
          <span class="text-xs font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="adjTurnover" 
          id="calc-adj-turnover" 
          value="500000" 
          min="1" 
          step="any"
          class="block w-full rounded-lg border border-hairline bg-canvas py-3 pl-8 pr-4 text-base text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary font-mono transition-all"
          placeholder="e.g. 500000"
          required
        />
      </div>
      <p class="mt-1 text-xs text-mute">Total turnover of the entity excluding exempt supplies during the period.</p>
    </div>

    <!-- Output Tax on Inverted Supply (Conditional) -->
    <div id="inverted-inputs-container" class="hidden">
      <label for="calc-tax-payable" class="block text-sm font-semibold text-ink">Output Tax Payable on Inverted Supply (₹)</label>
      <div class="relative mt-2 rounded-lg shadow-xs">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-mute">
          <span class="text-xs font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="taxPayable" 
          id="calc-tax-payable" 
          value="10000" 
          min="0" 
          step="any"
          class="block w-full rounded-lg border border-hairline bg-canvas py-3 pl-8 pr-4 text-base text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary font-mono transition-all"
          placeholder="e.g. 10000"
        />
      </div>
      <p class="mt-1 text-xs text-mute">The actual tax liability generated on output sales under inverted duty.</p>
    </div>
  </form>

  <!-- Results Block -->
  <ResultCard slot="results" title="Refund Summary" showEffectiveTax={false} showChart={false} />

  <!-- Educational content: 1000+ words -->
  <div slot="content" class="prose max-w-none">
    <h2>GST Refund Calculator Online — Exports & Inverted Duty Guide</h2>
    <p>Two of the most common scenarios where Indian businesses accumulate excess GST and need refunds are: (1) <strong>Exports</strong> — where output is zero-rated but inputs attract GST, and (2) <strong>Inverted Duty Structure</strong> — where inputs attract higher GST than the finished output. Our free <strong>GST Refund Calculator online</strong> estimates your refund under both Rule 89(4) and Rule 89(5) of the CGST Rules, 2017.</p>

    <h2>GST Refund Scenarios</h2>
    <div class="overflow-x-auto my-4">
      <table class="w-full text-sm border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-canvas-soft-2">
          <tr>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Scenario</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Rule</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Who Can Apply</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-hairline/50"><td class="p-3 text-body">Zero-Rated Exports (LUT)</td><td class="p-3 font-mono">Rule 89(4)</td><td class="p-3 text-body">Exporters of goods/services</td></tr>
          <tr class="border-b border-hairline/50 bg-canvas-soft/30"><td class="p-3 text-body">Inverted Duty Structure</td><td class="p-3 font-mono">Rule 89(5)</td><td class="p-3 text-body">Businesses where input tax &gt; output tax</td></tr>
          <tr class="border-b border-hairline/50"><td class="p-3 text-body">Excess Cash Ledger Balance</td><td class="p-3 font-mono">Section 54</td><td class="p-3 text-body">Any taxpayer with excess cash paid</td></tr>
          <tr class="bg-canvas-soft/30"><td class="p-3 text-body">Deemed Exports</td><td class="p-3 font-mono">Section 54(3)</td><td class="p-3 text-body">Suppliers to SEZ / EOU</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Rule 89(4) — Export Refund Formula</h2>
    <div class="my-4 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed">
      <p class="font-semibold text-brand-link mb-2">Formula (Rule 89(4)):</p>
      <p>Refund = (Zero-Rated Turnover × Net ITC) ÷ Adjusted Total Turnover</p>
    </div>
    <p>Where:</p>
    <ul>
      <li><strong>Net ITC</strong> = ITC on inputs + ITC on input services (for the tax period)</li>
      <li><strong>Zero-Rated Turnover</strong> = Value of zero-rated export supplies</li>
      <li><strong>Adjusted Total Turnover</strong> = Total turnover − Exempt supply turnover</li>
    </ul>

    <h3>Export Refund Example</h3>
    <p>Monthly figures for an IT services exporter:</p>
    <ul>
      <li>Net ITC: ₹50,000</li>
      <li>Zero-Rated Export Turnover: ₹20,00,000</li>
      <li>Adjusted Total Turnover: ₹50,00,000</li>
      <li>Refund: (20,00,000 × 50,000) ÷ 50,00,000 = <strong>₹20,000</strong></li>
    </ul>

    <h2>Rule 89(5) — Inverted Duty Refund Formula</h2>
    <div class="my-4 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed">
      <p class="font-semibold text-brand-link mb-2">Formula (Rule 89(5)):</p>
      <p>Maximum Refund = [(Inverted Supply Turnover × Net ITC) ÷ Adjusted Total Turnover] − Tax Payable on Inverted Supply</p>
    </div>

    <h2>GST Refund Process — Step by Step</h2>
    <ol>
      <li><strong>File RFD-01</strong> — File the refund application online on the GST portal</li>
      <li><strong>Receive RFD-02</strong> — Acknowledgment of your application</li>
      <li><strong>Tax Officer Review</strong> — Officer scrutinizes your GSTR-1, GSTR-3B, and export documents</li>
      <li><strong>Provisional Refund (RFD-04)</strong> — For exports, 90% of refund is given provisionally within 7 days</li>
      <li><strong>Final Sanction (RFD-06)</strong> — Remaining 10% after verification</li>
      <li><strong>Bank Credit</strong> — Refund credited directly to your registered bank account</li>
    </ol>

    <h2>Important Rules to Know</h2>
    <ul>
      <li><strong>Time limit:</strong> 2 years from the relevant date to apply for refund</li>
      <li><strong>Processing time:</strong> 60 days; beyond that, 6% interest is payable by the government</li>
      <li><strong>LUT for exporters:</strong> File Form GST RFD-11 annually to avoid paying IGST on exports</li>
      <li><strong>GSTR-1 filing mandatory:</strong> Export refunds require GSTR-1 to be filed first</li>
    </ul>

    <FAQ items={faqs} />

    <h2>Related Calculators</h2>
    <ul>
      <li><a href="/tools/interest-calculator">GST Interest Calculator</a> — Calculate delayed refund interest (6% pa)</li>
      <li><a href="/tools/gst-calculator">GST Calculator Online</a> — Calculate GST on any transaction</li>
      <li><a href="/tools/late-fee-calculator">GST Late Fee Calculator</a> — Calculate filing penalty fees</li>
    </ul>

    <h2>Conclusion</h2>
    <p>GST refunds can significantly improve cash flow for exporters and businesses with inverted duty structures. Use our free <strong>GST Refund Calculator online</strong> to estimate your eligible refund before filing RFD-01. Always verify the calculated figures with your actual GSTR data and consult a GST practitioner for complex multi-product refund scenarios.</p>
  </div>
</CalculatorLayout>

<script>
  const netItcInput = document.getElementById('calc-net-itc') as HTMLInputElement | null;
  const turnoverInput = document.getElementById('calc-turnover') as HTMLInputElement | null;
  const adjTurnoverInput = document.getElementById('calc-adj-turnover') as HTMLInputElement | null;
  const taxPayableInput = document.getElementById('calc-tax-payable') as HTMLInputElement | null;
  const turnoverLabel = document.getElementById('turnover-label');
  const invertedInputsContainer = document.getElementById('inverted-inputs-container');
  const refundForm = document.getElementById('refund-form') as HTMLFormElement | null;
  const scenarioRadios = document.querySelectorAll('input[name="refund-scenario"]');

  // DOM Outputs
  const resTaxable = document.getElementById('res-taxable-val');
  const resCgstVal = document.getElementById('res-cgst-val');
  const resSgstVal = document.getElementById('res-sgst-val');
  const resTotalTax = document.getElementById('res-total-tax');
  const resGrandTotal = document.getElementById('res-grand-total');

  function validateInput(input: HTMLInputElement, message: string, check: () => boolean): boolean {
    const isValid = check();
    let errSpan = document.getElementById(`${input.id}-error`);
    if (!isValid) {
      input.classList.add('input-error');
      if (!errSpan) {
        errSpan = document.createElement('span');
        errSpan.id = `${input.id}-error`;
        errSpan.className = 'error-message';
        errSpan.innerText = message;
        input.parentElement?.parentElement?.appendChild(errSpan);
      }
    } else {
      input.classList.remove('input-error');
      errSpan?.remove();
    }
    return isValid;
  }

  function updateFormUI() {
    const scenarioRadio = document.querySelector('input[name="refund-scenario"]:checked') as HTMLInputElement | null;
    if (!scenarioRadio || !turnoverLabel || !invertedInputsContainer) return;

    if (scenarioRadio.value === 'export') {
      turnoverLabel.innerText = "Turnover of Zero-Rated Supply (Export) (₹)";
      invertedInputsContainer.classList.add('hidden');
      if (taxPayableInput) taxPayableInput.required = false;
    } else {
      turnoverLabel.innerText = "Turnover of Inverted Rated Supply (₹)";
      invertedInputsContainer.classList.remove('hidden');
      if (taxPayableInput) taxPayableInput.required = true;
    }
  }

  function calculate() {
    if (!netItcInput || !turnoverInput || !adjTurnoverInput) return;

    const scenarioRadio = document.querySelector('input[name="refund-scenario"]:checked') as HTMLInputElement | null;
    const scenario = scenarioRadio ? scenarioRadio.value : 'export';

    const isItcValid = validateInput(netItcInput, "ITC must be greater than 0", () => parseFloat(netItcInput.value) > 0);
    
    const isAdjValid = validateInput(
      adjTurnoverInput, 
      "Adjusted turnover must exceed purchase/supply turnovers", 
      () => {
        const adj = parseFloat(adjTurnoverInput.value) || 0;
        const turn = parseFloat(turnoverInput.value) || 0;
        return adj >= turn && adj > 0;
      }
    );

    const isTurnoverValid = validateInput(turnoverInput, "Turnover must be greater than 0", () => parseFloat(turnoverInput.value) > 0);
    
    let isTaxValid = true;
    if (scenario === 'inverted' && taxPayableInput) {
      isTaxValid = validateInput(taxPayableInput, "Enter a valid tax payable amount (>= 0)", () => parseFloat(taxPayableInput.value) >= 0);
    }

    if (!isItcValid || !isAdjValid || !isTurnoverValid || !isTaxValid) {
      if (resTaxable) resTaxable.innerText = "₹0.00";
      if (resCgstVal) resCgstVal.innerText = "₹0.00";
      if (resSgstVal) resSgstVal.innerText = "₹0.00";
      if (resTotalTax) resTotalTax.innerText = "₹0.00";
      if (resGrandTotal) resGrandTotal.innerText = "₹0.00";
      return;
    }

    const netItc = parseFloat(netItcInput.value) || 0;
    const turnover = parseFloat(turnoverInput.value) || 0;
    const adjTurnover = parseFloat(adjTurnoverInput.value) || 0;
    const taxPayable = scenario === 'inverted' && taxPayableInput ? (parseFloat(taxPayableInput.value) || 0) : 0;

    // Refund calculation: (Turnover * Net ITC) / Adjusted Turnover
    const baseRefund = (turnover * netItc) / adjTurnover;
    
    // Inverted structure subtracts tax payable
    let maxRefund = baseRefund;
    if (scenario === 'inverted') {
      maxRefund = Math.max(0, baseRefund - taxPayable);
    }

    const splitRefund = maxRefund / 2;

    const fmt = (val: number) => '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (resTaxable) resTaxable.innerText = fmt(adjTurnover);
    if (resCgstVal) resCgstVal.innerText = fmt(splitRefund);
    if (resSgstVal) resSgstVal.innerText = fmt(splitRefund);
    if (resTotalTax) resTotalTax.innerText = fmt(maxRefund);
    if (resGrandTotal) resGrandTotal.innerText = fmt(maxRefund);
  }

  function customizeLabels() {
    const labelTaxable = document.querySelector('#res-taxable-val')?.previousElementSibling as HTMLElement | null;
    const labelCgst = document.querySelector('#res-cgst-val')?.previousElementSibling as HTMLElement | null;
    const labelSgst = document.querySelector('#res-sgst-val')?.previousElementSibling as HTMLElement | null;
    const labelTotalTax = document.querySelector('#res-total-tax')?.previousElementSibling as HTMLElement | null;
    const labelGrandTotal = document.querySelector('#res-grand-total')?.previousElementSibling as HTMLElement | null;

    if (labelTaxable) labelTaxable.innerText = "Adjusted Total Turnover";
    if (labelCgst) labelCgst.innerText = "CGST Refund Share (50%)";
    if (labelSgst) labelSgst.innerText = "SGST Refund Share (50%)";
    if (labelTotalTax) labelTotalTax.innerText = "Total Eligible Tax Refund";
    if (labelGrandTotal) labelGrandTotal.innerText = "Estimated Refund Claim";

    // Hide IGST row as refund is claimed under split CGST/SGST shares
    document.getElementById('res-igst-row')?.classList.add('hidden');
  }

  // Prefill
  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const scenario = params.get('refund-scenario');
    const itc = params.get('netItc');
    const turnover = params.get('supplyTurnover');
    const adj = params.get('adjTurnover');
    const tax = params.get('taxPayable');

    if (scenario) {
      const radio = document.querySelector(`input[name="refund-scenario"][value="${scenario}"]`) as HTMLInputElement | null;
      if (radio) radio.checked = true;
    }

    updateFormUI();

    if (itc && netItcInput) netItcInput.value = itc;
    if (turnover && turnoverInput) turnoverInput.value = turnover;
    if (adj && adjTurnoverInput) adjTurnoverInput.value = adj;
    if (tax && taxPayableInput) taxPayableInput.value = tax;
  }

  // Listeners
  if (refundForm) {
    refundForm.addEventListener('input', calculate);
    refundForm.addEventListener('change', calculate);
  }

  scenarioRadios.forEach((radio) => {
    radio.addEventListener('change', () => {
      updateFormUI();
      calculate();
    });
  });

  // Init
  customizeLabels();
  loadFromUrl();
  calculate();
</script>
