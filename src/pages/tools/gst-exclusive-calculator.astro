---
import CalculatorLayout from '../../components/CalculatorLayout.astro';
import ResultCard from '../../components/ResultCard.astro';
import FAQ from '../../components/FAQ.astro';
import ToolCard from '../../components/ToolCard.astro';

const pageTitle = "GST Exclusive Calculator Online — Add GST to Base Price";
const pageDesc = "Use our free GST Exclusive Calculator to add GST to any base price. Instantly compute the final invoice amount with CGST, SGST, and IGST breakdown for 5%, 12%, 18%, 28% slabs. Perfect for raising GST invoices in India.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GST Exclusive Calculator Online",
  "url": "https://gstcalculatoronline.in/tools/gst-exclusive-calculator",
  "description": "Free GST exclusive calculator. Add GST to any base price and get the final invoice amount with CGST/SGST/IGST breakdown.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
};

const faqs = [
  { question: "What is a GST exclusive price?", answer: "A GST exclusive price (also called an ex-GST price or base price) is the net taxable value of a product or service before any tax is added. In B2B invoicing, prices are typically quoted exclusive of GST, and the tax is added separately in the invoice." },
  { question: "What is the formula for GST exclusive calculation?", answer: "GST Exclusive Formula: GST Amount = Base Price × (GST Rate ÷ 100). Final Invoice = Base Price + GST Amount. For intrastate: CGST = SGST = GST Amount ÷ 2. For interstate: IGST = GST Amount." },
  { question: "How to add 18% GST to a price?", answer: "To add 18% GST to ₹10,000: GST Amount = 10,000 × 18% = ₹1,800. Final Invoice = 10,000 + 1,800 = ₹11,800. For intrastate: CGST = SGST = ₹900. For interstate: IGST = ₹1,800." },
  { question: "How to add 12% GST to a price?", answer: "To add 12% GST to ₹50,000: GST Amount = 50,000 × 12% = ₹6,000. Final Invoice = ₹56,000. Intrastate: CGST = SGST = ₹3,000 each. Interstate: IGST = ₹6,000." },
  { question: "How to calculate GST exclusive for 5%?", answer: "To add 5% GST to ₹20,000: GST Amount = 20,000 × 5% = ₹1,000. Final Invoice = ₹21,000. Intrastate: CGST = SGST = ₹500 each." },
  { question: "What is the difference between GST exclusive and GST inclusive?", answer: "GST exclusive means the quoted price is the base value and GST will be added on top. GST inclusive means the quoted price already contains the tax within it. B2B invoices in India typically use GST exclusive pricing, while retail MRP prices are GST inclusive." },
  { question: "How is CGST and SGST calculated on an exclusive price?", answer: "CGST and SGST each equal half of the total GST for intrastate transactions. At 18% on ₹10,000: Total GST = ₹1,800; CGST = ₹900 (9%); SGST = ₹900 (9%). For interstate, the entire ₹1,800 is IGST." },
  { question: "When should I use GST exclusive calculation?", answer: "Use GST exclusive calculation when: (1) Raising B2B invoices where the price is quoted net of taxes, (2) Preparing purchase orders showing the base cost and tax separately, (3) Calculating the invoice amount from a quoted base price in a contract." },
  { question: "How is GST exclusive used in export invoicing?", answer: "For exports, the GST rate is 0% (zero-rated). You use the GST exclusive base price and add 0% GST, so the invoice amount equals the base price. GST paid on inputs can be claimed back as a refund. The IGST column on the export invoice shows 0%." },
  { question: "Can I use a custom GST rate in the exclusive calculator?", answer: "Yes. Apart from 5%, 12%, 18%, and 28% standard slabs, the exclusive calculator supports custom rates. Enter your custom rate (e.g., 3% for gold, 0.25% for rough precious stones) to calculate GST on any product or service category." },
  { question: "What is IGST on GST exclusive calculation?", answer: "For interstate B2B transactions, instead of splitting GST into CGST and SGST, the entire GST amount is charged as IGST (Integrated GST). Example: ₹10,000 base at 18% sold from Maharashtra to Delhi = IGST of ₹1,800. No CGST or SGST applies." },
  { question: "Is this GST Exclusive Calculator free?", answer: "Yes, fully free. No login, no charges, no limits. Enter any base price, select the GST rate, choose intrastate or interstate, and get instant results with all tax components shown." },
  { question: "How is GST exclusive different from reverse GST?", answer: "GST exclusive calculation adds tax to a base price (forward calculation). Reverse GST calculation removes embedded tax from a final price to find the base price (backward calculation). Both are supported in our free calculator suite at gstcalculatoronline.in." }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema} faqs={faqs}>
  <!-- Calculator Input Form -->
  <form id="gst-form" class="space-y-6">
    <!-- Net Price (GST Exclusive) -->
    <div>
      <label for="calc-amount" class="block text-sm font-semibold text-ink">Net Base Price / Exclusive Amount (₹)</label>
      <div class="relative mt-2 rounded-lg shadow-xs">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-mute">
          <span class="text-xs font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="amount" 
          id="calc-amount" 
          value="10000" 
          min="1" 
          step="any"
          class="block w-full rounded-lg border border-hairline bg-canvas py-3 pl-8 pr-4 text-base text-ink outline-hidden focus:border-hairline-strong focus:ring-1 focus:ring-primary font-mono transition-all"
          placeholder="e.g. 10000"
          required
        />
      </div>
      <p class="mt-1 text-xs text-mute">The net cost of the goods/services before applying GST.</p>
    </div>

    <!-- GST Tax Slab Rates -->
    <div>
      <span class="block text-sm font-semibold text-ink">GST Tax Rate (%)</span>
      <div class="mt-2 grid grid-cols-3 gap-2 sm:grid-cols-5">
        {['5', '12', '18', '28'].map((rate) => (
          <label class="flex items-center justify-center rounded-lg border border-hairline bg-canvas py-2.5 cursor-pointer text-sm font-semibold text-body hover:bg-canvas-soft-2 [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink font-mono select-none">
            <input type="radio" name="calc-rate" value={rate} checked={rate === '18'} class="sr-only" />
            <span>{rate}%</span>
          </label>
        ))}
        <label class="flex items-center justify-center rounded-lg border border-hairline bg-canvas py-2.5 cursor-pointer text-sm font-semibold text-body hover:bg-canvas-soft-2 [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 [&:has(input:checked)]:text-ink select-none">
          <input type="radio" name="calc-rate" id="rate-custom-radio" value="custom" class="sr-only" />
          <span>Custom</span>
        </label>
      </div>
      
      <!-- Custom Rate Input (Hidden by default) -->
      <div id="custom-rate-container" class="hidden mt-3">
        <label for="calc-rate-custom" class="sr-only">Custom GST Rate (%)</label>
        <div class="relative rounded-lg shadow-xs">
          <input 
            type="number" 
            name="custom-rate" 
            id="calc-rate-custom" 
            min="0.1" 
            max="100" 
            step="any"
            value="18"
            class="block w-full rounded-lg border border-hairline bg-canvas py-2 px-3 text-sm text-ink outline-hidden focus:border-hairline-strong font-mono"
            placeholder="Enter custom rate e.g. 3"
          />
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-mute">
            <span class="text-xs font-mono">%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Supply Destination -->
    <div>
      <span class="block text-sm font-semibold text-ink">Supply Location</span>
      <div class="mt-2 grid grid-cols-2 gap-3">
        <label class="flex flex-col items-center justify-center rounded-lg border border-hairline bg-canvas p-3 cursor-pointer text-center hover:bg-canvas-soft [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 select-none group">
          <input type="radio" name="tax-type" value="intrastate" checked class="sr-only" />
          <span class="text-sm font-semibold text-body group-hover:text-ink group-has-checked:text-ink">Intrastate</span>
          <span class="text-[10px] text-mute uppercase font-mono mt-0.5 group-has-checked:text-body">CGST + SGST</span>
        </label>
        <label class="flex flex-col items-center justify-center rounded-lg border border-hairline bg-canvas p-3 cursor-pointer text-center hover:bg-canvas-soft [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-canvas-soft-2 select-none group">
          <input type="radio" name="tax-type" value="interstate" class="sr-only" />
          <span class="text-sm font-semibold text-body group-hover:text-ink group-has-checked:text-ink">Interstate</span>
          <span class="text-[10px] text-mute uppercase font-mono mt-0.5 group-has-checked:text-body">IGST Only</span>
        </label>
      </div>
    </div>
  </form>

  <!-- Results Block -->
  <ResultCard slot="results" title="Exclusive Value Summary" />

  <!-- Educational content: 1100+ words -->
  <div slot="content" class="prose max-w-none">
    <h2>GST Exclusive Calculator Online — Add GST to Any Base Price</h2>
    <p>In Indian B2B commerce, prices are almost always quoted <strong>exclusive of GST</strong> — meaning the listed price is the taxable base value, and GST is added on top to arrive at the final payable invoice amount. This is known as GST exclusive pricing. Our free <strong>GST Exclusive Calculator online</strong> lets you instantly compute the invoice total, CGST, SGST, or IGST amounts for any base price and GST rate.</p>

    <h2>What Is a GST Exclusive Price?</h2>
    <p>A <strong>GST exclusive price</strong> (also called ex-GST or pre-tax price) is the base value of goods or services before any tax is added. It represents 100% of the taxable amount. In India:</p>
    <ul>
      <li><strong>B2B invoices</strong> — Typically show the base price + GST separately</li>
      <li><strong>Service agreements &amp; contracts</strong> — Quote fees exclusive of GST, with tax applied at billing</li>
      <li><strong>Purchase orders</strong> — Base price is exclusive, total payable includes GST</li>
      <li><strong>Retail price tags</strong> — Usually GST <em>inclusive</em> (MRP), unlike B2B scenarios</li>
    </ul>

    <h2>GST Exclusive Formula</h2>
    <div class="my-4 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed space-y-4">
      <div>
        <p class="font-semibold text-brand-link">Adding GST to Base Price (Exclusive):</p>
        <p>GST Amount = Base Price × (GST Rate ÷ 100)</p>
        <p>Final Invoice = Base Price + GST Amount</p>
        <p>CGST = SGST = GST Amount ÷ 2 (for intrastate)</p>
        <p>IGST = GST Amount (for interstate)</p>
      </div>
      <div class="border-t border-hairline/50 pt-4">
        <p class="font-semibold text-brand-link">Quick Multipliers:</p>
        <p>5% → × 1.05 &nbsp;|&nbsp; 12% → × 1.12 &nbsp;|&nbsp; 18% → × 1.18 &nbsp;|&nbsp; 28% → × 1.28</p>
      </div>
    </div>

    <h2>Calculation Examples</h2>
    <h3>Example 1 — Service Invoice at 18%</h3>
    <p>A digital marketing agency charges ₹50,000 for services (18% GST, intrastate, Mumbai client).</p>
    <ul>
      <li>Base Price: ₹50,000</li>
      <li>GST (18%): ₹9,000</li>
      <li>CGST (9%): <strong>₹4,500</strong> &nbsp;|&nbsp; SGST (9%): <strong>₹4,500</strong></li>
      <li>Total Invoice: <strong>₹59,000</strong></li>
    </ul>

    <h3>Example 2 — Interstate Goods Sale at 12%</h3>
    <p>A Bengaluru manufacturer supplies IT hardware worth ₹2,00,000 to a Delhi company.</p>
    <ul>
      <li>Base Price: ₹2,00,000</li>
      <li>IGST (12%): <strong>₹24,000</strong></li>
      <li>Total Invoice: <strong>₹2,24,000</strong></li>
    </ul>

    <h3>Example 3 — 5% GST on Food Products</h3>
    <p>A food manufacturer supplies packaged goods worth ₹1,00,000 to a local retailer (intrastate).</p>
    <ul>
      <li>Base Price: ₹1,00,000</li>
      <li>GST (5%): ₹5,000</li>
      <li>CGST (2.5%): <strong>₹2,500</strong> &nbsp;|&nbsp; SGST (2.5%): <strong>₹2,500</strong></li>
      <li>Total Invoice: <strong>₹1,05,000</strong></li>
    </ul>

    <h2>GST Rates for Common B2B Categories</h2>
    <div class="overflow-x-auto my-4">
      <table class="w-full text-sm border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-canvas-soft-2">
          <tr>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">GST Rate</th>
            <th class="text-left p-3 font-semibold text-ink border-b border-hairline">Common B2B Categories</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-hairline/50"><td class="p-3 font-mono font-bold text-primary">5%</td><td class="p-3 text-body">Agri products, economy transport, packaged food items</td></tr>
          <tr class="border-b border-hairline/50 bg-canvas-soft/30"><td class="p-3 font-mono font-bold text-primary">12%</td><td class="p-3 text-body">Computers, mobile phones, processed foods, business services</td></tr>
          <tr class="border-b border-hairline/50"><td class="p-3 font-mono font-bold text-primary">18%</td><td class="p-3 text-body">Professional services, software, FMCG, electronics, manufacturing</td></tr>
          <tr class="bg-canvas-soft/30"><td class="p-3 font-mono font-bold text-primary">28%</td><td class="p-3 text-body">Luxury goods, tobacco, cement, automobiles, casinos</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Benefits of This Calculator</h2>
    <ul>
      <li><strong>Invoice-ready</strong> — Results match exactly what should appear on your GST invoice</li>
      <li><strong>CGST/SGST/IGST auto-split</strong> — Automatically shows the right tax structure</li>
      <li><strong>Custom rates supported</strong> — Works for 3% (gold), 0.25% and any other category</li>
      <li><strong>Real-time calculation</strong> — Results update as you type, no submit needed</li>
      <li><strong>Mobile-friendly &amp; free</strong> — Works on all devices without login or charges</li>
    </ul>

    <FAQ items={faqs} />

    <h2>Related Calculators</h2>
    <ul>
      <li><a href="/tools/gst-calculator">GST Calculator Online</a> — General add/remove GST tool</li>
      <li><a href="/tools/gst-inclusive-calculator">GST Inclusive Calculator</a> — Extract tax from MRP price</li>
      <li><a href="/tools/igst-calculator">IGST Calculator</a> — Interstate GST calculation</li>
      <li><a href="/tools/gst-split-calculator">GST Split Calculator</a> — CGST and SGST component split</li>
    </ul>

    <h2>Conclusion</h2>
    <p>Whether you are a business owner raising your first GST invoice or a CA preparing bulk billing data, our free <strong>GST Exclusive Calculator online</strong> makes the process instant and error-free. Enter the base price, select the rate, and get a complete breakdown of CGST, SGST, IGST, and the final invoice total in seconds.</p>
  </div>
</CalculatorLayout>

<script>
  const amountInput = document.getElementById('calc-amount') as HTMLInputElement | null;
  const customRateInput = document.getElementById('calc-rate-custom') as HTMLInputElement | null;
  const customRateContainer = document.getElementById('custom-rate-container');
  const gstForm = document.getElementById('gst-form') as HTMLFormElement | null;

  // DOM Outputs
  const resTaxable = document.getElementById('res-taxable-val');
  const resCgstRow = document.getElementById('res-cgst-row');
  const resCgstVal = document.getElementById('res-cgst-val');
  const resSgstRow = document.getElementById('res-sgst-row');
  const resSgstVal = document.getElementById('res-sgst-val');
  const resIgstRow = document.getElementById('res-igst-row');
  const resIgstVal = document.getElementById('res-igst-val');
  const resTotalTax = document.getElementById('res-total-tax');
  const resGrandTotal = document.getElementById('res-grand-total');

  function validateInput(input: HTMLInputElement, message: string, check: () => boolean): boolean {
    const isValid = check();
    let errSpan = document.getElementById(`${input.id}-error`);
    if (!isValid) {
      input.classList.add('input-error');
      if (!errSpan) {
        errSpan = document.createElement('span');
        errSpan.id = `${input.id}-error`;
        errSpan.className = 'error-message';
        errSpan.innerText = message;
        input.parentElement?.parentElement?.appendChild(errSpan);
      }
    } else {
      input.classList.remove('input-error');
      errSpan?.remove();
    }
    return isValid;
  }

  function getSelectedRate(): number {
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    if (!rateRadio) return 18;
    if (rateRadio.value === 'custom') {
      return parseFloat(customRateInput?.value || '0') || 0;
    }
    return parseFloat(rateRadio.value) || 0;
  }

  function calculate() {
    if (!amountInput) return;

    const isAmountValid = validateInput(
      amountInput,
      "Please enter a valid price greater than 0",
      () => parseFloat(amountInput.value) > 0
    );

    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    let isRateValid = true;
    if (rateRadio?.value === 'custom' && customRateInput) {
      isRateValid = validateInput(
        customRateInput,
        "Please enter a rate between 0.1% and 100%",
        () => {
          const val = parseFloat(customRateInput.value);
          return val >= 0.1 && val <= 100;
        }
      );
    }

    if (!isAmountValid || !isRateValid) {
      if (resTaxable) resTaxable.innerText = "₹0.00";
      if (resTotalTax) resTotalTax.innerText = "₹0.00";
      if (resGrandTotal) resGrandTotal.innerText = "₹0.00";
      if (resCgstVal) resCgstVal.innerText = "₹0.00";
      if (resSgstVal) resSgstVal.innerText = "₹0.00";
      if (resIgstVal) resIgstVal.innerText = "₹0.00";
      return;
    }

    const amount = parseFloat(amountInput.value) || 0;
    const rate = getSelectedRate();
    const taxTypeRadio = document.querySelector('input[name="tax-type"]:checked') as HTMLInputElement | null;
    const isIntrastate = taxTypeRadio ? taxTypeRadio.value === 'intrastate' : true;

    // Exclusive GST logic: taxable value is base
    const taxableValue = amount;
    const totalTax = amount * (rate / 100);
    const grandTotal = amount + totalTax;

    // Format currency function
    const fmt = (val: number) => '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (resTaxable) resTaxable.innerText = fmt(taxableValue);
    if (resTotalTax) resTotalTax.innerText = fmt(totalTax);
    if (resGrandTotal) resGrandTotal.innerText = fmt(grandTotal);

    if (isIntrastate) {
      resCgstRow?.classList.remove('hidden');
      resSgstRow?.classList.remove('hidden');
      resIgstRow?.classList.add('hidden');
      
      const splitTax = totalTax / 2;
      if (resCgstVal) resCgstVal.innerText = fmt(splitTax);
      if (resSgstVal) resSgstVal.innerText = fmt(splitTax);
    } else {
      resCgstRow?.classList.add('hidden');
      resSgstRow?.classList.add('hidden');
      resIgstRow?.classList.remove('hidden');
      
      if (resIgstVal) resIgstVal.innerText = fmt(totalTax);
    }
  }

  // Handle prefill from URL
  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const amount = params.get('amount');
    const rate = params.get('rate');
    const taxtype = params.get('taxtype');

    if (amount && amountInput) {
      amountInput.value = amount;
    }

    if (taxtype) {
      const taxRadio = document.querySelector(`input[name="tax-type"][value="${taxtype}"]`) as HTMLInputElement | null;
      if (taxRadio) taxRadio.checked = true;
    }

    if (rate) {
      const standardRates = ['5', '12', '18', '28'];
      if (standardRates.includes(rate)) {
        const rateRadio = document.querySelector(`input[name="calc-rate"][value="${rate}"]`) as HTMLInputElement | null;
        if (rateRadio) rateRadio.checked = true;
      } else {
        const customRadio = document.getElementById('rate-custom-radio') as HTMLInputElement | null;
        if (customRadio) {
          customRadio.checked = true;
          customRateContainer?.classList.remove('hidden');
          if (customRateInput) customRateInput.value = rate;
        }
      }
    }
  }

  // Add listeners
  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  // Monitor Custom Rate visibility
  const rateRadios = document.querySelectorAll('input[name="calc-rate"]');
  rateRadios.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value === 'custom') {
        customRateContainer?.classList.remove('hidden');
        customRateInput?.focus();
      } else {
        customRateContainer?.classList.add('hidden');
        if (customRateInput) {
          customRateInput.classList.remove('input-error');
          document.getElementById('calc-rate-custom-error')?.remove();
        }
      }
      calculate();
    });
  });

  // Init
  loadFromUrl();
  calculate();
</script>
