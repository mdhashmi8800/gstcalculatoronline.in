---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { tools } from '../../utils/tools';

export async function getStaticPaths() {
  const categories = [
    {
      slug: 'tax-slabs',
      name: 'Tax Slab Calculators',
      desc: 'Calculate baseline values, GST percentages, CGST, SGST, IGST splits, and Rule 89 refunds.'
    },
    {
      slug: 'late-fees',
      name: 'Filing Late Fees',
      desc: 'Estimate penalties for delayed GSTR-3B filings with rationalized turnover limits.'
    },
    {
      slug: 'interest-penalties',
      name: 'Interest Penalties',
      desc: 'Calculate Section 50 interest at 18% and 24% p.a. on cash ledger balances.'
    },
    {
      slug: 'composition-scheme',
      name: 'Composition Scheme',
      desc: 'Compute quarterly liabilities for service providers, restaurateurs, and traders.'
    },
    {
      slug: 'utilities',
      name: 'Tax Utilities & Invoice Builders',
      desc: 'Free tools for generating GST invoices, searching HSN codes, and lookup rates.'
    }
  ];

  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { cat }
  }));
}

const { cat } = Astro.props;

// Filter tools belonging to this category
const filteredTools = tools.filter(t => t.category === cat.slug);

// Get related articles dynamically based on category
const allPosts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true })) as any[];

const categoryKeywordMap: Record<string, string[]> = {
  'tax-slabs': ['what-is-gst', 'gst-rates-india-2026', 'hsn-code-guide-india', 'place-of-supply-gst-rules', 'value-of-supply-gst-rules'],
  'late-fees': ['gst-penalties-late-fees-interest', 'gst-return-filing-checklist', 'gstr-3b-filing-step-by-step', 'eway-bill-system-guide'],
  'interest-penalties': ['gst-penalties-late-fees-interest', 'input-tax-credit-itc-rules', 'gstr-2a-vs-gstr-2b-reconciliation'],
  'composition-scheme': ['composition-scheme-gst-guide', 'gst-small-businesses-impact', 'gst-invoice-rules-format'],
  'utilities': ['gst-invoice-rules-format', 'sac-code-services-guide', 'hsn-code-guide-india']
};

const targetSlugs = categoryKeywordMap[cat.slug] || ['what-is-gst'];
const relatedArticles = allPosts
  .filter(post => targetSlugs.includes(post.frontmatter.slug))
  .map(post => ({
    title: post.frontmatter.title,
    slug: post.frontmatter.slug,
    date: post.frontmatter.date,
    readTime: post.frontmatter.readTime
  }));

const pageTitle = `${cat.name} - Free GST Tools`;
const pageDesc = `${cat.desc} Fast, precise, and updated online financial tools according to the latest Indian GST rules.`;
---

<Layout seo={{ title: pageTitle, description: pageDesc }}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs />

    <header class="mb-10 mt-6 max-w-3xl">
      <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary font-mono uppercase tracking-wider mb-3">
        Tool Category
      </span>
      <h1 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{cat.name}</h1>
      <p class="mt-3 text-base sm:text-lg text-body leading-relaxed">{cat.desc}</p>
    </header>



    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Tool Cards List -->
      <main class="lg:col-span-8 space-y-6">
        <h2 class="text-xl font-bold text-ink mb-4">Available Calculators ({filteredTools.length})</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {filteredTools.map((tool) => (
            <ToolCard 
              title={tool.name}
              description={tool.desc}
              url={tool.url}
              icon={tool.icon}
              badge={tool.badge}
            />
          ))}
        </div>
      </main>

      <!-- Right Column: Sidebar (Related guides & Category chips) -->
      <aside class="lg:col-span-4 space-y-6">
        <!-- Related Articles Widget -->
        {relatedArticles.length > 0 && (
          <div class="rounded-2xl border border-hairline bg-canvas-soft p-6 shadow-xs">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-ink pb-3 border-b border-hairline mb-4">Category Filing Guides</h3>
            <div class="space-y-4">
              {relatedArticles.map((art) => (
                <a href={`/blog/${art.slug}`} class="block group">
                  <h4 class="text-sm font-semibold text-ink group-hover:text-primary transition-colors leading-snug line-clamp-2">
                    {art.title}
                  </h4>
                  <div class="flex items-center gap-2 mt-1 text-[10px] text-mute font-mono">
                    <span>{art.readTime}</span>
                  </div>
                </a>
              ))}
            </div>
            <div class="mt-6 border-t border-hairline pt-4">
              <a href="/blog" class="inline-flex items-center text-xs font-semibold text-primary hover:underline gap-1">
                Explore all Guides
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3 w-3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>
        )}

        <!-- Quick Links to other categories -->
        <div class="rounded-2xl border border-hairline bg-canvas-soft p-6 shadow-xs">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-ink pb-3 border-b border-hairline mb-4">Other Categories</h3>
          <div class="flex flex-col gap-2">
            {[
              { slug: 'tax-slabs', name: 'Tax Slabs' },
              { slug: 'late-fees', name: 'Late Fees' },
              { slug: 'interest-penalties', name: 'Interest' },
              { slug: 'composition-scheme', name: 'Composition' }
            ].filter(c => c.slug !== cat.slug).map((c) => (
              <a 
                href={`/category/${c.slug}`} 
                class="flex items-center justify-between p-3 rounded-xl border border-hairline bg-canvas hover:border-hairline-strong hover:bg-canvas-soft-2 transition-all text-xs font-semibold text-body hover:text-ink"
              >
                <span>{c.name} Tools</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3 w-3 text-mute">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>


  </div>
</Layout>
