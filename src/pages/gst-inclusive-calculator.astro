---
import CalculatorLayout from '../components/CalculatorLayout.astro';
import ResultCard from '../components/ResultCard.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "GST Inclusive Calculator – Extract Tax from Total";
const pageDesc = "Extract net values, total GST, and tax splits (CGST, SGST, IGST) from a price that already includes tax. Free, fast, and 100% accurate online tool.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": "GST Inclusive Calculator – Extract Tax from Final Price",
  "url": "https://gstcalculatoronline.in/gst-inclusive-calculator",
  "description": "Extract net values, total GST, and tax splits (CGST, SGST, IGST) from a price that already includes tax. Free, fast, and 100% accurate online tool.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  }
};

const faqs = [
  {
    question: "What does 'inclusive of GST' mean?",
    answer: "It means that the price shown on the tag or bill already includes the Goods and Services Tax. The buyer does not need to pay any additional tax on top of this stated price."
  },
  {
    question: "How to extract GST from an inclusive price?",
    answer: "Divide the inclusive price by (1 + GST Rate / 100). This isolates the base price. Subtract the base price from the inclusive price to find the GST amount. Example: ₹118 at 18% GST → ₹118 ÷ 1.18 = ₹100 base, leaving ₹18 GST."
  },
  {
    question: "What is the formula for inclusive GST?",
    answer: "GST Amount = Inclusive Price - [Inclusive Price ÷ (1 + GST Rate ÷ 100)]. Base Price = Inclusive Price ÷ (1 + GST Rate ÷ 100)."
  },
  {
    question: "What is the difference between GST inclusive and exclusive?",
    answer: "Inclusive means the tax is already added to the listed price. Exclusive means the listed price is the base rate, and tax will be calculated and added on top of it at checkout."
  },
  {
    question: "How do I calculate 18% inclusive GST?",
    answer: "Divide the total inclusive price by 1.18 to find the base value. Subtract that base value from the total price to find the 18% GST portion."
  },
  {
    question: "How do I calculate 12% inclusive GST?",
    answer: "Divide the total inclusive amount by 1.12 to get the base taxable value. The remainder is the 12% GST tax component."
  },
  {
    question: "How do I calculate 5% inclusive GST?",
    answer: "Divide the total inclusive amount by 1.05. The result is the pre-tax base cost, and the remaining 5% is the GST portion."
  },
  {
    question: "How do I calculate 28% inclusive GST?",
    answer: "Divide the inclusive total by 1.28 to find the net taxable value. The difference is the 28% luxury tax amount."
  },
  {
    question: "How to split inclusive GST into CGST and SGST?",
    answer: "After calculating the total GST using the inclusive formula, divide that amount by 2. Allocate one half as CGST and the other as SGST for local transactions."
  },
  {
    question: "Can I input a custom rate in the inclusive GST calculator?",
    answer: "Yes, click on 'Custom' in the rate list, enter your custom percentage (e.g. 3% for gold or 0.25% for precious stones), and the calculator will automatically extract the tax."
  },
  {
    question: "Why is inclusive GST calculation important for claiming ITC?",
    answer: "To claim Input Tax Credit (ITC), you must know the exact tax amount paid. If your vendor issues a tax-inclusive bill without showing the split, the inclusive calculator helps verify the figures before filing GSTR-3B."
  },
  {
    question: "What is the inclusive GST formula in Excel?",
    answer: "If the inclusive amount is in cell A1 and the tax rate is 18%, the formula is: `=A1 - (A1 / 1.18)`. This returns the GST portion directly."
  },
  {
    question: "Does this calculator support mobile view?",
    answer: "Yes, our GST Inclusive Calculator is fully responsive and designed to work on all modern mobile phones, tablets, and desktops."
  },
  {
    question: "Do I need to sign up to use the calculator?",
    answer: "No registration or login is required. The tool is 100% free and open for public use."
  },
  {
    question: "Are my calculation histories stored on your servers?",
    answer: "No. All calculations are performed inside your browser via local JavaScript. We do not store or track any of your financial data."
  },
  {
    question: "How do I print the inclusive GST breakdown?",
    answer: "Scroll to the results card, click the 'Print' button (visible on desktops), or click 'PDF' to download a clean, print-ready document of your breakdown."
  },
  {
    question: "What is the place of supply rule for inclusive GST?",
    answer: "If the supplier and place of supply are in the same state, split the GST into CGST and SGST. If they are in different states, allocate the entire GST to IGST."
  },
  {
    question: "How is gold GST calculated?",
    answer: "Gold attracts a special rate of 3% GST plus making charges. You can select 'Custom' and input 3% in our calculator to get the split details."
  },
  {
    question: "Does the calculator round off the decimal amounts?",
    answer: "It displays exact values to two decimal places. In actual tax returns, you round off the final value to the nearest integer under Section 170."
  },
  {
    question: "How do I reset the form fields?",
    answer: "Click the 'Reset' button below the results card or press the 'ESC' key on your keyboard to instantly restore default values."
  }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema} faqs={faqs}>
  <form id="gst-form" class="space-y-4 md:space-y-6" autocomplete="off">
    <!-- Transaction Amount -->
    <div>
      <label for="calc-amount" class="block text-sm font-bold text-ink">Transaction Amount (₹)</label>
      <div class="relative mt-2">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-mute">
          <span class="text-sm font-bold font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="amount" 
          id="calc-amount" 
          value="10000" 
          min="1" 
          step="any"
          class="block w-full rounded-xl border border-hairline bg-canvas py-3.5 pl-9 pr-4 text-base text-ink outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 font-mono font-semibold transition-all"
          placeholder="e.g. 10000"
          required
          aria-label="Transaction Amount in Rupees"
        />
      </div>
      <!-- Quick Amount Chips -->
      <div class="mt-3 flex flex-wrap gap-1.5" id="page-quick-chips" role="group" aria-label="Quick amount presets">
        {(['100', '500', '1K', '5K', '10K', '25K', '50K', '1L'] as const).map(chip => (
          <button type="button" class="quick-chip" data-chip={chip}>₹{chip}</button>
        ))}
      </div>
    </div>

    <!-- Calculation Direction -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">GST Direction</span>
      <div class="segmented-control" role="group" aria-label="GST calculation direction">
        <label class="segmented-btn btn-add-gst cursor-pointer">
          <input type="radio" name="calc-type" value="add" class="sr-only" />
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          Add GST
        </label>
        <label class="segmented-btn btn-remove-gst cursor-pointer">
          <input type="radio" name="calc-type" value="remove" checked class="sr-only" />
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/></svg>
          Remove GST
        </label>
      </div>
    </div>

    <!-- GST Tax Slab Rates -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">GST Rate</span>
      <div class="rate-pill-container sm:grid sm:grid-cols-6 gap-2" role="group" aria-label="GST rate selection">
        {(['3', '5', '12', '18', '28'] as const).map((rate) => (
          <label class="rate-pill cursor-pointer [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-primary [&:has(input:checked)]:text-on-primary">
            <input type="radio" name="calc-rate" value={rate} checked={rate === '18'} class="sr-only" />
            {rate}%
          </label>
        ))}
        <label class="rate-pill cursor-pointer [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-primary [&:has(input:checked)]:text-on-primary">
          <input type="radio" name="calc-rate" id="rate-custom-radio" value="custom" class="sr-only" />
          Custom
        </label>
      </div>
      
      <!-- Custom Rate Input (Hidden by default) -->
      <div id="custom-rate-container" class="hidden mt-3">
        <label for="calc-rate-custom" class="sr-only">Custom GST Rate (%)</label>
        <div class="relative">
          <input 
            type="number" 
            name="custom-rate" 
            id="calc-rate-custom" 
            min="0.1" 
            max="100" 
            step="any"
            value="18"
            class="block w-full rounded-xl border border-hairline bg-canvas py-2.5 px-3 pr-8 text-sm text-ink outline-none focus:border-primary font-mono"
            placeholder="Enter custom rate e.g. 3"
          />
          <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-mute text-xs font-mono">%</span>
        </div>
      </div>
    </div>

    <!-- Supply Destination -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">Transaction Type</span>
      <div class="segmented-control" role="group" aria-label="Transaction type">
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="tax-type" value="intrastate" checked class="sr-only" />
          <span>Intra-State <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(CGST+SGST)</span></span>
        </label>
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="tax-type" value="interstate" class="sr-only" />
          <span>Inter-State <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(IGST)</span></span>
        </label>
      </div>
    </div>

    <!-- Keyboard Shortcuts Hint -->
    <div class="flex items-center gap-3 text-[10px] text-mute font-mono pt-1">
      <span class="kbd">ESC</span><span>Reset</span>
      <span class="kbd ml-2">Tab</span><span>Navigate fields</span>
    </div>
  </form>

  <ResultCard slot="results" />

  <div slot="content" class="prose max-w-none">
    <h2>GST Inclusive Calculator — Extract Tax &amp; Pre-Tax Base Amount</h2>
    <p>A <strong>GST inclusive calculator</strong> is a specialized financial utility that extracts the pre-tax base cost and exact Goods and Services Tax (GST) amount from a price that already includes tax. In India, Maximum Retail Prices (MRP) displayed on consumer goods, retail packaging, and consumer service receipts are legally required to be inclusive of all taxes.</p>
    <p>When recording transactions in accounting software (such as Tally, Zoho Books, or QuickBooks), businesses must book the pure taxable base amount separately from output and input tax ledgers. Our free <strong>GST Inclusive Calculator</strong> automates this extraction instantly across all statutory Indian tax slabs (5%, 12%, 18%, 28%) and custom tax rates.</p>

    <h2>The Mathematical Formula for Inclusive GST Calculation</h2>
    <p>To extract the base amount and tax from a tax-inclusive total, use the following algebraic formulas:</p>

    <div class="my-6 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed space-y-4">
      <div>
        <p class="font-semibold text-primary">1. Baseline Taxable Value Formula:</p>
        <p>Pre-Tax Base Amount = Gross Inclusive Price ÷ (1 + GST Rate ÷ 100)</p>
      </div>
      <div class="border-t border-hairline/50 pt-4">
        <p class="font-semibold text-primary">2. GST Tax Extraction Formula:</p>
        <p>Total GST Tax Amount = Gross Inclusive Price − Pre-Tax Base Amount</p>
        <p>CGST Tax Portion = Total GST Tax Amount ÷ 2 (for intra-state supplies)</p>
        <p>SGST Tax Portion = Total GST Tax Amount ÷ 2 (for intra-state supplies)</p>
        <p>IGST Tax Portion = Full Total GST Tax Amount (for inter-state supplies)</p>
      </div>
    </div>

    <h2>Step-by-Step Worked Numerical Scenarios</h2>

    <h3>Example 1: Extracting 18% GST from an Electronics Invoice of ₹59,000</h3>
    <p>A corporate buyer purchases office IT hardware for a total invoice amount of ₹59,000 (inclusive of 18% GST):</p>
    <ul>
      <li><strong>Gross Inclusive Price:</strong> ₹59,000</li>
      <li><strong>Tax Factor:</strong> 1 + (18 ÷ 100) = 1.18</li>
      <li><strong>Pre-Tax Base Amount:</strong> ₹59,000 ÷ 1.18 = <strong>₹50,000</strong></li>
      <li><strong>Total GST Amount:</strong> ₹59,000 − ₹50,000 = <strong>₹9,000</strong></li>
      <li><strong>CGST (9%):</strong> ₹4,500 | <strong>SGST (9%):</strong> ₹4,500</li>
    </ul>

    <h3>Example 2: Extracting 12% GST from Commercial Goods of ₹22,400</h3>
    <p>A shopkeeper sells packaged goods for an MRP of ₹22,400 inclusive of 12% GST:</p>
    <ul>
      <li><strong>Gross MRP Total:</strong> ₹22,400</li>
      <li><strong>Pre-Tax Base Amount:</strong> ₹22,400 ÷ 1.12 = <strong>₹20,000</strong></li>
      <li><strong>Total GST Extracted:</strong> ₹22,400 − ₹20,000 = <strong>₹2,400</strong></li>
      <li><strong>CGST (6%):</strong> ₹1,200 | <strong>SGST (6%):</strong> ₹1,200</li>
    </ul>

    <h2>Inclusive GST Divisor Table Across Slabs</h2>
    <div class="overflow-x-auto my-6">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="border-b border-hairline bg-canvas-soft">
            <th class="p-3 font-semibold text-ink">Slab Rate</th>
            <th class="p-3 font-semibold text-ink">Inclusive Divisor</th>
            <th class="p-3 font-semibold text-ink">Effective Tax Fraction</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <tr>
            <td class="p-3 font-mono font-bold text-primary">3% (Gold)</td>
            <td class="p-3 font-mono">1.03</td>
            <td class="p-3 text-body">3 ÷ 103 ≈ 2.912% of total price</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold text-primary">5% (Merit)</td>
            <td class="p-3 font-mono">1.05</td>
            <td class="p-3 text-body">5 ÷ 105 ≈ 4.762% of total price</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold text-primary">12% (Standard I)</td>
            <td class="p-3 font-mono">1.12</td>
            <td class="p-3 text-body">12 ÷ 112 ≈ 10.714% of total price</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold text-primary">18% (Standard II)</td>
            <td class="p-3 font-mono">1.18</td>
            <td class="p-3 text-body">18 ÷ 118 ≈ 15.254% of total price</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold text-primary">28% (Luxury)</td>
            <td class="p-3 font-mono">1.28</td>
            <td class="p-3 text-body">28 ÷ 128 ≈ 21.875% of total price</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>Why Inclusive GST Calculation Matters for Input Tax Credit (ITC)</h2>
    <p>To claim <strong>Input Tax Credit (ITC)</strong> under Section 16 of the CGST Act, 2017, registered taxpayers must report the exact taxable value and segregated tax amounts in their monthly GSTR-3B filings. When vendors issue consolidated bills without separate line items, using an inclusive calculator ensures that credit claims match your accounting ledgers with zero discrepancy.</p>

    <h2>Frequently Asked Questions</h2>
    <FAQ items={faqs} />

    <div class="mt-8 rounded-xl border border-hairline bg-canvas-soft p-6 shadow-xs text-center">
      <h3 class="text-lg font-bold text-ink mb-2">Need a different GST tool?</h3>
      <p class="text-sm text-body mb-4">Browse our complete list of calculators, find active GST rate slabs, or create professional invoices in seconds.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/gst-calculator" class="px-4 py-2 rounded-xl bg-primary text-on-primary text-xs font-semibold hover:opacity-90 transition-all">GST Calculator</a>
        <a href="/gst-exclusive-calculator" class="px-4 py-2 rounded-xl border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all">GST Exclusive Calculator</a>
        <a href="/reverse-gst-calculator" class="px-4 py-2 rounded-xl border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all">Reverse GST Calculator</a>
        <a href="/gst-rates" class="px-4 py-2 rounded-xl border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all">View GST Rates</a>
      </div>
    </div>
  </div>
</CalculatorLayout>

<script>
  // Calculator logical implementation
  const amountInput = document.getElementById('calc-amount') as HTMLInputElement | null;
  const customRateInput = document.getElementById('calc-rate-custom') as HTMLInputElement | null;
  const customRateContainer = document.getElementById('custom-rate-container');
  const gstForm = document.getElementById('gst-form') as HTMLFormElement | null;

  // DOM Outputs
  const resTaxable = document.getElementById('res-taxable-val');
  const resCgstRow = document.getElementById('res-cgst-row');
  const resCgstVal = document.getElementById('res-cgst-val');
  const resSgstRow = document.getElementById('res-sgst-row');
  const resSgstVal = document.getElementById('res-sgst-val');
  const resIgstRow = document.getElementById('res-igst-row');
  const resIgstVal = document.getElementById('res-igst-val');
  const resTotalTax = document.getElementById('res-total-tax');
  const resGrandTotal = document.getElementById('res-grand-total');

  function validateInput(input: HTMLInputElement, message: string, check: () => boolean): boolean {
    const isValid = check();
    let errSpan = document.getElementById(`${input.id}-error`);
    if (!isValid) {
      input.classList.add('input-error');
      if (!errSpan) {
        errSpan = document.createElement('span');
        errSpan.id = `${input.id}-error`;
        errSpan.className = 'error-message';
        errSpan.innerText = message;
        input.parentElement?.parentElement?.appendChild(errSpan);
      }
    } else {
      input.classList.remove('input-error');
      errSpan?.remove();
    }
    return isValid;
  }

  function getSelectedRate(): number {
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    if (!rateRadio) return 18;
    if (rateRadio.value === 'custom') {
      return parseFloat(customRateInput?.value || '0') || 0;
    }
    return parseFloat(rateRadio.value) || 0;
  }

  function calculate() {
    if (!amountInput) return;

    // Validate main amount
    const isAmountValid = validateInput(
      amountInput,
      "Please enter a valid amount greater than 0",
      () => parseFloat(amountInput.value) > 0
    );

    // Validate custom rate if selected
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    let isRateValid = true;
    if (rateRadio?.value === 'custom' && customRateInput) {
      isRateValid = validateInput(
        customRateInput,
        "Please enter a rate between 0.1% and 100%",
        () => {
          const val = parseFloat(customRateInput.value);
          return val >= 0.1 && val <= 100;
        }
      );
    }

    if (!isAmountValid || !isRateValid) {
      if (resTaxable) resTaxable.innerText = "₹0.00";
      if (resTotalTax) resTotalTax.innerText = "₹0.00";
      if (resGrandTotal) resGrandTotal.innerText = "₹0.00";
      if (resCgstVal) resCgstVal.innerText = "₹0.00";
      if (resSgstVal) resSgstVal.innerText = "₹0.00";
      if (resIgstVal) resIgstVal.innerText = "₹0.00";
      return;
    }

    const amount = parseFloat(amountInput.value) || 0;
    const rate = getSelectedRate();
    const typeRadio = document.querySelector('input[name="calc-type"]:checked') as HTMLInputElement | null;
    const isAdd = typeRadio ? typeRadio.value === 'add' : true;
    
    const taxTypeRadio = document.querySelector('input[name="tax-type"]:checked') as HTMLInputElement | null;
    const isIntrastate = taxTypeRadio ? taxTypeRadio.value === 'intrastate' : true;

    let taxableValue = 0;
    let totalTax = 0;
    let grandTotal = 0;

    if (isAdd) {
      taxableValue = amount;
      totalTax = amount * (rate / 100);
      grandTotal = amount + totalTax;
    } else {
      taxableValue = amount / (1 + (rate / 100));
      totalTax = amount - taxableValue;
      grandTotal = amount;
    }

    const fmt = (val: number) => '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (resTaxable) resTaxable.innerText = fmt(taxableValue);
    if (resTotalTax) resTotalTax.innerText = fmt(totalTax);
    if (resGrandTotal) resGrandTotal.innerText = fmt(grandTotal);

    if (isIntrastate) {
      resCgstRow?.classList.remove('hidden');
      resSgstRow?.classList.remove('hidden');
      resIgstRow?.classList.add('hidden');
      const splitTax = totalTax / 2;
      if (resCgstVal) resCgstVal.innerText = fmt(splitTax);
      if (resSgstVal) resSgstVal.innerText = fmt(splitTax);
    } else {
      resCgstRow?.classList.add('hidden');
      resSgstRow?.classList.add('hidden');
      resIgstRow?.classList.remove('hidden');
      if (resIgstVal) resIgstVal.innerText = fmt(totalTax);
    }
  }

  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const amount = params.get('amount');
    const rate = params.get('rate');
    const type = params.get('type');
    const taxtype = params.get('taxtype');

    if (amount && amountInput) amountInput.value = amount;

    if (type) {
      const typeRadio = document.querySelector(`input[name="calc-type"][value="${type}"]`) as HTMLInputElement | null;
      if (typeRadio) typeRadio.checked = true;
    }

    if (taxtype) {
      const taxRadio = document.querySelector(`input[name="tax-type"][value="${taxtype}"]`) as HTMLInputElement | null;
      if (taxRadio) taxRadio.checked = true;
    }

    if (rate) {
      const standardRates = ['5', '12', '18', '28'];
      if (standardRates.includes(rate)) {
        const rateRadio = document.querySelector(`input[name="calc-rate"][value="${rate}"]`) as HTMLInputElement | null;
        if (rateRadio) rateRadio.checked = true;
      } else {
        const customRadio = document.getElementById('rate-custom-radio') as HTMLInputElement | null;
        if (customRadio) {
          customRadio.checked = true;
          customRateContainer?.classList.remove('hidden');
          if (customRateInput) customRateInput.value = rate;
        }
      }
    }
  }

  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  const rateRadios = document.querySelectorAll('input[name="calc-rate"]');
  rateRadios.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value === 'custom') {
        customRateContainer?.classList.remove('hidden');
        customRateInput?.focus();
      } else {
        customRateContainer?.classList.add('hidden');
        if (customRateInput) {
          customRateInput.classList.remove('input-error');
          document.getElementById('calc-rate-custom-error')?.remove();
        }
      }
      calculate();
    });
  });

  // Quick Amount Chips
  const chipValues: Record<string, number> = {
    '100': 100, '500': 500, '1K': 1000, '5K': 5000,
    '10K': 10000, '25K': 25000, '50K': 50000, '1L': 100000
  };
  document.querySelectorAll<HTMLButtonElement>('#page-quick-chips .quick-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const val = chipValues[chip.dataset.chip || ''] || 0;
      if (amountInput) amountInput.value = String(val);
      document.querySelectorAll('#page-quick-chips .quick-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      calculate();
    });
  });

  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  loadFromUrl();
  calculate();
</script>
