---
import CalculatorLayout from '../components/CalculatorLayout.astro';
import ResultCard from '../components/ResultCard.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "GST Exclusive Calculator – Add GST to Base Price";
const pageDesc = "Add GST to base exclusive amounts. Calculate final prices and splits (CGST, SGST, IGST) at 5%, 12%, 18%, and 28%. Free and accurate online tool.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": "GST Exclusive Calculator – Add GST on Top of Base Price",
  "url": "https://gstcalculatoronline.in/gst-exclusive-calculator",
  "description": "Add GST to base exclusive amounts. Calculate final prices and splits (CGST, SGST, IGST) at 5%, 12%, 18%, and 28%. Free and accurate online tool.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  }
};

const faqs = [
  {
    question: "What does 'exclusive of GST' mean?",
    answer: "It means that the stated price represents only the cost of the product or service, and does not include the tax. GST will be calculated separately and added on top at checkout."
  },
  {
    question: "How do I calculate GST exclusive of price?",
    answer: "Multiply the base price by the tax rate. GST Amount = Base Price × (GST Rate ÷ 100). The total price is Base Price + GST Amount."
  },
  {
    question: "What is the formula to add GST to a price?",
    answer: "Total Price = Base Price × (1 + GST Rate ÷ 100). GST Tax Amount = Base Price × (GST Rate ÷ 100)."
  },
  {
    question: "How to calculate 18% GST on a base price?",
    answer: "Multiply the base amount by 0.18. This gives the GST tax portion. Add this tax portion to the base amount to get the final bill value. Example: ₹10,000 × 0.18 = ₹1,800 tax; total = ₹11,800."
  },
  {
    question: "How to calculate 12% GST on an exclusive price?",
    answer: "Multiply the base price by 12% (or 0.12) to find the tax amount. Add it to the base price to compute the final gross value."
  },
  {
    question: "How to calculate 5% GST on an exclusive price?",
    answer: "Multiply the base amount by 5% (or 0.05) to compute the tax portion. Add it to the base to get the gross invoice total."
  },
  {
    question: "How to calculate 28% GST on an exclusive price?",
    answer: "Multiply the base price by 28% (or 0.28) to find the luxury tax portion. Add it to the base price to calculate the grand total."
  },
  {
    question: "Is exclusive GST the same as adding GST?",
    answer: "Yes. Exclusive GST calculation refers to adding tax on top of a net base price, whereas inclusive calculation refers to extracting tax from a gross price."
  },
  {
    question: "How is B2B invoicing handled for exclusive prices?",
    answer: "B2B invoices are almost always generated in exclusive format. The seller lists the item base rate, computes the GST split, and lists the grand total. This allows the buyer to claim ITC on the exact tax line item."
  },
  {
    question: "Does this calculator show CGST and SGST splits?",
    answer: "Yes. If you select 'Intra-State', the calculator automatically divides the total tax into two equal parts: Central GST (CGST) and State GST (SGST)."
  },
  {
    question: "What is the Excel formula for adding GST?",
    answer: "If the base price is in cell A1 and the tax rate is 18%, the formula is: `=A1 * (1 + 18/100)` or `=A1 * 1.18`. This returns the total inclusive price."
  },
  {
    question: "Does the calculator support custom tax rates?",
    answer: "Yes. Choose 'Custom' and input any percentage, such as 3% for gold or 1.5% for specific goods, and the tool will calculate the tax instantly."
  },
  {
    question: "Is this online exclusive GST calculator free?",
    answer: "Yes, it is 100% free. No registration, no logs, and no usage caps."
  },
  {
    question: "Can I use the tool on my smartphone?",
    answer: "Absolutely. The tool is fully optimized and mobile-responsive for both iOS and Android browsers."
  },
  {
    question: "Are calculations private?",
    answer: "Yes. Calculations run on your device using client-side JavaScript. No data is sent to our servers."
  },
  {
    question: "How to split the exclusive tax for interstate supply?",
    answer: "For interstate supply, select 'Inter-State' in the form. The calculator will allocate the entire tax portion to Integrated GST (IGST) without splitting."
  },
  {
    question: "Does this calculator handle fractions or decimals?",
    answer: "Yes, you can enter decimal values for both amounts and custom rates. The results are displayed to two decimal places."
  },
  {
    question: "How do I share the calculation with someone?",
    answer: "Fill in the form, click the 'Share' button under the results card, and a unique URL containing your parameters will be copied to your clipboard."
  },
  {
    question: "What is the charging section under the CGST Act?",
    answer: "Section 9 of the CGST Act, 2017, is the charging section that levies GST on intrastate supplies, making exclusive calculation mandatory for taxable invoicing."
  },
  {
    question: "How do I reset all form values?",
    answer: "Click 'Reset' at the bottom of the results card, or press the 'ESC' key on your keyboard to clear all fields and start over."
  }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema} faqs={faqs}>
  <form id="gst-form" class="space-y-4 md:space-y-6" autocomplete="off">
    <!-- Transaction Amount -->
    <div>
      <label for="calc-amount" class="block text-sm font-bold text-ink">Transaction Amount (₹)</label>
      <div class="relative mt-2">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-mute">
          <span class="text-sm font-bold font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="amount" 
          id="calc-amount" 
          value="10000" 
          min="1" 
          step="any"
          class="block w-full rounded-xl border border-hairline bg-canvas py-3.5 pl-9 pr-4 text-base text-ink outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 font-mono font-semibold transition-all"
          placeholder="e.g. 10000"
          required
          aria-label="Transaction Amount in Rupees"
        />
      </div>
      <!-- Quick Amount Chips -->
      <div class="mt-3 flex flex-wrap gap-1.5" id="page-quick-chips" role="group" aria-label="Quick amount presets">
        {(['100', '500', '1K', '5K', '10K', '25K', '50K', '1L'] as const).map(chip => (
          <button type="button" class="quick-chip" data-chip={chip}>₹{chip}</button>
        ))}
      </div>
    </div>

    <!-- Calculation Direction -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">GST Direction</span>
      <div class="segmented-control" role="group" aria-label="GST calculation direction">
        <label class="segmented-btn btn-add-gst cursor-pointer">
          <input type="radio" name="calc-type" value="add" checked class="sr-only" />
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          Add GST
        </label>
        <label class="segmented-btn btn-remove-gst cursor-pointer">
          <input type="radio" name="calc-type" value="remove" class="sr-only" />
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/></svg>
          Remove GST
        </label>
      </div>
    </div>

    <!-- GST Tax Slab Rates -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">GST Rate</span>
      <div class="rate-pill-container sm:grid sm:grid-cols-6 gap-2" role="group" aria-label="GST rate selection">
        {(['3', '5', '12', '18', '28'] as const).map((rate) => (
          <label class="rate-pill cursor-pointer [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-primary [&:has(input:checked)]:text-on-primary">
            <input type="radio" name="calc-rate" value={rate} checked={rate === '18'} class="sr-only" />
            {rate}%
          </label>
        ))}
        <label class="rate-pill cursor-pointer [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-primary [&:has(input:checked)]:text-on-primary">
          <input type="radio" name="calc-rate" id="rate-custom-radio" value="custom" class="sr-only" />
          Custom
        </label>
      </div>
      
      <!-- Custom Rate Input (Hidden by default) -->
      <div id="custom-rate-container" class="hidden mt-3">
        <label for="calc-rate-custom" class="sr-only">Custom GST Rate (%)</label>
        <div class="relative">
          <input 
            type="number" 
            name="custom-rate" 
            id="calc-rate-custom" 
            min="0.1" 
            max="100" 
            step="any"
            value="18"
            class="block w-full rounded-xl border border-hairline bg-canvas py-2.5 px-3 pr-8 text-sm text-ink outline-none focus:border-primary font-mono"
            placeholder="Enter custom rate e.g. 3"
          />
          <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-mute text-xs font-mono">%</span>
        </div>
      </div>
    </div>

    <!-- Supply Destination -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">Transaction Type</span>
      <div class="segmented-control" role="group" aria-label="Transaction type">
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="tax-type" value="intrastate" checked class="sr-only" />
          <span>Intra-State <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(CGST+SGST)</span></span>
        </label>
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="tax-type" value="interstate" class="sr-only" />
          <span>Inter-State <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(IGST)</span></span>
        </label>
      </div>
    </div>

    <!-- Keyboard Shortcuts Hint -->
    <div class="flex items-center gap-3 text-[10px] text-mute font-mono pt-1">
      <span class="kbd">ESC</span><span>Reset</span>
      <span class="kbd ml-2">Tab</span><span>Navigate fields</span>
    </div>
  </form>

  <ResultCard slot="results" />

  <div slot="content" class="prose max-w-none">
    <h2>GST Exclusive Calculator — Add GST to Net Base Price</h2>
    <p>A <strong>GST exclusive calculator</strong> is a financial utility used to calculate the final invoice total and tax breakdowns by adding Goods and Services Tax (GST) on top of a net taxable base price. In business-to-business (B2B) trade and professional service proposals across India, pricing quotes are standardly presented as 'exclusive of GST'. This allows buyers to clearly view the net cost and calculate the exact Input Tax Credit (ITC) they can claim.</p>
    <p>Our free <strong>GST Exclusive Calculator</strong> adds GST accurately across all statutory Indian tax slabs — <strong>5%, 12%, 18%, and 28%</strong> — and custom rates, automatically computing intra-state (CGST + SGST) and inter-state (IGST) splits.</p>

    <h2>The Mathematical Formula for Exclusive GST Calculation</h2>
    <p>When adding GST to a net base price, use the following standard formulas:</p>

    <div class="my-6 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed space-y-4">
      <div>
        <p class="font-semibold text-primary">1. Adding GST to Base Price:</p>
        <p>GST Tax Amount = Base Taxable Price × (GST Rate ÷ 100)</p>
        <p>Gross Final Invoice Amount = Base Taxable Price + GST Tax Amount</p>
      </div>
      <div class="border-t border-hairline/50 pt-4">
        <p class="font-semibold text-primary">2. Tax Component Splits:</p>
        <p>CGST Tax Portion = GST Tax Amount ÷ 2 (for intra-state supplies)</p>
        <p>SGST Tax Portion = GST Tax Amount ÷ 2 (for intra-state supplies)</p>
        <p>IGST Tax Portion = Full GST Tax Amount (for inter-state supplies)</p>
      </div>
    </div>

    <h2>Step-by-Step Numerical Examples</h2>

    <h3>Example 1: Adding 18% GST to CA Audit Services of ₹25,000</h3>
    <p>A Chartered Accountant in Mumbai invoices a client in Maharashtra for ₹25,000 plus 18% GST:</p>
    <ul>
      <li><strong>Base Taxable Fee:</strong> ₹25,000</li>
      <li><strong>GST Tax Rate:</strong> 18%</li>
      <li><strong>GST Tax Amount:</strong> ₹25,000 × (18 ÷ 100) = <strong>₹4,500</strong></li>
      <li><strong>CGST Component (9%):</strong> ₹2,250</li>
      <li><strong>SGST Component (9%):</strong> ₹2,250</li>
      <li><strong>Grand Total Invoice Amount:</strong> ₹25,000 + ₹4,500 = <strong>₹29,500</strong></li>
    </ul>

    <h3>Example 2: Adding 5% GST to Packaged Commodities of ₹80,000</h3>
    <p>A wholesaler in Delhi sells packaged spices to a local retailer for ₹80,000 (exclusive of tax):</p>
    <ul>
      <li><strong>Base Taxable Price:</strong> ₹80,000</li>
      <li><strong>GST Tax Rate:</strong> 5%</li>
      <li><strong>GST Tax Amount:</strong> ₹80,000 × 5% = <strong>₹4,000</strong></li>
      <li><strong>CGST (2.5%):</strong> ₹2,000 | <strong>SGST (2.5%):</strong> ₹2,000</li>
      <li><strong>Gross Invoice Total:</strong> ₹80,000 + ₹4,000 = <strong>₹84,000</strong></li>
    </ul>

    <h3>Example 3: Interstate Supply at 28% Luxury GST of ₹2,00,000</h3>
    <p>A dealer in Haryana ships commercial air conditioning units to a company in Punjab for ₹2,00,000:</p>
    <ul>
      <li><strong>Base Taxable Value:</strong> ₹2,00,000</li>
      <li><strong>Transaction Type:</strong> Inter-State (IGST)</li>
      <li><strong>IGST Tax Amount (28%):</strong> ₹2,00,000 × 28% = <strong>₹56,000</strong></li>
      <li><strong>Final Billing Value:</strong> ₹2,00,000 + ₹56,000 = <strong>₹2,56,000</strong></li>
    </ul>

    <h2>B2B Invoicing Rules for Exclusive GST Pricing</h2>
    <p>Under Section 31 of the CGST Act and Rule 46 of the CGST Rules, 2017, a valid tax invoice must show:</p>
    <ul>
      <li>The total taxable value of the goods or services supplied.</li>
      <li>The applicable rate of GST (CGST, SGST, UTGST, or IGST).</li>
      <li>The exact total tax charged on the supply.</li>
      <li>The recipient's GSTIN (to enable Input Tax Credit auto-population in GSTR-2B).</li>
    </ul>

    <h2>Frequently Asked Questions</h2>
    <FAQ items={faqs} />

    <div class="mt-8 rounded-xl border border-hairline bg-canvas-soft p-6 shadow-xs text-center">
      <h3 class="text-lg font-bold text-ink mb-2">Need a different GST tool?</h3>
      <p class="text-sm text-body mb-4">Browse our complete list of calculators, find active GST rate slabs, or create professional invoices in seconds.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/gst-calculator" class="px-4 py-2 rounded-xl bg-primary text-on-primary text-xs font-semibold hover:opacity-90 transition-all">GST Calculator</a>
        <a href="/gst-inclusive-calculator" class="px-4 py-2 rounded-xl border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all">GST Inclusive Calculator</a>
        <a href="/reverse-gst-calculator" class="px-4 py-2 rounded-xl border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all">Reverse GST Calculator</a>
        <a href="/invoice-builder" class="px-4 py-2 rounded-xl border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all">GST Invoice Builder</a>
      </div>
    </div>
  </div>
</CalculatorLayout>

<script>
  // Calculator logical implementation
  const amountInput = document.getElementById('calc-amount') as HTMLInputElement | null;
  const customRateInput = document.getElementById('calc-rate-custom') as HTMLInputElement | null;
  const customRateContainer = document.getElementById('custom-rate-container');
  const gstForm = document.getElementById('gst-form') as HTMLFormElement | null;

  // DOM Outputs
  const resTaxable = document.getElementById('res-taxable-val');
  const resCgstRow = document.getElementById('res-cgst-row');
  const resCgstVal = document.getElementById('res-cgst-val');
  const resSgstRow = document.getElementById('res-sgst-row');
  const resSgstVal = document.getElementById('res-sgst-val');
  const resIgstRow = document.getElementById('res-igst-row');
  const resIgstVal = document.getElementById('res-igst-val');
  const resTotalTax = document.getElementById('res-total-tax');
  const resGrandTotal = document.getElementById('res-grand-total');

  function validateInput(input: HTMLInputElement, message: string, check: () => boolean): boolean {
    const isValid = check();
    let errSpan = document.getElementById(`${input.id}-error`);
    if (!isValid) {
      input.classList.add('input-error');
      if (!errSpan) {
        errSpan = document.createElement('span');
        errSpan.id = `${input.id}-error`;
        errSpan.className = 'error-message';
        errSpan.innerText = message;
        input.parentElement?.parentElement?.appendChild(errSpan);
      }
    } else {
      input.classList.remove('input-error');
      errSpan?.remove();
    }
    return isValid;
  }

  function getSelectedRate(): number {
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    if (!rateRadio) return 18;
    if (rateRadio.value === 'custom') {
      return parseFloat(customRateInput?.value || '0') || 0;
    }
    return parseFloat(rateRadio.value) || 0;
  }

  function calculate() {
    if (!amountInput) return;

    // Validate main amount
    const isAmountValid = validateInput(
      amountInput,
      "Please enter a valid amount greater than 0",
      () => parseFloat(amountInput.value) > 0
    );

    // Validate custom rate if selected
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    let isRateValid = true;
    if (rateRadio?.value === 'custom' && customRateInput) {
      isRateValid = validateInput(
        customRateInput,
        "Please enter a rate between 0.1% and 100%",
        () => {
          const val = parseFloat(customRateInput.value);
          return val >= 0.1 && val <= 100;
        }
      );
    }

    if (!isAmountValid || !isRateValid) {
      if (resTaxable) resTaxable.innerText = "₹0.00";
      if (resTotalTax) resTotalTax.innerText = "₹0.00";
      if (resGrandTotal) resGrandTotal.innerText = "₹0.00";
      if (resCgstVal) resCgstVal.innerText = "₹0.00";
      if (resSgstVal) resSgstVal.innerText = "₹0.00";
      if (resIgstVal) resIgstVal.innerText = "₹0.00";
      return;
    }

    const amount = parseFloat(amountInput.value) || 0;
    const rate = getSelectedRate();
    const typeRadio = document.querySelector('input[name="calc-type"]:checked') as HTMLInputElement | null;
    const isAdd = typeRadio ? typeRadio.value === 'add' : true;
    
    const taxTypeRadio = document.querySelector('input[name="tax-type"]:checked') as HTMLInputElement | null;
    const isIntrastate = taxTypeRadio ? taxTypeRadio.value === 'intrastate' : true;

    let taxableValue = 0;
    let totalTax = 0;
    let grandTotal = 0;

    if (isAdd) {
      taxableValue = amount;
      totalTax = amount * (rate / 100);
      grandTotal = amount + totalTax;
    } else {
      taxableValue = amount / (1 + (rate / 100));
      totalTax = amount - taxableValue;
      grandTotal = amount;
    }

    const fmt = (val: number) => '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (resTaxable) resTaxable.innerText = fmt(taxableValue);
    if (resTotalTax) resTotalTax.innerText = fmt(totalTax);
    if (resGrandTotal) resGrandTotal.innerText = fmt(grandTotal);

    if (isIntrastate) {
      resCgstRow?.classList.remove('hidden');
      resSgstRow?.classList.remove('hidden');
      resIgstRow?.classList.add('hidden');
      const splitTax = totalTax / 2;
      if (resCgstVal) resCgstVal.innerText = fmt(splitTax);
      if (resSgstVal) resSgstVal.innerText = fmt(splitTax);
    } else {
      resCgstRow?.classList.add('hidden');
      resSgstRow?.classList.add('hidden');
      resIgstRow?.classList.remove('hidden');
      if (resIgstVal) resIgstVal.innerText = fmt(totalTax);
    }
  }

  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const amount = params.get('amount');
    const rate = params.get('rate');
    const type = params.get('type');
    const taxtype = params.get('taxtype');

    if (amount && amountInput) amountInput.value = amount;

    if (type) {
      const typeRadio = document.querySelector(`input[name="calc-type"][value="${type}"]`) as HTMLInputElement | null;
      if (typeRadio) typeRadio.checked = true;
    }

    if (taxtype) {
      const taxRadio = document.querySelector(`input[name="tax-type"][value="${taxtype}"]`) as HTMLInputElement | null;
      if (taxRadio) taxRadio.checked = true;
    }

    if (rate) {
      const standardRates = ['5', '12', '18', '28'];
      if (standardRates.includes(rate)) {
        const rateRadio = document.querySelector(`input[name="calc-rate"][value="${rate}"]`) as HTMLInputElement | null;
        if (rateRadio) rateRadio.checked = true;
      } else {
        const customRadio = document.getElementById('rate-custom-radio') as HTMLInputElement | null;
        if (customRadio) {
          customRadio.checked = true;
          customRateContainer?.classList.remove('hidden');
          if (customRateInput) customRateInput.value = rate;
        }
      }
    }
  }

  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  const rateRadios = document.querySelectorAll('input[name="calc-rate"]');
  rateRadios.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value === 'custom') {
        customRateContainer?.classList.remove('hidden');
        customRateInput?.focus();
      } else {
        customRateContainer?.classList.add('hidden');
        if (customRateInput) {
          customRateInput.classList.remove('input-error');
          document.getElementById('calc-rate-custom-error')?.remove();
        }
      }
      calculate();
    });
  });

  // Quick Amount Chips
  const chipValues: Record<string, number> = {
    '100': 100, '500': 500, '1K': 1000, '5K': 5000,
    '10K': 10000, '25K': 25000, '50K': 50000, '1L': 100000
  };
  document.querySelectorAll<HTMLButtonElement>('#page-quick-chips .quick-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const val = chipValues[chip.dataset.chip || ''] || 0;
      if (amountInput) amountInput.value = String(val);
      document.querySelectorAll('#page-quick-chips .quick-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      calculate();
    });
  });

  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  loadFromUrl();
  calculate();
</script>
