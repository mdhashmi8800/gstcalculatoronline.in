---
import CalculatorLayout from '../components/CalculatorLayout.astro';
import ResultCard from '../components/ResultCard.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = "12% GST Calculator Online – Free & Instant (2026)";
const pageDesc = "Free online 12% GST calculator. Add or remove 12% tax from any amount. Calculate CGST (6%) and SGST (6%) splits instantly and accurately.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": "12% GST Calculator Online – Free & Instant (2026)",
  "url": "https://gstcalculatoronline.in/12-percent-gst-calculator",
  "description": "Free online 12% GST calculator. Add or remove 12% tax from any amount. Calculate CGST (6%) and SGST (6%) splits instantly and accurately.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  }
};

const faqs = [
  {
    question: "How do I calculate 12% GST on an amount?",
    answer: "To add 12% GST: Multiply the base amount by 0.12. For example, 12% GST on ₹10,000 is ₹1,200, making the total price ₹11,200."
  },
  {
    question: "How do I remove 12% GST from a total price?",
    answer: "To remove 12% GST: Divide the inclusive total price by 1.12. This gives the pre-tax base price. For example, ₹5,600 ÷ 1.12 = ₹5,000 base amount, and ₹600 tax."
  },
  {
    question: "What is the CGST and SGST split for 12% GST?",
    answer: "For local intrastate transactions, 12% GST is divided equally into 6% CGST (Central Government share) and 6% SGST (State Government share)."
  },
  {
    question: "When does the full 12% go to IGST?",
    answer: "If the sale is interstate (between different states), the entire 12% is charged as Integrated GST (IGST) without splitting."
  },
  {
    question: "What goods are in the 12% GST slab?",
    answer: "Common goods include ghee, butter, processed cheese, almonds, fruit juices, umbrellas, sewing machines, and various stationery items."
  },
  {
    question: "What services fall under 12% GST?",
    answer: "Services like work contracts, temporary accommodation (hotels under ₹1,000/night in some contexts), and business class flights attract 12% GST."
  },
  {
    question: "How is 12% GST calculated in Excel?",
    answer: "If cell A1 has the base price, the formula for total is `=A1 * 1.12`. To extract the 12% GST from cell A1, use `=A1 - (A1 / 1.12)`."
  },
  {
    question: "Is butter taxed at 12% GST?",
    answer: "Yes, dairy items like butter, ghee, and cheese attract 12% GST in India."
  },
  {
    question: "Can I calculate other rates on this page?",
    answer: "Yes. While pre-set to 12%, you can select 5%, 18%, 28%, or Custom rate from the form selector."
  },
  {
    question: "Is this calculator free to use?",
    answer: "Yes, it is 100% free with no registration or usage limit."
  },
  {
    question: "How is 12% GST calculated on ₹15,000?",
    answer: "GST Amount = ₹15,000 × 12% = ₹1,800. The grand total is ₹16,800."
  },
  {
    question: "How is 12% GST removed from ₹1,120?",
    answer: "Base value = 1,120 ÷ 1.12 = ₹1,000. The 12% tax portion is ₹120."
  },
  {
    question: "Are mobile phones taxed at 12%?",
    answer: "No. Mobile phones were previously taxed at 12% but were revised to the 18% slab to correct inverted duty structures."
  },
  {
    question: "What is the split of 12% GST on ₹5,000?",
    answer: "Total GST is ₹600. Split as CGST (6%) = ₹300 and SGST (6%) = ₹300."
  },
  {
    question: "Are calculations private?",
    answer: "Yes. The calculator runs locally in your browser and does not save your entries."
  },
  {
    question: "Does the calculator support decimal numbers?",
    answer: "Yes, you can enter fractional figures. Results are displayed to two decimal places."
  },
  {
    question: "How do I download the calculation summary?",
    answer: "Click on the 'PDF' button on the results card to save a copy to your device."
  },
  {
    question: "Does the tool support mobile browsers?",
    answer: "Yes, the layout is mobile-responsive and works perfectly on all web browsers."
  },
  {
    question: "How do I reset the calculator inputs?",
    answer: "Click the 'Reset' button at the bottom of the results card or press the 'ESC' key."
  },
  {
    question: "Can I use the tool for invoice preparation?",
    answer: "Yes. It provides the exact CGST, SGST, and IGST figures to use in tax invoices."
  }
];
---
<CalculatorLayout title={pageTitle} description={pageDesc} schema={pageSchema} faqs={faqs}>
  <form id="gst-form" class="space-y-4 md:space-y-6" autocomplete="off">
    <!-- Transaction Amount -->
    <div>
      <label for="calc-amount" class="block text-sm font-bold text-ink">Transaction Amount (₹)</label>
      <div class="relative mt-2">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-mute">
          <span class="text-sm font-bold font-mono">₹</span>
        </div>
        <input 
          type="number" 
          name="amount" 
          id="calc-amount" 
          value="10000" 
          min="1" 
          step="any"
          class="block w-full rounded-xl border border-hairline bg-canvas py-3.5 pl-9 pr-4 text-base text-ink outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 font-mono font-semibold transition-all"
          placeholder="e.g. 10000"
          required
          aria-label="Transaction Amount in Rupees"
        />
      </div>
      <!-- Quick Amount Chips -->
      <div class="mt-3 flex flex-wrap gap-1.5" id="page-quick-chips" role="group" aria-label="Quick amount presets">
        {(['100', '500', '1K', '5K', '10K', '25K', '50K', '1L'] as const).map(chip => (
          <button type="button" class="quick-chip" data-chip={chip}>₹{chip}</button>
        ))}
      </div>
    </div>

    <!-- Calculation Direction -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">GST Direction</span>
      <div class="segmented-control" role="group" aria-label="GST calculation direction">
        <label class="segmented-btn btn-add-gst cursor-pointer">
          <input type="radio" name="calc-type" value="add" checked class="sr-only" />
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          Add GST
        </label>
        <label class="segmented-btn btn-remove-gst cursor-pointer">
          <input type="radio" name="calc-type" value="remove" class="sr-only" />
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/></svg>
          Remove GST
        </label>
      </div>
    </div>

    <!-- GST Tax Slab Rates -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">GST Rate</span>
      <div class="rate-pill-container sm:grid sm:grid-cols-6 gap-2" role="group" aria-label="GST rate selection">
        {(['3', '5', '12', '18', '28'] as const).map((rate) => (
          <label class="rate-pill cursor-pointer [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-primary [&:has(input:checked)]:text-on-primary">
            <input type="radio" name="calc-rate" value={rate} checked={rate === '12'} class="sr-only" />
            {rate}%
          </label>
        ))}
        <label class="rate-pill cursor-pointer [&:has(input:checked)]:border-primary [&:has(input:checked)]:bg-primary [&:has(input:checked)]:text-on-primary">
          <input type="radio" name="calc-rate" id="rate-custom-radio" value="custom" class="sr-only" />
          Custom
        </label>
      </div>
      
      <!-- Custom Rate Input (Hidden by default) -->
      <div id="custom-rate-container" class="hidden mt-3">
        <label for="calc-rate-custom" class="sr-only">Custom GST Rate (%)</label>
        <div class="relative">
          <input 
            type="number" 
            name="custom-rate" 
            id="calc-rate-custom" 
            min="0.1" 
            max="100" 
            step="any"
            value="18"
            class="block w-full rounded-xl border border-hairline bg-canvas py-2.5 px-3 pr-8 text-sm text-ink outline-none focus:border-primary font-mono"
            placeholder="Enter custom rate e.g. 3"
          />
          <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-mute text-xs font-mono">%</span>
        </div>
      </div>
    </div>

    <!-- Supply Destination -->
    <div>
      <span class="block text-sm font-bold text-ink mb-2">Transaction Type</span>
      <div class="segmented-control" role="group" aria-label="Transaction type">
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="tax-type" value="intrastate" checked class="sr-only" />
          <span>Intra-State <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(CGST+SGST)</span></span>
        </label>
        <label class="segmented-btn cursor-pointer">
          <input type="radio" name="tax-type" value="interstate" class="sr-only" />
          <span>Inter-State <span class="text-[10px] text-mute font-mono ml-0.5 font-normal">(IGST)</span></span>
        </label>
      </div>
    </div>

    <!-- Keyboard Shortcuts Hint -->
    <div class="flex items-center gap-3 text-[10px] text-mute font-mono pt-1">
      <span class="kbd">ESC</span><span>Reset</span>
      <span class="kbd ml-2">Tab</span><span>Navigate fields</span>
    </div>
  </form>

  <ResultCard slot="results" />

  <div slot="content" class="prose max-w-none">
    <h2>12% GST Calculator — Comprehensive Guide to India's Standard Slab</h2>
    <p>The <strong>12% GST slab</strong> in India serves as one of the primary standard tax brackets under the Goods and Services Tax (GST) regime. Designed to balance revenue generation with essential industrial growth, the 12% slab applies to processed food items, dairy derivatives, agricultural machinery, printing equipment, medical devices, and specific works contracts.</p>
    <p>Using this <strong>12% GST Calculator</strong>, manufacturers, traders, CAs, and consumers can compute exact 6% CGST + 6% SGST splits for local intrastate transactions or full 12% IGST for interstate supplies across both exclusive (add tax) and inclusive (extract tax) modes.</p>

    <h2>Mathematical Formula for 12% GST Calculations</h2>
    <p>Calculating 12% GST requires distinct mathematical formulas depending on whether tax is added to an exclusive price or extracted from an inclusive total.</p>
    
    <div class="my-6 rounded-xl border border-hairline bg-canvas-soft-2 p-5 font-mono text-sm text-ink leading-relaxed space-y-4">
      <div>
        <p class="font-semibold text-primary">1. Adding 12% GST to Exclusive Base Price:</p>
        <p>GST Tax Amount = Base Price × (12 / 100) = Base Price × 0.12</p>
        <p>Gross Invoice Amount = Base Price + GST Tax Amount = Base Price × 1.12</p>
        <p>Intrastate Breakdown: CGST (6%) = GST Tax Amount ÷ 2 | SGST (6%) = GST Tax Amount ÷ 2</p>
        <p>Interstate Breakdown: IGST (12%) = Full GST Tax Amount</p>
      </div>
      <div class="border-t border-hairline/50 pt-4">
        <p class="font-semibold text-primary">2. Extracting 12% GST from Inclusive Total Price:</p>
        <p>Pre-Tax Base Value = Inclusive Total ÷ (1 + 0.12) = Inclusive Total ÷ 1.12</p>
        <p>GST Tax Component = Inclusive Total − Pre-Tax Base Value</p>
        <p>CGST (6%) = SGST (6%) = GST Tax Component ÷ 2</p>
      </div>
    </div>

    <h2>Step-by-Step Calculation Scenarios</h2>
    
    <h3>Example 1: Intrastate Billing of Processed Dairy Products (Exclusive Base Price)</h3>
    <p>A dairy processing plant in Maharashtra supplies 1,000 kg of ghee and processed cheese to a retail chain in Pune for <strong>₹4,00,000</strong> (exclusive of GST).</p>
    <ul>
      <li><strong>Base Taxable Value:</strong> ₹4,00,000</li>
      <li><strong>Total GST (12%):</strong> ₹4,00,000 × 12% = ₹48,000</li>
      <li><strong>CGST Split (6%):</strong> ₹48,000 ÷ 2 = ₹24,000</li>
      <li><strong>SGST Split (6%):</strong> ₹48,000 ÷ 2 = ₹24,000</li>
      <li><strong>Grand Total Invoice Value:</strong> ₹4,00,000 + ₹48,000 = <strong>₹4,48,000</strong></li>
    </ul>

    <h3>Example 2: Interstate Purchase of Printing Machinery (Inclusive Total)</h3>
    <p>A publishing firm in Bengaluru orders offset printing machinery from a manufacturer in Chennai for a total inclusive invoice price of <strong>₹5,60,000</strong>.</p>
    <ul>
      <li><strong>Gross Inclusive Invoice Total:</strong> ₹5,60,000</li>
      <li><strong>Pre-Tax Base Value:</strong> ₹5,60,000 ÷ 1.12 = <strong>₹5,00,000</strong></li>
      <li><strong>Integrated GST (IGST 12%):</strong> ₹5,60,000 − ₹5,00,000 = <strong>₹60,000</strong></li>
      <li><strong>CGST / SGST Split:</strong> ₹0 (Not applicable for interstate transactions)</li>
    </ul>

    <h2>Key Goods & Services Classified Under 12% GST</h2>
    <p>The 12% GST slab governs specific categories under HSN chapters 04, 20, 48, 84, and 99:</p>
    
    <div class="overflow-x-auto my-6">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="border-b border-hairline bg-canvas-soft">
            <th class="p-3 font-semibold text-ink">Category</th>
            <th class="p-3 font-semibold text-ink">Description of Goods / Services</th>
            <th class="p-3 font-semibold text-ink">HSN / SAC Code</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <tr>
            <td class="p-3 font-medium text-ink">Processed Dairy & Food</td>
            <td class="p-3 text-body">Ghee, butter, cheese, frozen meat products, fruit juices, sausage, preserved vegetables</td>
            <td class="p-3 font-mono text-xs">HSN 0405, 2009</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-ink">Industrial & Printing</td>
            <td class="p-3 text-body">Printing ink, exercise books, drawing books, paper products, offset printing presses</td>
            <td class="p-3 font-mono text-xs">HSN 3215, 4820, 8443</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-ink">Medical Devices</td>
            <td class="p-3 text-body">Diagnostic test kits, blood glucose monitors, corrective spectacles, surgical tools</td>
            <td class="p-3 font-mono text-xs">HSN 9018, 9021</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-ink">Works Contracts</td>
            <td class="p-3 text-body">Specified construction works contracts for government infrastructure projects</td>
            <td class="p-3 font-mono text-xs">SAC 9954</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>Common Compliance Errors in 12% GST Filings</h2>
    <ul>
      <li><strong>Misinterpreting Dairy & Fat Rates:</strong> While fresh unflavored milk is exempt (0%) and packaged curd/paneer is 5%, clarified butter (ghee) and butter strictly attract 12% GST.</li>
      <li><strong>Subcontractor Works Contract Rates:</strong> Construction works contracts for private residential buildings attract 18% GST, whereas specific government works contracts qualify for the 12% concessional rate. Applying 12% on private construction leads to demand notices under Section 73/74.</li>
      <li><strong>Input Tax Credit Matching (GSTR-2B):</strong> Buyers claiming 12% ITC must verify that their suppliers have correctly filed GSTR-1, as mismatched credit claims attract Section 50 interest penalties (calculated using our <a href="/interest-calculator" class="text-primary hover:underline">GST Interest Calculator</a>).</li>
    </ul>

    <h2>Frequently Asked Questions</h2>
    <FAQ items={faqs} />

    <div class="mt-8 rounded-xl border border-hairline bg-canvas-soft p-6 shadow-xs text-center">
      <h3 class="text-lg font-bold text-ink mb-2">Need a different GST tool?</h3>
      <p class="text-sm text-body mb-4">Browse our complete list of calculators, find active GST rate slabs, or create professional invoices in seconds.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/" class="px-5 py-2.5 rounded-xl bg-primary text-on-primary text-sm font-semibold hover:opacity-90 transition-all">All Calculators</a>
        <a href="/gst-rates" class="px-5 py-2.5 rounded-xl border border-hairline bg-canvas text-ink text-sm font-semibold hover:bg-canvas-soft-2 transition-all">View GST Rates</a>
      </div>
    </div>
  </div>
</CalculatorLayout>

<script>
  // Calculator logical implementation
  const amountInput = document.getElementById('calc-amount') as HTMLInputElement | null;
  const customRateInput = document.getElementById('calc-rate-custom') as HTMLInputElement | null;
  const customRateContainer = document.getElementById('custom-rate-container');
  const gstForm = document.getElementById('gst-form') as HTMLFormElement | null;

  // DOM Outputs
  const resTaxable = document.getElementById('res-taxable-val');
  const resCgstRow = document.getElementById('res-cgst-row');
  const resCgstVal = document.getElementById('res-cgst-val');
  const resSgstRow = document.getElementById('res-sgst-row');
  const resSgstVal = document.getElementById('res-sgst-val');
  const resIgstRow = document.getElementById('res-igst-row');
  const resIgstVal = document.getElementById('res-igst-val');
  const resTotalTax = document.getElementById('res-total-tax');
  const resGrandTotal = document.getElementById('res-grand-total');

  function validateInput(input: HTMLInputElement, message: string, check: () => boolean): boolean {
    const isValid = check();
    let errSpan = document.getElementById(`${input.id}-error`);
    if (!isValid) {
      input.classList.add('input-error');
      if (!errSpan) {
        errSpan = document.createElement('span');
        errSpan.id = `${input.id}-error`;
        errSpan.className = 'error-message';
        errSpan.innerText = message;
        input.parentElement?.parentElement?.appendChild(errSpan);
      }
    } else {
      input.classList.remove('input-error');
      errSpan?.remove();
    }
    return isValid;
  }

  function getSelectedRate(): number {
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    if (!rateRadio) return 18;
    if (rateRadio.value === 'custom') {
      return parseFloat(customRateInput?.value || '0') || 0;
    }
    return parseFloat(rateRadio.value) || 0;
  }

  function calculate() {
    if (!amountInput) return;

    // Validate main amount
    const isAmountValid = validateInput(
      amountInput,
      "Please enter a valid amount greater than 0",
      () => parseFloat(amountInput.value) > 0
    );

    // Validate custom rate if selected
    const rateRadio = document.querySelector('input[name="calc-rate"]:checked') as HTMLInputElement | null;
    let isRateValid = true;
    if (rateRadio?.value === 'custom' && customRateInput) {
      isRateValid = validateInput(
        customRateInput,
        "Please enter a rate between 0.1% and 100%",
        () => {
          const val = parseFloat(customRateInput.value);
          return val >= 0.1 && val <= 100;
        }
      );
    }

    if (!isAmountValid || !isRateValid) {
      if (resTaxable) resTaxable.innerText = "₹0.00";
      if (resTotalTax) resTotalTax.innerText = "₹0.00";
      if (resGrandTotal) resGrandTotal.innerText = "₹0.00";
      if (resCgstVal) resCgstVal.innerText = "₹0.00";
      if (resSgstVal) resSgstVal.innerText = "₹0.00";
      if (resIgstVal) resIgstVal.innerText = "₹0.00";
      return;
    }

    const amount = parseFloat(amountInput.value) || 0;
    const rate = getSelectedRate();
    const typeRadio = document.querySelector('input[name="calc-type"]:checked') as HTMLInputElement | null;
    const isAdd = typeRadio ? typeRadio.value === 'add' : true;
    
    const taxTypeRadio = document.querySelector('input[name="tax-type"]:checked') as HTMLInputElement | null;
    const isIntrastate = taxTypeRadio ? taxTypeRadio.value === 'intrastate' : true;

    let taxableValue = 0;
    let totalTax = 0;
    let grandTotal = 0;

    if (isAdd) {
      taxableValue = amount;
      totalTax = amount * (rate / 100);
      grandTotal = amount + totalTax;
    } else {
      taxableValue = amount / (1 + (rate / 100));
      totalTax = amount - taxableValue;
      grandTotal = amount;
    }

    const fmt = (val: number) => '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (resTaxable) resTaxable.innerText = fmt(taxableValue);
    if (resTotalTax) resTotalTax.innerText = fmt(totalTax);
    if (resGrandTotal) resGrandTotal.innerText = fmt(grandTotal);

    if (isIntrastate) {
      resCgstRow?.classList.remove('hidden');
      resSgstRow?.classList.remove('hidden');
      resIgstRow?.classList.add('hidden');
      const splitTax = totalTax / 2;
      if (resCgstVal) resCgstVal.innerText = fmt(splitTax);
      if (resSgstVal) resSgstVal.innerText = fmt(splitTax);
    } else {
      resCgstRow?.classList.add('hidden');
      resSgstRow?.classList.add('hidden');
      resIgstRow?.classList.remove('hidden');
      if (resIgstVal) resIgstVal.innerText = fmt(totalTax);
    }
  }

  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const amount = params.get('amount');
    const rate = params.get('rate');
    const type = params.get('type');
    const taxtype = params.get('taxtype');

    if (amount && amountInput) amountInput.value = amount;

    if (type) {
      const typeRadio = document.querySelector(`input[name="calc-type"][value="${type}"]`) as HTMLInputElement | null;
      if (typeRadio) typeRadio.checked = true;
    }

    if (taxtype) {
      const taxRadio = document.querySelector(`input[name="tax-type"][value="${taxtype}"]`) as HTMLInputElement | null;
      if (taxRadio) taxRadio.checked = true;
    }

    if (rate) {
      const standardRates = ['5', '12', '18', '28'];
      if (standardRates.includes(rate)) {
        const rateRadio = document.querySelector(`input[name="calc-rate"][value="${rate}"]`) as HTMLInputElement | null;
        if (rateRadio) rateRadio.checked = true;
      } else {
        const customRadio = document.getElementById('rate-custom-radio') as HTMLInputElement | null;
        if (customRadio) {
          customRadio.checked = true;
          customRateContainer?.classList.remove('hidden');
          if (customRateInput) customRateInput.value = rate;
        }
      }
    }
  }

  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  const rateRadios = document.querySelectorAll('input[name="calc-rate"]');
  rateRadios.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value === 'custom') {
        customRateContainer?.classList.remove('hidden');
        customRateInput?.focus();
      } else {
        customRateContainer?.classList.add('hidden');
        if (customRateInput) {
          customRateInput.classList.remove('input-error');
          document.getElementById('calc-rate-custom-error')?.remove();
        }
      }
      calculate();
    });
  });

  // Quick Amount Chips
  const chipValues: Record<string, number> = {
    '100': 100, '500': 500, '1K': 1000, '5K': 5000,
    '10K': 10000, '25K': 25000, '50K': 50000, '1L': 100000
  };
  document.querySelectorAll<HTMLButtonElement>('#page-quick-chips .quick-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const val = chipValues[chip.dataset.chip || ''] || 0;
      if (amountInput) amountInput.value = String(val);
      document.querySelectorAll('#page-quick-chips .quick-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      calculate();
    });
  });

  if (gstForm) {
    gstForm.addEventListener('input', calculate);
    gstForm.addEventListener('change', calculate);
  }

  loadFromUrl();
  calculate();
</script>
