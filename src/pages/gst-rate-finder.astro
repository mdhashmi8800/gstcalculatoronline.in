---
import CalculatorLayout from '../components/CalculatorLayout.astro';

const pageTitle = "GST Rate Finder – Search GST Rates & HSN/SAC Codes";
const pageDesc = "Find GST rates for any product or service instantly. Search by name, HSN code, or category. Filter by 0%, 5%, 12%, 18%, 28% slabs. Free GST rate directory.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": "GST Rate Finder – Search GST Rates & HSN/SAC Codes",
  "url": "https://gstcalculatoronline.in/gst-rate-finder",
  "description": "Search GST rates for 100+ goods and services. Filter by category and rate. Free Indian GST rate directory.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
};

const faqs = [
  {
    question: "What are the GST rates in India?",
    answer: "India has four main GST slabs: 5% for essential goods, 12% for standard goods, 18% for most services and electronics, and 28% for luxury items. Gold attracts 3% and some essential items are at 0%."
  },
  {
    question: "How do I find the GST rate for my product?",
    answer: "Use our GST Rate Finder: search by product name or HSN code in the search box, or filter by category (Food, Electronics, Services, etc.) or by rate slab to find the applicable rate."
  },
  {
    question: "What is an HSN code?",
    answer: "HSN (Harmonised System of Nomenclature) is an internationally standardized system of names and numbers to classify traded products. In India, HSN codes are mandatory on GST invoices for goods, while SAC codes are used for services."
  },
  {
    question: "Are GST rates the same across all states?",
    answer: "Yes. GST rates are uniform across all Indian states as they are set by the GST Council. Only the split differs: for intrastate, the rate is split into equal CGST and SGST portions; for interstate, the full rate applies as IGST."
  }
];

// GST Rate Data
const gstRates = [
  // 0% — Essential Goods & Services
  { name: "Fresh Vegetables", category: "Food", hsn: "0701-0714", rate: 0 },
  { name: "Fresh Fruits", category: "Food", hsn: "0801-0814", rate: 0 },
  { name: "Milk and Cream", category: "Food", hsn: "0401", rate: 0 },
  { name: "Eggs (fresh)", category: "Food", hsn: "0407", rate: 0 },
  { name: "Bread (non-packaged)", category: "Food", hsn: "1905", rate: 0 },
  { name: "Salt (table)", category: "Food", hsn: "2501", rate: 0 },
  { name: "Wheat Flour (non-branded)", category: "Food", hsn: "1101", rate: 0 },
  { name: "Rice (non-branded)", category: "Food", hsn: "1006", rate: 0 },
  { name: "Educational Services", category: "Education", hsn: "9992", rate: 0 },
  { name: "Healthcare Services", category: "Healthcare", hsn: "9993", rate: 0 },
  { name: "Books (printed)", category: "Education", hsn: "4901", rate: 0 },
  { name: "Newspapers", category: "Media", hsn: "4902", rate: 0 },
  { name: "Children's Drawing Books", category: "Education", hsn: "4904", rate: 0 },
  // 3% — Gold & Precious
  { name: "Gold (articles)", category: "Jewellery", hsn: "7113", rate: 3 },
  { name: "Silver (articles)", category: "Jewellery", hsn: "7114", rate: 3 },
  { name: "Diamond (cut/polished)", category: "Jewellery", hsn: "7102", rate: 0.25 },
  { name: "Precious Stones", category: "Jewellery", hsn: "7103", rate: 0.25 },
  { name: "Imitation Jewellery", category: "Jewellery", hsn: "7117", rate: 3 },
  // 5% — Essential Goods
  { name: "Packaged Food Items", category: "Food", hsn: "2106", rate: 5 },
  { name: "Coffee (non-branded)", category: "Food", hsn: "0901", rate: 5 },
  { name: "Tea (non-branded)", category: "Food", hsn: "0902", rate: 5 },
  { name: "Coal", category: "Energy", hsn: "2701", rate: 5 },
  { name: "Kerosene (PDS)", category: "Energy", hsn: "2770", rate: 5 },
  { name: "Economy Air Travel", category: "Transport", hsn: "9964", rate: 5 },
  { name: "Railway Transport (non-AC)", category: "Transport", hsn: "9964", rate: 5 },
  { name: "Road Transport Services", category: "Transport", hsn: "9966", rate: 5 },
  { name: "Life Insurance Premium", category: "Insurance", hsn: "9971", rate: 5 },
  { name: "Fertilisers", category: "Agriculture", hsn: "3102", rate: 5 },
  { name: "Handmade Carpets", category: "Textiles", hsn: "5701", rate: 5 },
  { name: "Tailoring Services", category: "Services", hsn: "9988", rate: 5 },
  // 12% — Standard Goods
  { name: "Computers & Laptops", category: "Electronics", hsn: "8471", rate: 12 },
  { name: "Mobile Phones (≤12K)", category: "Electronics", hsn: "8517", rate: 12 },
  { name: "Processed Cheese", category: "Food", hsn: "0406", rate: 12 },
  { name: "Butter and Ghee", category: "Food", hsn: "0405", rate: 12 },
  { name: "Frozen Meat", category: "Food", hsn: "0204", rate: 12 },
  { name: "Spices (branded)", category: "Food", hsn: "0910", rate: 12 },
  { name: "Hotels (tariff ₹1000-7500)", category: "Hospitality", hsn: "9963", rate: 12 },
  { name: "Business Class Air Travel", category: "Transport", hsn: "9964", rate: 12 },
  { name: "Textile Fabric (man-made)", category: "Textiles", hsn: "5407", rate: 12 },
  { name: "Medicines (under DPCO)", category: "Healthcare", hsn: "3004", rate: 12 },
  { name: "Construction Services (residential)", category: "Real Estate", hsn: "9954", rate: 12 },
  // 18% — Standard Rate
  { name: "Restaurants (AC)", category: "Food & Dining", hsn: "9963", rate: 18 },
  { name: "Banking & Financial Services", category: "Financial Services", hsn: "9971", rate: 18 },
  { name: "IT Services (Software)", category: "IT & Software", hsn: "9983", rate: 18 },
