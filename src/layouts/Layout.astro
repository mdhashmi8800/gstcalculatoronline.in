---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import QuickCalculatorFloat from '../components/QuickCalculatorFloat.astro';
import StickyBottomBar from '../components/StickyBottomBar.astro';
import type { SEOMetadata } from '../utils/seo';

interface Props {
  seo?: SEOMetadata;
  schema?: Record<string, any>;
  schemas?: Record<string, any>[];
}

const { seo, schema, schemas } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts Loader (Optimized for Core Web Vitals) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- SEO Meta & Schema -->
    <SEO seo={seo} schema={schema} schemas={schemas} />

    <!-- Defer heavy third-party scripts (GTM & AdSense) until user interaction or idle to optimize Core Web Vitals (LCP, INP, TTFB) -->
    <script is:inline>
      (function() {
        const scriptsLoaded = new Set();
        const scriptsToLoad = [
          { src: 'https://www.googletagmanager.com/gtag/js?id=G-LC5EXYTHR3', type: 'gtm' },
          { src: 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8763819545697765', type: 'adsense', crossorigin: 'anonymous' }
        ];

        function loadScript(config) {
          if (scriptsLoaded.has(config.src)) return;
          scriptsLoaded.add(config.src);

          const el = document.createElement('script');
          el.src = config.src;
          el.async = true;
          if (config.crossorigin) {
            el.setAttribute('crossorigin', config.crossorigin);
          }
          document.head.appendChild(el);

          if (config.type === 'gtm') {
            el.onload = function() {
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', 'G-LC5EXYTHR3');
            };
          }
        }

        function triggerLoad() {
          scriptsToLoad.forEach(loadScript);
          triggerEvents.forEach(e => window.removeEventListener(e, triggerLoad, { passive: true }));
        }

        const triggerEvents = ['scroll', 'mousedown', 'mousemove', 'touchstart', 'keydown'];
        triggerEvents.forEach(e => window.addEventListener(e, triggerLoad, { passive: true }));

        // Fallback load after 3.5s to ensure tracking is recorded if no interaction occurs
        if (document.readyState === 'complete') {
          setTimeout(triggerLoad, 3500);
        } else {
          window.addEventListener('load', () => setTimeout(triggerLoad, 3500));
        }
      })();
    </script>

    <!-- Theme Inline Script to avoid theme flash -->
    <script is:inline>
      if (
        localStorage.getItem('color-theme') === 'dark' ||
        (!('color-theme' in localStorage) &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-canvas text-ink transition-colors duration-200 overflow-x-clip w-full">
    <Header />
    
    <div class="relative flex flex-1 flex-col">
      <!-- Decorative Mesh Background -->
      <div class="mesh-bg"></div>
      
      <main class="flex-1">
        <slot />
      </main>
    </div>

    <Footer />
    <Search />
    <QuickCalculatorFloat />
    <StickyBottomBar />
  </body>
</html>
