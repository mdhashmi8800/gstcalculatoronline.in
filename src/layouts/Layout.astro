---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import QuickCalculatorFloat from '../components/QuickCalculatorFloat.astro';
import type { SEOMetadata } from '../utils/seo';

interface Props {
  seo?: SEOMetadata;
  schema?: Record<string, any>;
  schemas?: Record<string, any>[];
}

const { seo, schema, schemas } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts Loader (Optimized for Core Web Vitals) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- SEO Meta & Schema -->
    <SEO seo={seo} schema={schema} schemas={schemas} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LC5EXYTHR3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LC5EXYTHR3');
    </script>

    <!-- Theme Inline Script to avoid theme flash -->
    <script is:inline>
      if (
        localStorage.getItem('color-theme') === 'dark' ||
        (!('color-theme' in localStorage) &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-canvas text-ink transition-colors duration-200 overflow-x-clip w-full">
    <Header />
    
    <div class="relative flex flex-1 flex-col">
      <!-- Decorative Mesh Background -->
      <div class="mesh-bg"></div>
      
      <main class="flex-1">
        <slot />
      </main>
    </div>

    <Footer />
    <Search />
    <QuickCalculatorFloat />
  </body>
</html>
