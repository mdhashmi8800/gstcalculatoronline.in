---
interface Props {
  slot?: string;
  format?: 'auto' | 'fluid' | 'rectangle' | 'horizontal';
  responsive?: boolean;
  class?: string;
}

const {
  slot = '',
  format = 'auto',
  responsive = true,
  class: className = '',
} = Astro.props;

const publisherId = 'ca-pub-8763819545697765';
---

<div class={`adsense-container my-6 text-center no-print overflow-hidden min-h-[90px] flex flex-col items-center justify-center rounded-xl bg-canvas-soft/50 border border-dashed border-hairline p-2 ${className}`}>
  <span class="text-[10px] uppercase font-mono tracking-widest text-mute mb-1 select-none">Advertisement</span>
  
  {slot ? (
    <ins
      class="adsbygoogle block w-full"
      data-ad-client={publisherId}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive={responsive ? 'true' : 'false'}
    ></ins>
  ) : (
    <ins
      class="adsbygoogle block w-full"
      data-ad-client={publisherId}
      data-ad-format={format}
      data-full-width-responsive={responsive ? 'true' : 'false'}
    ></ins>
  )}

  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>
