---
interface Props {
  title: string;
  description: string;
  url: string;
  icon: 'calculator' | 'fee' | 'interest' | 'composition' | 'invoice' | 'finder';
  badge?: string;
}

const { title, description, url, icon, badge } = Astro.props;

const badgeClass = badge === 'Popular' 
  ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' 
  : badge === 'Updated'
  ? 'bg-blue-500/10 text-blue-600 dark:text-blue-400'
  : badge === 'Section 50'
  ? 'bg-violet-500/10 text-violet-600 dark:text-violet-400'
  : badge === 'Rule 89'
  ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400'
  : badge === 'New'
  ? 'bg-primary/10 text-primary'
  : 'bg-primary/10 text-primary';

const isUtility = icon === 'invoice' || icon === 'finder';
const ctaText = isUtility ? (icon === 'invoice' ? 'Build Invoice' : 'Find Rate') : 'Open Calculator';
---
<a 
  href={url} 
  class="relative flex flex-col justify-between overflow-hidden rounded-2xl border border-hairline bg-canvas-soft p-5 sm:p-6 shadow-xs hover:-translate-y-1.5 hover:shadow-md hover:border-primary/30 transition-all duration-300 ease-out group active:scale-[0.98] active:duration-100 cursor-pointer"
>
  <div>
    <!-- Icon & Badge Row -->
    <div class="flex items-center justify-between gap-4">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-canvas-soft-2 text-primary border border-hairline/60 group-hover:bg-primary group-hover:text-on-primary group-hover:border-transparent group-hover:shadow-md transition-all duration-300 ease-out">
        {icon === 'calculator' && (
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6">
            <rect width="16" height="20" x="4" y="2" rx="2" stroke-linecap="round" stroke-linejoin="round" />
            <line x1="8" x2="16" y1="6" y2="6" stroke-linecap="round" />
            <line x1="16" x2="16" y1="14" y2="18" stroke-linecap="round" />
            <path d="M16 10h.01" stroke-linecap="round" />
            <path d="M12 10h.01" stroke-linecap="round" />
            <path d="M8 10h.01" stroke-linecap="round" />
            <path d="M12 14h.01" stroke-linecap="round" />
            <path d="M8 14h.01" stroke-linecap="round" />
            <path d="M12 18h.01" stroke-linecap="round" />
            <path d="M8 18h.01" stroke-linecap="round" />
          </svg>
        )}
        {icon === 'fee' && (
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 2v4" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 2v4" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14v4h4" />
            <circle cx="18" cy="18" r="4" />
          </svg>
        )}
        {icon === 'interest' && (
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6">
            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" stroke-linecap="round" stroke-linejoin="round" />
            <polyline points="16 7 22 7 22 13" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        )}
        {icon === 'composition' && (
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2 7 4.41-3.67A2 2 0 0 1 7.73 3h8.54a2 2 0 0 1 1.32.33L22 7" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 12V9" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 12V9" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 12V9" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 20v-4H10v4" />
          </svg>
        )}
        {icon === 'invoice' && (
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V19.5a2.25 2.25 0 0 0 2.25 2.25h.75" />
          </svg>
        )}
        {icon === 'finder' && (
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
          </svg>
        )}
      </div>
      
      {badge && (
        <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-bold tracking-wider uppercase ${badgeClass}`}>
          {badge}
        </span>
      )}
    </div>

    <!-- Title and Description -->
    <h3 class="mt-4 text-base font-bold text-ink group-hover:text-primary transition-colors duration-200">{title}</h3>
    <p class="mt-1.5 text-xs text-mute leading-relaxed line-clamp-2">{description}</p>
  </div>

  <!-- Bottom CTA Row -->
  <div class="mt-5 pt-4 border-t border-hairline/60 flex items-center justify-between text-xs font-bold text-primary group-hover:text-brand-link-deep transition-all duration-300">
    <span class="inline-flex items-center gap-1">
      {ctaText}
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5 transition-transform duration-300 ease-out group-hover:translate-x-1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    </span>
    <span class="text-[9px] font-mono tracking-wider text-mute opacity-0 group-hover:opacity-100 transition-opacity duration-300">
      TRY NOW
    </span>
  </div>
</a>
