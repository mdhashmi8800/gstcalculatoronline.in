---
interface Props {
  title: string;
  description: string;
  url: string;
  icon: 'calculator' | 'fee' | 'interest' | 'composition';
  badge?: string;
}

const { title, description, url, icon, badge } = Astro.props;
---
<a 
  href={url} 
  class="relative flex flex-col justify-between overflow-hidden rounded-xl border border-hairline bg-canvas p-6 shadow-xs hover:border-hairline-strong hover:shadow-md hover:bg-canvas-soft transition-all duration-200 group cursor-pointer"
>
  <div>
    <!-- Icon & Badge row -->
    <div class="flex items-center justify-between">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-canvas-soft-2 text-ink border border-hairline group-hover:bg-primary group-hover:text-on-primary group-hover:border-transparent transition-all duration-200">
        {icon === 'calculator' && (
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75h.008v.008H15.75v-.008Zm0-2.25h.008v.008H15.75v-.008Zm0-2.25h.008v.008H15.75V11.25Zm0-2.25h.008v.008H15.75V9Zm-2.25 6.75h.008v.008h-.008v-.008Zm0-2.25h.008v.008h-.008v-.008Zm0-2.25h.008v.008h-.008V11.25Zm0-2.25h.008v.008h-.008V9m-2.25 6.75h.008v.008h-.008v-.008Zm0-2.25h.008v.008h-.008v-.008Zm0-2.25h.008v.008h-.008V11.25Zm0-2.25h.008v.008h-.008V9M8.25 6.75h12.502c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125H8.25a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125Zm-4.5 3h2.25a.75.75 0 0 0 .75-.75V6.75a.75.75 0 0 0-.75-.75H3.75a.75.75 0 0 0-.75.75v2.25c0 .414.336.75.75.75Zm0 4.5h2.25a.75.75 0 0 0 .75-.75V11.25a.75.75 0 0 0-.75-.75H3.75a.75.75 0 0 0-.75.75v2.25c0 .414.336.75.75.75Zm0 4.5h2.25a.75.75 0 0 0 .75-.75V15.75a.75.75 0 0 0-.75-.75H3.75a.75.75 0 0 0-.75.75v2.25c0 .414.336.75.75.75Z" />
          </svg>
        )}
        {icon === 'fee' && (
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        )}
        {icon === 'interest' && (
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" />
          </svg>
        )}
        {icon === 'composition' && (
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z" />
          </svg>
        )}
      </div>
      
      {badge && (
        <span class="inline-flex items-center rounded-full bg-brand-success/10 px-2.5 py-0.5 text-xs font-semibold text-brand-success">
          {badge}
        </span>
      )}
    </div>

    <!-- Title and Description -->
    <h3 class="mt-4 text-base font-semibold text-ink group-hover:text-link transition-colors duration-200">{title}</h3>
    <p class="mt-2 text-sm text-body leading-relaxed">{description}</p>
  </div>

  <div class="mt-6 flex items-center gap-1 text-xs font-semibold text-link group-hover:text-brand-link-deep transition-colors">
    Open Calculator
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
    </svg>
  </div>
</a>
