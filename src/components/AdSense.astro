---
import { PUBLIC_ADSENSE_CLIENT } from '../utils/seo';

interface Props {
  type: 'below-hero' | 'middle-content' | 'above-faq' | 'sidebar-desktop' | 'before-footer';
  className?: string;
}

const { type, className = '' } = Astro.props;

// Mock slots for each type. Real users replace these keys with their AdSense Slot IDs.
const slotIds: Record<string, string> = {
  'below-hero': '1111111111',
  'middle-content': '2222222222',
  'above-faq': '3333333333',
  'sidebar-desktop': '4444444444',
  'before-footer': '5555555555'
};

const slotId = slotIds[type];

// Check if AdSense is active
const isDev = process.env.NODE_ENV !== 'production';
const hasRealClient = PUBLIC_ADSENSE_CLIENT && PUBLIC_ADSENSE_CLIENT !== 'ca-pub-8419827361928374';
const showRealAd = hasRealClient && !isDev;
---

{showRealAd ? (
  <div class={`adsense-wrapper my-6 clear-both w-full overflow-hidden text-center ${className}`}>
    <span class="block text-[10px] font-mono uppercase tracking-wider text-mute mb-1">Advertisement</span>
    
    {type === 'sidebar-desktop' ? (
      <ins 
        class="adsbygoogle"
        style="display:block; min-width:250px; max-width:300px; height:600px;"
        data-ad-client={PUBLIC_ADSENSE_CLIENT}
        data-ad-slot={slotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
    ) : type === 'below-hero' ? (
      <ins 
        class="adsbygoogle"
        style="display:block; height:90px;"
        data-ad-client={PUBLIC_ADSENSE_CLIENT}
        data-ad-slot={slotId}
        data-ad-format="horizontal"
        data-full-width-responsive="true"
      ></ins>
    ) : (
      <ins 
        class="adsbygoogle"
        style="display:block"
        data-ad-client={PUBLIC_ADSENSE_CLIENT}
        data-ad-slot={slotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
    )}
    
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
) : (
  /* Premium visual placeholder for Core Web Vitals preservation and user visualization */
  <div 
    class={`adsense-placeholder select-none border border-dashed border-hairline-strong bg-canvas-soft-2 rounded-xl text-center flex flex-col justify-center items-center overflow-hidden transition-all duration-200 hover:bg-canvas-soft ${
      type === 'sidebar-desktop' 
        ? 'hidden lg:flex w-full min-h-[400px] h-[600px] max-w-[300px] sticky top-24 p-6' 
        : type === 'below-hero'
        ? 'w-full py-4 px-6 my-6 min-h-[90px]'
        : type === 'middle-content'
        ? 'w-full py-6 px-8 my-8 min-h-[120px]'
        : type === 'above-faq'
        ? 'w-full py-5 px-6 my-6 min-h-[100px]'
        : 'w-full py-8 px-6 my-8 min-h-[140px]'
    } ${className}`}
  >
    <div class="flex items-center gap-1.5 text-mute/50 mb-1">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5 text-mute/60">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.752-.628a8.38 8.38 0 0 1 8.3-1.077M3.75 3.375c0-1.036.84-1.875 1.875-1.875h.375a3.75 3.75 0 0 1 3.75 3.75v1.875m0 0H5.625a1.875 1.875 0 0 1-1.875-1.875v-.375ZM9.75 8.625c0-1.036.84-1.875 1.875-1.875h.375A3.75 3.75 0 0 1 15.75 10.5v1.875m0 0h-3.75a1.875 1.875 0 0 1-1.875-1.875v-.375Z" />
      </svg>
      <span class="font-mono text-[9px] uppercase tracking-widest font-semibold text-mute">AdSense Slot</span>
    </div>
    <span class="text-xs font-semibold text-body">
      {type === 'sidebar-desktop' && 'Sidebar Desktop (Skyscraper)'}
      {type === 'below-hero' && 'Below Hero (Leaderboard)'}
      {type === 'middle-content' && 'Middle of Content (Responsive)'}
      {type === 'above-faq' && 'Above FAQ Banner'}
      {type === 'before-footer' && 'Before Footer Banner'}
    </span>
    <span class="text-[10px] text-mute mt-1.5 max-w-[200px] leading-normal">
      Position reserved safely away from calculator controls.
    </span>
  </div>
)}
