---
const currentYear = new Date().getFullYear();
---
<footer class="border-t border-hairline bg-canvas-soft transition-colors duration-200 select-none">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="xl:grid xl:grid-cols-5 xl:gap-8">
      
      <!-- Brand column -->
      <div class="space-y-4 xl:col-span-1">
        <a href="/" class="flex items-center gap-2 group">
          <img 
            src="/favicon.png" 
            alt="GST Calculator Online Logo" 
            width="32"
            height="32"
            loading="lazy"
            class="h-8 w-8 rounded-lg shadow-sm transition-transform duration-200 group-hover:scale-105"
          />
          <span class="font-sans text-base font-extrabold tracking-tight text-ink">GST Calculator Online</span>
        </a>
        <p class="text-xs text-body max-w-sm leading-relaxed">
          Free GST calculators for Indian businesses, CAs, and taxpayers. Formulated as per the latest CGST/SGST Acts and CBIC notifications.
        </p>
        <p class="text-[10px] text-mute leading-relaxed max-w-sm">
          Disclaimer: Calculations are for illustrative purposes. Verify with a qualified CA before official filings.
        </p>
        <div class="pt-2 flex flex-col gap-1">
          <a href="/editorial-policy" class="text-[10px] text-mute hover:text-primary transition-colors">Editorial Policy</a>
          <a href="/sitemap-page" class="text-[10px] text-mute hover:text-primary transition-colors">HTML Sitemap</a>
        </div>
      </div>

      <!-- Links Columns -->
      <div class="mt-12 grid grid-cols-2 gap-8 xl:col-span-4 xl:mt-0 sm:grid-cols-4">
        <!-- Popular Calculators -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Popular Tools</h3>
          <ul class="mt-4 space-y-2">
            <li><a href="/gst-calculator" class="text-xs text-body hover:text-primary transition-colors">GST Calculator</a></li>
            <li><a href="/reverse-gst-calculator" class="text-xs text-body hover:text-primary transition-colors">Reverse GST</a></li>
            <li><a href="/late-fee-calculator" class="text-xs text-body hover:text-primary transition-colors">Late Fee Calculator</a></li>
            <li><a href="/interest-calculator" class="text-xs text-body hover:text-primary transition-colors">Interest Calculator</a></li>
            <li><a href="/composition-calculator" class="text-xs text-body hover:text-primary transition-colors">Composition Scheme</a></li>
            <li><a href="/invoice-builder" class="text-xs text-body hover:text-primary transition-colors">Invoice Builder</a></li>
            <li><a href="/igst-calculator" class="text-xs text-body hover:text-primary transition-colors">IGST Calculator</a></li>
            <li><a href="/gst-refund-calculator" class="text-xs text-body hover:text-primary transition-colors">Refund Calculator</a></li>
          </ul>
        </div>

        <!-- Calculator Categories -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Categories</h3>
          <ul class="mt-4 space-y-2">
            <li><a href="/category/tax-slabs" class="text-xs text-body hover:text-primary transition-colors">Tax Slabs</a></li>
            <li><a href="/category/late-fees" class="text-xs text-body hover:text-primary transition-colors">Late Fees</a></li>
            <li><a href="/category/interest-penalties" class="text-xs text-body hover:text-primary transition-colors">Interest</a></li>
            <li><a href="/category/composition-scheme" class="text-xs text-body hover:text-primary transition-colors">Composition</a></li>
            <li><a href="/category/utilities" class="text-xs text-body hover:text-primary transition-colors">Utilities</a></li>
            <li><a href="/gst-rate-finder" class="text-xs text-body hover:text-primary transition-colors">Rate Finder</a></li>
            <li><a href="/gst-rates" class="text-xs text-body hover:text-primary transition-colors">GST Rates 2026</a></li>
            <li><a href="/gst-formula" class="text-xs text-body hover:text-primary transition-colors">GST Formula</a></li>
          </ul>
        </div>

        <!-- Resources & Blog -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Resources</h3>
          <ul class="mt-4 space-y-2">
            <li><a href="/" class="text-xs text-body hover:text-primary transition-colors">All Calculators</a></li>
            <li><a href="/blog" class="text-xs text-body hover:text-primary transition-colors">Tax Blog</a></li>
            <li><a href="/guides" class="text-xs text-body hover:text-primary transition-colors font-semibold">Compliance Guides</a></li>
            <li><a href="/blog/category/gst-basics" class="text-xs text-body hover:text-primary transition-colors">GST Basics</a></li>
            <li><a href="/blog/category/gst-compliance" class="text-xs text-body hover:text-primary transition-colors">GST Compliance</a></li>
            <li><a href="/blog/category/input-tax-credit" class="text-xs text-body hover:text-primary transition-colors">Input Tax Credit</a></li>
            <li><a href="/search" rel="nofollow" class="text-xs text-body hover:text-primary transition-colors">Search Hub</a></li>
            <li><a href="/rss.xml" class="text-xs text-body hover:text-primary transition-colors font-mono">RSS Feed</a></li>
          </ul>
        </div>

        <!-- Company & Legal -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Company</h3>
          <ul class="mt-4 space-y-2">
            <li><a href="/about" class="text-xs text-body hover:text-primary transition-colors">About Us</a></li>
            <li><a href="/contact" class="text-xs text-body hover:text-primary transition-colors">Contact</a></li>
            <li><a href="/editorial-policy" class="text-xs text-body hover:text-primary transition-colors">Editorial Policy</a></li>
            <li><a href="/privacy-policy" class="text-xs text-body hover:text-primary transition-colors">Privacy Policy</a></li>
            <li><a href="/terms-and-conditions" class="text-xs text-body hover:text-primary transition-colors">Terms of Service</a></li>
            <li><a href="/disclaimer" class="text-xs text-body hover:text-primary transition-colors">Disclaimer</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom border & copyright -->
    <div class="mt-12 border-t border-hairline pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-[10px] text-mute font-mono">
        &copy; {currentYear} gstcalculatoronline.in. All rights reserved. Not affiliated with GSTN, CBIC, or the Government of India.
      </p>
      <div class="flex items-center gap-4">
        <a href="/rss.xml" class="text-[10px] text-mute hover:text-primary transition-colors font-mono">RSS Feed</a>
        <a href="/sitemap.xml" class="text-[10px] text-mute hover:text-primary transition-colors font-mono">XML Sitemap</a>
        <a href="/sitemap-page" class="text-[10px] text-mute hover:text-primary transition-colors font-mono">HTML Sitemap</a>
        <div class="flex items-center gap-2">
          <span class="inline-block h-2 w-2 rounded-full bg-primary animate-pulse"></span>
          <span class="text-[10px] font-mono text-mute">Designed for Indian Taxpayers</span>
        </div>
      </div>
    </div>
  </div>
</footer>
