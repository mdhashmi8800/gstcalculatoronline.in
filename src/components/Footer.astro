---
const currentYear = new Date().getFullYear();
---
<footer class="border-t border-hairline bg-canvas-soft transition-colors duration-200 select-none">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      
      <!-- Brand column -->
      <div class="space-y-4 xl:col-span-1">
        <a href="/" class="flex items-center gap-2 group">
          <img 
            src="/favicon.png" 
            alt="GST Calculator Online Logo" 
            width="32"
            height="32"
            class="h-8 w-8 rounded-lg shadow-sm transition-transform duration-200 group-hover:scale-105"
          />
          <span class="font-sans text-base font-extrabold tracking-tight text-ink">GST Calculator Online</span>
        </a>
        <p class="text-xs text-body max-w-sm leading-relaxed">
          Providing businesses, CA professionals, and Indian taxpayers with reliable, fast, and precise tax calculators. Formulated according to the latest CGST/SGST acts.
        </p>
        <p class="text-[10px] text-mute leading-relaxed max-w-sm">
          Disclaimer: The calculations on this site are for illustrative purposes. Please verify calculations with a qualified chartered accountant before taking financial decisions.
        </p>
      </div>

      <!-- Links Columns -->
      <div class="mt-12 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0 sm:grid-cols-4">
        <!-- GST Tools -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Calculators</h3>
          <ul class="mt-4 space-y-2">
            <li><a href="/tools/category/tax-slabs" class="text-xs text-body hover:text-primary transition-colors">Tax Slabs</a></li>
            <li><a href="/tools/category/late-fees" class="text-xs text-body hover:text-primary transition-colors">Late Fees</a></li>
            <li><a href="/tools/category/interest-penalties" class="text-xs text-body hover:text-primary transition-colors">Interest</a></li>
            <li><a href="/tools/category/composition-scheme" class="text-xs text-body hover:text-primary transition-colors">Composition</a></li>
          </ul>
        </div>

        <!-- Blog Topics -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Blog Topics</h3>
          <ul class="mt-4 space-y-2">
            <li><a href="/blog/category/gst-basics" class="text-xs text-body hover:text-primary transition-colors">GST Basics</a></li>
            <li><a href="/blog/category/gst-compliance" class="text-xs text-body hover:text-primary transition-colors">Compliance</a></li>
            <li><a href="/blog/category/input-tax-credit" class="text-xs text-body hover:text-primary transition-colors">Input Credit</a></li>
            <li><a href="/blog/category/small-business" class="text-xs text-body hover:text-primary transition-colors">Small Business</a></li>
          </ul>
        </div>
        
        <!-- Resources -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Resources</h3>
          <ul class="mt-4 space-y-2">
            <li><a href="/tools" class="text-xs text-body hover:text-primary transition-colors">All Tools</a></li>
            <li><a href="/blog" class="text-xs text-body hover:text-primary transition-colors">Tax Blog</a></li>
            <li><a href="/search" class="text-xs text-body hover:text-primary transition-colors">Search Hub</a></li>
            <li><a href="/about" class="text-xs text-body hover:text-primary transition-colors">About Us</a></li>
            <li><a href="/contact" class="text-xs text-body hover:text-primary transition-colors">Contact</a></li>
          </ul>
        </div>

        <!-- Legal -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Legal Info</h3>
          <ul class="mt-4 space-y-2">
            <li><a href="/privacy-policy" class="text-xs text-body hover:text-primary transition-colors">Privacy Policy</a></li>
            <li><a href="/terms-and-conditions" class="text-xs text-body hover:text-primary transition-colors">Terms of Service</a></li>
            <li><a href="/disclaimer" class="text-xs text-body hover:text-primary transition-colors">Disclaimer</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom border & copyright -->
    <div class="mt-12 border-t border-hairline pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-[10px] text-mute font-mono">
        &copy; {currentYear} gstcalculatoronline.in. All rights reserved.
      </p>
      <div class="flex items-center gap-2">
        <span class="inline-block h-2 w-2 rounded-full bg-primary animate-pulse"></span>
        <span class="text-[10px] font-mono text-mute">Designed for Indian Taxpayers</span>
      </div>
    </div>
  </div>
</footer>
