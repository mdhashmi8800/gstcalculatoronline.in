---
// Search.astro - Dynamic search overlay component for calculators & articles
import { tools } from '../utils/tools';

// Load blog posts at build-time
const posts = Object.values(import.meta.glob('../content/blog/*.md', { eager: true })) as any[];

const searchItems = [
  ...tools.map(tool => ({
    name: tool.name,
    desc: tool.desc,
    url: tool.url,
    category: 'Calculator',
    keywords: tool.keywords.toLowerCase()
  })),
  ...posts.map(post => ({
    name: post.frontmatter.title,
    desc: post.frontmatter.metaDescription || post.frontmatter.description,
    url: `/blog/${post.frontmatter.slug}`,
    category: 'Guide',
    keywords: `${post.frontmatter.title} ${post.frontmatter.category || ''} ${post.frontmatter.metaDescription || ''}`.toLowerCase()
  }))
];
---
<div id="search-modal" class="fixed inset-0 z-50 hidden items-start justify-center bg-slate-900/40 p-4 pt-[15vh] backdrop-blur-xs dark:bg-black/80 select-none">
  <div class="relative w-full max-w-lg overflow-hidden rounded-2xl border border-hairline bg-canvas shadow-2xl transition-all">
    <!-- Search Bar -->
    <div class="relative flex items-center border-b border-hairline p-4">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="absolute left-6 h-5 w-5 text-mute">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
      </svg>
      <input 
        id="search-input"
        type="text" 
        placeholder="Search for calculators, return guides..." 
        class="w-full bg-transparent pl-10 pr-4 text-sm text-ink outline-hidden placeholder-mute font-medium"
      />
      <button 
        id="search-close-btn"
        type="button" 
        class="rounded-md border border-hairline px-2 py-0.5 font-mono text-[10px] text-mute hover:text-ink hover:bg-canvas-soft transition-all cursor-pointer"
      >
        ESC
      </button>
    </div>

    <!-- Search Results -->
    <div id="search-results-list" class="max-h-[320px] overflow-y-auto p-2 space-y-1">
      {searchItems.map((item) => {
        const isTool = item.category === 'Calculator';
        return (
          <a 
            href={item.url}
            data-keywords={item.keywords}
            class="search-result-item block rounded-xl p-3 hover:bg-canvas-soft-2 transition-colors cursor-pointer group"
          >
            <div class="flex items-center justify-between">
              <span class="text-sm font-semibold text-ink group-hover:text-primary transition-colors line-clamp-1">{item.name}</span>
              <span 
                class="font-mono text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-md"
                class:list={[
                  isTool ? 'bg-primary/10 text-primary' : 'bg-brand-violet/10 text-brand-violet'
                ]}
              >
                {item.category}
              </span>
            </div>
            <p class="text-xs text-mute mt-1 leading-normal line-clamp-1">{item.desc}</p>
          </a>
        );
      })}
      
      <div id="search-no-results" class="hidden py-8 text-center text-sm text-mute">
        No resources match your query. Try searching for 'gst', 'late fee', or 'refund'.
      </div>
    </div>

    <!-- Sticky Footer Link -->
    <div class="border-t border-hairline bg-canvas-soft p-3 text-center text-xs text-mute">
      <span>Looking for advanced filters? </span>
      <a href="/search" id="search-modal-go-page" class="font-semibold text-primary hover:underline ml-1">
        Go to Search Page →
      </a>
    </div>
  </div>
</div>

<script>
  const searchToggleBtn = document.getElementById('search-toggle-btn');
  const searchModal = document.getElementById('search-modal');
  const searchCloseBtn = document.getElementById('search-close-btn');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const resultItems = document.querySelectorAll('.search-result-item');
  const noResults = document.getElementById('search-no-results');
  const modalGoPage = document.getElementById('search-modal-go-page') as HTMLAnchorElement | null;

  function openSearch() {
    searchModal?.classList.remove('hidden');
    searchModal?.classList.add('flex');
    setTimeout(() => searchInput?.focus(), 50);
    document.body.classList.add('overflow-hidden');
  }

  function closeSearch() {
    searchModal?.classList.add('hidden');
    searchModal?.classList.remove('flex');
    if (searchInput) searchInput.value = '';
    filterResults('');
    document.body.classList.remove('overflow-hidden');
  }

  function filterResults(query: string) {
    let matchCount = 0;
    const cleanQuery = query.toLowerCase().trim();

    // Update the Go Page link URL dynamically
    if (modalGoPage) {
      modalGoPage.href = cleanQuery ? `/search?q=${encodeURIComponent(cleanQuery)}` : '/search';
    }

    resultItems.forEach((item) => {
      const htmlItem = item as HTMLElement;
      const text = htmlItem.innerText.toLowerCase();
      const keywords = htmlItem.dataset.keywords?.toLowerCase() || '';
      
      if (cleanQuery === '' || text.includes(cleanQuery) || keywords.includes(cleanQuery)) {
        // Show item
        htmlItem.classList.remove('hidden');
        matchCount++;
      } else {
        htmlItem.classList.add('hidden');
      }
    });

    if (matchCount === 0 && cleanQuery !== '') {
      noResults?.classList.remove('hidden');
    } else {
      noResults?.classList.add('hidden');
    }
  }

  // Toggle button click
  searchToggleBtn?.addEventListener('click', openSearch);

  // Close button click
  searchCloseBtn?.addEventListener('click', closeSearch);

  // Input typing
  searchInput?.addEventListener('input', (e) => {
    filterResults((e.target as HTMLInputElement).value);
  });

  // Handle Enter Key to redirect to search page
  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && searchInput.value.trim() !== '') {
      window.location.href = `/search?q=${encodeURIComponent(searchInput.value.trim())}`;
    }
  });

  // Modal backdrop click
  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) {
      closeSearch();
    }
  });

  // Keyboard listeners
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
      closeSearch();
    }
    // Command/Control + K to open search
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (searchModal?.classList.contains('hidden')) {
        openSearch();
      } else {
        closeSearch();
      }
    }
  });
</script>
