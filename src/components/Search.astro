---
// Search.astro - Premium command palette for calculators, guides, and FAQs
---

<!-- Modal Overlay container -->
<div 
  id="search-modal" 
  class="fixed inset-0 z-50 hidden items-start justify-center bg-slate-900/60 p-4 pt-[10vh] backdrop-blur-xs select-none transition-opacity duration-200 opacity-0"
>
  <!-- Search Modal Dialog -->
  <div 
    id="search-modal-card" 
    class="relative w-full max-w-2xl overflow-hidden rounded-2xl border border-hairline bg-canvas shadow-2xl transition-all duration-200 scale-95"
  >
    <!-- Search Bar Input Header -->
    <div class="relative flex items-center border-b border-hairline p-4">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="absolute left-6 h-5 w-5 text-mute">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
      </svg>
      
      <input 
        id="search-input"
        type="text" 
        placeholder="Search for calculators, return guides, FAQs..." 
        class="w-full bg-transparent pl-10 pr-12 text-base text-ink outline-hidden placeholder-mute font-medium"
        autocomplete="off"
        aria-label="Search for calculators, return guides, and FAQs"
      />
      
      <div class="absolute right-18 flex items-center gap-1 text-[10px] font-bold text-mute border border-hairline bg-canvas-soft-2 px-1.5 py-0.5 rounded-md select-none pointer-events-none">
        <span>ESC</span>
      </div>

      <button 
        id="search-close-btn"
        type="button" 
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-hairline text-mute hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
        aria-label="Close search overlay"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-4 w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex flex-wrap items-center gap-2 border-b border-hairline/50 bg-canvas-soft-2/30 px-4 py-2.5">
      <span class="text-[10px] font-bold text-mute uppercase tracking-wider mr-1">Filter:</span>
      <button type="button" data-filter="all" class="modal-filter-btn rounded-full px-3 py-1 text-[11px] font-bold bg-primary text-on-primary shadow-xs transition-all cursor-pointer">
        All
      </button>
      <button type="button" data-filter="Calculator" class="modal-filter-btn rounded-full px-3 py-1 text-[11px] font-semibold border border-hairline bg-canvas text-body hover:bg-canvas-soft hover:text-ink transition-all cursor-pointer">
        Calculators
      </button>
      <button type="button" data-filter="Guide" class="modal-filter-btn rounded-full px-3 py-1 text-[11px] font-semibold border border-hairline bg-canvas text-body hover:bg-canvas-soft hover:text-ink transition-all cursor-pointer">
        Guides
      </button>
      <button type="button" data-filter="FAQ" class="modal-filter-btn rounded-full px-3 py-1 text-[11px] font-semibold border border-hairline bg-canvas text-body hover:bg-canvas-soft hover:text-ink transition-all cursor-pointer">
        FAQs
      </button>
    </div>

    <!-- Scrollable content list wrapper -->
    <div id="search-content-area" class="max-h-[380px] overflow-y-auto p-3">
      <!-- Default View: Recent and Popular Searches -->
      <div id="search-default-view" class="space-y-4">
        <!-- Recent Searches Section -->
        <div id="recent-searches-section" class="hidden">
          <div class="flex items-center justify-between px-2 mb-2">
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-mute">Recent Searches</span>
            <button id="clear-recent-btn" type="button" class="text-[10px] font-semibold text-primary hover:underline cursor-pointer">
              Clear All
            </button>
          </div>
          <div id="recent-searches-list" class="space-y-1">
            <!-- Recent searches loaded dynamically here -->
          </div>
        </div>

        <!-- Popular Searches Section -->
        <div>
          <span class="block text-[10px] font-extrabold uppercase tracking-wider text-mute px-2 mb-2">Popular Searches</span>
          <div class="grid grid-cols-2 gap-2 px-1 sm:grid-cols-3">
            <button type="button" class="popular-search-tag text-left rounded-xl border border-hairline bg-canvas p-2.5 text-xs text-body hover:border-hairline-strong hover:bg-canvas-soft-2 transition-all cursor-pointer flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5 text-primary shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-3-3V18m-3-3V18M3 21h18M3 3h18v18H3V3ZM5.25 5.25h13.5v3H5.25v-3Zm0 6h13.5v3H5.25v-3Z" />
              </svg>
              <span>GST Calculator</span>
            </button>
            <button type="button" class="popular-search-tag text-left rounded-xl border border-hairline bg-canvas p-2.5 text-xs text-body hover:border-hairline-strong hover:bg-canvas-soft-2 transition-all cursor-pointer flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5 text-primary shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-3-3V18m-3-3V18M3 21h18M3 3h18v18H3V3ZM5.25 5.25h13.5v3H5.25v-3Zm0 6h13.5v3H5.25v-3Z" />
              </svg>
              <span>Reverse GST</span>
            </button>
            <button type="button" class="popular-search-tag text-left rounded-xl border border-hairline bg-canvas p-2.5 text-xs text-body hover:border-hairline-strong hover:bg-canvas-soft-2 transition-all cursor-pointer flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5 text-primary shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" />
              </svg>
              <span>Section 50 Interest</span>
            </button>
            <button type="button" class="popular-search-tag text-left rounded-xl border border-hairline bg-canvas p-2.5 text-xs text-body hover:border-hairline-strong hover:bg-canvas-soft-2 transition-all cursor-pointer flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5 text-primary shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />
              </svg>
              <span>Late Fee GSTR-3B</span>
            </button>
            <button type="button" class="popular-search-tag text-left rounded-xl border border-hairline bg-canvas p-2.5 text-xs text-body hover:border-hairline-strong hover:bg-canvas-soft-2 transition-all cursor-pointer flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5 text-primary shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Composition Scheme</span>
            </button>
            <button type="button" class="popular-search-tag text-left rounded-xl border border-hairline bg-canvas p-2.5 text-xs text-body hover:border-hairline-strong hover:bg-canvas-soft-2 transition-all cursor-pointer flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5 text-primary shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              <span>Input Tax Credit</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Search Results Area -->
      <div id="search-dynamic-results" class="hidden space-y-1">
        <!-- Results mapped dynamically -->
      </div>

      <!-- Empty state when no matches -->
      <div id="search-no-results" class="hidden py-10 text-center text-sm text-mute">
        No resources match your query. Try searching for <span class="font-bold text-ink hover:underline cursor-pointer" onclick="document.getElementById('search-input').value='gst'; document.getElementById('search-input').dispatchEvent(new Event('input'))">'gst'</span>, <span class="font-bold text-ink hover:underline cursor-pointer" onclick="document.getElementById('search-input').value='late fee'; document.getElementById('search-input').dispatchEvent(new Event('input'))">'late fee'</span>, or <span class="font-bold text-ink hover:underline cursor-pointer" onclick="document.getElementById('search-input').value='interest'; document.getElementById('search-input').dispatchEvent(new Event('input'))">'interest'</span>.
      </div>
    </div>

    <!-- Sticky footer help text -->
    <div class="border-t border-hairline bg-canvas-soft-2/20 p-3 text-center text-xs text-mute flex justify-between items-center px-4 font-mono text-[10px]">
      <div class="flex items-center gap-3">
        <span><kbd class="bg-canvas-soft border border-hairline px-1 rounded">↑↓</kbd> Select</span>
        <span><kbd class="bg-canvas-soft border border-hairline px-1 rounded">Enter</kbd> Open</span>
      </div>
      <a href="/search" id="search-modal-go-page" class="font-bold text-primary hover:underline">
        Advanced Search Page →
      </a>
    </div>
  </div>
</div>

<script>
  interface SearchItem {
    title: string;
    desc: string;
    url: string;
    category: 'Calculator' | 'Guide' | 'FAQ';
    keywords: string;
  }

  interface RecentSearch {
    title: string;
    url: string;
    category: string;
  }

  // Load DOM elements
  const searchToggleBtn = document.getElementById('search-toggle-btn');
  const searchModal = document.getElementById('search-modal');
  const searchCard = document.getElementById('search-modal-card');
  const searchCloseBtn = document.getElementById('search-close-btn');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  
  const filterBtns = document.querySelectorAll('.modal-filter-btn');
  const popularTags = document.querySelectorAll('.popular-search-tag');
  
  const defaultView = document.getElementById('search-default-view');
  const dynamicResults = document.getElementById('search-dynamic-results');
  const noResults = document.getElementById('search-no-results');
  const modalGoPage = document.getElementById('search-modal-go-page') as HTMLAnchorElement | null;
  
  const recentSection = document.getElementById('recent-searches-section');
  const recentList = document.getElementById('recent-searches-list');
  const clearRecentBtn = document.getElementById('clear-recent-btn');

  // Load data index asynchronously
  let searchIndex: SearchItem[] = [];
  let isIndexLoaded = false;
  let isIndexFetching = false;

  async function loadSearchIndex() {
    if (isIndexLoaded || isIndexFetching) return;
    isIndexFetching = true;
    try {
      const res = await fetch('/search-index.json');
      const data = await res.json();
      const categoryMap = {
        tool: 'Calculator' as const,
        article: 'Guide' as const,
        faq: 'FAQ' as const
      };
      searchIndex = data.map((item: any) => ({
        title: item.title,
        desc: item.desc,
        url: item.url,
        category: categoryMap[item.type as 'tool' | 'article' | 'faq'] || 'Calculator',
        keywords: item.keywords
      }));
      isIndexLoaded = true;
    } catch (e) {
      console.error('Failed to load search index', e);
    } finally {
      isIndexFetching = false;
    }
  }

  let activeFilter = 'all';
  let queryText = '';
  let selectedIndex = -1;
  let visibleResultUrls: string[] = [];

  function openSearch() {
    if (!searchModal || !searchCard) return;
    searchModal.classList.remove('hidden');
    searchModal.classList.add('flex');
    
    // Animate open
    requestAnimationFrame(() => {
      searchModal.classList.add('opacity-100');
      searchCard.classList.remove('scale-95');
      searchCard.classList.add('scale-100');
    });

    setTimeout(() => searchInput?.focus(), 50);
    document.body.classList.add('overflow-hidden');
    
    renderRecentSearches();

    // Lazy load the index
    loadSearchIndex().then(() => {
      renderResults();
    });
  }

  function closeSearch() {
    if (!searchModal || !searchCard) return;
    
    // Animate close
    searchModal.classList.remove('opacity-100');
    searchCard.classList.remove('scale-100');
    searchCard.classList.add('scale-95');

    setTimeout(() => {
      searchModal.classList.add('hidden');
      searchModal.classList.remove('flex');
      if (searchInput) searchInput.value = '';
      queryText = '';
      selectedIndex = -1;
      resetFilter();
    }, 200);

    document.body.classList.remove('overflow-hidden');
  }

  function resetFilter() {
    activeFilter = 'all';
    filterBtns.forEach((btn, idx) => {
      if (idx === 0) {
        btn.classList.add('bg-primary', 'text-on-primary');
        btn.classList.remove('bg-canvas', 'text-body', 'border-hairline');
      } else {
        btn.classList.remove('bg-primary', 'text-on-primary');
        btn.classList.add('bg-canvas', 'text-body', 'border-hairline');
      }
    });
  }

  function escapeRegExp(string: string) {
    return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function highlightText(text: string, query: string): string {
    if (!query) return text;
    const cleanQuery = query.trim();
    if (!cleanQuery) return text;
    const regex = new RegExp(`(${escapeRegExp(cleanQuery)})`, 'gi');
    return text.replace(regex, '<mark class="bg-primary/20 text-ink rounded-[3px] px-0.5 font-bold">$1</mark>');
  }

  function renderRecentSearches() {
    if (!recentSection || !recentList) return;
    
    const recents: RecentSearch[] = JSON.parse(localStorage.getItem('gst_recent_searches') || '[]');
    
    if (recents.length === 0) {
      recentSection.classList.add('hidden');
      return;
    }

    recentSection.classList.remove('hidden');
    recentList.innerHTML = '';
    
    recents.forEach((item, idx) => {
      const a = document.createElement('a');
      a.href = item.url;
      a.className = "recent-item flex items-center justify-between rounded-xl p-2.5 hover:bg-canvas-soft-2 transition-colors cursor-pointer group";
      a.dataset.url = item.url;
      
      const badgeBg = item.category === 'Calculator' ? 'bg-primary/10 text-primary' : 
                      item.category === 'Guide' ? 'bg-brand-violet/10 text-brand-violet' : 
                      'bg-brand-cyan/10 text-brand-cyan';
      
      a.innerHTML = `
        <div class="flex items-center gap-2.5 min-w-0">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4 text-mute">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-xs font-semibold text-ink group-hover:text-primary transition-colors line-clamp-1">${item.title}</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-mono text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-md shrink-0 ${badgeBg}">
            ${item.category}
          </span>
          <button type="button" class="delete-recent-btn text-mute hover:text-brand-error p-1 rounded-md hover:bg-canvas-soft opacity-0 group-hover:opacity-100 transition-all cursor-pointer" data-index="${idx}" aria-label="Remove search history">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      `;

      // Click listener to save to recent again (bumps it to top) and close
      a.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.delete-recent-btn')) {
          e.preventDefault();
          e.stopPropagation();
          const deleteIdx = parseInt(target.closest('.delete-recent-btn')?.getAttribute('data-index') || '0', 10);
          deleteRecentSearch(deleteIdx);
          return;
        }
        saveToRecent(item.title, item.url, item.category);
      });

      recentList.appendChild(a);
    });
  }

  function saveToRecent(title: string, url: string, category: string) {
    const recents: RecentSearch[] = JSON.parse(localStorage.getItem('gst_recent_searches') || '[]');
    // Filter existing
    const updated = recents.filter(x => x.url !== url);
    updated.unshift({ title, url, category });
    // Slice to 5
    localStorage.setItem('gst_recent_searches', JSON.stringify(updated.slice(0, 5)));
  }

  function deleteRecentSearch(index: number) {
    const recents: RecentSearch[] = JSON.parse(localStorage.getItem('gst_recent_searches') || '[]');
    recents.splice(index, 1);
    localStorage.setItem('gst_recent_searches', JSON.stringify(recents));
    renderRecentSearches();
  }

  function renderResults() {
    if (!dynamicResults || !defaultView || !noResults || !modalGoPage) return;

    const query = queryText.toLowerCase().trim();

    // Update advanced search footer URL
    modalGoPage.href = query ? `/search?q=${encodeURIComponent(query)}` : '/search';

    if (query === '') {
      defaultView.classList.remove('hidden');
      dynamicResults.classList.add('hidden');
      noResults.classList.add('hidden');
      visibleResultUrls = [];
      selectedIndex = -1;
      return;
    }

    defaultView.classList.add('hidden');
    dynamicResults.classList.remove('hidden');

    if (!isIndexLoaded) {
      dynamicResults.innerHTML = '<div class="py-6 text-center text-xs text-mute font-mono animate-pulse">Loading search resources...</div>';
      noResults.classList.add('hidden');
      visibleResultUrls = [];
      selectedIndex = -1;
      return;
    }

    // Filter index
    const matches = searchIndex.filter((item) => {
      // Category pill filter
      if (activeFilter !== 'all' && item.category !== activeFilter) return false;

      // Text query match
      return item.title.toLowerCase().includes(query) || 
             item.desc.toLowerCase().includes(query) || 
             item.keywords.includes(query);
    });

    if (matches.length === 0) {
      dynamicResults.innerHTML = '';
      noResults.classList.remove('hidden');
      visibleResultUrls = [];
      selectedIndex = -1;
      return;
    }

    noResults.classList.add('hidden');
    dynamicResults.innerHTML = '';
    
    visibleResultUrls = matches.map(m => m.url);
    
    // Ensure selectedIndex is in bounds
    if (selectedIndex >= matches.length) {
      selectedIndex = matches.length - 1;
    } else if (selectedIndex < 0 && matches.length > 0) {
      selectedIndex = 0;
    }

    matches.forEach((item, idx) => {
      const isSelected = idx === selectedIndex;
      const card = document.createElement('a');
      card.href = item.url;
      card.className = `search-card-item flex flex-col rounded-xl p-3.5 transition-all cursor-pointer border ${isSelected ? 'bg-canvas-soft-2 border-primary/20' : 'border-transparent hover:bg-canvas-soft-2/50'}`;
      card.dataset.url = item.url;

      const badgeBg = item.category === 'Calculator' ? 'bg-primary/10 text-primary' : 
                      item.category === 'Guide' ? 'bg-brand-violet/10 text-brand-violet' : 
                      'bg-brand-cyan/10 text-brand-cyan';

      card.innerHTML = `
        <div class="flex items-center justify-between gap-3">
          <span class="text-sm font-bold text-ink transition-colors line-clamp-1">
            ${highlightText(item.title, query)}
          </span>
          <span class="font-mono text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-md shrink-0 ${badgeBg}">
            ${item.category}
          </span>
        </div>
        <p class="text-xs text-mute mt-1.5 leading-normal line-clamp-1">
          ${highlightText(item.desc, query)}
        </p>
      `;

      card.addEventListener('click', () => {
        saveToRecent(item.title, item.url, item.category);
      });

      dynamicResults.appendChild(card);
    });
  }

  // Toggle open
  searchToggleBtn?.addEventListener('click', openSearch);

  // Close overlay button
  searchCloseBtn?.addEventListener('click', closeSearch);

  // Close on background click
  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) {
      closeSearch();
    }
  });

  // Handle clear recent history
  clearRecentBtn?.addEventListener('click', () => {
    localStorage.removeItem('gst_recent_searches');
    renderRecentSearches();
  });

  // Dynamic filter chips clicking
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const clicked = e.currentTarget as HTMLButtonElement;
      activeFilter = clicked.dataset.filter || 'all';

      // Visual highlight swap
      filterBtns.forEach(b => {
        b.classList.remove('bg-primary', 'text-on-primary');
        b.classList.add('bg-canvas', 'text-body', 'border-hairline');
      });
      clicked.classList.remove('bg-canvas', 'text-body', 'border-hairline');
      clicked.classList.add('bg-primary', 'text-on-primary');

      selectedIndex = 0; // reset selection index
      renderResults();
      searchInput?.focus();
    });
  });

  // Popular queries clicking
  popularTags.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const btnEl = e.currentTarget as HTMLButtonElement;
      const text = btnEl.querySelector('span')?.innerText || '';
      if (searchInput && text) {
        searchInput.value = text;
        queryText = text;
        
        // Lazy load dynamic index first
        loadSearchIndex().then(() => {
          renderResults();
          searchInput.focus();
        });
      }
    });
  });

  // Typing event
  searchInput?.addEventListener('input', (e) => {
    queryText = (e.target as HTMLInputElement).value;
    selectedIndex = 0; // default to first match
    renderResults();
  });

  // Key Bindings (Up, Down, Enter, Escape, Command-K)
  document.addEventListener('keydown', (e) => {
    // CMD/CTRL + K: Toggle modal
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (searchModal?.classList.contains('hidden')) {
        openSearch();
      } else {
        closeSearch();
      }
      return;
    }

    if (!searchModal || searchModal.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      e.preventDefault();
      closeSearch();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      const length = visibleResultUrls.length;
      if (length > 0) {
        selectedIndex = (selectedIndex + 1) % length;
        renderResults();
        
        // Scroll selected element into view if needed
        const activeCard = dynamicResults?.children[selectedIndex] as HTMLElement | null;
        activeCard?.scrollIntoView({ block: 'nearest' });
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      const length = visibleResultUrls.length;
      if (length > 0) {
        selectedIndex = (selectedIndex - 1 + length) % length;
        renderResults();
        
        // Scroll selected element into view if needed
        const activeCard = dynamicResults?.children[selectedIndex] as HTMLElement | null;
        activeCard?.scrollIntoView({ block: 'nearest' });
      }
    } else if (e.key === 'Enter') {
      const length = visibleResultUrls.length;
      if (length > 0 && selectedIndex >= 0 && selectedIndex < length) {
        e.preventDefault();
        const activeUrl = visibleResultUrls[selectedIndex];
        
        // Find match in index to save it
        const matchItem = searchIndex.find(item => item.url === activeUrl);
        if (matchItem) {
          saveToRecent(matchItem.title, matchItem.url, matchItem.category);
        }
        
        window.location.href = activeUrl;
      }
    }
  });

  // Global key intercept for typing on home page
  window.addEventListener('DOMContentLoaded', () => {
    // Look for global search trigger key presses
    document.addEventListener('keydown', (e) => {
      // Avoid opening search modal when typing inside inputs, forms, textareas, selects, or buttons
      const target = e.target as HTMLElement;
      const isInput = target && (
        target.tagName === 'INPUT' ||
        target.tagName === 'TEXTAREA' ||
        target.tagName === 'SELECT' ||
        target.tagName === 'BUTTON' ||
        target.closest('label') !== null ||
        target.closest('button') !== null ||
        target.closest('form') !== null ||
        target.isContentEditable
      );
      
      if (isInput || e.metaKey || e.ctrlKey || e.altKey) return;
      
      // If modal is hidden, and user presses alphanumeric key
      if (searchModal?.classList.contains('hidden') && /^[a-zA-Z0-9]$/.test(e.key)) {
        e.preventDefault();
        openSearch();
        if (searchInput) {
          searchInput.value = e.key;
          queryText = e.key;
          
          // Lazy load dynamic index first
          loadSearchIndex().then(() => {
            renderResults();
          });
        }
      }
    });
  });
</script>
