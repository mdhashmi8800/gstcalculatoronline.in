---
import { getSEOMetadata, type SEOMetadata } from '../utils/seo';

interface Props {
  seo?: SEOMetadata;
  schema?: Record<string, any>;
  schemas?: Record<string, any>[];
  publishedTime?: string;
  modifiedTime?: string;
}

const { seo, schema, schemas, publishedTime, modifiedTime } = Astro.props;

// Determine unique canonical URL automatically, stripping trailing slash and normalising to lowercase
let cleanPath = Astro.url.pathname.toLowerCase();
if (cleanPath.endsWith('/') && cleanPath !== '/') {
  cleanPath = cleanPath.slice(0, -1);
}
const canonicalUrl = `https://gstcalculatoronline.in${cleanPath}`;

const metadata = getSEOMetadata({
  canonical: canonicalUrl,
  ...seo,
});

let cleanCanonical = (metadata.canonical || canonicalUrl).toLowerCase();
if (cleanCanonical.endsWith('/') && cleanCanonical !== 'https://gstcalculatoronline.in/') {
  cleanCanonical = cleanCanonical.slice(0, -1);
}
metadata.canonical = cleanCanonical;

// Combine all schemas into one list for rendering
const allPageSchemas: Record<string, any>[] = [];
if (schema) allPageSchemas.push(schema);
if (schemas && Array.isArray(schemas)) allPageSchemas.push(...schemas);

// Process page-specific schemas to stitch them to the main WebPage and Organization graph
const webpageMainEntityIds: Record<string, any>[] = [];
const processedPageSchemas = allPageSchemas.map(s => {
  if (!s || typeof s !== 'object') return s;
  
  const originalType = s["@type"];
  const types = Array.isArray(originalType) ? originalType : [originalType];
  
  // Software / Web Application matching
  if (types.includes("SoftwareApplication") || types.includes("WebApplication") || types.includes("FinancialApplication")) {
    const stitchedId = s["@id"] || `${cleanCanonical}#software`;
    webpageMainEntityIds.push({ "@id": stitchedId });
    return {
      ...s,
      "@id": stitchedId,
      "isPartOf": { "@id": `${cleanCanonical}#webpage` }
    };
  }
  
  // Article / BlogPosting matching
  if (types.includes("BlogPosting") || types.includes("Article") || types.includes("NewsArticle")) {
    const stitchedId = s["@id"] || `${cleanCanonical}#article`;
    webpageMainEntityIds.push({ "@id": stitchedId });
    return {
      ...s,
      "@id": stitchedId,
      "isPartOf": { "@id": `${cleanCanonical}#webpage` },
      "publisher": { "@id": "https://gstcalculatoronline.in/#organization" }
    };
  }
  
  // FAQPage matching
  if (types.includes("FAQPage")) {
    const stitchedId = s["@id"] || `${cleanCanonical}#faq`;
    webpageMainEntityIds.push({ "@id": stitchedId });
    return {
      ...s,
      "@id": stitchedId,
      "isPartOf": { "@id": `${cleanCanonical}#webpage` }
    };
  }
  
  return s;
});

// Organization Schema (Required by SEO standards & EEAT)
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://gstcalculatoronline.in/#organization",
  "name": "GST Calculator Online",
  "url": "https://gstcalculatoronline.in",
  "description": "Free online GST calculators for Indian taxpayers. Calculate CGST, SGST, IGST, GST interest, late fees, and refunds instantly.",
  "logo": {
    "@type": "ImageObject",
    "@id": "https://gstcalculatoronline.in/#logo",
    "url": "https://gstcalculatoronline.in/favicon.png",
    "caption": "GST Calculator Online"
  },
  "image": {
    "@id": "https://gstcalculatoronline.in/#logo"
  },
  "sameAs": [
    "https://gstcalculatoronline.in"
  ]
};

// WebSite Schema with Search Action
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://gstcalculatoronline.in/#website",
  "name": "GST Calculator Online",
  "url": "https://gstcalculatoronline.in",
  "description": "India's most comprehensive free GST calculator platform with 11 tools and 30+ expert tax guides.",
  "publisher": {
    "@id": "https://gstcalculatoronline.in/#organization"
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://gstcalculatoronline.in/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

// WebPage Schema (Required by SEO standards) - stitched to website and children components
const webpageSchema: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${cleanCanonical}#webpage`,
  "url": cleanCanonical,
  "name": metadata.title,
  "description": metadata.description,
  "isPartOf": {
    "@id": "https://gstcalculatoronline.in/#website"
  }
};

// Only link breadcrumb schema if we are not on the homepage or 404 page
if (cleanPath !== '/' && cleanPath !== '/404') {
  webpageSchema.breadcrumb = {
    "@id": `${cleanCanonical}#breadcrumb`
  };
}


// Add mainEntity linkage if we have child entities like Article, SoftwareApplication, FAQPage
if (webpageMainEntityIds.length > 0) {
  webpageSchema.mainEntity = webpageMainEntityIds.length === 1 
    ? webpageMainEntityIds[0] 
    : webpageMainEntityIds;
}
---

<!-- Primary Meta Tags -->
<title>{metadata.title}</title>
<meta name="title" content={metadata.title} />
<meta name="description" content={metadata.description} />
<meta name="robots" content={metadata.noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
{seo?.keywords && <meta name="keywords" content={seo.keywords} />}
{seo?.author && <meta name="author" content={seo.author} />}

<!-- Geo & Language Targeting -->
<meta property="og:locale" content="en_IN" />
<meta name="geo.region" content="IN" />
<meta name="geo.placename" content="India" />

<!-- Canonical URL -->
{metadata.canonical && <link rel="canonical" href={metadata.canonical} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={metadata.ogType} />
<meta property="og:url" content={metadata.canonical} />
<meta property="og:title" content={metadata.ogTitle} />
<meta property="og:description" content={metadata.ogDescription} />
<meta property="og:image" content={metadata.ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={metadata.ogTitle} />
<meta property="og:site_name" content="GST Calculator Online" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{metadata.ogType === 'article' && <meta property="article:author" content={seo?.author || 'GST Calculator Online'} />}

<!-- Twitter Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={metadata.canonical} />
<meta property="twitter:title" content={metadata.ogTitle} />
<meta property="twitter:description" content={metadata.ogDescription} />
<meta property="twitter:image" content={metadata.ogImage} />
<meta name="twitter:site" content="@gstcalconline" />



<!-- Page-specific Structured Data (JSON-LD) – supports multiple schemas -->
{processedPageSchemas.map(s => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}

<!-- Global site-wide schemas -->
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webpageSchema)} />

