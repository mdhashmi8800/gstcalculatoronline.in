---
import { tools } from '../utils/tools';

const categories = [
  { id: 'tax-slabs', name: 'Tax Slabs', desc: 'Slab calculations & splits', url: '/tools/category/tax-slabs' },
  { id: 'late-fees', name: 'Late Fees', desc: 'Turnover-capped penalties', url: '/tools/category/late-fees' },
  { id: 'interest-penalties', name: 'Interest', desc: 'Section 50 interest estimators', url: '/tools/category/interest-penalties' },
  { id: 'composition-scheme', name: 'Composition', desc: 'Quarterly trader liabilities', url: '/tools/category/composition-scheme' }
];

const blogCategories = [
  { slug: 'gst-basics', name: 'GST Basics' },
  { slug: 'gst-compliance', name: 'GST Compliance' },
  { slug: 'input-tax-credit', name: 'Input Tax Credit' },
  { slug: 'small-business', name: 'Small Business' }
];
---
<header class="sticky top-0 z-40 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md transition-all duration-200">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group select-none">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary text-on-primary shadow-sm shadow-primary/20 transition-transform duration-200 group-hover:scale-105">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.752-.628a8.38 8.38 0 0 1 8.3-1.077M3.75 3.375c0-1.036.84-1.875 1.875-1.875h.375a3.75 3.75 0 0 1 3.75 3.75v1.875m0 0H5.625a1.875 1.875 0 0 1-1.875-1.875v-.375ZM9.75 8.625c0-1.036.84-1.875 1.875-1.875h.375A3.75 3.75 0 0 1 15.75 10.5v1.875m0 0h-3.75a1.875 1.875 0 0 1-1.875-1.875v-.375Z" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-sans text-base font-extrabold tracking-tight text-ink">GST Calculator</span>
        <span class="font-mono text-[9px] font-bold text-mute uppercase tracking-widest leading-none">Online India</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 select-none">
      <a href="/" class="px-3 py-1.5 text-sm font-semibold text-body rounded-full hover:text-ink hover:bg-canvas-soft-2 transition-all">Home</a>
      
      <!-- Calculators Dropdown Container -->
      <div class="relative group">
        <button 
          type="button" 
          class="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-body rounded-full hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
        >
          Calculators
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3 w-3 text-mute group-hover:text-ink transition-colors">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <!-- Dropdown Panel -->
        <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 w-80 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 ease-out">
          <div class="rounded-2xl border border-hairline bg-canvas p-4 shadow-xl">
            <div class="space-y-1.5">
              <a href="/tools" class="block p-2 rounded-xl hover:bg-canvas-soft-2 group/link">
                <span class="text-xs font-bold text-ink group-hover/link:text-primary transition-colors">All Calculators</span>
                <span class="block text-[10px] text-mute leading-normal mt-0.5">Browse all 11 tax tools</span>
              </a>
              <div class="border-t border-hairline my-2"></div>
              {categories.map(cat => (
                <a href={cat.url} class="block p-2 rounded-xl hover:bg-canvas-soft-2 group/link">
                  <span class="text-xs font-bold text-ink group-hover/link:text-primary transition-colors">{cat.name}</span>
                  <span class="block text-[10px] text-mute leading-normal mt-0.5">{cat.desc}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Blog Dropdown Container -->
      <div class="relative group">
        <button 
          type="button" 
          class="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-body rounded-full hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
        >
          Guides
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3 w-3 text-mute group-hover:text-ink transition-colors">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <!-- Dropdown Panel -->
        <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 w-56 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 ease-out">
          <div class="rounded-2xl border border-hairline bg-canvas p-3 shadow-xl">
            <div class="space-y-1">
              <a href="/blog" class="block p-2 rounded-xl hover:bg-canvas-soft-2 text-xs font-bold text-ink hover:text-primary transition-colors">
                All Tax Articles
              </a>
              <div class="border-t border-hairline my-1.5"></div>
              {blogCategories.map(cat => (
                <a 
                  href={`/blog/category/${cat.slug}`} 
                  class="block p-2 rounded-xl hover:bg-canvas-soft-2 text-xs font-bold text-body hover:text-primary transition-colors"
                >
                  {cat.name}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <a href="/about" class="px-3 py-1.5 text-sm font-semibold text-body rounded-full hover:text-ink hover:bg-canvas-soft-2 transition-all">About</a>
      <a href="/contact" class="px-3 py-1.5 text-sm font-semibold text-body rounded-full hover:text-ink hover:bg-canvas-soft-2 transition-all">Contact</a>
    </nav>

    <!-- Right Side Actions -->
    <div class="flex items-center gap-2">
      <!-- Search Button Toggle -->
      <button 
        id="search-toggle-btn"
        type="button" 
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-hairline text-body hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
        aria-label="Search tools"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-4.5 w-4.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
        </svg>
      </button>

      <!-- Theme Switcher -->
      <button 
        id="theme-toggle" 
        type="button" 
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-hairline text-body hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
        aria-label="Toggle theme"
      >
        <!-- Light Mode Icon (Sun) -->
        <svg id="theme-toggle-light-icon" class="hidden h-4.5 w-4.5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.46 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
        </svg>
        <!-- Dark Mode Icon (Moon) -->
        <svg id="theme-toggle-dark-icon" class="hidden h-4.5 w-4.5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-btn" 
        type="button" 
        class="md:hidden flex h-9 w-9 items-center justify-center rounded-xl border border-hairline text-body hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
        aria-label="Open main menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-4.5 w-4.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Overlay -->
  <div id="mobile-drawer-overlay" class="fixed inset-0 z-45 hidden bg-slate-900/40 backdrop-blur-xs transition-opacity duration-300 opacity-0 md:hidden"></div>

  <!-- Mobile Drawer Menu (Right side slide-out) -->
  <div id="mobile-drawer" class="fixed top-0 right-0 bottom-0 z-50 w-72 max-w-full bg-canvas border-l border-hairline shadow-2xl translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col justify-between">
    <!-- Top Bar -->
    <div>
      <div class="flex h-16 items-center justify-between px-6 border-b border-hairline">
        <span class="font-sans text-sm font-extrabold tracking-tight text-ink uppercase">Menu Navigation</span>
        <button 
          id="mobile-drawer-close"
          type="button"
          class="rounded-xl border border-hairline p-2 text-mute hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
          aria-label="Close menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-4 w-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Links & Accordions -->
      <nav class="p-6 space-y-4 overflow-y-auto max-h-[calc(100vh-10rem)]">
        <a href="/" class="block text-sm font-bold text-body hover:text-primary transition-colors py-1">Home</a>
        
        <!-- Collapsible Calculators -->
        <div class="space-y-2">
          <button 
            id="mobile-collapsible-calc-btn"
            type="button" 
            class="flex w-full items-center justify-between text-sm font-bold text-body hover:text-primary py-1 cursor-pointer"
          >
            <span>Calculators</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3 w-3 text-mute transition-transform duration-200" id="mobile-collapsible-calc-icon">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <div id="mobile-collapsible-calc-panel" class="hidden pl-4 space-y-2 border-l border-hairline my-1">
            <a href="/tools" class="block text-xs font-semibold text-mute hover:text-primary transition-colors py-1">All Tools</a>
            {categories.map(cat => (
              <a href={cat.url} class="block text-xs font-semibold text-mute hover:text-primary transition-colors py-1">{cat.name}</a>
            ))}
          </div>
        </div>

        <!-- Collapsible Blog -->
        <div class="space-y-2">
          <button 
            id="mobile-collapsible-blog-btn"
            type="button" 
            class="flex w-full items-center justify-between text-sm font-bold text-body hover:text-primary py-1 cursor-pointer"
          >
            <span>Guides</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3 w-3 text-mute transition-transform duration-200" id="mobile-collapsible-blog-icon">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <div id="mobile-collapsible-blog-panel" class="hidden pl-4 space-y-2 border-l border-hairline my-1">
            <a href="/blog" class="block text-xs font-semibold text-mute hover:text-primary transition-colors py-1">All Articles</a>
            {blogCategories.map(cat => (
              <a href={`/blog/category/${cat.slug}`} class="block text-xs font-semibold text-mute hover:text-primary transition-colors py-1">{cat.name}</a>
            ))}
          </div>
        </div>

        <a href="/about" class="block text-sm font-bold text-body hover:text-primary transition-colors py-1">About Us</a>
        <a href="/contact" class="block text-sm font-bold text-body hover:text-primary transition-colors py-1">Contact</a>
      </nav>
    </div>

    <!-- Mobile Drawer Footer -->
    <div class="p-6 border-t border-hairline bg-canvas-soft flex flex-col gap-3">
      <button 
        id="mobile-drawer-search-btn"
        type="button"
        class="flex w-full items-center justify-center gap-2 rounded-xl border border-hairline bg-canvas py-2.5 text-xs font-bold text-body hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-4 w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
        </svg>
        Search Portal
      </button>
      <span class="text-[9px] text-mute font-mono text-center">Tax Calculator &bull; Online India</span>
    </div>
  </div>
</header>

<script>
  // Mobile drawer controls
  const openDrawerBtn = document.getElementById('mobile-menu-btn');
  const closeDrawerBtn = document.getElementById('mobile-drawer-close');
  const drawerOverlay = document.getElementById('mobile-drawer-overlay');
  const drawerPanel = document.getElementById('mobile-drawer');
  const drawerSearchBtn = document.getElementById('mobile-drawer-search-btn');
  const searchModal = document.getElementById('search-modal');
  const searchInput = document.getElementById('search-input');

  function openDrawer() {
    drawerOverlay?.classList.remove('hidden');
    // For transition timing
    setTimeout(() => {
      drawerOverlay?.classList.remove('opacity-0');
      drawerOverlay?.classList.add('opacity-100');
      drawerPanel?.classList.remove('translate-x-full');
      drawerPanel?.classList.add('translate-x-0');
    }, 20);
    document.body.classList.add('overflow-hidden');
  }

  function closeDrawer() {
    drawerOverlay?.classList.remove('opacity-100');
    drawerOverlay?.classList.add('opacity-0');
    drawerPanel?.classList.remove('translate-x-0');
    drawerPanel?.classList.add('translate-x-full');
    
    setTimeout(() => {
      drawerOverlay?.classList.add('hidden');
    }, 300);
    document.body.classList.remove('overflow-hidden');
  }

  openDrawerBtn?.addEventListener('click', openDrawer);
  closeDrawerBtn?.addEventListener('click', closeDrawer);
  drawerOverlay?.addEventListener('click', closeDrawer);

  drawerSearchBtn?.addEventListener('click', () => {
    closeDrawer();
    setTimeout(() => {
      searchModal?.classList.remove('hidden');
      searchModal?.classList.add('flex');
      setTimeout(() => (searchInput as HTMLInputElement | null)?.focus(), 50);
      document.body.classList.add('overflow-hidden');
    }, 250);
  });

  // Mobile Collapsibles
  const calcBtn = document.getElementById('mobile-collapsible-calc-btn');
  const calcPanel = document.getElementById('mobile-collapsible-calc-panel');
  const calcIcon = document.getElementById('mobile-collapsible-calc-icon');

  calcBtn?.addEventListener('click', () => {
    calcPanel?.classList.toggle('hidden');
    calcIcon?.classList.toggle('rotate-180');
  });

  const blogBtn = document.getElementById('mobile-collapsible-blog-btn');
  const blogPanel = document.getElementById('mobile-collapsible-blog-panel');
  const blogIcon = document.getElementById('mobile-collapsible-blog-icon');

  blogBtn?.addEventListener('click', () => {
    blogPanel?.classList.toggle('hidden');
    blogIcon?.classList.toggle('rotate-180');
  });

  // Theme Toggler
  const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
  const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
  const themeToggleBtn = document.getElementById('theme-toggle');

  if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    themeToggleLightIcon?.classList.remove('hidden');
  } else {
    themeToggleDarkIcon?.classList.remove('hidden');
  }

  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', function() {
      themeToggleDarkIcon?.classList.toggle('hidden');
      themeToggleLightIcon?.classList.toggle('hidden');

      if (localStorage.getItem('color-theme')) {
        if (localStorage.getItem('color-theme') === 'light') {
          document.documentElement.classList.add('dark');
          localStorage.setItem('color-theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('color-theme', 'light');
        }
      } else {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('color-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('color-theme', 'dark');
        }
      }
    });
  }
</script>
