---
interface Props {
  title?: string;
}

const { title = "Calculation Summary" } = Astro.props;
---
<div class="rounded-xl border border-hairline bg-canvas-soft p-4 sm:p-6 shadow-xs transition-colors duration-200">
  <h3 class="text-sm font-semibold uppercase tracking-wider text-ink border-b border-hairline pb-3">{title}</h3>
  
  <div class="mt-4 space-y-3.5">
    <!-- Base / Taxable Amount -->
    <div class="flex justify-between items-center text-sm">
      <span class="text-body font-medium">Taxable Value (Net)</span>
      <span id="res-taxable-val" class="font-mono font-semibold text-ink">₹0.00</span>
    </div>

    <!-- CGST (Central Tax) -->
    <div id="res-cgst-row" class="flex justify-between items-center text-sm">
      <span class="text-body">Central Tax (CGST)</span>
      <span id="res-cgst-val" class="font-mono text-ink">₹0.00</span>
    </div>

    <!-- SGST (State Tax) -->
    <div id="res-sgst-row" class="flex justify-between items-center text-sm">
      <span class="text-body">State Tax (SGST)</span>
      <span id="res-sgst-val" class="font-mono text-ink">₹0.00</span>
    </div>

    <!-- IGST (Integrated Tax) -->
    <div id="res-igst-row" class="hidden justify-between items-center text-sm">
      <span class="text-body">Integrated Tax (IGST)</span>
      <span id="res-igst-val" class="font-mono text-ink">₹0.00</span>
    </div>

    <!-- Total Tax Amount -->
    <div class="flex justify-between items-center text-sm border-t border-hairline pt-3.5">
      <span class="text-body font-medium">Total GST Tax</span>
      <span id="res-total-tax" class="font-mono font-semibold text-brand-link">₹0.00</span>
    </div>

    <!-- Grand Total (Gross) -->
    <div class="flex justify-between items-center border-t border-hairline/80 pt-3.5">
      <span class="text-base font-semibold text-ink">Total Value (Gross)</span>
      <span id="res-grand-total" class="font-mono text-xl font-bold text-ink">₹0.00</span>
    </div>
  </div>

  <!-- Action buttons -->
  <div class="mt-6 grid grid-cols-2 gap-3 no-print">
    <!-- Copy Button -->
    <button 
      id="copy-calculation-btn"
      type="button" 
      class="flex items-center justify-center gap-1.5 rounded-lg border border-hairline bg-canvas py-3 text-xs font-semibold text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer select-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 7.5V6.108c0-1.135.845-2.098 1.976-2.192.373-.03.748-.057 1.123-.08M15.75 18H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08M15.75 18.75v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5A3.375 3.375 0 0 0 6.375 7.5H5.25m11.9-3.664A2.251 2.251 0 0 0 15 2.25h-1.5a2.251 2.251 0 0 0-2.15 1.586m5.8 0c.065.21.1.433.1.664v.75h-6V4.5c0-.231.035-.454.1-.664M6.75 7.5H4.875c-.621 0-1.125.504-1.125 1.125v12c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V16.5a9 9 0 0 0-9-9Z" />
      </svg>
      Copy Results
    </button>

    <!-- Share Button -->
    <button 
      id="share-calculation-btn"
      type="button" 
      class="flex items-center justify-center gap-1.5 rounded-lg border border-hairline bg-canvas py-3 text-xs font-semibold text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer select-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z" />
      </svg>
      Share Link
    </button>

    <!-- Print Button -->
    <button 
      id="print-calculation-btn"
      type="button" 
      class="flex items-center justify-center gap-1.5 rounded-lg border border-hairline bg-canvas py-3 text-xs font-semibold text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer select-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.615 0-1.101-.482-1.12-1.1L5.91 18m11.75 0c.27-.024.54-.051.81-.082 1.18-.137 2.13-1.02 2.21-2.207l.45-6.6a2.25 2.25 0 0 0-2.01-2.402a48.9 48.9 0 0 0-15.16 0A2.25 2.25 0 0 0 2.22 9.11l.45 6.6a2.25 2.25 0 0 0 2.21 2.207c.27.031.54.058.81.082M18 18V9m-12 9V9m4.72-4.121a3 3 0 1 1 5.714 0M10.5 9.75h.008v.008H10.5V9.75Zm2.25 0h.008v.008h-.008V9.75Z" />
      </svg>
      Print Results
    </button>

    <!-- Reset Button -->
    <button 
      id="reset-calculation-btn"
      type="button" 
      class="flex items-center justify-center gap-1.5 rounded-lg border border-hairline bg-canvas py-3 text-xs font-semibold text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer select-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
      </svg>
      Reset Inputs
    </button>
  </div>
  
  <div id="copy-toast" class="hidden mt-3 text-center text-xs font-semibold text-brand-success py-1.5 rounded bg-brand-success/10 transition-all duration-200">
    Breakdown copied to clipboard!
  </div>
  <div id="share-toast" class="hidden mt-3 text-center text-xs font-semibold text-brand-success py-1.5 rounded bg-brand-success/10 transition-all duration-200">
    Link with prefilled values copied to clipboard!
  </div>
</div>

<script>
  const copyBtn = document.getElementById('copy-calculation-btn');
  const shareBtn = document.getElementById('share-calculation-btn');
  const printBtn = document.getElementById('print-calculation-btn');
  const resetBtn = document.getElementById('reset-calculation-btn');
  const copyToast = document.getElementById('copy-toast');
  const shareToast = document.getElementById('share-toast');

  copyBtn?.addEventListener('click', () => {
    const taxableLabel = document.getElementById('res-taxable-val')?.previousElementSibling?.textContent?.trim() || 'Taxable Value (Net)';
    const taxable = document.getElementById('res-taxable-val')?.innerText || '₹0.00';
    
    const cgstLabel = document.getElementById('res-cgst-val')?.previousElementSibling?.textContent?.trim() || 'Central Tax (CGST)';
    const cgst = document.getElementById('res-cgst-row')?.classList.contains('hidden') ? null : (document.getElementById('res-cgst-val')?.innerText || '₹0.00');
    
    const sgstLabel = document.getElementById('res-sgst-val')?.previousElementSibling?.textContent?.trim() || 'State Tax (SGST)';
    const sgst = document.getElementById('res-sgst-row')?.classList.contains('hidden') ? null : (document.getElementById('res-sgst-val')?.innerText || '₹0.00');
    
    const igstLabel = document.getElementById('res-igst-val')?.previousElementSibling?.textContent?.trim() || 'Integrated Tax (IGST)';
    const igst = document.getElementById('res-igst-row')?.classList.contains('hidden') ? null : (document.getElementById('res-igst-val')?.innerText || '₹0.00');
    
    const totalTaxLabel = document.getElementById('res-total-tax')?.previousElementSibling?.textContent?.trim() || 'Total GST Tax';
    const totalTax = document.getElementById('res-total-tax')?.innerText || '₹0.00';
    
    const grandTotalLabel = document.getElementById('res-grand-total')?.previousElementSibling?.textContent?.trim() || 'Total Value (Gross)';
    const grandTotal = document.getElementById('res-grand-total')?.innerText || '₹0.00';

    let txt = `GST Calculation Breakdown:\n-------------------------\n${taxableLabel}: ${taxable}\n`;
    if (cgst !== null) txt += `${cgstLabel}: ${cgst}\n`;
    if (sgst !== null) txt += `${sgstLabel}: ${sgst}\n`;
    if (igst !== null) txt += `${igstLabel}: ${igst}\n`;
    txt += `${totalTaxLabel}: ${totalTax}\n${grandTotalLabel}: ${grandTotal}\n-------------------------\nCalculated via gstcalculatoronline.in`;

    navigator.clipboard.writeText(txt).then(() => {
      if (copyToast) {
        copyToast.classList.remove('hidden');
        setTimeout(() => copyToast.classList.add('hidden'), 2000);
      }
    });
  });

  shareBtn?.addEventListener('click', () => {
    const url = new URL(window.location.href);
    url.search = ''; // reset params
    
    const form = document.querySelector('form');
    if (form) {
      const inputs = form.querySelectorAll('input, select, textarea');
      inputs.forEach((input) => {
        const el = input as HTMLInputElement | HTMLSelectElement;
        if (el.name) {
          if (el.type === 'radio' || el.type === 'checkbox') {
            const radio = el as HTMLInputElement;
            if (radio.checked) {
              url.searchParams.set(radio.name, radio.value);
            }
          } else if (el.value !== '') {
            url.searchParams.set(el.name, el.value);
          }
        }
      });
    }

    navigator.clipboard.writeText(url.toString()).then(() => {
      if (shareToast) {
        shareToast.classList.remove('hidden');
        setTimeout(() => shareToast.classList.add('hidden'), 2000);
      }
    });
  });

  printBtn?.addEventListener('click', () => {
    window.print();
  });

  resetBtn?.addEventListener('click', () => {
    const form = document.querySelector('form');
    if (form) {
      form.reset();
      
      // Hide any custom conditional elements on form reset
      const customRateContainer = document.getElementById('custom-rate-container');
      if (customRateContainer) {
        customRateContainer.classList.add('hidden');
      }
      
      const turnoverContainer = document.getElementById('turnover-container');
      if (turnoverContainer) {
        turnoverContainer.classList.add('hidden');
      }

      const refundInvertedInputs = document.getElementById('inverted-inputs-container');
      if (refundInvertedInputs) {
        refundInvertedInputs.classList.add('hidden');
      }

      // Remove validation error classes on reset
      form.querySelectorAll('input, select').forEach((input) => {
        input.classList.remove('input-error');
        const errSpan = document.getElementById(`${input.id}-error`);
        if (errSpan) errSpan.remove();
      });

      // Dispatch change & input events to recalculate to defaults
      form.dispatchEvent(new Event('input', { bubbles: true }));
      form.dispatchEvent(new Event('change', { bubbles: true }));
    }
  });
</script>

