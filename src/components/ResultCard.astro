---
interface Props {
  title?: string;
  showEffectiveTax?: boolean;
}

const { title = "Calculation Summary", showEffectiveTax = true } = Astro.props;
---
<div class="rounded-2xl border border-hairline bg-canvas-soft p-4 sm:p-6 shadow-xs transition-colors duration-200" id="result-card-root">
  <div class="flex items-center justify-between border-b border-hairline pb-2.5 mb-3">
    <h3 class="text-sm font-bold uppercase tracking-wider text-ink">{title}</h3>
    <span class="text-[10px] font-mono text-mute bg-canvas-soft-2 px-2 py-0.5 rounded-full border border-hairline">Live</span>
  </div>
  
  <!-- Grand Total -->
  <div class="grand-total-row">
    <div class="flex justify-between items-center md:flex-row flex-col">
      <span class="text-sm font-bold text-ink">Grand Total</span>
      <span id="res-grand-total" class="font-mono text-2xl font-extrabold text-ink">₹0.00</span>
    </div>
    <p class="text-[10px] text-mute mt-0.5 font-mono" id="res-grand-total-label">Inclusive of all taxes</p>
  </div>

  <div id="primary-summary-grid" class="w-full">
    <!-- Base / Taxable Amount -->
    <div class="primary-summary-box" id="result-taxable-row">
      <span class="text-xs text-mute md:text-sm md:text-body md:font-medium">Base Amount</span>
      <span id="res-taxable-val" class="font-mono text-base font-bold text-ink md:text-sm md:font-semibold">₹0.00</span>
    </div>

    <!-- Total GST Tax -->
    <div class="primary-summary-box" id="result-total-tax-row">
      <span class="text-xs text-mute md:text-sm md:text-body md:font-medium">Total GST</span>
      <span id="res-total-tax" class="font-mono text-base font-bold md:text-sm md:font-semibold" style="color: var(--color-brand-link);">₹0.00</span>
    </div>
  </div>

  <!-- Mobile Detailed Breakdown Toggle -->
  <button 
    id="mobile-breakdown-toggle" 
    type="button" 
    class="md:hidden flex items-center justify-center gap-1.5 w-full py-2.5 px-4 rounded-xl border border-hairline bg-canvas text-xs font-bold text-mute hover:text-ink transition-all cursor-pointer select-none mb-3"
  >
    <span>Show Detailed Breakdown</span>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 transition-transform duration-200" id="toggle-arrow">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </button>

  <div id="mobile-collapsible-breakdown" class="hidden md:block w-full space-y-1">
    <!-- CGST (Central Tax) -->
    <div id="res-cgst-row" class="result-row pl-4">
      <span class="text-xs text-mute flex items-center gap-1">
        <span class="inline-block w-2 h-2 rounded-full" style="background:#059669;"></span>
        CGST (Central)
      </span>
      <span id="res-cgst-val" class="font-mono text-xs font-semibold text-mute">₹0.00</span>
    </div>

    <!-- SGST (State Tax) -->
    <div id="res-sgst-row" class="result-row pl-4">
      <span class="text-xs text-mute flex items-center gap-1">
        <span class="inline-block w-2 h-2 rounded-full" style="background:#10b981;"></span>
        SGST (State)
      </span>
      <span id="res-sgst-val" class="font-mono text-xs font-semibold text-mute">₹0.00</span>
    </div>

    <!-- IGST (Integrated Tax) -->
    <div id="res-igst-row" class="hidden result-row pl-4">
      <span class="text-xs text-mute flex items-center gap-1">
        <span class="inline-block w-2 h-2 rounded-full" style="background:#059669;"></span>
        IGST (Integrated)
      </span>
      <span id="res-igst-val" class="font-mono text-xs font-semibold text-mute">₹0.00</span>
    </div>

    {showEffectiveTax && (
      <div class="result-row border-t border-hairline/60 mt-1 pt-1">
        <span class="text-xs text-body font-medium">Effective Tax Rate</span>
        <span id="res-effective-rate" class="font-mono text-xs font-bold" style="color: var(--color-brand-link);">0.00%</span>
      </div>
    )}

    <!-- Live Bar Chart -->
    <div class="bar-chart-container" id="bar-chart-area">
      <p class="bar-chart-label mb-3">Tax Breakdown</p>
      <div class="space-y-2.5">
        <!-- Base Bar -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <span class="bar-chart-label">Base</span>
            <span id="chart-base-pct" class="bar-chart-label">0%</span>
          </div>
          <div class="h-2 rounded-full overflow-hidden bg-canvas-soft-2">
            <div id="chart-base-bar" class="bar-chart-bar h-2 rounded-full" style="background: var(--color-ink); opacity: 0.2; width: 0%"></div>
          </div>
        </div>
        <!-- GST Bar -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <span class="bar-chart-label">GST</span>
            <span id="chart-gst-pct" class="bar-chart-label">0%</span>
          </div>
          <div class="h-2 rounded-full overflow-hidden bg-canvas-soft-2">
            <div id="chart-gst-bar" class="bar-chart-bar h-2 rounded-full" style="background: var(--color-primary); width: 0%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Action buttons -->
  <div class="mt-4 grid grid-cols-3 md:grid-cols-2 gap-2 no-print">
    <!-- Copy Button -->
    <button 
      id="copy-calculation-btn"
      type="button" 
      class="flex items-center justify-center gap-1.5 rounded-xl border border-hairline bg-canvas py-2.5 text-xs font-semibold text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer select-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 7.5V6.108c0-1.135.845-2.098 1.976-2.192.373-.03.748-.057 1.123-.08M15.75 18H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08M15.75 18.75v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5A3.375 3.375 0 0 0 6.375 7.5H5.25m11.9-3.664A2.251 2.251 0 0 0 15 2.25h-1.5a2.251 2.251 0 0 0-2.15 1.586m5.8 0c.065.21.1.433.1.664v.75h-6V4.5c0-.231.035-.454.1-.664M6.75 7.5H4.875c-.621 0-1.125.504-1.125 1.125v12c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V16.5a9 9 0 0 0-9-9Z" />
      </svg>
      Copy
    </button>

    <!-- Share Button -->
    <button 
      id="share-calculation-btn"
      type="button" 
      class="flex items-center justify-center gap-1.5 rounded-xl border border-hairline bg-canvas py-2.5 text-xs font-semibold text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer select-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z" />
      </svg>
      Share
    </button>

    <!-- Download PDF Button -->
    <button 
      id="pdf-calculation-btn"
      type="button" 
      class="flex items-center justify-center gap-1.5 rounded-xl border border-hairline bg-canvas py-2.5 text-xs font-semibold text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer select-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
      </svg>
      PDF
    </button>

    <!-- Print Button (Hidden on Mobile) -->
    <button 
      id="print-calculation-btn"
      type="button" 
      class="hidden md:flex items-center justify-center gap-1.5 rounded-xl border border-hairline bg-canvas py-2.5 text-xs font-semibold text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer select-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.615 0-1.101-.482-1.12-1.1L5.91 18m11.75 0c.27-.024.54-.051.81-.082 1.18-.137 2.13-1.02 2.21-2.207l.45-6.6a2.25 2.25 0 0 0-2.01-2.402a48.9 48.9 0 0 0-15.16 0A2.25 2.25 0 0 0 2.22 9.11l.45 6.6a2.25 2.25 0 0 0 2.21 2.207c.27.031.54.058.81.082M18 18V9m-12 9V9m4.72-4.121a3 3 0 1 1 5.714 0M10.5 9.75h.008v.008H10.5V9.75Zm2.25 0h.008v.008h-.008V9.75Z" />
      </svg>
      Print
    </button>
  </div>

  <!-- Reset Link -->
  <button 
    id="reset-calculation-btn"
    type="button"
    class="no-print mt-3 w-full text-center text-xs font-semibold text-mute hover:text-primary transition-colors cursor-pointer py-1"
  >
    ↺ Reset Calculator <span class="kbd ml-1">ESC</span>
  </button>
  
  <div id="copy-toast" class="hidden mt-3 text-center text-xs font-semibold text-brand-success py-1.5 rounded-lg bg-brand-success/10 transition-all duration-200">
    ✓ Breakdown copied to clipboard!
  </div>
  <div id="share-toast" class="hidden mt-3 text-center text-xs font-semibold text-brand-success py-1.5 rounded-lg bg-brand-success/10 transition-all duration-200">
    ✓ Shareable link copied to clipboard!
  </div>
  <div id="pdf-toast" class="hidden mt-3 text-center text-xs font-semibold text-brand-success py-1.5 rounded-lg bg-brand-success/10 transition-all duration-200">
    ✓ PDF downloaded successfully!
  </div>
</div>

<script>
  const copyBtn = document.getElementById('copy-calculation-btn');
  const shareBtn = document.getElementById('share-calculation-btn');
  const pdfBtn = document.getElementById('pdf-calculation-btn');
  const printBtn = document.getElementById('print-calculation-btn');
  const resetBtn = document.getElementById('reset-calculation-btn');
  const copyToast = document.getElementById('copy-toast');
  const shareToast = document.getElementById('share-toast');
  const pdfToast = document.getElementById('pdf-toast');

  function showToast(el: HTMLElement | null) {
    if (!el) return;
    el.classList.remove('hidden');
    setTimeout(() => el.classList.add('hidden'), 2500);
  }

  function getResultsText(): string {
    const taxable = document.getElementById('res-taxable-val')?.innerText || '₹0.00';
    const cgstRow = document.getElementById('res-cgst-row');
    const sgstRow = document.getElementById('res-sgst-row');
    const igstRow = document.getElementById('res-igst-row');
    const cgst = cgstRow?.classList.contains('hidden') ? null : document.getElementById('res-cgst-val')?.innerText;
    const sgst = sgstRow?.classList.contains('hidden') ? null : document.getElementById('res-sgst-val')?.innerText;
    const igst = igstRow?.classList.contains('hidden') ? null : document.getElementById('res-igst-val')?.innerText;
    const totalTax = document.getElementById('res-total-tax')?.innerText || '₹0.00';
    const effectiveRate = document.getElementById('res-effective-rate')?.innerText || '0.00%';
    const grandTotal = document.getElementById('res-grand-total')?.innerText || '₹0.00';

    let txt = `GST Calculation Breakdown\n${'─'.repeat(30)}\nBase Amount:       ${taxable}\n`;
    if (cgst) txt += `CGST (Central):    ${cgst}\n`;
    if (sgst) txt += `SGST (State):      ${sgst}\n`;
    if (igst) txt += `IGST (Integrated): ${igst}\n`;
    txt += `Total GST:         ${totalTax}\nEffective Rate:    ${effectiveRate}\n${'─'.repeat(30)}\nGrand Total:       ${grandTotal}\n\nCalculated via gstcalculatoronline.in`;
    return txt;
  }

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(getResultsText()).then(() => showToast(copyToast));
  });

  shareBtn?.addEventListener('click', () => {
    const url = new URL(window.location.href);
    url.search = '';
    const form = document.querySelector('form');
    if (form) {
      form.querySelectorAll('input, select, textarea').forEach((input) => {
        const el = input as HTMLInputElement | HTMLSelectElement;
        if (el.name) {
          if ((el.type === 'radio' || el.type === 'checkbox')) {
            const radio = el as HTMLInputElement;
            if (radio.checked) url.searchParams.set(radio.name, radio.value);
          } else if (el.value !== '') {
            url.searchParams.set(el.name, el.value);
          }
        }
      });
    }
    navigator.clipboard.writeText(url.toString()).then(() => showToast(shareToast));
  });

  pdfBtn?.addEventListener('click', async () => {
    // Dynamically load jsPDF from CDN on demand
    if (!(window as any).jspdf) {
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
      document.head.appendChild(script);
      await new Promise(resolve => script.onload = resolve);
    }
    const { jsPDF } = (window as any).jspdf;
    const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a5' });
    
    // Header
    doc.setFillColor(5, 150, 105);
    doc.rect(0, 0, 148, 18, 'F');
    doc.setTextColor(255, 255, 255);
    doc.setFontSize(13);
    doc.setFont('helvetica', 'bold');
    doc.text('GST Calculation Report', 10, 12);
    doc.setFontSize(8);
    doc.setFont('helvetica', 'normal');
    doc.text(`gstcalculatoronline.in`, 108, 12);

    // Date
    doc.setTextColor(80, 80, 80);
    doc.setFontSize(8);
    doc.text(`Generated: ${new Date().toLocaleString('en-IN')}`, 10, 26);

    // Results table
    const taxable = document.getElementById('res-taxable-val')?.innerText || '₹0.00';
    const cgstRow = document.getElementById('res-cgst-row');
    const sgstRow = document.getElementById('res-sgst-row');
    const igstRow = document.getElementById('res-igst-row');
    const cgst = cgstRow?.classList.contains('hidden') ? null : document.getElementById('res-cgst-val')?.innerText;
    const sgst = sgstRow?.classList.contains('hidden') ? null : document.getElementById('res-sgst-val')?.innerText;
    const igst = igstRow?.classList.contains('hidden') ? null : document.getElementById('res-igst-val')?.innerText;
    const totalTax = document.getElementById('res-total-tax')?.innerText || '₹0.00';
    const effectiveRate = document.getElementById('res-effective-rate')?.innerText || '0.00%';
    const grandTotal = document.getElementById('res-grand-total')?.innerText || '₹0.00';

    const rows: [string, string][] = [
      ['Base Amount', taxable],
    ];
    if (cgst) rows.push(['CGST (Central Tax)', cgst]);
    if (sgst) rows.push(['SGST (State Tax)', sgst]);
    if (igst) rows.push(['IGST (Integrated Tax)', igst]);
    rows.push(['Total GST', totalTax]);
    rows.push(['Effective Tax Rate', effectiveRate]);

    let y = 34;
    doc.setFontSize(9);
    rows.forEach(([label, val]) => {
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(60, 60, 60);
      doc.text(label, 10, y);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(15, 23, 42);
      doc.text(val, 138, y, { align: 'right' });
      doc.setDrawColor(226, 232, 240);
      doc.line(10, y + 2, 138, y + 2);
      y += 10;
    });

    // Grand Total highlight
    doc.setFillColor(240, 253, 244);
    doc.roundedRect(8, y, 132, 14, 3, 3, 'F');
    doc.setTextColor(5, 150, 105);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(10);
    doc.text('GRAND TOTAL', 14, y + 9);
    doc.setFontSize(12);
    doc.text(grandTotal, 138, y + 9, { align: 'right' });

    // Footer
    doc.setFontSize(7);
    doc.setTextColor(150, 150, 150);
    doc.setFont('helvetica', 'normal');
    doc.text('Disclaimer: For illustrative purposes only. Verify with a qualified CA.', 10, 205);
    doc.text('© gstcalculatoronline.in — Free Indian GST Calculator', 10, 210);

    doc.save(`GST-Calculation-${Date.now()}.pdf`);
    showToast(pdfToast);
  });

  printBtn?.addEventListener('click', () => window.print());

  resetBtn?.addEventListener('click', () => {
    const form = document.querySelector('form');
    if (form) {
      form.reset();
      document.getElementById('custom-rate-container')?.classList.add('hidden');
      document.getElementById('turnover-container')?.classList.add('hidden');
      document.getElementById('inverted-inputs-container')?.classList.add('hidden');
      form.querySelectorAll('input, select').forEach((input) => {
        input.classList.remove('input-error');
        const errSpan = document.getElementById(`${(input as HTMLInputElement).id}-error`);
        if (errSpan) errSpan.remove();
      });
      form.dispatchEvent(new Event('input', { bubbles: true }));
      form.dispatchEvent(new Event('change', { bubbles: true }));
    }
  });

  // ESC key to reset
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && !document.getElementById('search-modal')?.classList.contains('hidden') === false) {
      document.getElementById('reset-calculation-btn')?.click();
    }
  });

  // Mobile breakdown toggle
  function setupCollapsibleBreakdown() {
    const toggleBtn = document.getElementById('mobile-breakdown-toggle');
    const breakdown = document.getElementById('mobile-collapsible-breakdown');
    const toggleArrow = document.getElementById('toggle-arrow');

    if (!toggleBtn || !breakdown) return;

    toggleBtn.addEventListener('click', () => {
      const isHidden = breakdown.classList.contains('hidden');
      if (isHidden) {
        breakdown.classList.remove('hidden');
        const span = toggleBtn.querySelector('span');
        if (span) span.textContent = 'Hide Detailed Breakdown';
        if (toggleArrow) (toggleArrow as HTMLElement).style.transform = 'rotate(180deg)';
      } else {
        breakdown.classList.add('hidden');
        const span = toggleBtn.querySelector('span');
        if (span) span.textContent = 'Show Detailed Breakdown';
        if (toggleArrow) (toggleArrow as HTMLElement).style.transform = 'rotate(0deg)';
      }
    });
  }

  document.addEventListener('astro:page-load', setupCollapsibleBreakdown);
  setupCollapsibleBreakdown();
</script>
