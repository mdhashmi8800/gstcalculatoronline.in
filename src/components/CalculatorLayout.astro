---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { SEOMetadata } from '../utils/seo';

interface Props {
  title: string;
  description: string;
  seo?: SEOMetadata;
  schema?: Record<string, any>;
}

const { title, description, seo, schema } = Astro.props;
---
<Layout seo={seo || { title, description }} schema={schema}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <Breadcrumbs />

    <!-- Page Header -->
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{title}</h1>
      <p class="mt-2 text-base text-body max-w-3xl">{description}</p>
    </header>

    <!-- AdSense Top Banner -->
    <div class="mb-8 rounded-lg border border-dashed border-hairline-strong bg-canvas-soft-2 p-2 text-center text-xs text-mute">
      Ad Placement (Responsive Auto Ads)
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Inputs (8 cols on large screen) -->
      <div class="lg:col-span-7 bg-canvas rounded-xl border border-hairline p-6 shadow-xs">
        <slot />
      </div>

      <!-- Right Column: Results & Action Cards (5 cols on large screen) -->
      <div class="lg:col-span-5 lg:sticky lg:top-20 space-y-6">
        <slot name="results" />

        <!-- AdSense Sidebar Banner -->
        <div class="rounded-xl border border-dashed border-hairline-strong bg-canvas-soft-2 p-6 text-center text-xs text-mute h-64 flex items-center justify-center">
          Ad Slot (Sticky Sidebar / Skyscraper)
        </div>
      </div>
    </div>

    <!-- Bottom Section: Detailed content / formulas / rules -->
    {Astro.slots.has('content') && (
      <div class="mt-16 border-t border-hairline pt-12 max-w-3xl">
        <div class="prose dark:prose-invert">
          <slot name="content" />
        </div>
      </div>
    )}
  </div>
</Layout>
